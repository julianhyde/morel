(* Draft tests for [MOREL-430]: 'with all', 'extend', 'extend all',
 * 'remove', 'rename'. Expected output is what the issue specifies, not
 * what Morel currently does; none of these operators is implemented
 * yet, so every statement below is currently a parse-level
 * "cannot derive label" error. Move into
 * src/test/resources/script/type.smli, beside the 'with' tests, as the
 * operators land.
 *)

(* -------------------------------------------------------------------
 * with
 *)

(*) An assignment sees the fields, which shadow the environment.
val j = 100;
> val j = 100 : int
{{i=1,j=2} with i=j};
> val it = {i=2,j=2} : {i:int, j:int}

(*) The assignments of a region are simultaneous, so this swaps.
{{i=1,j=2} with i=j, j=i};
> val it = {i=2,j=1} : {i:int, j:int}

(*) Order within a region does not matter; the same swap, written the other way.
{{i=1,j=2} with j=i, i=j};
> val it = {i=2,j=1} : {i:int, j:int}

(*) The record being updated is also visible, and can be qualified.
val r = {i=1,j=100};
> val r = {i=1,j=100} : {i:int, j:int}
{r with j = r.i + 1};
> val it = {i=1,j=2} : {i:int, j:int}

(*) Qualified or not, the assignments see the old values, so both swap.
{r with i = r.j, j = r.i};
> val it = {i=100,j=1} : {i:int, j:int}
{r with i = j, j = i};
> val it = {i=100,j=1} : {i:int, j:int}

(*) The variable is frozen at its binding, while the fields evolve.
{r with i = i + 1 with j = r.i};
> val it = {i=2,j=1} : {i:int, j:int}

(* A field shadows a variable of the same name: 'r' here is the field,
 * of type int, not the record bound above. *)
val t = {i=1,r=100};
> val t = {i=1,r=100} : {i:int, r:int}
{t with i = r.i};
> stdIn:1.18 Error: reference to field i of non-record type int

(*) The record itself is still reachable, under its own name.
{t with i = t.r};
> val it = {i=100,r=100} : {i:int, r:int}

(* If the shadowing field is itself a record, both readings are
 * well-typed, so the answer changes silently: 'r.i' was 1, the
 * variable, and is now 99, the field. *)
val u = {i=0,r={i=99}};
> val u = {i=0,r={i=99}} : {i:int, r:{i:int}}
{u with i = r.i};
> val it = {i=99,r={i=99}} : {i:int, r:{i:int}}

(*) Qualifying by the record's own name is unambiguous either way.
{u with i = u.r.i};
> val it = {i=99,r={i=99}} : {i:int, r:{i:int}}

(*) A field that does not exist is an error.
{{i=1,j="a"} with k=2};
> stdIn:1.1-1.23 Error: field 'k' does not exist

(*) A field may not change type.
{{i=1,j="a"} with i="b"};
> stdIn:1.1-1.25 Error: Cannot deduce type: conflict: string vs int

(* -------------------------------------------------------------------
 * Type inference
 *)

(* A base whose type is not known should give the same error as any
 * other unresolved record. Morel currently throws
 * "java.lang.ClassCastException: TypeVar cannot be cast to
 * RecordLikeType"; the message is not pinned in type-inference.smli
 * because it names JDK internals. Compare 'fn (e, job) => e.job = job'
 * and '#a', which already report this properly. *)
fn r => {r with i = 1};
> stdIn:1.10 Error: unresolved flex record (can't tell what fields there are besides #i)

(* Only a bare variable is a problem. A record expression as the base
 * is deducible from its fields: 'fn {i,j} => {{i, j} with i = size j}'
 * already gives '{i:int, j:string} -> {i:int, j:string}'. *)

(*) With a selector to constrain it, the error is already correct.
fun f r = {r with i = r.i + 1};
> stdIn:1.23 Error: unresolved flex record (can't tell what fields there are besides #i)

(*) The other operators should behave the same way.
fn r => {r extend k = 1};
> stdIn:1.10 Error: unresolved flex record (can't tell what fields there are besides #k)
fn r => {r remove i};
> stdIn:1.10 Error: unresolved flex record (can't tell what fields there are besides #i)

(*) 'extend' widens the type; 'remove' narrows it.
:t fn (r : {i:int}) => {r extend j="a"};
> val it : {i:int} -> {i:int, j:string}
:t fn (r : {i:int, j:string}) => {r remove j};
> val it : {i:int, j:string} -> {i:int}
:t fn (r : {i:int, j:string}) => {r rename k=j};
> val it : {i:int, j:string} -> {i:int, k:string}

(* -------------------------------------------------------------------
 * with all
 *)

{{i=1,j="a"} with all {i=2}};
> val it = {i=2,j="a"} : {i:int, j:string}

(*) Every field of the argument is replaced.
{{i=1,j="a"} with all {i=2,j="b"}};
> val it = {i=2,j="b"} : {i:int, j:string}

(*) A field of the argument that does not exist in the base is an error.
{{i=1} with all {k=2}};
> stdIn:1.1-1.21 Error: field 'k' does not exist

(*) A field may not change type.
{{i=1} with all {i="a"}};
> stdIn:1.1-1.24 Error: Cannot deduce type: conflict: string vs int

(* -------------------------------------------------------------------
 * extend
 *)

{{i=1,j="a"} extend k=true};
> val it = {i=1,j="a",k=true} : {i:int, j:string, k:bool}

(*) An assignment sees the fields.
{{i=1} extend j=i+1};
> val it = {i=1,j=2} : {i:int, j:int}

(*) A field that already exists is an error.
{{i=1,j="a"} extend i=2};
> stdIn:1.1-1.24 Error: field 'i' exists

(*) Assignments in one region are simultaneous, so 'j' is not visible to 'k'.
{{i=1} extend j=i+1, k=j+1};
> stdIn:1.26 Error: unbound variable or constructor: j

(*) A second region sees the first, so this is how to chain.
{{i=1} extend j=i+1 extend k=j+1};
> val it = {i=1,j=2,k=3} : {i:int, j:int, k:int}

(* -------------------------------------------------------------------
 * extend all
 *)

{{i=1} extend all {j="a",k=true}};
> val it = {i=1,j="a",k=true} : {i:int, j:string, k:bool}

(*) The labels must be disjoint.
{{i=1} extend all {i=2}};
> stdIn:1.1-1.24 Error: field 'i' exists

(*) SQL's 'e.*, d.*' less the duplicate join key.
{{deptno=10,ename="Shaggy"} extend all {{deptno=10,dname="Sales"} remove deptno}};
> val it = {deptno=10,dname="Sales",ename="Shaggy"}
>   : {deptno:int, dname:string, ename:string}

(* -------------------------------------------------------------------
 * remove
 *)

{{i=1,j="a"} remove j};
> val it = {i=1} : {i:int}

{{i=1,j="a",k=true} remove j, k};
> val it = {i=1} : {i:int}

(*) Removing the only field gives the empty record, which is unit.
{{i=1} remove i};
> val it = () : unit

(*) A field that does not exist is an error.
{{i=1} remove k};
> stdIn:1.1-1.16 Error: field 'k' does not exist

(* -------------------------------------------------------------------
 * rename
 *)

(*) The label being defined is on the left, as everywhere else.
{{i=1,j="a"} rename k=j};
> val it = {i=1,k="a"} : {i:int, k:string}

(*) All pairs apply simultaneously, so this swaps two labels.
{{i=1,j=2} rename i=j, j=i};
> val it = {i=2,j=1} : {i:int, j:int}

(* A chain: 'k' takes i's value, 'i' takes j's, and 'j' is left over
 * and removed. Equivalent to {e extend k=i with i=j remove j}. *)
{{i=1,j=2} rename k=i, i=j};
> val it = {i=2,k=1} : {i:int, k:int}

(*) The right-hand label must exist.
{{i=1} rename k=z};
> stdIn:1.1-1.18 Error: field 'z' does not exist

(* The left-hand label must be absent once every right-hand label is
 * removed; 'i' survives here, so it collides. *)
{{i=1,j=2} rename i=j};
> stdIn:1.1-1.22 Error: field 'i' exists

(*) Labels must be distinct within each side, so a rename is injective.
{{i=1,j=2} rename k=i, k=j};
> stdIn:1.1-1.27 Error: duplicate field 'k' in record

(*) To duplicate a value under a second label, use 'extend'.
{{i=1} extend k=i};
> val it = {i=1,k=1} : {i:int, k:int}

(* -------------------------------------------------------------------
 * Order of operations
 *)

(*) A later region sees the result of an earlier one.
{{i=1,j=2} with i=j remove j};
> val it = {i=2} : {i:int}

(*) The same operators in the other order: 'j' is gone before 'with' runs.
{{i=1,j=2} remove j with i=j};
> stdIn:1.1-1.29 Error: field 'j' does not exist

(*) 'rename' then 'with': the assignment sees the new label.
{{i=1,j=2} rename k=j with k=k+1};
> val it = {i=1,k=3} : {i:int, k:int}

(*) 'with' then 'rename': the assignment sees the old label.
{{i=1,j=2} with j=j+1 rename k=j};
> val it = {i=1,k=3} : {i:int, k:int}

(*) 'extend' then 'remove' of the field the extension read.
{{i=1} extend j=i+1 remove i};
> val it = {j=2} : {j:int}

(*) The worked example from the issue.
{{comm=2.0,ename="Shaggy",sal=10.0} with sal=sal*12.0 extend tax=sal*0.3 extend net=sal-tax remove comm};
> val it = {ename="Shaggy",net=84,sal=120,tax=36}
>   : {ename:string, net:real, sal:real, tax:real}

(*) End 430-tests.smli
