 *
 * Seed queries for the Spark backend.
 *
 * Each query pins one translation decision, and its expected Spark
 * plan is recorded in src/test/resources/spark/seed-plans.txt. The
 * queries currently run locally; when the Spark structure exists,
 * each will also be prepared, its plan printed, and its result
 * executed remotely.
 *
 * The queries read the scott data set, which the Spark test container
 * holds as a database of the same name with the same rows, so a query
 * gives the same answer whether it runs here or there.
 *)
Sys.set ("printLength", 64);
> val it = () : unit
Sys.set ("output", "tabular");
> val it = () : unit

(* Query 1: filter and project over an inline relation. Pins the
 * LocalRelation encoding (one column each of int, string, bool, real),
 * a conjunctive filter, and a projection that renames and computes. *)
from r in [{i = 1, s = "one", b = true, x = 1.5},
           {i = 2, s = "two", b = false, x = 2.5},
           {i = 3, s = "three", b = true, x = 3.5}]
  where r.b andalso r.i > 1
  yield {r.s, y = r.x * 2.0};
> s     y
> ----- -
> three 7
>
> val it : {s:string, y:real} list

(* Query 2: equijoin. Pins the join relation, the qualification of
 * a column name that both inputs have, and projection over the
 * concatenated row. *)
from e in scott.emps
  join d in scott.depts on e.deptno = d.deptno
  yield {e.ename, d.dname};
> dname      ename
> ---------- ------
> RESEARCH   SMITH
> SALES      ALLEN
> SALES      WARD
> RESEARCH   JONES
> SALES      MARTIN
> SALES      BLAKE
> ACCOUNTING CLARK
> RESEARCH   SCOTT
> ACCOUNTING KING
> SALES      TURNER
> RESEARCH   ADAMS
> SALES      JAMES
> RESEARCH   FORD
> ACCOUNTING MILLER
>
> val it : {dname:string, ename:string} bag

(* Query 3: group by with aggregates. Pins the aggregate relation, the
 * grouping key, and count, sum and max. *)
from e in scott.emps
  group e.deptno
    compute {c = count over (), total = sum over e.sal, top = max over e.sal};
> c deptno top  total
> - ------ ---- -----
> 5     20 3000 10875
> 6     30 2850  9400
> 3     10 5000  8750
>
> val it : {c:int, deptno:int, top:real, total:real} bag

(* Query 4: sort and limit. Pins the sort relation with mixed
 * directions, a limit, and that the result is an ordered list. *)
from e in scott.emps
  yield {e.ename, e.sal}
  order (DESC sal, ename)
  take 3;
> ename sal
> ----- ----
> KING  5000
> FORD  3000
> SCOTT 3000
>
> val it : {ename:string, sal:real} list

(* Query 5: correlated exists subquery. Pins the subquery expression
 * whose inner plan refers to the outer row. *)
from d in scott.depts
  where (exists e in scott.emps where e.deptno = d.deptno andalso e.job = "CLERK")
  yield d.dname;
> val it = ["ACCOUNTING","RESEARCH","SALES"] : string bag


(*) End spark.smli
