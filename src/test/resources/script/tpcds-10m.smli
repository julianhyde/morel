(* --- q77 -------------------------------------------------------- *)
(*
WITH ss AS
(SELECT
    s_store_sk,
    sum(ss_ext_sales_price) AS sales,
    sum(ss_net_profit) AS profit
  FROM store_sales, date_dim, store
  WHERE ss_sold_date_sk = d_date_sk
    AND d_date BETWEEN cast('2000-08-03' AS DATE) AND
  (cast('2000-08-03' AS DATE) + INTERVAL 30 days)
    AND ss_store_sk = s_store_sk
  GROUP BY s_store_sk),
    sr AS
  (SELECT
    s_store_sk,
    sum(sr_return_amt) AS returns,
    sum(sr_net_loss) AS profit_loss
  FROM store_returns, date_dim, store
  WHERE sr_returned_date_sk = d_date_sk
    AND d_date BETWEEN cast('2000-08-03' AS DATE) AND
  (cast('2000-08-03' AS DATE) + INTERVAL 30 days)
    AND sr_store_sk = s_store_sk
  GROUP BY s_store_sk),
    cs AS
  (SELECT
    cs_call_center_sk,
    sum(cs_ext_sales_price) AS sales,
    sum(cs_net_profit) AS profit
  FROM catalog_sales, date_dim
  WHERE cs_sold_date_sk = d_date_sk
    AND d_date BETWEEN cast('2000-08-03' AS DATE) AND
  (cast('2000-08-03' AS DATE) + INTERVAL 30 days)
  GROUP BY cs_call_center_sk),
    cr AS
  (SELECT
    sum(cr_return_amount) AS returns,
    sum(cr_net_loss) AS profit_loss
  FROM catalog_returns, date_dim
  WHERE cr_returned_date_sk = d_date_sk
    AND d_date BETWEEN cast('2000-08-03' AS DATE) AND
  (cast('2000-08-03' AS DATE) + INTERVAL 30 days)),
    ws AS
  (SELECT
    wp_web_page_sk,
    sum(ws_ext_sales_price) AS sales,
    sum(ws_net_profit) AS profit
  FROM web_sales, date_dim, web_page
  WHERE ws_sold_date_sk = d_date_sk
    AND d_date BETWEEN cast('2000-08-03' AS DATE) AND
  (cast('2000-08-03' AS DATE) + INTERVAL 30 days)
    AND ws_web_page_sk = wp_web_page_sk
  GROUP BY wp_web_page_sk),
    wr AS
  (SELECT
    wp_web_page_sk,
    sum(wr_return_amt) AS returns,
    sum(wr_net_loss) AS profit_loss
  FROM web_returns, date_dim, web_page
  WHERE wr_returned_date_sk = d_date_sk
    AND d_date BETWEEN cast('2000-08-03' AS DATE) AND
  (cast('2000-08-03' AS DATE) + INTERVAL 30 days)
    AND wr_web_page_sk = wp_web_page_sk
  GROUP BY wp_web_page_sk)
SELECT
  channel,
  id,
  sum(sales) AS sales,
  sum(returns) AS returns,
  sum(profit) AS profit
FROM
  (SELECT
     'store channel' AS channel,
     ss.s_store_sk AS id,
     sales,
     coalesce(returns, 0) AS returns,
     (profit - coalesce(profit_loss, 0)) AS profit
   FROM ss
     LEFT JOIN sr
       ON ss.s_store_sk = sr.s_store_sk
   UNION ALL
   SELECT
     'catalog channel' AS channel,
     cs_call_center_sk AS id,
     sales,
     returns,
     (profit - profit_loss) AS profit
   FROM cs, cr
   UNION ALL
   SELECT
     'web channel' AS channel,
     ws.wp_web_page_sk AS id,
     sales,
     coalesce(returns, 0) returns,
     (profit - coalesce(profit_loss, 0)) AS profit
   FROM ws
     LEFT JOIN wr
       ON ws.wp_web_page_sk = wr.wp_web_page_sk
  ) x
GROUP BY ROLLUP (channel, id)
ORDER BY channel, id
LIMIT 100
*)
(* "GROUP BY ROLLUP", as in q22; "cr", an aggregate without "GROUP BY",
 * is one record. *)
fun q77 () =
  let
    fun day (year, month, day) =
      Date.date {year, month, day, hour = 0, minute = 0, second = 0,
        offset = SOME Time.zeroTime}
    val zero = Decimal.fromInt 0
    (* "a - b" and "a - coalesce(b, 0)", where "a" and "b" may be NONE *)
    fun minus (a : decimal option, b) =
      case (a, b) of
          (SOME a, SOME b) => SOME (a - b)
        | _ => NONE
    fun minus0 (a, b) = Option.map (fn a => a - getOpt (b, zero)) a
    fun inRange d =
      d >= SOME (day (2000, Aug, 3)) andalso d <= SOME (day (2000, Aug, 3 + 30))
    val ss =
      from ss in tpcds.store_sales,
          d in tpcds.date_dim,
          s in tpcds.store
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso inRange d.d_date
          andalso ss.ss_store_sk = SOME s.s_store_sk
        group s.s_store_sk
          compute {sales = sumSome over ss.ss_ext_sales_price,
            profit = sumSome over ss.ss_net_profit}
    val sr =
      from sr in tpcds.store_returns,
          d in tpcds.date_dim,
          s in tpcds.store
        where sr.sr_returned_date_sk = SOME d.d_date_sk
          andalso inRange d.d_date
          andalso sr.sr_store_sk = SOME s.s_store_sk
        group s.s_store_sk
          compute {returns = sumSome over sr.sr_return_amt,
            profit_loss = sumSome over sr.sr_net_loss}
    val cs =
      from cs in tpcds.catalog_sales,
          d in tpcds.date_dim
        where cs.cs_sold_date_sk = SOME d.d_date_sk
          andalso inRange d.d_date
        group cs.cs_call_center_sk
          compute {sales = sumSome over cs.cs_ext_sales_price,
            profit = sumSome over cs.cs_net_profit}
    val cr =
      from cr in tpcds.catalog_returns,
          d in tpcds.date_dim
        where cr.cr_returned_date_sk = SOME d.d_date_sk
          andalso inRange d.d_date
        compute {returns = sumSome over cr.cr_return_amount,
          profit_loss = sumSome over cr.cr_net_loss}
    val ws =
      from ws in tpcds.web_sales,
          d in tpcds.date_dim,
          wp in tpcds.web_page
        where ws.ws_sold_date_sk = SOME d.d_date_sk
          andalso inRange d.d_date
          andalso ws.ws_web_page_sk = SOME wp.wp_web_page_sk
        group wp.wp_web_page_sk
          compute {sales = sumSome over ws.ws_ext_sales_price,
            profit = sumSome over ws.ws_net_profit}
    val wr =
      from wr in tpcds.web_returns,
          d in tpcds.date_dim,
          wp in tpcds.web_page
        where wr.wr_returned_date_sk = SOME d.d_date_sk
          andalso inRange d.d_date
          andalso wr.wr_web_page_sk = SOME wp.wp_web_page_sk
        group wp.wp_web_page_sk
          compute {returns = sumSome over wr.wr_return_amt,
            profit_loss = sumSome over wr.wr_net_loss}
    val x =
      (from s in ss
        left join r in sr on s.s_store_sk = r.s_store_sk
        yield {channel = SOME "store channel", id = SOME s.s_store_sk,
          s.sales,
          returns = SOME (getOpt (Option.`join` r?.returns, zero)),
          profit = minus0 (s.profit, Option.`join` r?.profit_loss)})
      @
      (from c in cs
        yield {channel = SOME "catalog channel", id = c.cs_call_center_sk,
          c.sales, returns = cr.returns,
          profit = minus (c.profit, cr.profit_loss)})
      @
      (from w in ws
        left join r in wr on w.wp_web_page_sk = r.wp_web_page_sk
        yield {channel = SOME "web channel", id = SOME w.wp_web_page_sk,
          w.sales,
          returns = SOME (getOpt (Option.`join` r?.returns, zero)),
          profit = minus0 (w.profit, Option.`join` r?.profit_loss)})
  in
    from r in (from b in x
          group {b.channel, b.id}
            compute {sales = sumSome over b.sales,
                returns = sumSome over b.returns,
                profit = sumSome over b.profit}
          yield {channel, id, sales, returns, profit})
        union
          (from b in x
              group {b.channel}
                compute {sales = sumSome over b.sales,
                    returns = sumSome over b.returns,
                    profit = sumSome over b.profit}
              yield {channel, id = NONE, sales, returns, profit}),
          (from b in x
              group {}
                compute {sales = sumSome over b.sales,
                    returns = sumSome over b.returns,
                    profit = sumSome over b.profit}
              yield {channel = NONE, id = NONE, sales, returns, profit})
      order (r.channel, r.id)
      take 100
  end;
> val q77 = fn
>   : unit
>      -> {channel:string option, id:int option, profit:decimal option,
>           returns:decimal option, sales:decimal option} list
val r77 = q77 ();
