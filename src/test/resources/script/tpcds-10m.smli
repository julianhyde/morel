> ...
>
> val r77 : {channel:string option, id:int option, profit:decimal option, returns:decimal option, sales:decimal option} list

(* --- q78 -------------------------------------------------------- *)
(*
WITH ws AS
(SELECT
    d_year AS ws_sold_year,
    ws_item_sk,
    ws_bill_customer_sk ws_customer_sk,
    sum(ws_quantity) ws_qty,
    sum(ws_wholesale_cost) ws_wc,
    sum(ws_sales_price) ws_sp
  FROM web_sales
    LEFT JOIN web_returns ON wr_order_number = ws_order_number AND ws_item_sk = wr_item_sk
    JOIN date_dim ON ws_sold_date_sk = d_date_sk
  WHERE wr_order_number IS NULL
  GROUP BY d_year, ws_item_sk, ws_bill_customer_sk
),
    cs AS
  (SELECT
    d_year AS cs_sold_year,
    cs_item_sk,
    cs_bill_customer_sk cs_customer_sk,
    sum(cs_quantity) cs_qty,
    sum(cs_wholesale_cost) cs_wc,
    sum(cs_sales_price) cs_sp
  FROM catalog_sales
    LEFT JOIN catalog_returns ON cr_order_number = cs_order_number AND cs_item_sk = cr_item_sk
    JOIN date_dim ON cs_sold_date_sk = d_date_sk
  WHERE cr_order_number IS NULL
  GROUP BY d_year, cs_item_sk, cs_bill_customer_sk
  ),
    ss AS
  (SELECT
    d_year AS ss_sold_year,
    ss_item_sk,
    ss_customer_sk,
    sum(ss_quantity) ss_qty,
    sum(ss_wholesale_cost) ss_wc,
    sum(ss_sales_price) ss_sp
  FROM store_sales
    LEFT JOIN store_returns ON sr_ticket_number = ss_ticket_number AND ss_item_sk = sr_item_sk
    JOIN date_dim ON ss_sold_date_sk = d_date_sk
  WHERE sr_ticket_number IS NULL
  GROUP BY d_year, ss_item_sk, ss_customer_sk
  )
SELECT
  round(ss_qty / (coalesce(ws_qty + cs_qty, 1)), 2) ratio,
  ss_qty store_qty,
  ss_wc store_wholesale_cost,
  ss_sp store_sales_price,
  coalesce(ws_qty, 0) + coalesce(cs_qty, 0) other_chan_qty,
  coalesce(ws_wc, 0) + coalesce(cs_wc, 0) other_chan_wholesale_cost,
  coalesce(ws_sp, 0) + coalesce(cs_sp, 0) other_chan_sales_price
FROM ss
  LEFT JOIN ws
    ON (ws_sold_year = ss_sold_year AND ws_item_sk = ss_item_sk AND ws_customer_sk = ss_customer_sk)
  LEFT JOIN cs
    ON (cs_sold_year = ss_sold_year AND cs_item_sk = ss_item_sk AND cs_customer_sk = ss_customer_sk)
WHERE coalesce(ws_qty, 0) > 0 AND coalesce(cs_qty, 0) > 0 AND ss_sold_year = 2000
ORDER BY
  ratio,
  ss_qty DESC, ss_wc DESC, ss_sp DESC,
  other_chan_qty,
  other_chan_wholesale_cost,
  other_chan_sales_price,
  round(ss_qty / (coalesce(ws_qty + cs_qty, 1)), 2)
LIMIT 100
*)
fun q78 () =
  let
    val ws =
      from ws in tpcds.web_sales
        left join wr in tpcds.web_returns
          on wr.wr_order_number = ws.ws_order_number
            andalso ws.ws_item_sk = wr.wr_item_sk
        join d in tpcds.date_dim on ws.ws_sold_date_sk = SOME d.d_date_sk
        where not (Option.isSome wr)
        group {ws_sold_year = d.d_year, ws_item_sk = ws.ws_item_sk,
            ws_customer_sk = ws.ws_bill_customer_sk}
          compute {ws_qty = sumSome over ws.ws_quantity,
            ws_wc = sumSome over ws.ws_wholesale_cost,
            ws_sp = sumSome over ws.ws_sales_price}
    val cs =
      from cs in tpcds.catalog_sales
        left join cr in tpcds.catalog_returns
          on cr.cr_order_number = cs.cs_order_number
            andalso cs.cs_item_sk = cr.cr_item_sk
        join d in tpcds.date_dim on cs.cs_sold_date_sk = SOME d.d_date_sk
        where not (Option.isSome cr)
        group {cs_sold_year = d.d_year, cs_item_sk = cs.cs_item_sk,
            cs_customer_sk = cs.cs_bill_customer_sk}
          compute {cs_qty = sumSome over cs.cs_quantity,
            cs_wc = sumSome over cs.cs_wholesale_cost,
            cs_sp = sumSome over cs.cs_sales_price}
    val ss =
      from ss in tpcds.store_sales
        left join sr in tpcds.store_returns
          on sr.sr_ticket_number = ss.ss_ticket_number
            andalso ss.ss_item_sk = sr.sr_item_sk
        join d in tpcds.date_dim on ss.ss_sold_date_sk = SOME d.d_date_sk
        where not (Option.isSome sr)
        group {ss_sold_year = d.d_year, ss_item_sk = ss.ss_item_sk,
            ss_customer_sk = ss.ss_customer_sk}
          compute {ss_qty = sumSome over ss.ss_quantity,
            ss_wc = sumSome over ss.ss_wholesale_cost,
            ss_sp = sumSome over ss.ss_sales_price}
    (* "coalesce(a, 0) + coalesce(b, 0)" *)
    fun plus (a, b) = getOpt (a, 0) + getOpt (b, 0)
    fun plusAmt (a, b) =
      getOpt (a, Decimal.fromInt 0) + getOpt (b, Decimal.fromInt 0)
    (* "round(ss_qty / coalesce(ws_qty + cs_qty, 1), 2)" *)
    fun ratio (ss_qty, ws_qty, cs_qty) =
      let
        val other =
          case (ws_qty, cs_qty) of
              (SOME w, SOME c) => w + c
            | _ => 1
      in
        Option.map
          (fn q => Real.realRound (Real.fromInt q / Real.fromInt other * 100.0)
            / 100.0)
          ss_qty
      end
  in
    from ss in ss
      left join ws in ws
        on ss.ss_customer_sk <> NONE
          andalso ws.ws_sold_year = ss.ss_sold_year
          andalso ws.ws_item_sk = ss.ss_item_sk
          andalso ws.ws_customer_sk = ss.ss_customer_sk
      left join cs in cs
        on ss.ss_customer_sk <> NONE
          andalso cs.cs_sold_year = ss.ss_sold_year
          andalso cs.cs_item_sk = ss.ss_item_sk
          andalso cs.cs_customer_sk = ss.ss_customer_sk
      yield {ss,
        ws_qty = Option.`join` ws?.ws_qty,
        ws_wc = Option.`join` ws?.ws_wc,
        ws_sp = Option.`join` ws?.ws_sp,
        cs_qty = Option.`join` cs?.cs_qty,
        cs_wc = Option.`join` cs?.cs_wc,
        cs_sp = Option.`join` cs?.cs_sp}
      where getOpt (ws_qty, 0) > 0
        andalso getOpt (cs_qty, 0) > 0
        andalso ss.ss_sold_year = SOME 2000
      yield {ratio = ratio (ss.ss_qty, ws_qty, cs_qty), store_qty = ss.ss_qty,
        store_wholesale_cost = ss.ss_wc, store_sales_price = ss.ss_sp,
        other_chan_qty = plus (ws_qty, cs_qty),
        other_chan_wholesale_cost = plusAmt (ws_wc, cs_wc),
        other_chan_sales_price = plusAmt (ws_sp, cs_sp)}
      order (ratio, DESC store_qty, DESC store_wholesale_cost,
        DESC store_sales_price, other_chan_qty, other_chan_wholesale_cost,
        other_chan_sales_price)
      take 100
  end;
> val q78 = fn
>   : unit
>      -> {other_chan_qty:int, other_chan_sales_price:decimal,
>           other_chan_wholesale_cost:decimal, ratio:real option,
>           store_qty:int option, store_sales_price:decimal option,
>           store_wholesale_cost:decimal option} list
val r78 = q78 ();
> other_chan_qty other_chan_sales_price other_chan_wholesale_cost ratio store_qty store_sales_price store_wholesale_cost
> -------------- ---------------------- ------------------------- ----- --------- ----------------- --------------------
>
> val r78 : {other_chan_qty:int, other_chan_sales_price:decimal, other_chan_wholesale_cost:decimal, ratio:real option, store_qty:int option, store_sales_price:decimal option, store_wholesale_cost:decimal option} list

(* --- q79 -------------------------------------------------------- *)
(*
SELECT
  c_last_name,
  c_first_name,
  substr(s_city, 1, 30),
  ss_ticket_number,
  amt,
  profit
FROM
  (SELECT
    ss_ticket_number,
    ss_customer_sk,
    store.s_city,
    sum(ss_coupon_amt) amt,
    sum(ss_net_profit) profit
  FROM store_sales, date_dim, store, household_demographics
  WHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk
    AND store_sales.ss_store_sk = store.s_store_sk
    AND store_sales.ss_hdemo_sk = household_demographics.hd_demo_sk
    AND (household_demographics.hd_dep_count = 6 OR
    household_demographics.hd_vehicle_count > 2)
    AND date_dim.d_dow = 1
    AND date_dim.d_year IN (1999, 1999 + 1, 1999 + 2)
    AND store.s_number_employees BETWEEN 200 AND 295
  GROUP BY ss_ticket_number, ss_customer_sk, ss_addr_sk, store.s_city) ms, customer
WHERE ss_customer_sk = c_customer_sk
ORDER BY c_last_name, c_first_name, substr(s_city, 1, 30), profit
LIMIT 100
*)
fun q79 () =
  from ms in (
      from ss in tpcds.store_sales,
          d in tpcds.date_dim,
          s in tpcds.store,
          hd in tpcds.household_demographics
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso ss.ss_hdemo_sk = SOME hd.hd_demo_sk
          andalso (hd.hd_dep_count = SOME 6
            orelse hd.hd_vehicle_count > SOME 2)
          andalso d.d_dow = SOME 1
          andalso d.d_year elem [SOME 1999, SOME (1999 + 1), SOME (1999 + 2)]
          andalso s.s_number_employees >= SOME 200
          andalso s.s_number_employees <= SOME 295
        group {ss.ss_ticket_number, ss.ss_customer_sk, ss.ss_addr_sk,
            s.s_city}
          compute {amt = sumSome over ss.ss_coupon_amt,
            profit = sumSome over ss.ss_net_profit}),
      c in tpcds.customer
    where ms.ss_customer_sk = SOME c.c_customer_sk
    yield {c.c_last_name, c.c_first_name,
      city = Option.map (fn s => String.substring (s, 0, Int.min (30, size s)))
        ms.s_city,
      ms.ss_ticket_number, ms.amt, ms.profit}
    order (c_last_name, c_first_name, city, profit)
    take 100;
> val q79 = fn
>   : unit
>      -> {amt:decimal option, c_first_name:string option,
>           c_last_name:string option, city:string option,
>           profit:decimal option, ss_ticket_number:int} list
val r79 = q79 ();
