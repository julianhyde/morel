(* --- q75 -------------------------------------------------------- *)
(*
WITH all_sales AS (
  SELECT
    d_year,
    i_brand_id,
    i_class_id,
    i_category_id,
    i_manufact_id,
    SUM(sales_cnt) AS sales_cnt,
    SUM(sales_amt) AS sales_amt
  FROM (
         SELECT
           d_year,
           i_brand_id,
           i_class_id,
           i_category_id,
           i_manufact_id,
           cs_quantity - COALESCE(cr_return_quantity, 0) AS sales_cnt,
           cs_ext_sales_price - COALESCE(cr_return_amount, 0.0) AS sales_amt
         FROM catalog_sales
           JOIN item ON i_item_sk = cs_item_sk
           JOIN date_dim ON d_date_sk = cs_sold_date_sk
           LEFT JOIN catalog_returns ON (cs_order_number = cr_order_number
             AND cs_item_sk = cr_item_sk)
         WHERE i_category = 'Books'
         UNION
         SELECT
           d_year,
           i_brand_id,
           i_class_id,
           i_category_id,
           i_manufact_id,
           ss_quantity - COALESCE(sr_return_quantity, 0) AS sales_cnt,
           ss_ext_sales_price - COALESCE(sr_return_amt, 0.0) AS sales_amt
         FROM store_sales
           JOIN item ON i_item_sk = ss_item_sk
           JOIN date_dim ON d_date_sk = ss_sold_date_sk
           LEFT JOIN store_returns ON (ss_ticket_number = sr_ticket_number
             AND ss_item_sk = sr_item_sk)
         WHERE i_category = 'Books'
         UNION
         SELECT
           d_year,
           i_brand_id,
           i_class_id,
           i_category_id,
           i_manufact_id,
           ws_quantity - COALESCE(wr_return_quantity, 0) AS sales_cnt,
           ws_ext_sales_price - COALESCE(wr_return_amt, 0.0) AS sales_amt
         FROM web_sales
           JOIN item ON i_item_sk = ws_item_sk
           JOIN date_dim ON d_date_sk = ws_sold_date_sk
           LEFT JOIN web_returns ON (ws_order_number = wr_order_number
             AND ws_item_sk = wr_item_sk)
         WHERE i_category = 'Books') sales_detail
  GROUP BY d_year, i_brand_id, i_class_id, i_category_id, i_manufact_id)
SELECT
  prev_yr.d_year AS prev_year,
  curr_yr.d_year AS year,
  curr_yr.i_brand_id,
  curr_yr.i_class_id,
  curr_yr.i_category_id,
  curr_yr.i_manufact_id,
  prev_yr.sales_cnt AS prev_yr_cnt,
  curr_yr.sales_cnt AS curr_yr_cnt,
  curr_yr.sales_cnt - prev_yr.sales_cnt AS sales_cnt_diff,
  curr_yr.sales_amt - prev_yr.sales_amt AS sales_amt_diff
FROM all_sales curr_yr, all_sales prev_yr
WHERE curr_yr.i_brand_id = prev_yr.i_brand_id
  AND curr_yr.i_class_id = prev_yr.i_class_id
  AND curr_yr.i_category_id = prev_yr.i_category_id
  AND curr_yr.i_manufact_id = prev_yr.i_manufact_id
  AND curr_yr.d_year = 2002
  AND prev_yr.d_year = 2002 - 1
  AND CAST(curr_yr.sales_cnt AS DECIMAL(17, 2)) / CAST(prev_yr.sales_cnt AS DECIMAL(17, 2)) < 0.9
ORDER BY sales_cnt_diff
LIMIT 100
*)
fun q75 () =
  let
    val all_sales =
      from sales_detail in (
        from cs in tpcds.catalog_sales
          join i in tpcds.item on i.i_item_sk = cs.cs_item_sk
          join d in tpcds.date_dim
            on cs.cs_sold_date_sk = SOME d.d_date_sk
          left join cr in tpcds.catalog_returns
            on cs.cs_order_number = cr.cr_order_number
              andalso cs.cs_item_sk = cr.cr_item_sk
          where i.i_category = SOME "Books"
          yield {d.d_year, i.i_brand_id, i.i_class_id, i.i_category_id,
            i.i_manufact_id,
            sales_cnt =
              Option.map
                (fn q => q - getOpt (Option.`join` cr?.cr_return_quantity, 0))
                cs.cs_quantity,
            sales_amt =
              Option.map
                (fn p =>
                  p - getOpt (Option.`join` cr?.cr_return_amount,
                        Decimal.fromInt 0))
                cs.cs_ext_sales_price}
        union distinct
          (from ss in tpcds.store_sales
            join i in tpcds.item on i.i_item_sk = ss.ss_item_sk
            join d in tpcds.date_dim
              on ss.ss_sold_date_sk = SOME d.d_date_sk
            left join sr in tpcds.store_returns
              on ss.ss_ticket_number = sr.sr_ticket_number
                andalso ss.ss_item_sk = sr.sr_item_sk
            where i.i_category = SOME "Books"
            yield {d.d_year, i.i_brand_id, i.i_class_id, i.i_category_id,
              i.i_manufact_id,
              sales_cnt =
                Option.map
                  (fn q => q - getOpt (Option.`join` sr?.sr_return_quantity, 0))
                  ss.ss_quantity,
              sales_amt =
                Option.map
                  (fn p =>
                    p - getOpt (Option.`join` sr?.sr_return_amt,
                          Decimal.fromInt 0))
                  ss.ss_ext_sales_price}),
          (from ws in tpcds.web_sales
            join i in tpcds.item on i.i_item_sk = ws.ws_item_sk
            join d in tpcds.date_dim
              on ws.ws_sold_date_sk = SOME d.d_date_sk
            left join wr in tpcds.web_returns
              on ws.ws_order_number = wr.wr_order_number
                andalso ws.ws_item_sk = wr.wr_item_sk
            where i.i_category = SOME "Books"
            yield {d.d_year, i.i_brand_id, i.i_class_id, i.i_category_id,
              i.i_manufact_id,
              sales_cnt =
                Option.map
                  (fn q => q - getOpt (Option.`join` wr?.wr_return_quantity, 0))
                  ws.ws_quantity,
              sales_amt =
                Option.map
                  (fn p =>
                    p - getOpt (Option.`join` wr?.wr_return_amt,
                          Decimal.fromInt 0))
                  ws.ws_ext_sales_price}))
        group {sales_detail.d_year, sales_detail.i_brand_id,
            sales_detail.i_class_id, sales_detail.i_category_id,
            sales_detail.i_manufact_id}
          compute {sales_cnt = sumSome over sales_detail.sales_cnt,
            sales_amt = sumSome over sales_detail.sales_amt}
    (* "CAST(a AS DECIMAL(17, 2)) / CAST(b AS DECIMAL(17, 2)) < 0.9" *)
    fun fell (a, b) =
      case (a, b) of
          (SOME a, SOME b) =>
            Decimal.fromInt a / Decimal.fromInt b < decimal "0.9"
        | _ => false
    (* "a - b"; one for counts, one for amounts. *)
    fun minus (a : int option, b) =
      case (a, b) of
          (SOME a, SOME b) => SOME (a - b)
        | _ => NONE
    fun minusAmt (a : decimal option, b) =
      case (a, b) of
          (SOME a, SOME b) => SOME (a - b)
        | _ => NONE
  in
    from curr_yr in all_sales,
        prev_yr in all_sales
      where curr_yr.i_brand_id <> NONE
        andalso curr_yr.i_brand_id = prev_yr.i_brand_id
        andalso curr_yr.i_class_id <> NONE
        andalso curr_yr.i_class_id = prev_yr.i_class_id
        andalso curr_yr.i_category_id <> NONE
        andalso curr_yr.i_category_id = prev_yr.i_category_id
        andalso curr_yr.i_manufact_id <> NONE
        andalso curr_yr.i_manufact_id = prev_yr.i_manufact_id
        andalso curr_yr.d_year = SOME 2002
        andalso prev_yr.d_year = SOME (2002 - 1)
        andalso fell (curr_yr.sales_cnt, prev_yr.sales_cnt)
      yield {prev_year = prev_yr.d_year, year = curr_yr.d_year,
        curr_yr.i_brand_id, curr_yr.i_class_id, curr_yr.i_category_id,
        curr_yr.i_manufact_id, prev_yr_cnt = prev_yr.sales_cnt,
        curr_yr_cnt = curr_yr.sales_cnt,
        sales_cnt_diff = minus (curr_yr.sales_cnt, prev_yr.sales_cnt),
        sales_amt_diff = minusAmt (curr_yr.sales_amt, prev_yr.sales_amt)}
      order sales_cnt_diff
      take 100
  end;
> val q75 = fn
>   : unit
>      -> {curr_yr_cnt:int option, i_brand_id:int option,
>           i_category_id:int option, i_class_id:int option,
>           i_manufact_id:int option, prev_year:int option,
>           prev_yr_cnt:int option, sales_amt_diff:decimal option,
>           sales_cnt_diff:int option, year:int option} list
val r75 = q75 ();
