(* --- q55 -------------------------------------------------------- *)
(*
SELECT
  i_brand_id brand_id,
  i_brand brand,
  sum(ss_ext_sales_price) ext_price
FROM date_dim, store_sales, item
WHERE d_date_sk = ss_sold_date_sk
  AND ss_item_sk = i_item_sk
  AND i_manager_id = 28
  AND d_moy = 11
  AND d_year = 1999
GROUP BY i_brand, i_brand_id
ORDER BY ext_price DESC, brand_id
LIMIT 100
*)
fun q55 () =
  from d in tpcds.date_dim,
      ss in tpcds.store_sales,
      i in tpcds.item
    where SOME d.d_date_sk = ss.ss_sold_date_sk
      andalso ss.ss_item_sk = i.i_item_sk
      andalso i.i_manager_id = SOME 28
      andalso d.d_moy = SOME 11
      andalso d.d_year = SOME 1999
    group {brand_id = i.i_brand_id, brand = i.i_brand}
      compute {ext_price = sum over ss.ss_ext_sales_price}
    order (DESC ext_price, brand_id)
    take 100;
> val q55 = fn
>   : unit
>      -> {brand:string option, brand_id:int option, ext_price:decimal option}
>         list
