 *
 * TPC-DS queries at scale factor 0.01, in Morel. Data from
 * tpcds/generate.sh. The SQL, in comments, is copied unchanged from
 * Apache Spark (sql/core/src/test/resources/tpcds, tag v4.0.0,
 * Apache License 2.0); derived from TPC-DS, it is not a TPC-DS
 * benchmark. The harness binds "tpcds" to the tables, and checks
 * each "rN" against Spark's answer to the SQL (TpcdsChecker). It
 * runs the script twice, with the same output, in full: over the
 * data set's files, and over a Spark server's database "tpcds", each
 * query running on the server. By hand, first bind "tpcds", with
 * "val tpcds = file;" and "directory" set to the data, or with
 * "val tpcds = spark.catalog.tpcds;".
 *
 * A column not declared "not null" is an option. SQL's aggregates,
 * which ignore null, are "sumSome", "avgSome", "minSome", "maxSome",
 * "countSome" and "stddevSampSome". As NONE < SOME c, "col = SOME c",
 * ">", ">=" (so "between") drop rows where the column is NONE, as
 * SQL's "where" does; a lone "<", "<=", "<>", a function of a column
 * (such as "substr"), and an equality of two option columns (NONE =
 * NONE, but NULL = NULL is not true) are written with a guard.
 *)
(*) requires: tpcds

Sys.set ("output", "tabular");
> val it = () : unit
Sys.set ("printLength", NONE);
> val it = () : unit
Sys.set ("stringDepth", NONE);
> val it = () : unit

(* A date, at midnight UTC; SQL's "cast('2000-08-23' AS DATE)" is
 * "day (2000, Aug, 23)". *)
fun day (year, month, day) =
  Date.date {year, month, day, hour = 0, minute = 0, second = 0,
    offset = SOME Time.zeroTime};
> val day = fn : int * month * int -> date

(* "lift2 f (a, b)" applies "f" to the values of two options, or is
 * NONE if either is NONE, as SQL's arithmetic is NULL if an operand
 * is NULL; "lift2 (op -) (a, b)" is SQL's "a - b". *)
fun lift2 f (SOME a, SOME b) = SOME (f (a, b))
  | lift2 f _ = NONE;
> val lift2 = fn : ('a * 'b -> 'c) -> 'a option * 'b option -> 'c option

(* --- q1 --------------------------------------------------------- *)
(*
WITH customer_total_return AS
( SELECT
    sr_customer_sk AS ctr_customer_sk,
    sr_store_sk AS ctr_store_sk,
    sum(sr_return_amt) AS ctr_total_return
  FROM store_returns, date_dim
  WHERE sr_returned_date_sk = d_date_sk AND d_year = 2000
  GROUP BY sr_customer_sk, sr_store_sk)
SELECT c_customer_id
FROM customer_total_return ctr1, store, customer
WHERE ctr1.ctr_total_return >
  (SELECT avg(ctr_total_return) * 1.2
  FROM customer_total_return ctr2
  WHERE ctr1.ctr_store_sk = ctr2.ctr_store_sk)
  AND s_store_sk = ctr1.ctr_store_sk
  AND s_state = 'TN'
  AND ctr1.ctr_customer_sk = c_customer_sk
ORDER BY c_customer_id
LIMIT 100
*)
fun q1 () =
  let
    val customer_total_return =
      from sr in tpcds.store_returns,
          d in tpcds.date_dim
        where sr.sr_returned_date_sk = SOME d.d_date_sk
          andalso d.d_year = SOME 2000
        group {ctr_customer_sk = sr.sr_customer_sk,
            ctr_store_sk = sr.sr_store_sk}
          compute {ctr_total_return = sumSome over sr.sr_return_amt}
  in
    from ctr1 in customer_total_return,
        s in tpcds.store,
        c in tpcds.customer
      where (case (ctr1.ctr_total_return,
              from ctr2 in customer_total_return
                where ctr2.ctr_store_sk <> NONE
                  andalso ctr1.ctr_store_sk = ctr2.ctr_store_sk
                compute avgSome over ctr2.ctr_total_return) of
            (SOME total, SOME average) => total > average * decimal "1.2"
          | _ => false)
        andalso ctr1.ctr_store_sk = SOME s.s_store_sk
        andalso s.s_state = SOME "TN"
        andalso ctr1.ctr_customer_sk = SOME c.c_customer_sk
      yield c.c_customer_id
      order current
      take 100
  end;
> val q1 = fn : unit -> string list
val r1 = q1 ();
> val r1 =
