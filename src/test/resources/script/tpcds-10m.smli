>   : {b1_cnt:int, b1_cntd:int, b1_lp:decimal option, b2_cnt:int, b2_cntd:int,
>       b2_lp:decimal option, b3_cnt:int, b3_cntd:int, b3_lp:decimal option,
>       b4_cnt:int, b4_cntd:int, b4_lp:decimal option, b5_cnt:int, b5_cntd:int,
>       b5_lp:decimal option, b6_cnt:int, b6_cntd:int, b6_lp:decimal option}

(* --- q29 -------------------------------------------------------- *)
(*
SELECT
  i_item_id,
  i_item_desc,
  s_store_id,
  s_store_name,
  sum(ss_quantity) AS store_sales_quantity,
  sum(sr_return_quantity) AS store_returns_quantity,
  sum(cs_quantity) AS catalog_sales_quantity
FROM
  store_sales, store_returns, catalog_sales, date_dim d1, date_dim d2,
  date_dim d3, store, item
WHERE
  d1.d_moy = 9
    AND d1.d_year = 1999
    AND d1.d_date_sk = ss_sold_date_sk
    AND i_item_sk = ss_item_sk
    AND s_store_sk = ss_store_sk
    AND ss_customer_sk = sr_customer_sk
    AND ss_item_sk = sr_item_sk
    AND ss_ticket_number = sr_ticket_number
    AND sr_returned_date_sk = d2.d_date_sk
    AND d2.d_moy BETWEEN 9 AND 9 + 3
    AND d2.d_year = 1999
    AND sr_customer_sk = cs_bill_customer_sk
    AND sr_item_sk = cs_item_sk
    AND cs_sold_date_sk = d3.d_date_sk
    AND d3.d_year IN (1999, 1999 + 1, 1999 + 2)
GROUP BY
  i_item_id, i_item_desc, s_store_id, s_store_name
ORDER BY
  i_item_id, i_item_desc, s_store_id, s_store_name
LIMIT 100
*)
fun q29 () =
  from ss in tpcds.store_sales,
      sr in tpcds.store_returns,
      cs in tpcds.catalog_sales,
      d1 in tpcds.date_dim,
      d2 in tpcds.date_dim,
      d3 in tpcds.date_dim,
      s in tpcds.store,
      i in tpcds.item
    where d1.d_moy = SOME 9
      andalso d1.d_year = SOME 1999
      andalso ss.ss_sold_date_sk = SOME d1.d_date_sk
      andalso ss.ss_item_sk = i.i_item_sk
      andalso ss.ss_store_sk = SOME s.s_store_sk
      andalso ss.ss_customer_sk <> NONE
      andalso ss.ss_customer_sk = sr.sr_customer_sk
      andalso ss.ss_item_sk = sr.sr_item_sk
      andalso ss.ss_ticket_number = sr.sr_ticket_number
      andalso sr.sr_returned_date_sk = SOME d2.d_date_sk
      andalso d2.d_moy >= SOME 9
      andalso d2.d_moy <= SOME (9 + 3)
      andalso d2.d_year = SOME 1999
      andalso sr.sr_customer_sk = cs.cs_bill_customer_sk
      andalso sr.sr_item_sk = cs.cs_item_sk
      andalso cs.cs_sold_date_sk = SOME d3.d_date_sk
      andalso d3.d_year elem [SOME 1999, SOME (1999 + 1), SOME (1999 + 2)]
    group {i.i_item_id, i.i_item_desc, s.s_store_id, s.s_store_name}
      compute {store_sales_quantity = sumSome over ss.ss_quantity,
        store_returns_quantity = sumSome over sr.sr_return_quantity,
        catalog_sales_quantity = sumSome over cs.cs_quantity}
    order (i_item_id, i_item_desc, s_store_id, s_store_name)
    take 100;
> val q29 = fn
>   : unit
>      -> {catalog_sales_quantity:int option, i_item_desc:string option,
>           i_item_id:string, s_store_id:string, s_store_name:string option,
>           store_returns_quantity:int option, store_sales_quantity:int option}
>         list
val r29 = q29 ();
> catalog_sales_quantity i_item_desc                                                                                                    i_item_id        s_store_id       s_store_name store_returns_quantity store_sales_quantity
> ---------------------- -------------------------------------------------------------------------------------------------------------- ---------------- ---------------- ------------ ---------------------- --------------------
>                     36 New, thin workshops might enhance considerably pregnant doors. Therefore middle periods ought to make often bi AAAAAAAACGGAAAAA AAAAAAAACAAAAAAA able                              7                    9
>                     75 Long, fine teachers should not occur. Particular, monetary children organise in situ on to a tests; details ma AAAAAAAAKAHAAAAA AAAAAAAABAAAAAAA ought                             1                   34
>
> val r29 : {catalog_sales_quantity:int option, i_item_desc:string option, i_item_id:string, s_store_id:string, s_store_name:string option, store_returns_quantity:int option, store_sales_quantity:int option} list

(* --- q30 -------------------------------------------------------- *)
(*
WITH customer_total_return AS
(SELECT
    wr_returning_customer_sk AS ctr_customer_sk,
    ca_state AS ctr_state,
    sum(wr_return_amt) AS ctr_total_return
  FROM web_returns, date_dim, customer_address
  WHERE wr_returned_date_sk = d_date_sk
    AND d_year = 2002
    AND wr_returning_addr_sk = ca_address_sk
  GROUP BY wr_returning_customer_sk, ca_state)
SELECT
  c_customer_id,
  c_salutation,
  c_first_name,
  c_last_name,
  c_preferred_cust_flag,
  c_birth_day,
  c_birth_month,
  c_birth_year,
  c_birth_country,
  c_login,
  c_email_address,
  c_last_review_date,
  ctr_total_return
FROM customer_total_return ctr1, customer_address, customer
WHERE ctr1.ctr_total_return > (SELECT avg(ctr_total_return) * 1.2
FROM customer_total_return ctr2
WHERE ctr1.ctr_state = ctr2.ctr_state)
  AND ca_address_sk = c_current_addr_sk
  AND ca_state = 'GA'
  AND ctr1.ctr_customer_sk = c_customer_sk
ORDER BY c_customer_id, c_salutation, c_first_name, c_last_name, c_preferred_cust_flag
  , c_birth_day, c_birth_month, c_birth_year, c_birth_country, c_login, c_email_address
  , c_last_review_date, ctr_total_return
LIMIT 100
*)
fun q30 () =
  let
    val customer_total_return =
      from wr in tpcds.web_returns,
          d in tpcds.date_dim,
          ca in tpcds.customer_address
        where wr.wr_returned_date_sk = SOME d.d_date_sk
          andalso d.d_year = SOME 2002
          andalso wr.wr_returning_addr_sk = SOME ca.ca_address_sk
        group {ctr_customer_sk = wr.wr_returning_customer_sk,
            ctr_state = ca.ca_state}
          compute {ctr_total_return = sumSome over wr.wr_return_amt}
  in
    from ctr1 in customer_total_return,
        ca in tpcds.customer_address,
        c in tpcds.customer
      where (case (ctr1.ctr_total_return,
              from ctr2 in customer_total_return
                where ctr2.ctr_state <> NONE
                  andalso ctr1.ctr_state = ctr2.ctr_state
                compute avgSome over ctr2.ctr_total_return) of
            (SOME total, SOME average) => total > average * decimal "1.2"
          | _ => false)
        andalso c.c_current_addr_sk = SOME ca.ca_address_sk
        andalso ca.ca_state = SOME "GA"
        andalso ctr1.ctr_customer_sk = SOME c.c_customer_sk
      yield {c.c_customer_id, c.c_salutation, c.c_first_name, c.c_last_name,
        c.c_preferred_cust_flag, c.c_birth_day, c.c_birth_month,
        c.c_birth_year, c.c_birth_country, c.c_login, c.c_email_address,
        c.c_last_review_date,
        ctr1.ctr_total_return}
      order (c_customer_id, c_salutation, c_first_name, c_last_name,
        c_preferred_cust_flag, c_birth_day, c_birth_month, c_birth_year,
        c_birth_country, c_login, c_email_address, c_last_review_date,
        ctr_total_return)
      take 100
  end;
> val q30 = fn
>   : unit
>      -> {c_birth_country:string option, c_birth_day:int option,
>           c_birth_month:int option, c_birth_year:int option,
>           c_customer_id:string, c_email_address:string option,
>           c_first_name:string option, c_last_name:string option,
>           c_last_review_date:int option, c_login:string option,
>           c_preferred_cust_flag:string option, c_salutation:string option,
>           ctr_total_return:decimal option} list
val r30 = q30 ();
> c_birth_country c_birth_day c_birth_month c_birth_year c_customer_id    c_email_address                 c_first_name c_last_name c_last_review_date c_login c_preferred_cust_flag c_salutation ctr_total_return
