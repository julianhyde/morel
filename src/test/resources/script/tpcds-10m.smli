 * software distributed under the License is distributed on an
 * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
 * either express or implied.  See the License for the specific
 * language governing permissions and limitations under the
 * License.
 *
 * Queries derived from TPC-DS, at scale factor 0.01 (about 10 MB),
 * translated into Morel. The data is generated by
 * src/test/resources/tpcds/generate.sh; the SQL of each query, in a
 * comment, is Spark's copy (src/test/resources/tpcds/queries).
 *
 * The harness sets "directory" to the data, so "file" holds its
 * tables, and checks each value bound as "qN" against Spark SQL's
 * answer to the same query (TpcdsChecker), as a multiset of rows.
 *
 * A column that the TPC-DS schema does not declare "not null" is an
 * option. An aggregate over an option ignores NONE, as SQL ignores
 * null. A comparison with an option is written as a comparison with
 * "SOME c"; because NONE < SOME c, that drops the rows where the
 * column is NONE, as SQL's three-valued "where" does, for "=", ">"
 * and ">=", and so for "between" too. For "<", "<=" and "<>" alone it
 * would keep them, so those are written with a guard, as is any
 * function of a column (such as "substr"). So is an equality between
 * two option columns, because NONE = NONE, where SQL's NULL = NULL is
 * not true.
 *)
(*) requires: tpcds

val tpcds = file;
> val tpcds =
>   {VERSION={},answers={},call_center=<relation>,catalog_page=<relation>,
>    catalog_returns=<relation>,catalog_sales=<relation>,customer=<relation>,
>    customer_address=<relation>,customer_demographics=<relation>,
>    date_dim=<relation>,household_demographics=<relation>,
>    income_band=<relation>,inventory=<relation>,item=<relation>,
>    promotion=<relation>,reason=<relation>,ship_mode=<relation>,
>    store=<relation>,store_returns=<relation>,store_sales=<relation>,
>    time_dim=<relation>,warehouse=<relation>,web_page=<relation>,
>    web_returns=<relation>,web_sales=<relation>,web_site=<relation>}
>   : {VERSION:{...}, answers:{...}, call_center:{...} list,
>       catalog_page:{...} list, catalog_returns:{...} list,
>       catalog_sales:{...} list, customer:{...} list,
>       customer_address:{...} list, customer_demographics:{...} list,
>       date_dim:{...} list, household_demographics:{...} list,
>       income_band:{...} list, inventory:{...} list, item:{...} list,
>       promotion:{...} list, reason:{...} list, ship_mode:{...} list,
>       store:{...} list, store_returns:{...} list, store_sales:{...} list,
>       time_dim:{...} list, warehouse:{...} list, web_page:{...} list,
>       web_returns:{...} list, web_sales:{...} list, web_site:{...} list, ...}
Sys.set ("output", "tabular");
> val it = () : unit
Sys.set ("printLength", 10);
> val it = () : unit

(* --- q2 --------------------------------------------------------- *)
(*
WITH wscs AS
( SELECT
    sold_date_sk,
    sales_price
  FROM (SELECT
    ws_sold_date_sk sold_date_sk,
    ws_ext_sales_price sales_price
  FROM web_sales) x
  UNION ALL
  (SELECT
    cs_sold_date_sk sold_date_sk,
    cs_ext_sales_price sales_price
  FROM catalog_sales)),
    wswscs AS
  ( SELECT
    d_week_seq,
    sum(CASE WHEN (d_day_name = 'Sunday')
      THEN sales_price
        ELSE NULL END)
    sun_sales,
    sum(CASE WHEN (d_day_name = 'Monday')
      THEN sales_price
        ELSE NULL END)
    mon_sales,
    sum(CASE WHEN (d_day_name = 'Tuesday')
      THEN sales_price
        ELSE NULL END)
    tue_sales,
    sum(CASE WHEN (d_day_name = 'Wednesday')
      THEN sales_price
        ELSE NULL END)
    wed_sales,
    sum(CASE WHEN (d_day_name = 'Thursday')
      THEN sales_price
        ELSE NULL END)
    thu_sales,
    sum(CASE WHEN (d_day_name = 'Friday')
      THEN sales_price
        ELSE NULL END)
    fri_sales,
    sum(CASE WHEN (d_day_name = 'Saturday')
      THEN sales_price
        ELSE NULL END)
    sat_sales
  FROM wscs, date_dim
  WHERE d_date_sk = sold_date_sk
  GROUP BY d_week_seq)
SELECT
  d_week_seq1,
  round(sun_sales1 / sun_sales2, 2),
  round(mon_sales1 / mon_sales2, 2),
  round(tue_sales1 / tue_sales2, 2),
  round(wed_sales1 / wed_sales2, 2),
  round(thu_sales1 / thu_sales2, 2),
  round(fri_sales1 / fri_sales2, 2),
  round(sat_sales1 / sat_sales2, 2)
FROM
  (SELECT
    wswscs.d_week_seq d_week_seq1,
    sun_sales sun_sales1,
    mon_sales mon_sales1,
    tue_sales tue_sales1,
    wed_sales wed_sales1,
    thu_sales thu_sales1,
    fri_sales fri_sales1,
    sat_sales sat_sales1
  FROM wswscs, date_dim
  WHERE date_dim.d_week_seq = wswscs.d_week_seq AND d_year = 2001) y,
  (SELECT
    wswscs.d_week_seq d_week_seq2,
    sun_sales sun_sales2,
    mon_sales mon_sales2,
    tue_sales tue_sales2,
    wed_sales wed_sales2,
    thu_sales thu_sales2,
    fri_sales fri_sales2,
    sat_sales sat_sales2
  FROM wswscs, date_dim
  WHERE date_dim.d_week_seq = wswscs.d_week_seq AND d_year = 2001 + 1) z
WHERE d_week_seq1 = d_week_seq2 - 53
ORDER BY d_week_seq1
*)
fun q2 () =
  let
    val wscs =
      (from ws in tpcds.web_sales
        yield {sold_date_sk = ws.ws_sold_date_sk,
          sales_price = ws.ws_ext_sales_price})
      @
      (from cs in tpcds.catalog_sales
        yield {sold_date_sk = cs.cs_sold_date_sk,
          sales_price = cs.cs_ext_sales_price})
    val wswscs =
      from w in wscs,
          d in tpcds.date_dim
        where w.sold_date_sk = SOME d.d_date_sk
        group d.d_week_seq
          compute {
        sun_sales = sum over (if d.d_day_name = SOME "Sunday"
          then w.sales_price else NONE),
        mon_sales = sum over (if d.d_day_name = SOME "Monday"
          then w.sales_price else NONE),
        tue_sales = sum over (if d.d_day_name = SOME "Tuesday"
          then w.sales_price else NONE),
        wed_sales = sum over (if d.d_day_name = SOME "Wednesday"
          then w.sales_price else NONE),
        thu_sales = sum over (if d.d_day_name = SOME "Thursday"
          then w.sales_price else NONE),
        fri_sales = sum over (if d.d_day_name = SOME "Friday"
          then w.sales_price else NONE),
        sat_sales = sum over (if d.d_day_name = SOME "Saturday"
          then w.sales_price else NONE)}
    (* "round(a / b, 2)" *)
    fun ratio (a, b) =
      case (a, b) of
          (SOME x, SOME y) =>
            SOME (Decimal.realRound (x / y * Decimal.fromInt 100)
              / Decimal.fromInt 100)
        | _ => NONE
    fun weeks year =
      from w in wswscs,
          d in tpcds.date_dim
        where d.d_week_seq <> NONE
          andalso d.d_week_seq = w.d_week_seq
          andalso d.d_year = SOME year
        yield w
  in
    from y in weeks 2001,
        z in weeks (2001 + 1)
      where y.d_week_seq = Option.map (fn s => s - 53) z.d_week_seq
      yield {d_week_seq1 = y.d_week_seq,
        `round((sun_sales1 / sun_sales2), 2)` =
          ratio (y.sun_sales, z.sun_sales),
        `round((mon_sales1 / mon_sales2), 2)` =
          ratio (y.mon_sales, z.mon_sales),
        `round((tue_sales1 / tue_sales2), 2)` =
          ratio (y.tue_sales, z.tue_sales),
        `round((wed_sales1 / wed_sales2), 2)` =
          ratio (y.wed_sales, z.wed_sales),
        `round((thu_sales1 / thu_sales2), 2)` =
          ratio (y.thu_sales, z.thu_sales),
        `round((fri_sales1 / fri_sales2), 2)` =
          ratio (y.fri_sales, z.fri_sales),
        `round((sat_sales1 / sat_sales2), 2)` =
          ratio (y.sat_sales, z.sat_sales)}
      order d_week_seq1
  end;
> val q2 = fn
>   : unit
>      -> {d_week_seq1:int option,
>           `round((fri_sales1 / fri_sales2), 2)`:decimal option,
>           `round((mon_sales1 / mon_sales2), 2)`:decimal option,
>           `round((sat_sales1 / sat_sales2), 2)`:decimal option,
>           `round((sun_sales1 / sun_sales2), 2)`:decimal option,
>           `round((thu_sales1 / thu_sales2), 2)`:decimal option,
>           `round((tue_sales1 / tue_sales2), 2)`:decimal option,
>           `round((wed_sales1 / wed_sales2), 2)`:decimal option} list
val r2 = q2 ();
> d_week_seq1 round((fri_sales1 / fri_sales2), 2) round((mon_sales1 / mon_sales2), 2) round((sat_sales1 / sat_sales2), 2) round((sun_sales1 / sun_sales2), 2) round((thu_sales1 / thu_sales2), 2) round((tue_sales1 / tue_sales2), 2) round((wed_sales1 / wed_sales2), 2)
> ----------- ----------------------------------- ----------------------------------- ----------------------------------- ----------------------------------- ----------------------------------- ----------------------------------- -----------------------------------
>        5270                                5.52                                1.12                                 3.9                                6.05                                1.22                                3.93                                1.24
>        5270                                5.52                                1.12                                 3.9                                6.05                                1.22                                3.93                                1.24
>        5270                                5.52                                1.12                                 3.9                                6.05                                1.22                                3.93                                1.24
>        5270                                5.52                                1.12                                 3.9                                6.05                                1.22                                3.93                                1.24
>        5270                                5.52                                1.12                                 3.9                                6.05                                1.22                                3.93                                1.24
>        5270                                5.52                                1.12                                 3.9                                6.05                                1.22                                3.93                                1.24
>        5270                                5.52                                1.12                                 3.9                                6.05                                1.22                                3.93                                1.24
>        5271                                0.48                                2.15                                0.54                                0.88                                0.49                                0.82                                0.85
>        5271                                0.48                                2.15                                0.54                                0.88                                0.49                                0.82                                0.85
>        5271                                0.48                                2.15                                0.54                                0.88                                0.49                                0.82                                0.85
> ...
>
> val r2 : {d_week_seq1:int option, `round((fri_sales1 / fri_sales2), 2)`:decimal option, `round((mon_sales1 / mon_sales2), 2)`:decimal option, `round((sat_sales1 / sat_sales2), 2)`:decimal option, `round((sun_sales1 / sun_sales2), 2)`:decimal option, `round((thu_sales1 / thu_sales2), 2)`:decimal option, `round((tue_sales1 / tue_sales2), 2)`:decimal option, `round((wed_sales1 / wed_sales2), 2)`:decimal option} list

(* --- q3 --------------------------------------------------------- *)
(*
SELECT
  dt.d_year,
  item.i_brand_id brand_id,
  item.i_brand brand,
  SUM(ss_ext_sales_price) sum_agg
FROM date_dim dt, store_sales, item
WHERE dt.d_date_sk = store_sales.ss_sold_date_sk
  AND store_sales.ss_item_sk = item.i_item_sk
  AND item.i_manufact_id = 128
  AND dt.d_moy = 11
GROUP BY dt.d_year, item.i_brand, item.i_brand_id
ORDER BY dt.d_year, sum_agg DESC, brand_id
LIMIT 100
*)
fun q3 () =
  from dt in tpcds.date_dim,
      ss in tpcds.store_sales,
      i in tpcds.item
    where SOME dt.d_date_sk = ss.ss_sold_date_sk
      andalso ss.ss_item_sk = i.i_item_sk
      andalso i.i_manufact_id = SOME 128
      andalso dt.d_moy = SOME 11
    group {dt.d_year, brand_id = i.i_brand_id, brand = i.i_brand}
      compute {sum_agg = sum over ss.ss_ext_sales_price}
    order (d_year, DESC sum_agg, brand_id)
    take 100;
> val q3 = fn
>   : unit
>      -> {brand:string option, brand_id:int option, d_year:int option,
>           sum_agg:decimal option} list
val r3 = q3 ();
> brand            brand_id d_year sum_agg
