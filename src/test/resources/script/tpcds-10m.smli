(* --- q65 -------------------------------------------------------- *)
(*
SELECT
  s_store_name,
  i_item_desc,
  sc.revenue,
  i_current_price,
  i_wholesale_cost,
  i_brand
FROM store, item,
  (SELECT
    ss_store_sk,
    avg(revenue) AS ave
  FROM
    (SELECT
      ss_store_sk,
      ss_item_sk,
      sum(ss_sales_price) AS revenue
    FROM store_sales, date_dim
    WHERE ss_sold_date_sk = d_date_sk AND d_month_seq BETWEEN 1176 AND 1176 + 11
    GROUP BY ss_store_sk, ss_item_sk) sa
  GROUP BY ss_store_sk) sb,
  (SELECT
    ss_store_sk,
    ss_item_sk,
    sum(ss_sales_price) AS revenue
  FROM store_sales, date_dim
  WHERE ss_sold_date_sk = d_date_sk AND d_month_seq BETWEEN 1176 AND 1176 + 11
  GROUP BY ss_store_sk, ss_item_sk) sc
WHERE sb.ss_store_sk = sc.ss_store_sk AND
  sc.revenue <= 0.1 * sb.ave AND
  s_store_sk = sc.ss_store_sk AND
  i_item_sk = sc.ss_item_sk
ORDER BY s_store_name, i_item_desc
LIMIT 100
*)
fun q65 () =
  let
    val sa =
      from ss in tpcds.store_sales,
          d in tpcds.date_dim
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso d.d_month_seq >= SOME 1176
          andalso d.d_month_seq <= SOME (1176 + 11)
        group {ss.ss_store_sk, ss.ss_item_sk}
          compute {revenue = sumSome over ss.ss_sales_price}
    val sb =
      from s in sa
        group s.ss_store_sk compute {ave = avgSome over s.revenue}
  in
    from s in tpcds.store,
        i in tpcds.item,
        sb in sb,
        sc in sa
      where sb.ss_store_sk <> NONE
        andalso sb.ss_store_sk = sc.ss_store_sk
        andalso (case (sc.revenue, sb.ave) of
                    (SOME r, SOME a) => r <= decimal "0.1" * a
                  | _ => false)
        andalso sc.ss_store_sk = SOME s.s_store_sk
        andalso sc.ss_item_sk = i.i_item_sk
      yield {s.s_store_name, i.i_item_desc, sc.revenue, i.i_current_price,
        i.i_wholesale_cost, i.i_brand}
      order (s_store_name, i_item_desc)
      take 100
  end;
> val q65 = fn
>   : unit
>      -> {i_brand:string option, i_current_price:decimal option,
>           i_item_desc:string option, i_wholesale_cost:decimal option,
>           revenue:decimal option, s_store_name:string option} list
val r65 = q65 ();
> i_brand            i_current_price i_item_desc                                                                                                                                                                                  i_wholesale_cost revenue s_store_name
