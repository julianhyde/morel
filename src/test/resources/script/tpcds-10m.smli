 *
 * TPC-DS queries at scale factor 0.01, in Morel. Data from
 * tpcds/generate.sh; SQL, in comments, from tpcds/queries. The
 * harness sets "directory" to the data, so "file" holds its tables,
 * and checks each "rN" against Spark's answer (TpcdsChecker).
 *
 * A column not declared "not null" is an option. SQL's aggregates,
 * which ignore null, are "sumSome", "avgSome", "minSome", "maxSome"
 * and "countSome". As NONE < SOME c, "col = SOME c", ">", ">=" (so
 * "between") drop rows where the column is NONE, as SQL's "where"
 * does; a lone "<", "<=", "<>", a function of a column (such as
 * "substr"), and an equality of two option columns (NONE = NONE, but
 * NULL = NULL is not true) are written with a guard.
 *)
(*) requires: tpcds

val tpcds = file;
> val tpcds =
>   {VERSION={},answers={},call_center=<relation>,catalog_page=<relation>,
>    catalog_returns=<relation>,catalog_sales=<relation>,customer=<relation>,
>    customer_address=<relation>,customer_demographics=<relation>,
>    date_dim=<relation>,household_demographics=<relation>,
>    income_band=<relation>,inventory=<relation>,item=<relation>,
>    promotion=<relation>,reason=<relation>,ship_mode=<relation>,
>    store=<relation>,store_returns=<relation>,store_sales=<relation>,
>    time_dim=<relation>,warehouse=<relation>,web_page=<relation>,
>    web_returns=<relation>,web_sales=<relation>,web_site=<relation>}
>   : {VERSION:{...}, answers:{...}, call_center:{...} list,
>       catalog_page:{...} list, catalog_returns:{...} list,
>       catalog_sales:{...} list, customer:{...} list,
>       customer_address:{...} list, customer_demographics:{...} list,
>       date_dim:{...} list, household_demographics:{...} list,
>       income_band:{...} list, inventory:{...} list, item:{...} list,
>       promotion:{...} list, reason:{...} list, ship_mode:{...} list,
>       store:{...} list, store_returns:{...} list, store_sales:{...} list,
>       time_dim:{...} list, warehouse:{...} list, web_page:{...} list,
>       web_returns:{...} list, web_sales:{...} list, web_site:{...} list, ...}
Sys.set ("output", "tabular");
> val it = () : unit
Sys.set ("printLength", 10);
> val it = () : unit

(* --- q1 --------------------------------------------------------- *)
(*
WITH customer_total_return AS
( SELECT
    sr_customer_sk AS ctr_customer_sk,
    sr_store_sk AS ctr_store_sk,
    sum(sr_return_amt) AS ctr_total_return
  FROM store_returns, date_dim
  WHERE sr_returned_date_sk = d_date_sk AND d_year = 2000
  GROUP BY sr_customer_sk, sr_store_sk)
SELECT c_customer_id
FROM customer_total_return ctr1, store, customer
WHERE ctr1.ctr_total_return >
  (SELECT avg(ctr_total_return) * 1.2
  FROM customer_total_return ctr2
  WHERE ctr1.ctr_store_sk = ctr2.ctr_store_sk)
  AND s_store_sk = ctr1.ctr_store_sk
  AND s_state = 'TN'
  AND ctr1.ctr_customer_sk = c_customer_sk
ORDER BY c_customer_id
LIMIT 100
*)
fun q1 () =
  let
    val customer_total_return =
      from sr in tpcds.store_returns,
          d in tpcds.date_dim
        where sr.sr_returned_date_sk = SOME d.d_date_sk
          andalso d.d_year = SOME 2000
        group {ctr_customer_sk = sr.sr_customer_sk,
            ctr_store_sk = sr.sr_store_sk}
          compute {ctr_total_return = sumSome over sr.sr_return_amt}
  in
    from ctr1 in customer_total_return,
        s in tpcds.store,
        c in tpcds.customer
      where (case (ctr1.ctr_total_return,
              from ctr2 in customer_total_return
                where ctr2.ctr_store_sk <> NONE
                  andalso ctr1.ctr_store_sk = ctr2.ctr_store_sk
                compute avgSome over ctr2.ctr_total_return) of
            (SOME total, SOME average) => total > average * decimal "1.2"
          | _ => false)
        andalso ctr1.ctr_store_sk = SOME s.s_store_sk
        andalso s.s_state = SOME "TN"
        andalso ctr1.ctr_customer_sk = SOME c.c_customer_sk
      yield c.c_customer_id
      order current
      take 100
  end;
> val q1 = fn : unit -> string list
val r1 = q1 ();
> val r1 =
>   ["AAAAAAAAAACAAAAA","AAAAAAAAAADAAAAA","AAAAAAAAACCAAAAA",
>    "AAAAAAAAADDAAAAA","AAAAAAAAAEAAAAAA","AAAAAAAAAHCAAAAA",
>    "AAAAAAAAAIDAAAAA","AAAAAAAAAJBAAAAA","AAAAAAAAAJCAAAAA",
>    "AAAAAAAAAKBAAAAA",...] : string list

(* --- q2 --------------------------------------------------------- *)
(*
WITH wscs AS
( SELECT
    sold_date_sk,
    sales_price
  FROM (SELECT
    ws_sold_date_sk sold_date_sk,
    ws_ext_sales_price sales_price
  FROM web_sales) x
  UNION ALL
  (SELECT
    cs_sold_date_sk sold_date_sk,
    cs_ext_sales_price sales_price
  FROM catalog_sales)),
    wswscs AS
  ( SELECT
    d_week_seq,
    sum(CASE WHEN (d_day_name = 'Sunday')
      THEN sales_price
        ELSE NULL END)
    sun_sales,
    sum(CASE WHEN (d_day_name = 'Monday')
      THEN sales_price
        ELSE NULL END)
    mon_sales,
    sum(CASE WHEN (d_day_name = 'Tuesday')
      THEN sales_price
        ELSE NULL END)
    tue_sales,
    sum(CASE WHEN (d_day_name = 'Wednesday')
      THEN sales_price
        ELSE NULL END)
    wed_sales,
    sum(CASE WHEN (d_day_name = 'Thursday')
      THEN sales_price
        ELSE NULL END)
    thu_sales,
    sum(CASE WHEN (d_day_name = 'Friday')
      THEN sales_price
        ELSE NULL END)
    fri_sales,
    sum(CASE WHEN (d_day_name = 'Saturday')
      THEN sales_price
        ELSE NULL END)
    sat_sales
  FROM wscs, date_dim
  WHERE d_date_sk = sold_date_sk
  GROUP BY d_week_seq)
SELECT
  d_week_seq1,
  round(sun_sales1 / sun_sales2, 2),
  round(mon_sales1 / mon_sales2, 2),
  round(tue_sales1 / tue_sales2, 2),
  round(wed_sales1 / wed_sales2, 2),
  round(thu_sales1 / thu_sales2, 2),
  round(fri_sales1 / fri_sales2, 2),
  round(sat_sales1 / sat_sales2, 2)
FROM
  (SELECT
    wswscs.d_week_seq d_week_seq1,
    sun_sales sun_sales1,
    mon_sales mon_sales1,
    tue_sales tue_sales1,
    wed_sales wed_sales1,
    thu_sales thu_sales1,
    fri_sales fri_sales1,
    sat_sales sat_sales1
  FROM wswscs, date_dim
  WHERE date_dim.d_week_seq = wswscs.d_week_seq AND d_year = 2001) y,
  (SELECT
    wswscs.d_week_seq d_week_seq2,
    sun_sales sun_sales2,
    mon_sales mon_sales2,
    tue_sales tue_sales2,
    wed_sales wed_sales2,
    thu_sales thu_sales2,
    fri_sales fri_sales2,
    sat_sales sat_sales2
  FROM wswscs, date_dim
  WHERE date_dim.d_week_seq = wswscs.d_week_seq AND d_year = 2001 + 1) z
WHERE d_week_seq1 = d_week_seq2 - 53
ORDER BY d_week_seq1
*)
fun q2 () =
  let
    val wscs =
      (from ws in tpcds.web_sales
        yield {sold_date_sk = ws.ws_sold_date_sk,
          sales_price = ws.ws_ext_sales_price})
      @
      (from cs in tpcds.catalog_sales
        yield {sold_date_sk = cs.cs_sold_date_sk,
          sales_price = cs.cs_ext_sales_price})
    val wswscs =
      from w in wscs,
          d in tpcds.date_dim
        where w.sold_date_sk = SOME d.d_date_sk
        group d.d_week_seq
          compute {
        sun_sales = sumSome over (if d.d_day_name = SOME "Sunday"
          then w.sales_price else NONE),
        mon_sales = sumSome over (if d.d_day_name = SOME "Monday"
          then w.sales_price else NONE),
        tue_sales = sumSome over (if d.d_day_name = SOME "Tuesday"
          then w.sales_price else NONE),
        wed_sales = sumSome over (if d.d_day_name = SOME "Wednesday"
          then w.sales_price else NONE),
        thu_sales = sumSome over (if d.d_day_name = SOME "Thursday"
          then w.sales_price else NONE),
        fri_sales = sumSome over (if d.d_day_name = SOME "Friday"
          then w.sales_price else NONE),
        sat_sales = sumSome over (if d.d_day_name = SOME "Saturday"
          then w.sales_price else NONE)}
    (* "round(a / b, 2)" *)
    fun ratio (a, b) =
      case (a, b) of
          (SOME x, SOME y) =>
            SOME (Decimal.realRound (x / y * Decimal.fromInt 100)
              / Decimal.fromInt 100)
        | _ => NONE
    fun weeks year =
      from w in wswscs,
          d in tpcds.date_dim
        where d.d_week_seq <> NONE
          andalso d.d_week_seq = w.d_week_seq
          andalso d.d_year = SOME year
        yield w
  in
    from y in weeks 2001,
        z in weeks (2001 + 1)
      where y.d_week_seq = Option.map (fn s => s - 53) z.d_week_seq
      yield {d_week_seq1 = y.d_week_seq,
        `round((sun_sales1 / sun_sales2), 2)` =
          ratio (y.sun_sales, z.sun_sales),
        `round((mon_sales1 / mon_sales2), 2)` =
          ratio (y.mon_sales, z.mon_sales),
        `round((tue_sales1 / tue_sales2), 2)` =
          ratio (y.tue_sales, z.tue_sales),
        `round((wed_sales1 / wed_sales2), 2)` =
          ratio (y.wed_sales, z.wed_sales),
        `round((thu_sales1 / thu_sales2), 2)` =
          ratio (y.thu_sales, z.thu_sales),
        `round((fri_sales1 / fri_sales2), 2)` =
          ratio (y.fri_sales, z.fri_sales),
        `round((sat_sales1 / sat_sales2), 2)` =
          ratio (y.sat_sales, z.sat_sales)}
      order d_week_seq1
  end;
> val q2 = fn
>   : unit
>      -> {d_week_seq1:int option,
>           `round((fri_sales1 / fri_sales2), 2)`:decimal option,
>           `round((mon_sales1 / mon_sales2), 2)`:decimal option,
>           `round((sat_sales1 / sat_sales2), 2)`:decimal option,
>           `round((sun_sales1 / sun_sales2), 2)`:decimal option,
>           `round((thu_sales1 / thu_sales2), 2)`:decimal option,
>           `round((tue_sales1 / tue_sales2), 2)`:decimal option,
>           `round((wed_sales1 / wed_sales2), 2)`:decimal option} list
val r2 = q2 ();
> d_week_seq1 round((fri_sales1 / fri_sales2), 2) round((mon_sales1 / mon_sales2), 2) round((sat_sales1 / sat_sales2), 2) round((sun_sales1 / sun_sales2), 2) round((thu_sales1 / thu_sales2), 2) round((tue_sales1 / tue_sales2), 2) round((wed_sales1 / wed_sales2), 2)
