(* --- q74 -------------------------------------------------------- *)
(*
WITH year_total AS (
  SELECT
    c_customer_id customer_id,
    c_first_name customer_first_name,
    c_last_name customer_last_name,
    d_year AS year,
    sum(ss_net_paid) year_total,
    's' sale_type
  FROM
    customer, store_sales, date_dim
  WHERE c_customer_sk = ss_customer_sk
    AND ss_sold_date_sk = d_date_sk
    AND d_year IN (2001, 2001 + 1)
  GROUP BY
    c_customer_id, c_first_name, c_last_name, d_year
  UNION ALL
  SELECT
    c_customer_id customer_id,
    c_first_name customer_first_name,
    c_last_name customer_last_name,
    d_year AS year,
    sum(ws_net_paid) year_total,
    'w' sale_type
  FROM
    customer, web_sales, date_dim
  WHERE c_customer_sk = ws_bill_customer_sk
    AND ws_sold_date_sk = d_date_sk
    AND d_year IN (2001, 2001 + 1)
  GROUP BY
    c_customer_id, c_first_name, c_last_name, d_year)
SELECT
  t_s_secyear.customer_id,
  t_s_secyear.customer_first_name,
  t_s_secyear.customer_last_name
FROM
  year_total t_s_firstyear, year_total t_s_secyear,
  year_total t_w_firstyear, year_total t_w_secyear
WHERE t_s_secyear.customer_id = t_s_firstyear.customer_id
  AND t_s_firstyear.customer_id = t_w_secyear.customer_id
  AND t_s_firstyear.customer_id = t_w_firstyear.customer_id
  AND t_s_firstyear.sale_type = 's'
  AND t_w_firstyear.sale_type = 'w'
  AND t_s_secyear.sale_type = 's'
  AND t_w_secyear.sale_type = 'w'
  AND t_s_firstyear.year = 2001
  AND t_s_secyear.year = 2001 + 1
  AND t_w_firstyear.year = 2001
  AND t_w_secyear.year = 2001 + 1
  AND t_s_firstyear.year_total > 0
  AND t_w_firstyear.year_total > 0
  AND CASE WHEN t_w_firstyear.year_total > 0
  THEN t_w_secyear.year_total / t_w_firstyear.year_total
      ELSE NULL END
  > CASE WHEN t_s_firstyear.year_total > 0
  THEN t_s_secyear.year_total / t_s_firstyear.year_total
    ELSE NULL END
ORDER BY 1, 1, 1
LIMIT 100
*)
fun q74 () =
  let
    val year_total =
      (from c in tpcds.customer,
          ss in tpcds.store_sales,
          d in tpcds.date_dim
        where ss.ss_customer_sk = SOME c.c_customer_sk
          andalso ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso d.d_year elem [SOME 2001, SOME (2001 + 1)]
        group {customer_id = c.c_customer_id,
            customer_first_name = c.c_first_name,
            customer_last_name = c.c_last_name, year = d.d_year}
          compute {year_total = sum over ss.ss_net_paid}
        yield {customer_id, customer_first_name, customer_last_name, year,
          year_total, sale_type = "s"})
      @
      (from c in tpcds.customer,
          ws in tpcds.web_sales,
          d in tpcds.date_dim
        where ws.ws_bill_customer_sk = SOME c.c_customer_sk
          andalso ws.ws_sold_date_sk = SOME d.d_date_sk
          andalso d.d_year elem [SOME 2001, SOME (2001 + 1)]
        group {customer_id = c.c_customer_id,
            customer_first_name = c.c_first_name,
            customer_last_name = c.c_last_name, year = d.d_year}
          compute {year_total = sum over ws.ws_net_paid}
        yield {customer_id, customer_first_name, customer_last_name, year,
          year_total, sale_type = "w"})
    val zero = SOME (Decimal.fromInt 0)
    (* "CASE WHEN b > 0 THEN a / b ELSE NULL END" *)
    fun ratio (a, b) =
      case (a, b) of
          (SOME x, SOME y) =>
            if y > Decimal.fromInt 0 then SOME (x / y) else NONE
        | _ => NONE
  in
    from t_s_firstyear in year_total,
        t_s_secyear in year_total,
        t_w_firstyear in year_total,
        t_w_secyear in year_total
      where t_s_secyear.customer_id = t_s_firstyear.customer_id
        andalso t_s_firstyear.customer_id = t_w_secyear.customer_id
        andalso t_s_firstyear.customer_id = t_w_firstyear.customer_id
        andalso t_s_firstyear.sale_type = "s"
        andalso t_w_firstyear.sale_type = "w"
        andalso t_s_secyear.sale_type = "s"
        andalso t_w_secyear.sale_type = "w"
        andalso t_s_firstyear.year = SOME 2001
        andalso t_s_secyear.year = SOME (2001 + 1)
        andalso t_w_firstyear.year = SOME 2001
        andalso t_w_secyear.year = SOME (2001 + 1)
        andalso t_s_firstyear.year_total > zero
        andalso t_w_firstyear.year_total > zero
        andalso ratio (t_w_secyear.year_total, t_w_firstyear.year_total)
          > ratio (t_s_secyear.year_total, t_s_firstyear.year_total)
        andalso ratio (t_s_secyear.year_total, t_s_firstyear.year_total)
          <> NONE
      yield {t_s_secyear.customer_id, t_s_secyear.customer_first_name,
        t_s_secyear.customer_last_name}
      order customer_id
      take 100
  end;
