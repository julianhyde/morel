(* --- q63 -------------------------------------------------------- *)
(*
SELECT *
FROM (SELECT
  i_manager_id,
  sum(ss_sales_price) sum_sales,
  avg(sum(ss_sales_price))
  OVER (PARTITION BY i_manager_id) avg_monthly_sales
FROM item
  , store_sales
  , date_dim
  , store
WHERE ss_item_sk = i_item_sk
  AND ss_sold_date_sk = d_date_sk
  AND ss_store_sk = s_store_sk
  AND d_month_seq IN (1200, 1200 + 1, 1200 + 2, 1200 + 3, 1200 + 4, 1200 + 5, 1200 + 6, 1200 + 7,
                            1200 + 8, 1200 + 9, 1200 + 10, 1200 + 11)
  AND ((i_category IN ('Books', 'Children', 'Electronics')
  AND i_class IN ('personal', 'portable', 'refernece', 'self-help')
  AND i_brand IN ('scholaramalgamalg #14', 'scholaramalgamalg #7',
                  'exportiunivamalg #9', 'scholaramalgamalg #9'))
  OR (i_category IN ('Women', 'Music', 'Men')
  AND i_class IN ('accessories', 'classical', 'fragrances', 'pants')
  AND i_brand IN ('amalgimporto #1', 'edu packscholar #1', 'exportiimporto #1',
                  'importoamalg #1')))
GROUP BY i_manager_id, d_moy) tmp1
WHERE CASE WHEN avg_monthly_sales > 0
  THEN abs(sum_sales - avg_monthly_sales) / avg_monthly_sales
      ELSE NULL END > 0.1
ORDER BY i_manager_id
  , avg_monthly_sales
  , sum_sales
LIMIT 100
*)
(* "avg(sum(x)) OVER (PARTITION BY k)" is the average of the groups'
 * sums for each "k", joined to the groups. A partition is not a join:
 * its NONE key is one partition, as NONE = NONE. "d_month_seq IN (1200,
 * ..., 1200 + 11)" is a range. *)
fun q63 () =
  let
    val base =
      from i in tpcds.item,
          ss in tpcds.store_sales,
          d in tpcds.date_dim,
          s in tpcds.store
        where ss.ss_item_sk = i.i_item_sk
          andalso ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
          andalso (i.i_category
                elem [SOME "Books", SOME "Children", SOME "Electronics"]
              andalso i.i_class elem [SOME "personal", SOME "portable",
                SOME "refernece", SOME "self-help"]
              andalso i.i_brand elem [SOME "scholaramalgamalg #14",
                SOME "scholaramalgamalg #7", SOME "exportiunivamalg #9",
                SOME "scholaramalgamalg #9"]
            orelse i.i_category elem [SOME "Women", SOME "Music", SOME "Men"]
              andalso i.i_class elem [SOME "accessories", SOME "classical",
                SOME "fragrances", SOME "pants"]
              andalso i.i_brand elem [SOME "amalgimporto #1",
                SOME "edu packscholar #1", SOME "exportiimporto #1",
                SOME "importoamalg #1"])
        yield {i.i_manager_id, d.d_moy, ss.ss_sales_price}
    val groups =
      from b in base
        group {b.i_manager_id, b.d_moy}
          compute {sum_sales = sumSome over b.ss_sales_price}
    val averages =
      from r in groups
        group {r.i_manager_id}
          compute {avg_monthly_sales = avgSome over r.sum_sales}
  in
    from r in groups,
        a in averages
      where a.i_manager_id = r.i_manager_id
        andalso (case (r.sum_sales, a.avg_monthly_sales) of
                    (SOME s, SOME a) => a > Decimal.fromInt 0
                      andalso Decimal.abs (s - a) / a > decimal "0.1"
                  | _ => false)
      order (r.i_manager_id, a.avg_monthly_sales, r.sum_sales)
      yield {r.i_manager_id, r.sum_sales, a.avg_monthly_sales}
      take 100
  end;
> val q63 = fn
>   : unit
>      -> {avg_monthly_sales:decimal option, i_manager_id:int option,
>           sum_sales:decimal option} list
