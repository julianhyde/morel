(* --- q61 -------------------------------------------------------- *)
(*
SELECT
  promotions,
  total,
  cast(promotions AS DECIMAL(15, 4)) / cast(total AS DECIMAL(15, 4)) * 100
FROM
  (SELECT sum(ss_ext_sales_price) promotions
  FROM store_sales, store, promotion, date_dim, customer, customer_address, item
  WHERE ss_sold_date_sk = d_date_sk
    AND ss_store_sk = s_store_sk
    AND ss_promo_sk = p_promo_sk
    AND ss_customer_sk = c_customer_sk
    AND ca_address_sk = c_current_addr_sk
    AND ss_item_sk = i_item_sk
    AND ca_gmt_offset = -5
    AND i_category = 'Jewelry'
    AND (p_channel_dmail = 'Y' OR p_channel_email = 'Y' OR p_channel_tv = 'Y')
    AND s_gmt_offset = -5
    AND d_year = 1998
    AND d_moy = 11) promotional_sales,
  (SELECT sum(ss_ext_sales_price) total
  FROM store_sales, store, date_dim, customer, customer_address, item
  WHERE ss_sold_date_sk = d_date_sk
    AND ss_store_sk = s_store_sk
    AND ss_customer_sk = c_customer_sk
    AND ca_address_sk = c_current_addr_sk
    AND ss_item_sk = i_item_sk
    AND ca_gmt_offset = -5
    AND i_category = 'Jewelry'
    AND s_gmt_offset = -5
    AND d_year = 1998
    AND d_moy = 11) all_sales
ORDER BY promotions, total
LIMIT 100
*)
fun q61 () =
  let
    val promotions =
      from ss in tpcds.store_sales,
          s in tpcds.store,
          p in tpcds.promotion,
          d in tpcds.date_dim,
          c in tpcds.customer,
          ca in tpcds.customer_address,
          i in tpcds.item
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso ss.ss_promo_sk = SOME p.p_promo_sk
          andalso ss.ss_customer_sk = SOME c.c_customer_sk
          andalso c.c_current_addr_sk = SOME ca.ca_address_sk
          andalso ss.ss_item_sk = i.i_item_sk
          andalso ca.ca_gmt_offset = SOME (Decimal.fromInt ~5)
          andalso i.i_category = SOME "Jewelry"
          andalso (p.p_channel_dmail = SOME "Y"
            orelse p.p_channel_email = SOME "Y"
            orelse p.p_channel_tv = SOME "Y")
          andalso s.s_gmt_offset = SOME (Decimal.fromInt ~5)
          andalso d.d_year = SOME 1998
          andalso d.d_moy = SOME 11
        compute sum over ss.ss_ext_sales_price
    val total =
      from ss in tpcds.store_sales,
          s in tpcds.store,
          d in tpcds.date_dim,
          c in tpcds.customer,
          ca in tpcds.customer_address,
          i in tpcds.item
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso ss.ss_customer_sk = SOME c.c_customer_sk
          andalso c.c_current_addr_sk = SOME ca.ca_address_sk
          andalso ss.ss_item_sk = i.i_item_sk
          andalso ca.ca_gmt_offset = SOME (Decimal.fromInt ~5)
          andalso i.i_category = SOME "Jewelry"
          andalso s.s_gmt_offset = SOME (Decimal.fromInt ~5)
          andalso d.d_year = SOME 1998
          andalso d.d_moy = SOME 11
        compute sum over ss.ss_ext_sales_price
  in
    [{promotions, total,
      ratio =
        case (promotions, total) of
            (SOME p, SOME t) => SOME (p / t * Decimal.fromInt 100)
          | _ => NONE}]
  end;
