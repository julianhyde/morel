         sum(CASE WHEN d_moy = 4
           THEN cs_net_paid_inc_tax * cs_quantity
             ELSE 0 END) AS apr_net,
         sum(CASE WHEN d_moy = 5
           THEN cs_net_paid_inc_tax * cs_quantity
             ELSE 0 END) AS may_net,
         sum(CASE WHEN d_moy = 6
           THEN cs_net_paid_inc_tax * cs_quantity
             ELSE 0 END) AS jun_net,
         sum(CASE WHEN d_moy = 7
           THEN cs_net_paid_inc_tax * cs_quantity
             ELSE 0 END) AS jul_net,
         sum(CASE WHEN d_moy = 8
           THEN cs_net_paid_inc_tax * cs_quantity
             ELSE 0 END) AS aug_net,
         sum(CASE WHEN d_moy = 9
           THEN cs_net_paid_inc_tax * cs_quantity
             ELSE 0 END) AS sep_net,
         sum(CASE WHEN d_moy = 10
           THEN cs_net_paid_inc_tax * cs_quantity
             ELSE 0 END) AS oct_net,
         sum(CASE WHEN d_moy = 11
           THEN cs_net_paid_inc_tax * cs_quantity
             ELSE 0 END) AS nov_net,
         sum(CASE WHEN d_moy = 12
           THEN cs_net_paid_inc_tax * cs_quantity
             ELSE 0 END) AS dec_net
       FROM
         catalog_sales, warehouse, date_dim, time_dim, ship_mode
       WHERE
         cs_warehouse_sk = w_warehouse_sk
           AND cs_sold_date_sk = d_date_sk
           AND cs_sold_time_sk = t_time_sk
           AND cs_ship_mode_sk = sm_ship_mode_sk
           AND d_year = 2001
           AND t_time BETWEEN 30838 AND 30838 + 28800
           AND sm_carrier IN ('DHL', 'BARIAN')
       GROUP BY
         w_warehouse_name, w_warehouse_sq_ft, w_city, w_county, w_state, w_country, d_year
       )
     ) x
GROUP BY
  w_warehouse_name, w_warehouse_sq_ft, w_city, w_county, w_state, w_country,
  ship_carriers, year
ORDER BY w_warehouse_name
LIMIT 100
*)
fun q66 () =
  let
    val zero = SOME (Decimal.fromInt 0)
    (* "price * quantity" *)
    val times = lift2 (fn (p, q) => p * Decimal.fromInt q)
    (* "sales / w_warehouse_sq_ft" *)
    fun perFoot (sales, sqFt) =
      case (sales, sqFt) of
          (SOME s, SOME f) => SOME (s / Decimal.fromInt f)
        | _ => NONE
    val x =
      from ws in tpcds.web_sales,
          w in tpcds.warehouse,
          d in tpcds.date_dim,
          t in tpcds.time_dim,
          sm in tpcds.ship_mode
        where ws.ws_warehouse_sk = SOME w.w_warehouse_sk
          andalso ws.ws_sold_date_sk = SOME d.d_date_sk
          andalso ws.ws_sold_time_sk = SOME t.t_time_sk
          andalso ws.ws_ship_mode_sk = SOME sm.sm_ship_mode_sk
          andalso d.d_year = SOME 2001
          andalso t.t_time >= SOME 30838
          andalso t.t_time <= SOME (30838 + 28800)
          andalso sm.sm_carrier elem [SOME "DHL", SOME "BARIAN"]
        group {w.w_warehouse_name, w.w_warehouse_sq_ft, w.w_city,
            w.w_county, w.w_state, w.w_country, year = d.d_year}
          compute {
            jan_sales = sumSome over
              (if d.d_moy = SOME 1
                then times (ws.ws_ext_sales_price,
                  ws.ws_quantity)
                else zero),
            feb_sales = sumSome over
              (if d.d_moy = SOME 2
                then times (ws.ws_ext_sales_price,
                  ws.ws_quantity)
                else zero),
            mar_sales = sumSome over
              (if d.d_moy = SOME 3
                then times (ws.ws_ext_sales_price,
                  ws.ws_quantity)
                else zero),
            apr_sales = sumSome over
              (if d.d_moy = SOME 4
                then times (ws.ws_ext_sales_price,
                  ws.ws_quantity)
                else zero),
            may_sales = sumSome over
              (if d.d_moy = SOME 5
                then times (ws.ws_ext_sales_price,
                  ws.ws_quantity)
                else zero),
            jun_sales = sumSome over
              (if d.d_moy = SOME 6
                then times (ws.ws_ext_sales_price,
                  ws.ws_quantity)
                else zero),
            jul_sales = sumSome over
              (if d.d_moy = SOME 7
                then times (ws.ws_ext_sales_price,
                  ws.ws_quantity)
                else zero),
            aug_sales = sumSome over
              (if d.d_moy = SOME 8
                then times (ws.ws_ext_sales_price,
                  ws.ws_quantity)
                else zero),
            sep_sales = sumSome over
              (if d.d_moy = SOME 9
                then times (ws.ws_ext_sales_price,
                  ws.ws_quantity)
                else zero),
            oct_sales = sumSome over
              (if d.d_moy = SOME 10
                then times (ws.ws_ext_sales_price,
                  ws.ws_quantity)
                else zero),
            nov_sales = sumSome over
              (if d.d_moy = SOME 11
                then times (ws.ws_ext_sales_price,
                  ws.ws_quantity)
                else zero),
            dec_sales = sumSome over
              (if d.d_moy = SOME 12
                then times (ws.ws_ext_sales_price,
                  ws.ws_quantity)
                else zero),
            jan_net = sumSome over
              (if d.d_moy = SOME 1
                then times (ws.ws_net_paid,
                  ws.ws_quantity)
                else zero),
            feb_net = sumSome over
              (if d.d_moy = SOME 2
                then times (ws.ws_net_paid,
                  ws.ws_quantity)
                else zero),
            mar_net = sumSome over
              (if d.d_moy = SOME 3
                then times (ws.ws_net_paid,
                  ws.ws_quantity)
                else zero),
            apr_net = sumSome over
              (if d.d_moy = SOME 4
                then times (ws.ws_net_paid,
                  ws.ws_quantity)
                else zero),
            may_net = sumSome over
              (if d.d_moy = SOME 5
                then times (ws.ws_net_paid,
                  ws.ws_quantity)
                else zero),
            jun_net = sumSome over
              (if d.d_moy = SOME 6
                then times (ws.ws_net_paid,
                  ws.ws_quantity)
                else zero),
            jul_net = sumSome over
              (if d.d_moy = SOME 7
                then times (ws.ws_net_paid,
                  ws.ws_quantity)
                else zero),
            aug_net = sumSome over
              (if d.d_moy = SOME 8
                then times (ws.ws_net_paid,
                  ws.ws_quantity)
                else zero),
            sep_net = sumSome over
              (if d.d_moy = SOME 9
                then times (ws.ws_net_paid,
                  ws.ws_quantity)
                else zero),
            oct_net = sumSome over
              (if d.d_moy = SOME 10
                then times (ws.ws_net_paid,
                  ws.ws_quantity)
                else zero),
            nov_net = sumSome over
              (if d.d_moy = SOME 11
                then times (ws.ws_net_paid,
                  ws.ws_quantity)
                else zero),
            dec_net = sumSome over
              (if d.d_moy = SOME 12
                then times (ws.ws_net_paid,
                  ws.ws_quantity)
                else zero)}
        yield {w_warehouse_name, w_warehouse_sq_ft, w_city, w_county,
          w_state, w_country, ship_carriers = "DHL" ^ "," ^ "BARIAN", year,
          jan_sales, feb_sales, mar_sales, apr_sales, may_sales, jun_sales,
          jul_sales, aug_sales, sep_sales, oct_sales, nov_sales, dec_sales,
          jan_net, feb_net, mar_net, apr_net, may_net, jun_net, jul_net,
          aug_net, sep_net, oct_net, nov_net, dec_net}
        union
          (from cs in tpcds.catalog_sales,
              w in tpcds.warehouse,
              d in tpcds.date_dim,
              t in tpcds.time_dim,
              sm in tpcds.ship_mode
            where cs.cs_warehouse_sk = SOME w.w_warehouse_sk
              andalso cs.cs_sold_date_sk = SOME d.d_date_sk
              andalso cs.cs_sold_time_sk = SOME t.t_time_sk
              andalso cs.cs_ship_mode_sk = SOME sm.sm_ship_mode_sk
              andalso d.d_year = SOME 2001
              andalso t.t_time >= SOME 30838
              andalso t.t_time <= SOME (30838 + 28800)
              andalso sm.sm_carrier elem [SOME "DHL", SOME "BARIAN"]
            group {w.w_warehouse_name, w.w_warehouse_sq_ft, w.w_city,
                w.w_county, w.w_state, w.w_country, year = d.d_year}
              compute {
                jan_sales = sumSome over
                  (if d.d_moy = SOME 1
                    then times (cs.cs_sales_price,
                      cs.cs_quantity)
                    else zero),
                feb_sales = sumSome over
                  (if d.d_moy = SOME 2
                    then times (cs.cs_sales_price,
                      cs.cs_quantity)
                    else zero),
                mar_sales = sumSome over
                  (if d.d_moy = SOME 3
                    then times (cs.cs_sales_price,
                      cs.cs_quantity)
                    else zero),
                apr_sales = sumSome over
                  (if d.d_moy = SOME 4
                    then times (cs.cs_sales_price,
                      cs.cs_quantity)
                    else zero),
                may_sales = sumSome over
                  (if d.d_moy = SOME 5
                    then times (cs.cs_sales_price,
                      cs.cs_quantity)
                    else zero),
                jun_sales = sumSome over
                  (if d.d_moy = SOME 6
                    then times (cs.cs_sales_price,
                      cs.cs_quantity)
                    else zero),
                jul_sales = sumSome over
                  (if d.d_moy = SOME 7
                    then times (cs.cs_sales_price,
                      cs.cs_quantity)
                    else zero),
                aug_sales = sumSome over
                  (if d.d_moy = SOME 8
                    then times (cs.cs_sales_price,
                      cs.cs_quantity)
                    else zero),
                sep_sales = sumSome over
                  (if d.d_moy = SOME 9
                    then times (cs.cs_sales_price,
                      cs.cs_quantity)
                    else zero),
                oct_sales = sumSome over
                  (if d.d_moy = SOME 10
                    then times (cs.cs_sales_price,
                      cs.cs_quantity)
                    else zero),
                nov_sales = sumSome over
                  (if d.d_moy = SOME 11
                    then times (cs.cs_sales_price,
                      cs.cs_quantity)
                    else zero),
                dec_sales = sumSome over
                  (if d.d_moy = SOME 12
                    then times (cs.cs_sales_price,
                      cs.cs_quantity)
                    else zero),
                jan_net = sumSome over
                  (if d.d_moy = SOME 1
                    then times (cs.cs_net_paid_inc_tax,
                      cs.cs_quantity)
                    else zero),
                feb_net = sumSome over
                  (if d.d_moy = SOME 2
                    then times (cs.cs_net_paid_inc_tax,
                      cs.cs_quantity)
                    else zero),
                mar_net = sumSome over
                  (if d.d_moy = SOME 3
                    then times (cs.cs_net_paid_inc_tax,
                      cs.cs_quantity)
                    else zero),
                apr_net = sumSome over
                  (if d.d_moy = SOME 4
                    then times (cs.cs_net_paid_inc_tax,
                      cs.cs_quantity)
                    else zero),
                may_net = sumSome over
                  (if d.d_moy = SOME 5
                    then times (cs.cs_net_paid_inc_tax,
                      cs.cs_quantity)
                    else zero),
                jun_net = sumSome over
                  (if d.d_moy = SOME 6
                    then times (cs.cs_net_paid_inc_tax,
                      cs.cs_quantity)
                    else zero),
                jul_net = sumSome over
                  (if d.d_moy = SOME 7
                    then times (cs.cs_net_paid_inc_tax,
                      cs.cs_quantity)
                    else zero),
                aug_net = sumSome over
                  (if d.d_moy = SOME 8
                    then times (cs.cs_net_paid_inc_tax,
                      cs.cs_quantity)
                    else zero),
                sep_net = sumSome over
                  (if d.d_moy = SOME 9
                    then times (cs.cs_net_paid_inc_tax,
                      cs.cs_quantity)
                    else zero),
                oct_net = sumSome over
                  (if d.d_moy = SOME 10
                    then times (cs.cs_net_paid_inc_tax,
                      cs.cs_quantity)
                    else zero),
                nov_net = sumSome over
                  (if d.d_moy = SOME 11
                    then times (cs.cs_net_paid_inc_tax,
                      cs.cs_quantity)
                    else zero),
                dec_net = sumSome over
                  (if d.d_moy = SOME 12
                    then times (cs.cs_net_paid_inc_tax,
                      cs.cs_quantity)
                    else zero)}
            yield {w_warehouse_name, w_warehouse_sq_ft, w_city, w_county,
              w_state, w_country, ship_carriers = "DHL" ^ "," ^ "BARIAN", year,
              jan_sales, feb_sales, mar_sales, apr_sales, may_sales, jun_sales,
              jul_sales, aug_sales, sep_sales, oct_sales, nov_sales, dec_sales,
              jan_net, feb_net, mar_net, apr_net, may_net, jun_net, jul_net,
              aug_net, sep_net, oct_net, nov_net, dec_net})
  in
    from x in x
      group {x.w_warehouse_name, x.w_warehouse_sq_ft, x.w_city, x.w_county,
          x.w_state, x.w_country, x.ship_carriers, x.year}
        compute {
        jan_sales = sumSome over x.jan_sales,
        feb_sales = sumSome over x.feb_sales,
        mar_sales = sumSome over x.mar_sales,
        apr_sales = sumSome over x.apr_sales,
        may_sales = sumSome over x.may_sales,
        jun_sales = sumSome over x.jun_sales,
        jul_sales = sumSome over x.jul_sales,
        aug_sales = sumSome over x.aug_sales,
        sep_sales = sumSome over x.sep_sales,
        oct_sales = sumSome over x.oct_sales,
        nov_sales = sumSome over x.nov_sales,
        dec_sales = sumSome over x.dec_sales,
        jan_sales_per_sq_foot =
          sumSome over
            perFoot (x.jan_sales, x.w_warehouse_sq_ft),
        feb_sales_per_sq_foot =
          sumSome over
            perFoot (x.feb_sales, x.w_warehouse_sq_ft),
        mar_sales_per_sq_foot =
          sumSome over
            perFoot (x.mar_sales, x.w_warehouse_sq_ft),
        apr_sales_per_sq_foot =
          sumSome over
            perFoot (x.apr_sales, x.w_warehouse_sq_ft),
        may_sales_per_sq_foot =
          sumSome over
            perFoot (x.may_sales, x.w_warehouse_sq_ft),
        jun_sales_per_sq_foot =
          sumSome over
            perFoot (x.jun_sales, x.w_warehouse_sq_ft),
        jul_sales_per_sq_foot =
          sumSome over
            perFoot (x.jul_sales, x.w_warehouse_sq_ft),
        aug_sales_per_sq_foot =
          sumSome over
            perFoot (x.aug_sales, x.w_warehouse_sq_ft),
        sep_sales_per_sq_foot =
          sumSome over
            perFoot (x.sep_sales, x.w_warehouse_sq_ft),
        oct_sales_per_sq_foot =
          sumSome over
            perFoot (x.oct_sales, x.w_warehouse_sq_ft),
        nov_sales_per_sq_foot =
          sumSome over
            perFoot (x.nov_sales, x.w_warehouse_sq_ft),
        dec_sales_per_sq_foot =
          sumSome over
            perFoot (x.dec_sales, x.w_warehouse_sq_ft),
        jan_net = sumSome over x.jan_net,
        feb_net = sumSome over x.feb_net,
        mar_net = sumSome over x.mar_net,
        apr_net = sumSome over x.apr_net,
        may_net = sumSome over x.may_net,
        jun_net = sumSome over x.jun_net,
        jul_net = sumSome over x.jul_net,
        aug_net = sumSome over x.aug_net,
        sep_net = sumSome over x.sep_net,
        oct_net = sumSome over x.oct_net,
        nov_net = sumSome over x.nov_net,
        dec_net = sumSome over x.dec_net}
      order w_warehouse_name
      take 100
  end;
