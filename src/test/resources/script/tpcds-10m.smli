(* --- q83 -------------------------------------------------------- *)
(*
WITH sr_items AS
(SELECT
    i_item_id item_id,
    sum(sr_return_quantity) sr_item_qty
  FROM store_returns, item, date_dim
  WHERE sr_item_sk = i_item_sk
    AND d_date IN (SELECT d_date
  FROM date_dim
  WHERE d_week_seq IN
    (SELECT d_week_seq
    FROM date_dim
    WHERE d_date IN ('2000-06-30', '2000-09-27', '2000-11-17')))
    AND sr_returned_date_sk = d_date_sk
  GROUP BY i_item_id),
    cr_items AS
  (SELECT
    i_item_id item_id,
    sum(cr_return_quantity) cr_item_qty
  FROM catalog_returns, item, date_dim
  WHERE cr_item_sk = i_item_sk
    AND d_date IN (SELECT d_date
  FROM date_dim
  WHERE d_week_seq IN
    (SELECT d_week_seq
    FROM date_dim
    WHERE d_date IN ('2000-06-30', '2000-09-27', '2000-11-17')))
    AND cr_returned_date_sk = d_date_sk
  GROUP BY i_item_id),
    wr_items AS
  (SELECT
    i_item_id item_id,
    sum(wr_return_quantity) wr_item_qty
  FROM web_returns, item, date_dim
  WHERE wr_item_sk = i_item_sk AND d_date IN
    (SELECT d_date
    FROM date_dim
    WHERE d_week_seq IN
      (SELECT d_week_seq
      FROM date_dim
      WHERE d_date IN ('2000-06-30', '2000-09-27', '2000-11-17')))
    AND wr_returned_date_sk = d_date_sk
  GROUP BY i_item_id)
SELECT
  sr_items.item_id,
  sr_item_qty,
  sr_item_qty / (sr_item_qty + cr_item_qty + wr_item_qty) / 3.0 * 100 sr_dev,
  cr_item_qty,
  cr_item_qty / (sr_item_qty + cr_item_qty + wr_item_qty) / 3.0 * 100 cr_dev,
  wr_item_qty,
  wr_item_qty / (sr_item_qty + cr_item_qty + wr_item_qty) / 3.0 * 100 wr_dev,
  (sr_item_qty + cr_item_qty + wr_item_qty) / 3.0 average
FROM sr_items, cr_items, wr_items
WHERE sr_items.item_id = cr_items.item_id
  AND sr_items.item_id = wr_items.item_id
ORDER BY sr_items.item_id, sr_item_qty
LIMIT 100
*)
fun q83 () =
  let
    fun day (year, month, day) =
      Date.date {year, month, day, hour = 0, minute = 0, second = 0,
        offset = SOME Time.zeroTime}
    val weeks =
      from d in tpcds.date_dim
        where d.d_date elem [SOME (day (2000, Jun, 30)),
          SOME (day (2000, Sep, 27)), SOME (day (2000, Nov, 17))]
        yield d.d_week_seq
    val dates =
      from d in tpcds.date_dim
        where d.d_week_seq <> NONE andalso d.d_week_seq elem weeks
        yield d.d_date
    val sr_items =
      from sr in tpcds.store_returns,
          i in tpcds.item,
          d in tpcds.date_dim
        where sr.sr_item_sk = i.i_item_sk
          andalso d.d_date elem dates
          andalso sr.sr_returned_date_sk = SOME d.d_date_sk
        group {item_id = i.i_item_id}
          compute {sr_item_qty = sum over sr.sr_return_quantity}
    val cr_items =
      from cr in tpcds.catalog_returns,
          i in tpcds.item,
          d in tpcds.date_dim
        where cr.cr_item_sk = i.i_item_sk
          andalso d.d_date elem dates
          andalso cr.cr_returned_date_sk = SOME d.d_date_sk
        group {item_id = i.i_item_id}
          compute {cr_item_qty = sum over cr.cr_return_quantity}
    val wr_items =
      from wr in tpcds.web_returns,
          i in tpcds.item,
          d in tpcds.date_dim
        where wr.wr_item_sk = i.i_item_sk
          andalso d.d_date elem dates
          andalso wr.wr_returned_date_sk = SOME d.d_date_sk
        group {item_id = i.i_item_id}
          compute {wr_item_qty = sum over wr.wr_return_quantity}
    fun ratio (q, total) =
      case (q, total) of
          (SOME q, SOME t) =>
            SOME (Real.fromInt q / Real.fromInt t / 3.0 * 100.0)
        | _ => NONE
  in
    from sr in sr_items,
        cr in cr_items,
        wr in wr_items
      where sr.item_id = cr.item_id
        andalso sr.item_id = wr.item_id
      yield {sr, cr, wr,
        total =
          case (sr.sr_item_qty, cr.cr_item_qty, wr.wr_item_qty) of
              (SOME s, SOME c, SOME w) => SOME (s + c + w)
            | _ => NONE}
      yield {sr.item_id, sr.sr_item_qty,
        sr_dev = ratio (sr.sr_item_qty, total),
        cr.cr_item_qty,
        cr_dev = ratio (cr.cr_item_qty, total),
        wr.wr_item_qty,
        wr_dev = ratio (wr.wr_item_qty, total),
        average =
          Option.map (fn t => Decimal.fromInt t / decimal "3.0") total}
      order (item_id, sr_item_qty)
      take 100
  end;
> val q83 = fn
>   : unit
>      -> {average:decimal option, cr_dev:real option, cr_item_qty:int option,
>           item_id:string, sr_dev:real option, sr_item_qty:int option,
>           wr_dev:real option, wr_item_qty:int option} list
val r83 = q83 ();
> average cr_dev cr_item_qty item_id sr_dev sr_item_qty wr_dev wr_item_qty
> ------- ------ ----------- ------- ------ ----------- ------ -----------
>
> val r83 : {average:decimal option, cr_dev:real option, cr_item_qty:int option, item_id:string, sr_dev:real option, sr_item_qty:int option, wr_dev:real option, wr_item_qty:int option} list

(* --- q84 -------------------------------------------------------- *)
(*
SELECT
  c_customer_id AS customer_id,
  concat(c_last_name, ', ', c_first_name) AS customername
FROM customer
  , customer_address
  , customer_demographics
  , household_demographics
  , income_band
  , store_returns
WHERE ca_city = 'Edgewood'
  AND c_current_addr_sk = ca_address_sk
  AND ib_lower_bound >= 38128
  AND ib_upper_bound <= 38128 + 50000
  AND ib_income_band_sk = hd_income_band_sk
  AND cd_demo_sk = c_current_cdemo_sk
  AND hd_demo_sk = c_current_hdemo_sk
  AND sr_cdemo_sk = cd_demo_sk
ORDER BY c_customer_id
LIMIT 100
*)
fun q84 () =
  from c in tpcds.customer,
      ca in tpcds.customer_address,
      cd in tpcds.customer_demographics,
      hd in tpcds.household_demographics,
      ib in tpcds.income_band,
      sr in tpcds.store_returns
    where ca.ca_city = SOME "Edgewood"
      andalso c.c_current_addr_sk = SOME ca.ca_address_sk
      andalso ib.ib_lower_bound >= SOME 38128
      andalso Option.isSome ib.ib_upper_bound
      andalso ib.ib_upper_bound <= SOME (38128 + 50000)
      andalso hd.hd_income_band_sk = SOME ib.ib_income_band_sk
      andalso c.c_current_cdemo_sk = SOME cd.cd_demo_sk
      andalso c.c_current_hdemo_sk = SOME hd.hd_demo_sk
      andalso sr.sr_cdemo_sk = SOME cd.cd_demo_sk
    yield {customer_id = c.c_customer_id,
      customername =
        case (c.c_last_name, c.c_first_name) of
            (SOME l, SOME f) => SOME (l ^ ", " ^ f)
          | _ => NONE}
    order customer_id
    take 100;
> val q84 = fn : unit -> {customer_id:string, customername:string option} list
val r84 = q84 ();
> customer_id customername
> ----------- ------------
>
> val r84 : {customer_id:string, customername:string option} list

(* --- q87 -------------------------------------------------------- *)
(*
SELECT count(*)
FROM ((SELECT DISTINCT
  c_last_name,
  c_first_name,
  d_date
FROM store_sales, date_dim, customer
WHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk
  AND store_sales.ss_customer_sk = customer.c_customer_sk
  AND d_month_seq BETWEEN 1200 AND 1200 + 11)
      EXCEPT
      (SELECT DISTINCT
        c_last_name,
        c_first_name,
        d_date
      FROM catalog_sales, date_dim, customer
      WHERE catalog_sales.cs_sold_date_sk = date_dim.d_date_sk
        AND catalog_sales.cs_bill_customer_sk = customer.c_customer_sk
        AND d_month_seq BETWEEN 1200 AND 1200 + 11)
      EXCEPT
      (SELECT DISTINCT
        c_last_name,
        c_first_name,
        d_date
      FROM web_sales, date_dim, customer
      WHERE web_sales.ws_sold_date_sk = date_dim.d_date_sk
        AND web_sales.ws_bill_customer_sk = customer.c_customer_sk
        AND d_month_seq BETWEEN 1200 AND 1200 + 11)
     ) cool_cust
*)
fun q87 () =
  from r in (
      from ss in tpcds.store_sales,
          d in tpcds.date_dim,
          c in tpcds.customer
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_customer_sk = SOME c.c_customer_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        yield {c.c_last_name, c.c_first_name, d.d_date})
    except distinct
      (from cs in tpcds.catalog_sales,
          d in tpcds.date_dim,
          c in tpcds.customer
        where cs.cs_sold_date_sk = SOME d.d_date_sk
          andalso cs.cs_bill_customer_sk = SOME c.c_customer_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        yield {c.c_last_name, c.c_first_name, d.d_date}),
      (from ws in tpcds.web_sales,
          d in tpcds.date_dim,
          c in tpcds.customer
        where ws.ws_sold_date_sk = SOME d.d_date_sk
          andalso ws.ws_bill_customer_sk = SOME c.c_customer_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        yield {c.c_last_name, c.c_first_name, d.d_date})
    compute count over ();
> val q87 = fn : unit -> int
val r87 = q87 ();
> val r87 = 1994 : int

(* --- q90 -------------------------------------------------------- *)
(*
SELECT cast(amc AS DECIMAL(15, 4)) / cast(pmc AS DECIMAL(15, 4)) am_pm_ratio
FROM (SELECT count(*) amc
FROM web_sales, household_demographics, time_dim, web_page
WHERE ws_sold_time_sk = time_dim.t_time_sk
  AND ws_ship_hdemo_sk = household_demographics.hd_demo_sk
  AND ws_web_page_sk = web_page.wp_web_page_sk
  AND time_dim.t_hour BETWEEN 8 AND 8 + 1
  AND household_demographics.hd_dep_count = 6
  AND web_page.wp_char_count BETWEEN 5000 AND 5200) at,
  (SELECT count(*) pmc
  FROM web_sales, household_demographics, time_dim, web_page
  WHERE ws_sold_time_sk = time_dim.t_time_sk
    AND ws_ship_hdemo_sk = household_demographics.hd_demo_sk
    AND ws_web_page_sk = web_page.wp_web_page_sk
    AND time_dim.t_hour BETWEEN 19 AND 19 + 1
    AND household_demographics.hd_dep_count = 6
    AND web_page.wp_char_count BETWEEN 5000 AND 5200) pt
ORDER BY am_pm_ratio
LIMIT 100
*)
fun q90 () =
  let
    fun countSales (h1, h2) =
      from ws in tpcds.web_sales,
          hd in tpcds.household_demographics,
          t in tpcds.time_dim,
          wp in tpcds.web_page
        where ws.ws_sold_time_sk = SOME t.t_time_sk
          andalso ws.ws_ship_hdemo_sk = SOME hd.hd_demo_sk
          andalso ws.ws_web_page_sk = SOME wp.wp_web_page_sk
          andalso t.t_hour >= SOME h1
          andalso t.t_hour <= SOME h2
          andalso hd.hd_dep_count = SOME 6
          andalso wp.wp_char_count >= SOME 5000
          andalso wp.wp_char_count <= SOME 5200
        compute count over ()
    val amc = countSales (8, 8 + 1)
    val pmc = countSales (19, 19 + 1)
  in
    [{am_pm_ratio = Decimal.fromInt amc / Decimal.fromInt pmc}]
  end;
> val q90 = fn : unit -> {am_pm_ratio:decimal} list
val r90 = q90 ();
> uncaught exception Div [divide by zero]
>   raised at: stdIn:20.21-20.62

(* --- q91 -------------------------------------------------------- *)
(*
SELECT
  cc_call_center_id Call_Center,
  cc_name Call_Center_Name,
  cc_manager Manager,
  sum(cr_net_loss) Returns_Loss
FROM
  call_center, catalog_returns, date_dim, customer, customer_address,
  customer_demographics, household_demographics
WHERE
  cr_call_center_sk = cc_call_center_sk
    AND cr_returned_date_sk = d_date_sk
    AND cr_returning_customer_sk = c_customer_sk
    AND cd_demo_sk = c_current_cdemo_sk
    AND hd_demo_sk = c_current_hdemo_sk
    AND ca_address_sk = c_current_addr_sk
    AND d_year = 1998
    AND d_moy = 11
    AND ((cd_marital_status = 'M' AND cd_education_status = 'Unknown')
    OR (cd_marital_status = 'W' AND cd_education_status = 'Advanced Degree'))
    AND hd_buy_potential LIKE 'Unknown%'
    AND ca_gmt_offset = -7
GROUP BY cc_call_center_id, cc_name, cc_manager, cd_marital_status, cd_education_status
ORDER BY sum(cr_net_loss) DESC
*)
fun q91 () =
  from cc in tpcds.call_center,
      cr in tpcds.catalog_returns,
      d in tpcds.date_dim,
      c in tpcds.customer,
      ca in tpcds.customer_address,
      cd in tpcds.customer_demographics,
      hd in tpcds.household_demographics
    where cr.cr_call_center_sk = SOME cc.cc_call_center_sk
      andalso cr.cr_returned_date_sk = SOME d.d_date_sk
      andalso cr.cr_returning_customer_sk = SOME c.c_customer_sk
      andalso c.c_current_cdemo_sk = SOME cd.cd_demo_sk
      andalso c.c_current_hdemo_sk = SOME hd.hd_demo_sk
      andalso c.c_current_addr_sk = SOME ca.ca_address_sk
      andalso d.d_year = SOME 1998
      andalso d.d_moy = SOME 11
      andalso (cd.cd_marital_status = SOME "M"
          andalso cd.cd_education_status = SOME "Unknown"
        orelse cd.cd_marital_status = SOME "W"
          andalso cd.cd_education_status = SOME "Advanced Degree")
      andalso (case hd.hd_buy_potential of
                  SOME p => String.isPrefix "Unknown" p
                | NONE => false)
      andalso ca.ca_gmt_offset = SOME (Decimal.fromInt ~7)
    group {call_center = cc.cc_call_center_id,
        call_center_name = cc.cc_name, manager = cc.cc_manager,
        cd.cd_marital_status, cd.cd_education_status}
      compute {returns_loss = sum over cr.cr_net_loss}
    yield {call_center, call_center_name, manager, returns_loss}
    order DESC returns_loss;
> val q91 = fn
>   : unit
>      -> {call_center:string, call_center_name:string option,
>           manager:string option, returns_loss:decimal option} list
val r91 = q91 ();
> call_center call_center_name manager returns_loss
> ----------- ---------------- ------- ------------
>
> val r91 : {call_center:string, call_center_name:string option, manager:string option, returns_loss:decimal option} list

(* --- q93 -------------------------------------------------------- *)
(*
SELECT
  ss_customer_sk,
  sum(act_sales) sumsales
FROM (SELECT
  ss_item_sk,
  ss_ticket_number,
  ss_customer_sk,
  CASE WHEN sr_return_quantity IS NOT NULL
    THEN (ss_quantity - sr_return_quantity) * ss_sales_price
  ELSE (ss_quantity * ss_sales_price) END act_sales
FROM store_sales
  LEFT OUTER JOIN store_returns
    ON (sr_item_sk = ss_item_sk AND sr_ticket_number = ss_ticket_number)
  ,
  reason
WHERE sr_reason_sk = r_reason_sk AND r_reason_desc = 'reason 28') t
GROUP BY ss_customer_sk
ORDER BY sumsales, ss_customer_sk
LIMIT 100
*)
fun q93 () =
  from t in (
      from ss in tpcds.store_sales
        left join sr in tpcds.store_returns
          on sr.sr_item_sk = ss.ss_item_sk
            andalso sr.sr_ticket_number = ss.ss_ticket_number,
        r in tpcds.reason
        where Option.`join` sr?.sr_reason_sk = SOME r.r_reason_sk
          andalso r.r_reason_desc = SOME "reason 28"
        yield {ss.ss_item_sk, ss.ss_ticket_number, ss.ss_customer_sk,
          act_sales =
            case (ss.ss_quantity, Option.`join` sr?.sr_return_quantity,
                ss.ss_sales_price) of
                (SOME q, SOME rq, SOME p) =>
                  SOME (Decimal.fromInt (q - rq) * p)
              | (SOME q, NONE, SOME p) => SOME (Decimal.fromInt q * p)
              | _ => NONE})
    group t.ss_customer_sk compute {sumsales = sum over t.act_sales}
    order (sumsales, ss_customer_sk)
    take 100;
> val q93 = fn
>   : unit -> {ss_customer_sk:int option, sumsales:decimal option} list
val r93 = q93 ();
> ss_customer_sk sumsales
> -------------- --------
>
> val r93 : {ss_customer_sk:int option, sumsales:decimal option} list

(* --- q96 -------------------------------------------------------- *)
(*
SELECT count(*)
FROM store_sales, household_demographics, time_dim, store
WHERE ss_sold_time_sk = time_dim.t_time_sk
  AND ss_hdemo_sk = household_demographics.hd_demo_sk
  AND ss_store_sk = s_store_sk
  AND time_dim.t_hour = 20
  AND time_dim.t_minute >= 30
  AND household_demographics.hd_dep_count = 7
  AND store.s_store_name = 'ese'
ORDER BY count(*)
LIMIT 100
*)
fun q96 () =
  from ss in tpcds.store_sales,
      hd in tpcds.household_demographics,
      t in tpcds.time_dim,
      s in tpcds.store
    where ss.ss_sold_time_sk = SOME t.t_time_sk
      andalso ss.ss_hdemo_sk = SOME hd.hd_demo_sk
      andalso ss.ss_store_sk = SOME s.s_store_sk
      andalso t.t_hour = SOME 20
      andalso t.t_minute >= SOME 30
      andalso hd.hd_dep_count = SOME 7
      andalso s.s_store_name = SOME "ese"
    compute count over ();
> val q96 = fn : unit -> int
val r96 = q96 ();
> val r96 = 0 : int

(* --- q97 -------------------------------------------------------- *)
(*
WITH ssci AS (
  SELECT
    ss_customer_sk customer_sk,
    ss_item_sk item_sk
  FROM store_sales, date_dim
  WHERE ss_sold_date_sk = d_date_sk
    AND d_month_seq BETWEEN 1200 AND 1200 + 11
  GROUP BY ss_customer_sk, ss_item_sk),
    csci AS (
    SELECT
      cs_bill_customer_sk customer_sk,
      cs_item_sk item_sk
    FROM catalog_sales, date_dim
    WHERE cs_sold_date_sk = d_date_sk
      AND d_month_seq BETWEEN 1200 AND 1200 + 11
    GROUP BY cs_bill_customer_sk, cs_item_sk)
SELECT
  sum(CASE WHEN ssci.customer_sk IS NOT NULL AND csci.customer_sk IS NULL
    THEN 1
      ELSE 0 END) store_only,
  sum(CASE WHEN ssci.customer_sk IS NULL AND csci.customer_sk IS NOT NULL
    THEN 1
      ELSE 0 END) catalog_only,
  sum(CASE WHEN ssci.customer_sk IS NOT NULL AND csci.customer_sk IS NOT NULL
    THEN 1
      ELSE 0 END) store_and_catalog
FROM ssci
  FULL OUTER JOIN csci ON (ssci.customer_sk = csci.customer_sk
    AND ssci.item_sk = csci.item_sk)
LIMIT 100
*)
fun q97 () =
  let
    val ssci =
      from ss in tpcds.store_sales,
          d in tpcds.date_dim
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        group {customer_sk = ss.ss_customer_sk, item_sk = ss.ss_item_sk}
    val csci =
      from cs in tpcds.catalog_sales,
          d in tpcds.date_dim
        where cs.cs_sold_date_sk = SOME d.d_date_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        group {customer_sk = cs.cs_bill_customer_sk, item_sk = cs.cs_item_sk}
  in
    from s in ssci
      full join c in csci
        on s.customer_sk <> NONE
          andalso s.customer_sk = c.customer_sk
          andalso s.item_sk = c.item_sk
      compute {
        store_only = sum over
          (case (Option.`join` s?.customer_sk,
              Option.`join` c?.customer_sk) of
              (SOME _, NONE) => 1
            | _ => 0),
        catalog_only = sum over
          (case (Option.`join` s?.customer_sk,
              Option.`join` c?.customer_sk) of
              (NONE, SOME _) => 1
            | _ => 0),
        store_and_catalog = sum over
          (case (Option.`join` s?.customer_sk,
              Option.`join` c?.customer_sk) of
              (SOME _, SOME _) => 1
            | _ => 0)}
  end;
> val q97 = fn
>   : unit -> {catalog_only:int, store_and_catalog:int, store_only:int}
val r97 = q97 ();
> val r97 = {catalog_only=16944,store_and_catalog=391,store_only=22255}
>   : {catalog_only:int, store_and_catalog:int, store_only:int}

(* --- q99 -------------------------------------------------------- *)
(*
SELECT
  substr(w_warehouse_name, 1, 20),
  sm_type,
  cc_name,
  sum(CASE WHEN (cs_ship_date_sk - cs_sold_date_sk <= 30)
    THEN 1
      ELSE 0 END)  AS `30 days `,
  sum(CASE WHEN (cs_ship_date_sk - cs_sold_date_sk > 30) AND
    (cs_ship_date_sk - cs_sold_date_sk <= 60)
    THEN 1
      ELSE 0 END)  AS `31 - 60 days `,
  sum(CASE WHEN (cs_ship_date_sk - cs_sold_date_sk > 60) AND
    (cs_ship_date_sk - cs_sold_date_sk <= 90)
    THEN 1
      ELSE 0 END)  AS `61 - 90 days `,
  sum(CASE WHEN (cs_ship_date_sk - cs_sold_date_sk > 90) AND
    (cs_ship_date_sk - cs_sold_date_sk <= 120)
    THEN 1
      ELSE 0 END)  AS `91 - 120 days `,
  sum(CASE WHEN (cs_ship_date_sk - cs_sold_date_sk > 120)
    THEN 1
      ELSE 0 END)  AS `>120 days `
FROM
  catalog_sales, warehouse, ship_mode, call_center, date_dim
WHERE
  d_month_seq BETWEEN 1200 AND 1200 + 11
    AND cs_ship_date_sk = d_date_sk
    AND cs_warehouse_sk = w_warehouse_sk
    AND cs_ship_mode_sk = sm_ship_mode_sk
    AND cs_call_center_sk = cc_call_center_sk
GROUP BY
  substr(w_warehouse_name, 1, 20), sm_type, cc_name
ORDER BY substr(w_warehouse_name, 1, 20), sm_type, cc_name
LIMIT 100
*)
fun q99 () =
  from cs in tpcds.catalog_sales,
      w in tpcds.warehouse,
      sm in tpcds.ship_mode,
      cc in tpcds.call_center,
      d in tpcds.date_dim
    where d.d_month_seq >= SOME 1200
      andalso d.d_month_seq <= SOME (1200 + 11)
      andalso cs.cs_ship_date_sk = SOME d.d_date_sk
      andalso cs.cs_warehouse_sk = SOME w.w_warehouse_sk
      andalso cs.cs_ship_mode_sk = SOME sm.sm_ship_mode_sk
      andalso cs.cs_call_center_sk = SOME cc.cc_call_center_sk
    yield {w_warehouse_name =
        Option.map (fn s => String.substring (s, 0, Int.min (20, size s)))
          w.w_warehouse_name,
      sm.sm_type, cc.cc_name,
      lag =
        case (cs.cs_ship_date_sk, cs.cs_sold_date_sk) of
            (SOME ship, SOME sold) => SOME (ship - sold)
          | _ => NONE}
    group {w_warehouse_name, sm_type, cc_name}
      compute {
        `30 days ` = sum over
          (if lag <> NONE andalso lag <= SOME 30 then 1 else 0),
        `31 - 60 days ` = sum over
          (if lag > SOME 30 andalso lag <= SOME 60 then 1 else 0),
        `61 - 90 days ` = sum over
          (if lag > SOME 60 andalso lag <= SOME 90 then 1 else 0),
        `91 - 120 days ` = sum over
          (if lag > SOME 90 andalso lag <= SOME 120 then 1 else 0),
        `>120 days ` = sum over (if lag > SOME 120 then 1 else 0)}
    order (w_warehouse_name, sm_type, cc_name)
    take 100;
> val q99 = fn
>   : unit
>      -> {`30 days `:int, `31 - 60 days `:int, `61 - 90 days `:int,
>           `91 - 120 days `:int, `>120 days `:int, cc_name:string option,
>           sm_type:string option, w_warehouse_name:string option} list
val r99 = q99 ();
