(* --- q31 -------------------------------------------------------- *)
(*
WITH ss AS
(SELECT
    ca_county,
    d_qoy,
    d_year,
    sum(ss_ext_sales_price) AS store_sales
  FROM store_sales, date_dim, customer_address
  WHERE ss_sold_date_sk = d_date_sk
    AND ss_addr_sk = ca_address_sk
  GROUP BY ca_county, d_qoy, d_year),
    ws AS
  (SELECT
    ca_county,
    d_qoy,
    d_year,
    sum(ws_ext_sales_price) AS web_sales
  FROM web_sales, date_dim, customer_address
  WHERE ws_sold_date_sk = d_date_sk
    AND ws_bill_addr_sk = ca_address_sk
  GROUP BY ca_county, d_qoy, d_year)
SELECT
  ss1.ca_county,
  ss1.d_year,
  ws2.web_sales / ws1.web_sales web_q1_q2_increase,
  ss2.store_sales / ss1.store_sales store_q1_q2_increase,
  ws3.web_sales / ws2.web_sales web_q2_q3_increase,
  ss3.store_sales / ss2.store_sales store_q2_q3_increase
FROM
  ss ss1, ss ss2, ss ss3, ws ws1, ws ws2, ws ws3
WHERE
  ss1.d_qoy = 1
    AND ss1.d_year = 2000
    AND ss1.ca_county = ss2.ca_county
    AND ss2.d_qoy = 2
    AND ss2.d_year = 2000
    AND ss2.ca_county = ss3.ca_county
    AND ss3.d_qoy = 3
    AND ss3.d_year = 2000
    AND ss1.ca_county = ws1.ca_county
    AND ws1.d_qoy = 1
    AND ws1.d_year = 2000
    AND ws1.ca_county = ws2.ca_county
    AND ws2.d_qoy = 2
    AND ws2.d_year = 2000
    AND ws1.ca_county = ws3.ca_county
    AND ws3.d_qoy = 3
    AND ws3.d_year = 2000
    AND CASE WHEN ws1.web_sales > 0
    THEN ws2.web_sales / ws1.web_sales
        ELSE NULL END
    > CASE WHEN ss1.store_sales > 0
    THEN ss2.store_sales / ss1.store_sales
      ELSE NULL END
    AND CASE WHEN ws2.web_sales > 0
    THEN ws3.web_sales / ws2.web_sales
        ELSE NULL END
    > CASE WHEN ss2.store_sales > 0
    THEN ss3.store_sales / ss2.store_sales
      ELSE NULL END
ORDER BY ss1.ca_county
*)
fun q31 () =
  let
    val ss =
      from ss in tpcds.store_sales,
          d in tpcds.date_dim,
          ca in tpcds.customer_address
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_addr_sk = SOME ca.ca_address_sk
        group {ca.ca_county, d.d_qoy, d.d_year}
          compute {store_sales = sumSome over ss.ss_ext_sales_price}
    val ws =
      from ws in tpcds.web_sales,
          d in tpcds.date_dim,
          ca in tpcds.customer_address
        where ws.ws_sold_date_sk = SOME d.d_date_sk
          andalso ws.ws_bill_addr_sk = SOME ca.ca_address_sk
        group {ca.ca_county, d.d_qoy, d.d_year}
          compute {web_sales = sumSome over ws.ws_ext_sales_price}
    (* "a / b", which raises if "b" is zero *)
    fun divide (a : decimal option, b) =
      case (a, b) of
          (SOME x, SOME y) => SOME (x / y)
        | _ => NONE
    (* "CASE WHEN b > 0 THEN a / b ELSE NULL END" *)
    fun ratio (a, b) =
      case (a, b) of
          (SOME x, SOME y) =>
            if y > Decimal.fromInt 0 then SOME (x / y) else NONE
        | _ => NONE
  in
    from ss1 in ss, ss2 in ss, ss3 in ss, ws1 in ws, ws2 in ws, ws3 in ws
      where ss1.d_qoy = SOME 1
        andalso ss1.d_year = SOME 2000
        andalso ss1.ca_county <> NONE
        andalso ss1.ca_county = ss2.ca_county
        andalso ss2.d_qoy = SOME 2
        andalso ss2.d_year = SOME 2000
        andalso ss2.ca_county = ss3.ca_county
        andalso ss3.d_qoy = SOME 3
        andalso ss3.d_year = SOME 2000
        andalso ss1.ca_county = ws1.ca_county
        andalso ws1.d_qoy = SOME 1
        andalso ws1.d_year = SOME 2000
        andalso ws1.ca_county = ws2.ca_county
        andalso ws2.d_qoy = SOME 2
        andalso ws2.d_year = SOME 2000
        andalso ws1.ca_county = ws3.ca_county
        andalso ws3.d_qoy = SOME 3
        andalso ws3.d_year = SOME 2000
        andalso ratio (ss2.store_sales, ss1.store_sales) <> NONE
        andalso ratio (ws2.web_sales, ws1.web_sales)
          > ratio (ss2.store_sales, ss1.store_sales)
        andalso ratio (ss3.store_sales, ss2.store_sales) <> NONE
        andalso ratio (ws3.web_sales, ws2.web_sales)
          > ratio (ss3.store_sales, ss2.store_sales)
      yield {ss1.ca_county, ss1.d_year,
        web_q1_q2_increase = divide (ws2.web_sales, ws1.web_sales),
        store_q1_q2_increase = divide (ss2.store_sales, ss1.store_sales),
        web_q2_q3_increase = divide (ws3.web_sales, ws2.web_sales),
        store_q2_q3_increase = divide (ss3.store_sales, ss2.store_sales)}
      order ca_county
  end;
> val q31 = fn
>   : unit
>      -> {ca_county:string option, d_year:int option,
>           store_q1_q2_increase:decimal option,
>           store_q2_q3_increase:decimal option,
>           web_q1_q2_increase:decimal option,
>           web_q2_q3_increase:decimal option} list
val r31 = q31 ();
> ca_county d_year store_q1_q2_increase store_q2_q3_increase web_q1_q2_increase web_q2_q3_increase
> --------- ------ -------------------- -------------------- ------------------ ------------------
>
> val r31 : {ca_county:string option, d_year:int option, store_q1_q2_increase:decimal option, store_q2_q3_increase:decimal option, web_q1_q2_increase:decimal option, web_q2_q3_increase:decimal option} list

(* --- q32 -------------------------------------------------------- *)
(*
SELECT sum(cs_ext_discount_amt) AS `excess discount amount`
FROM
  catalog_sales, item, date_dim
WHERE
  i_manufact_id = 977
    AND i_item_sk = cs_item_sk
    AND d_date BETWEEN '2000-01-27' AND (cast('2000-01-27' AS DATE) + interval 90 days)
    AND d_date_sk = cs_sold_date_sk
    AND cs_ext_discount_amt > (
    SELECT 1.3 * avg(cs_ext_discount_amt)
    FROM catalog_sales, date_dim
    WHERE cs_item_sk = i_item_sk
      AND d_date BETWEEN '2000-01-27' AND (cast('2000-01-27' AS DATE) + interval 90 days)
      AND d_date_sk = cs_sold_date_sk)
LIMIT 100
*)
fun q32 () =
  let
    fun day (year, month, day) =
      Date.date {year, month, day, hour = 0, minute = 0, second = 0,
        offset = SOME Time.zeroTime}
  in
    from cs in tpcds.catalog_sales,
        i in tpcds.item,
        d in tpcds.date_dim
      where i.i_manufact_id = SOME 977
        andalso cs.cs_item_sk = i.i_item_sk
        andalso d.d_date >= SOME (day (2000, Jan, 27))
        andalso d.d_date <= SOME (day (2000, Jan, 27 + 90))
        andalso cs.cs_sold_date_sk = SOME d.d_date_sk
        andalso (case (cs.cs_ext_discount_amt,
                from cs2 in tpcds.catalog_sales,
                    d2 in tpcds.date_dim
                  where cs2.cs_item_sk = i.i_item_sk
                    andalso d2.d_date >= SOME (day (2000, Jan, 27))
                    andalso d2.d_date <= SOME (day (2000, Jan, 27 + 90))
                    andalso cs2.cs_sold_date_sk = SOME d2.d_date_sk
                  compute avgSome over cs2.cs_ext_discount_amt) of
              (SOME amt, SOME average) => amt > decimal "1.3" * average
            | _ => false)
      compute {`excess discount amount` = sumSome over cs.cs_ext_discount_amt}
  end;
> val q32 = fn : unit -> {`excess discount amount`:decimal option}
val r32 = q32 ();
> val r32 = {`excess discount amount`=NONE}
>   : {`excess discount amount`:decimal option}

(* --- q33 -------------------------------------------------------- *)
(*
WITH ss AS (
  SELECT
    i_manufact_id,
    sum(ss_ext_sales_price) total_sales
  FROM
    store_sales, date_dim, customer_address, item
  WHERE
    i_manufact_id IN (SELECT i_manufact_id
    FROM item
    WHERE i_category IN ('Electronics'))
      AND ss_item_sk = i_item_sk
      AND ss_sold_date_sk = d_date_sk
      AND d_year = 1998
      AND d_moy = 5
      AND ss_addr_sk = ca_address_sk
      AND ca_gmt_offset = -5
  GROUP BY i_manufact_id), cs AS
(SELECT
    i_manufact_id,
    sum(cs_ext_sales_price) total_sales
  FROM catalog_sales, date_dim, customer_address, item
  WHERE
    i_manufact_id IN (
      SELECT i_manufact_id
      FROM item
      WHERE
        i_category IN ('Electronics'))
      AND cs_item_sk = i_item_sk
      AND cs_sold_date_sk = d_date_sk
      AND d_year = 1998
      AND d_moy = 5
      AND cs_bill_addr_sk = ca_address_sk
      AND ca_gmt_offset = -5
  GROUP BY i_manufact_id),
    ws AS (
    SELECT
      i_manufact_id,
      sum(ws_ext_sales_price) total_sales
    FROM
      web_sales, date_dim, customer_address, item
    WHERE
      i_manufact_id IN (SELECT i_manufact_id
      FROM item
      WHERE i_category IN ('Electronics'))
        AND ws_item_sk = i_item_sk
        AND ws_sold_date_sk = d_date_sk
        AND d_year = 1998
        AND d_moy = 5
        AND ws_bill_addr_sk = ca_address_sk
        AND ca_gmt_offset = -5
    GROUP BY i_manufact_id)
SELECT
  i_manufact_id,
  sum(total_sales) total_sales
FROM (SELECT *
      FROM ss
      UNION ALL
      SELECT *
      FROM cs
      UNION ALL
      SELECT *
      FROM ws) tmp1
GROUP BY i_manufact_id
ORDER BY total_sales
LIMIT 100
*)
fun q33 () =
  let
    val keys =
      from i in tpcds.item
        where i.i_category elem [SOME "Electronics"]
        yield i.i_manufact_id
  in
    from tmp1 in (
        from ss in tpcds.store_sales,
            d in tpcds.date_dim,
            ca in tpcds.customer_address,
            i in tpcds.item
          where i.i_manufact_id <> NONE
            andalso i.i_manufact_id elem keys
            andalso ss.ss_item_sk = i.i_item_sk
            andalso ss.ss_sold_date_sk = SOME d.d_date_sk
            andalso d.d_year = SOME 1998
            andalso d.d_moy = SOME 5
            andalso ss.ss_addr_sk = SOME ca.ca_address_sk
            andalso ca.ca_gmt_offset = SOME (Decimal.fromInt ~5)
          group i.i_manufact_id
            compute {total_sales = sumSome over ss.ss_ext_sales_price})
      union
        (from cs in tpcds.catalog_sales,
            d in tpcds.date_dim,
            ca in tpcds.customer_address,
            i in tpcds.item
          where i.i_manufact_id <> NONE
            andalso i.i_manufact_id elem keys
            andalso cs.cs_item_sk = i.i_item_sk
            andalso cs.cs_sold_date_sk = SOME d.d_date_sk
            andalso d.d_year = SOME 1998
            andalso d.d_moy = SOME 5
            andalso cs.cs_bill_addr_sk = SOME ca.ca_address_sk
            andalso ca.ca_gmt_offset = SOME (Decimal.fromInt ~5)
          group i.i_manufact_id
            compute {total_sales = sumSome over cs.cs_ext_sales_price}),
        (from ws in tpcds.web_sales,
            d in tpcds.date_dim,
            ca in tpcds.customer_address,
            i in tpcds.item
          where i.i_manufact_id <> NONE
            andalso i.i_manufact_id elem keys
            andalso ws.ws_item_sk = i.i_item_sk
            andalso ws.ws_sold_date_sk = SOME d.d_date_sk
            andalso d.d_year = SOME 1998
            andalso d.d_moy = SOME 5
            andalso ws.ws_bill_addr_sk = SOME ca.ca_address_sk
            andalso ca.ca_gmt_offset = SOME (Decimal.fromInt ~5)
          group i.i_manufact_id
            compute {total_sales = sumSome over ws.ws_ext_sales_price})
      group tmp1.i_manufact_id
        compute {total_sales = sumSome over tmp1.total_sales}
      order total_sales
      take 100
  end;
> val q33 = fn
>   : unit -> {i_manufact_id:int option, total_sales:decimal option} list
val r33 = q33 ();
