(* --- q72 -------------------------------------------------------- *)
(*
SELECT
  i_item_desc,
  w_warehouse_name,
  d1.d_week_seq,
  count(CASE WHEN p_promo_sk IS NULL
    THEN 1
        ELSE 0 END) no_promo,
  count(CASE WHEN p_promo_sk IS NOT NULL
    THEN 1
        ELSE 0 END) promo,
  count(*) total_cnt
FROM catalog_sales
  JOIN inventory ON (cs_item_sk = inv_item_sk)
  JOIN warehouse ON (w_warehouse_sk = inv_warehouse_sk)
  JOIN item ON (i_item_sk = cs_item_sk)
  JOIN customer_demographics ON (cs_bill_cdemo_sk = cd_demo_sk)
  JOIN household_demographics ON (cs_bill_hdemo_sk = hd_demo_sk)
  JOIN date_dim d1 ON (cs_sold_date_sk = d1.d_date_sk)
  JOIN date_dim d2 ON (inv_date_sk = d2.d_date_sk)
  JOIN date_dim d3 ON (cs_ship_date_sk = d3.d_date_sk)
  LEFT OUTER JOIN promotion ON (cs_promo_sk = p_promo_sk)
  LEFT OUTER JOIN catalog_returns ON (cr_item_sk = cs_item_sk AND cr_order_number = cs_order_number)
WHERE d1.d_week_seq = d2.d_week_seq
  AND inv_quantity_on_hand < cs_quantity
  AND d3.d_date > (cast(d1.d_date AS DATE) + interval 5 days)
  AND hd_buy_potential = '>10000'
  AND d1.d_year = 1999
  AND hd_buy_potential = '>10000'
  AND cd_marital_status = 'D'
  AND d1.d_year = 1999
GROUP BY i_item_desc, w_warehouse_name, d1.d_week_seq
ORDER BY total_cnt DESC, i_item_desc, w_warehouse_name, d_week_seq
LIMIT 100
*)
(* The joins are in another order than the SQL's: Morel joins in the
 * order written, and the SQL joins "catalog_sales" to "inventory",
 * on the item alone, before the dimensions that filter them. *)
fun q72 () =
  let
    (* "d + interval n days" *)
    fun plusDays (d, n) =
      Date.fromTimeUniv
        (Time.`+` (Date.toTime d, Time.fromSeconds (n * 24 * 60 * 60)))
  in
    from cs in tpcds.catalog_sales
      join cd in tpcds.customer_demographics
        on cs.cs_bill_cdemo_sk = SOME cd.cd_demo_sk
      join hd in tpcds.household_demographics
        on cs.cs_bill_hdemo_sk = SOME hd.hd_demo_sk
      join d1 in tpcds.date_dim on cs.cs_sold_date_sk = SOME d1.d_date_sk
      join i in tpcds.item on i.i_item_sk = cs.cs_item_sk
      join inv in tpcds.inventory on cs.cs_item_sk = inv.inv_item_sk
      join w in tpcds.warehouse on w.w_warehouse_sk = inv.inv_warehouse_sk
      join d2 in tpcds.date_dim on inv.inv_date_sk = d2.d_date_sk
      join d3 in tpcds.date_dim on cs.cs_ship_date_sk = SOME d3.d_date_sk
      left join p in tpcds.promotion on cs.cs_promo_sk = SOME p.p_promo_sk
      left join cr in tpcds.catalog_returns
        on cr.cr_item_sk = cs.cs_item_sk
          andalso cr.cr_order_number = cs.cs_order_number
      where d1.d_week_seq <> NONE
        andalso d1.d_week_seq = d2.d_week_seq
        andalso inv.inv_quantity_on_hand <> NONE
        andalso inv.inv_quantity_on_hand < cs.cs_quantity
        andalso (case (d3.d_date, d1.d_date) of
                    (SOME shipped, SOME sold) =>
                      Date.compare (shipped, plusDays (sold, 5)) = GREATER
                  | _ => false)
        andalso hd.hd_buy_potential = SOME ">10000"
        andalso d1.d_year = SOME 1999
        andalso hd.hd_buy_potential = SOME ">10000"
        andalso cd.cd_marital_status = SOME "D"
        andalso d1.d_year = SOME 1999
      group {i.i_item_desc, w.w_warehouse_name, d1.d_week_seq}
        compute {
          no_promo = count over (if Option.isSome p then 0 else 1),
          promo = count over (if Option.isSome p then 1 else 0),
          total_cnt = count over ()}
      order (DESC total_cnt, i_item_desc, w_warehouse_name, d_week_seq)
      take 100
  end;
> val q72 = fn
>   : unit
>      -> {d_week_seq:int option, i_item_desc:string option, no_promo:int,
>           promo:int, total_cnt:int, w_warehouse_name:string option} list
val r72 = q72 ();
