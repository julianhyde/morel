> edu packcorp #8   6004008   1999  6224.95
> edu packamalg #1  1004001   1999  6131.62
> brandbrand #10    7007010   1999   4792.9
> edu packcorp #8   6004008   2000  9502.59
> amalgexporti #1   3001001   2000  6823.96
> ...
>
> val r3 : {brand:string option, brand_id:int option, d_year:int option, sum_agg:decimal option} list

(* --- q4 --------------------------------------------------------- *)
(*
WITH year_total AS (
  SELECT
    c_customer_id customer_id,
    c_first_name customer_first_name,
    c_last_name customer_last_name,
    c_preferred_cust_flag customer_preferred_cust_flag,
    c_birth_country customer_birth_country,
    c_login customer_login,
    c_email_address customer_email_address,
    d_year dyear,
    sum(((ss_ext_list_price - ss_ext_wholesale_cost - ss_ext_discount_amt) +
      ss_ext_sales_price) / 2) year_total,
    's' sale_type
  FROM customer, store_sales, date_dim
  WHERE c_customer_sk = ss_customer_sk AND ss_sold_date_sk = d_date_sk
  GROUP BY c_customer_id,
    c_first_name,
    c_last_name,
    c_preferred_cust_flag,
    c_birth_country,
    c_login,
    c_email_address,
    d_year
  UNION ALL
  SELECT
    c_customer_id customer_id,
    c_first_name customer_first_name,
    c_last_name customer_last_name,
    c_preferred_cust_flag customer_preferred_cust_flag,
    c_birth_country customer_birth_country,
    c_login customer_login,
    c_email_address customer_email_address,
    d_year dyear,
    sum((((cs_ext_list_price - cs_ext_wholesale_cost - cs_ext_discount_amt) +
      cs_ext_sales_price) / 2)) year_total,
    'c' sale_type
  FROM customer, catalog_sales, date_dim
  WHERE c_customer_sk = cs_bill_customer_sk AND cs_sold_date_sk = d_date_sk
  GROUP BY c_customer_id,
    c_first_name,
    c_last_name,
    c_preferred_cust_flag,
    c_birth_country,
    c_login,
    c_email_address,
    d_year
  UNION ALL
  SELECT
    c_customer_id customer_id,
    c_first_name customer_first_name,
    c_last_name customer_last_name,
    c_preferred_cust_flag customer_preferred_cust_flag,
    c_birth_country customer_birth_country,
    c_login customer_login,
    c_email_address customer_email_address,
    d_year dyear,
    sum((((ws_ext_list_price - ws_ext_wholesale_cost - ws_ext_discount_amt) + ws_ext_sales_price) /
      2)) year_total,
    'w' sale_type
  FROM customer, web_sales, date_dim
  WHERE c_customer_sk = ws_bill_customer_sk AND ws_sold_date_sk = d_date_sk
  GROUP BY c_customer_id,
    c_first_name,
    c_last_name,
    c_preferred_cust_flag,
    c_birth_country,
    c_login,
    c_email_address,
    d_year)
SELECT
  t_s_secyear.customer_id,
  t_s_secyear.customer_first_name,
  t_s_secyear.customer_last_name,
  t_s_secyear.customer_preferred_cust_flag,
  t_s_secyear.customer_birth_country,
  t_s_secyear.customer_login,
  t_s_secyear.customer_email_address
FROM year_total t_s_firstyear, year_total t_s_secyear, year_total t_c_firstyear,
  year_total t_c_secyear, year_total t_w_firstyear, year_total t_w_secyear
WHERE t_s_secyear.customer_id = t_s_firstyear.customer_id
  AND t_s_firstyear.customer_id = t_c_secyear.customer_id
  AND t_s_firstyear.customer_id = t_c_firstyear.customer_id
  AND t_s_firstyear.customer_id = t_w_firstyear.customer_id
  AND t_s_firstyear.customer_id = t_w_secyear.customer_id
  AND t_s_firstyear.sale_type = 's'
  AND t_c_firstyear.sale_type = 'c'
  AND t_w_firstyear.sale_type = 'w'
  AND t_s_secyear.sale_type = 's'
  AND t_c_secyear.sale_type = 'c'
  AND t_w_secyear.sale_type = 'w'
  AND t_s_firstyear.dyear = 2001
  AND t_s_secyear.dyear = 2001 + 1
  AND t_c_firstyear.dyear = 2001
  AND t_c_secyear.dyear = 2001 + 1
  AND t_w_firstyear.dyear = 2001
  AND t_w_secyear.dyear = 2001 + 1
  AND t_s_firstyear.year_total > 0
  AND t_c_firstyear.year_total > 0
  AND t_w_firstyear.year_total > 0
  AND CASE WHEN t_c_firstyear.year_total > 0
  THEN t_c_secyear.year_total / t_c_firstyear.year_total
      ELSE NULL END
  > CASE WHEN t_s_firstyear.year_total > 0
  THEN t_s_secyear.year_total / t_s_firstyear.year_total
    ELSE NULL END
  AND CASE WHEN t_c_firstyear.year_total > 0
  THEN t_c_secyear.year_total / t_c_firstyear.year_total
      ELSE NULL END
  > CASE WHEN t_w_firstyear.year_total > 0
  THEN t_w_secyear.year_total / t_w_firstyear.year_total
    ELSE NULL END
ORDER BY
  t_s_secyear.customer_id,
  t_s_secyear.customer_first_name,
  t_s_secyear.customer_last_name,
  t_s_secyear.customer_preferred_cust_flag,
  t_s_secyear.customer_birth_country,
  t_s_secyear.customer_login,
  t_s_secyear.customer_email_address
LIMIT 100
*)
fun q4 () =
  let
    val year_total =
      (from c in tpcds.customer,
          ss in tpcds.store_sales,
          d in tpcds.date_dim
        where ss.ss_customer_sk = SOME c.c_customer_sk
          andalso ss.ss_sold_date_sk = SOME d.d_date_sk
        group {customer_id = c.c_customer_id,
            customer_first_name = c.c_first_name,
            customer_last_name = c.c_last_name,
            customer_preferred_cust_flag = c.c_preferred_cust_flag,
            customer_birth_country = c.c_birth_country,
            customer_login = c.c_login,
            customer_email_address = c.c_email_address, dyear = d.d_year}
          compute {year_total = sum over
            (case (ss.ss_ext_list_price, ss.ss_ext_wholesale_cost,
                ss.ss_ext_discount_amt, ss.ss_ext_sales_price) of
                (SOME lp, SOME wc, SOME da, SOME sp) =>
                  SOME ((lp - wc - da + sp) / Decimal.fromInt 2)
              | _ => NONE)}
        yield {customer_id, customer_first_name, customer_last_name,
          customer_preferred_cust_flag, customer_birth_country,
          customer_login, customer_email_address, dyear, year_total,
          sale_type = "s"})
      @
      (from c in tpcds.customer,
          cs in tpcds.catalog_sales,
          d in tpcds.date_dim
        where cs.cs_bill_customer_sk = SOME c.c_customer_sk
          andalso cs.cs_sold_date_sk = SOME d.d_date_sk
        group {customer_id = c.c_customer_id,
            customer_first_name = c.c_first_name,
            customer_last_name = c.c_last_name,
            customer_preferred_cust_flag = c.c_preferred_cust_flag,
            customer_birth_country = c.c_birth_country,
            customer_login = c.c_login,
            customer_email_address = c.c_email_address, dyear = d.d_year}
          compute {year_total = sum over
            (case (cs.cs_ext_list_price, cs.cs_ext_wholesale_cost,
                cs.cs_ext_discount_amt, cs.cs_ext_sales_price) of
                (SOME lp, SOME wc, SOME da, SOME sp) =>
                  SOME ((lp - wc - da + sp) / Decimal.fromInt 2)
              | _ => NONE)}
        yield {customer_id, customer_first_name, customer_last_name,
          customer_preferred_cust_flag, customer_birth_country,
          customer_login, customer_email_address, dyear, year_total,
          sale_type = "c"})
      @
      (from c in tpcds.customer,
          ws in tpcds.web_sales,
          d in tpcds.date_dim
        where ws.ws_bill_customer_sk = SOME c.c_customer_sk
          andalso ws.ws_sold_date_sk = SOME d.d_date_sk
        group {customer_id = c.c_customer_id,
            customer_first_name = c.c_first_name,
            customer_last_name = c.c_last_name,
            customer_preferred_cust_flag = c.c_preferred_cust_flag,
            customer_birth_country = c.c_birth_country,
            customer_login = c.c_login,
            customer_email_address = c.c_email_address, dyear = d.d_year}
          compute {year_total = sum over
            (case (ws.ws_ext_list_price, ws.ws_ext_wholesale_cost,
                ws.ws_ext_discount_amt, ws.ws_ext_sales_price) of
                (SOME lp, SOME wc, SOME da, SOME sp) =>
                  SOME ((lp - wc - da + sp) / Decimal.fromInt 2)
              | _ => NONE)}
        yield {customer_id, customer_first_name, customer_last_name,
          customer_preferred_cust_flag, customer_birth_country,
          customer_login, customer_email_address, dyear, year_total,
          sale_type = "w"})
    val zero = SOME (Decimal.fromInt 0)
    (* "CASE WHEN b > 0 THEN a / b ELSE NULL END" *)
    fun ratio (a, b) =
      case (a, b) of
          (SOME x, SOME y) =>
            if y > Decimal.fromInt 0 then SOME (x / y) else NONE
        | _ => NONE
  in
    from t_s_firstyear in year_total,
        t_s_secyear in year_total,
        t_c_firstyear in year_total,
        t_c_secyear in year_total,
        t_w_firstyear in year_total,
        t_w_secyear in year_total
      where t_s_secyear.customer_id = t_s_firstyear.customer_id
        andalso t_s_firstyear.customer_id = t_c_secyear.customer_id
        andalso t_s_firstyear.customer_id = t_c_firstyear.customer_id
        andalso t_s_firstyear.customer_id = t_w_firstyear.customer_id
        andalso t_s_firstyear.customer_id = t_w_secyear.customer_id
        andalso t_s_firstyear.sale_type = "s"
        andalso t_c_firstyear.sale_type = "c"
        andalso t_w_firstyear.sale_type = "w"
        andalso t_s_secyear.sale_type = "s"
        andalso t_c_secyear.sale_type = "c"
        andalso t_w_secyear.sale_type = "w"
        andalso t_s_firstyear.dyear = SOME 2001
        andalso t_s_secyear.dyear = SOME (2001 + 1)
        andalso t_c_firstyear.dyear = SOME 2001
        andalso t_c_secyear.dyear = SOME (2001 + 1)
        andalso t_w_firstyear.dyear = SOME 2001
        andalso t_w_secyear.dyear = SOME (2001 + 1)
        andalso t_s_firstyear.year_total > zero
        andalso t_c_firstyear.year_total > zero
        andalso t_w_firstyear.year_total > zero
        andalso ratio (t_s_secyear.year_total, t_s_firstyear.year_total)
          <> NONE
        andalso ratio (t_c_secyear.year_total, t_c_firstyear.year_total)
          > ratio (t_s_secyear.year_total, t_s_firstyear.year_total)
        andalso ratio (t_w_secyear.year_total, t_w_firstyear.year_total)
          <> NONE
        andalso ratio (t_c_secyear.year_total, t_c_firstyear.year_total)
          > ratio (t_w_secyear.year_total, t_w_firstyear.year_total)
      yield {t_s_secyear.customer_id, t_s_secyear.customer_first_name,
        t_s_secyear.customer_last_name,
        t_s_secyear.customer_preferred_cust_flag,
        t_s_secyear.customer_birth_country, t_s_secyear.customer_login,
        t_s_secyear.customer_email_address}
      order (customer_id, customer_first_name, customer_last_name,
        customer_preferred_cust_flag, customer_birth_country,
        customer_login, customer_email_address)
      take 100
  end;
> val q4 = fn
