          jan_net, feb_net, mar_net, apr_net, may_net, jun_net, jul_net,
          aug_net, sep_net, oct_net, nov_net, dec_net})
  in
    from x in x
      group {x.w_warehouse_name, x.w_warehouse_sq_ft, x.w_city, x.w_county,
          x.w_state, x.w_country, x.ship_carriers, x.year}
        compute {
        jan_sales = sumSome over x.jan_sales,
