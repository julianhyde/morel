(* --- q5 --------------------------------------------------------- *)
(*
WITH ssr AS
( SELECT
    s_store_id,
    sum(sales_price) AS sales,
    sum(profit) AS profit,
    sum(return_amt) AS RETURNS,
    sum(net_loss) AS profit_loss
  FROM
    (SELECT
       ss_store_sk AS store_sk,
       ss_sold_date_sk AS date_sk,
       ss_ext_sales_price AS sales_price,
       ss_net_profit AS profit,
       cast(0 AS DECIMAL(7, 2)) AS return_amt,
       cast(0 AS DECIMAL(7, 2)) AS net_loss
     FROM store_sales
     UNION ALL
     SELECT
       sr_store_sk AS store_sk,
       sr_returned_date_sk AS date_sk,
       cast(0 AS DECIMAL(7, 2)) AS sales_price,
       cast(0 AS DECIMAL(7, 2)) AS profit,
       sr_return_amt AS return_amt,
       sr_net_loss AS net_loss
     FROM store_returns)
    salesreturns, date_dim, store
  WHERE date_sk = d_date_sk
    AND d_date BETWEEN cast('2000-08-23' AS DATE)
  AND ((cast('2000-08-23' AS DATE) + INTERVAL 14 days))
    AND store_sk = s_store_sk
  GROUP BY s_store_id),
    csr AS
  ( SELECT
    cp_catalog_page_id,
    sum(sales_price) AS sales,
    sum(profit) AS profit,
    sum(return_amt) AS RETURNS,
    sum(net_loss) AS profit_loss
  FROM
    (SELECT
       cs_catalog_page_sk AS page_sk,
       cs_sold_date_sk AS date_sk,
       cs_ext_sales_price AS sales_price,
       cs_net_profit AS profit,
       cast(0 AS DECIMAL(7, 2)) AS return_amt,
       cast(0 AS DECIMAL(7, 2)) AS net_loss
     FROM catalog_sales
     UNION ALL
     SELECT
       cr_catalog_page_sk AS page_sk,
       cr_returned_date_sk AS date_sk,
       cast(0 AS DECIMAL(7, 2)) AS sales_price,
       cast(0 AS DECIMAL(7, 2)) AS profit,
       cr_return_amount AS return_amt,
       cr_net_loss AS net_loss
     FROM catalog_returns
    ) salesreturns, date_dim, catalog_page
  WHERE date_sk = d_date_sk
    AND d_date BETWEEN cast('2000-08-23' AS DATE)
  AND ((cast('2000-08-23' AS DATE) + INTERVAL 14 days))
    AND page_sk = cp_catalog_page_sk
  GROUP BY cp_catalog_page_id)
  ,
    wsr AS
  ( SELECT
    web_site_id,
    sum(sales_price) AS sales,
    sum(profit) AS profit,
    sum(return_amt) AS RETURNS,
    sum(net_loss) AS profit_loss
  FROM
    (SELECT
       ws_web_site_sk AS wsr_web_site_sk,
       ws_sold_date_sk AS date_sk,
       ws_ext_sales_price AS sales_price,
       ws_net_profit AS profit,
       cast(0 AS DECIMAL(7, 2)) AS return_amt,
       cast(0 AS DECIMAL(7, 2)) AS net_loss
     FROM web_sales
     UNION ALL
     SELECT
       ws_web_site_sk AS wsr_web_site_sk,
       wr_returned_date_sk AS date_sk,
       cast(0 AS DECIMAL(7, 2)) AS sales_price,
       cast(0 AS DECIMAL(7, 2)) AS profit,
       wr_return_amt AS return_amt,
       wr_net_loss AS net_loss
     FROM web_returns
       LEFT OUTER JOIN web_sales ON
                                   (wr_item_sk = ws_item_sk
                                     AND wr_order_number = ws_order_number)
    ) salesreturns, date_dim, web_site
  WHERE date_sk = d_date_sk
    AND d_date BETWEEN cast('2000-08-23' AS DATE)
  AND ((cast('2000-08-23' AS DATE) + INTERVAL 14 days))
    AND wsr_web_site_sk = web_site_sk
  GROUP BY web_site_id)
SELECT
  channel,
  id,
  sum(sales) AS sales,
  sum(returns) AS returns,
  sum(profit) AS profit
FROM
  (SELECT
     'store channel' AS channel,
     concat('store', s_store_id) AS id,
     sales,
     returns,
     (profit - profit_loss) AS profit
   FROM ssr
   UNION ALL
   SELECT
     'catalog channel' AS channel,
     concat('catalog_page', cp_catalog_page_id) AS id,
     sales,
     returns,
     (profit - profit_loss) AS profit
   FROM csr
   UNION ALL
   SELECT
     'web channel' AS channel,
     concat('web_site', web_site_id) AS id,
     sales,
     returns,
     (profit - profit_loss) AS profit
   FROM wsr
  ) x
GROUP BY ROLLUP (channel, id)
ORDER BY channel, id
LIMIT 100
*)
(* "GROUP BY ROLLUP", as in q22. Each channel's sales and returns are
 * a union, a sale having no return amount and a return no sales. *)
fun q5 () =
  let
    fun day (year, month, day) =
      Date.date {year, month, day, hour = 0, minute = 0, second = 0,
        offset = SOME Time.zeroTime}
    val zero = Decimal.fromInt 0
    (* "a - b" and "a - coalesce(b, 0)", where "a" and "b" may be NONE *)
    fun minus (a : decimal option, b) =
      case (a, b) of
          (SOME a, SOME b) => SOME (a - b)
        | _ => NONE
    fun minus0 (a, b) = Option.map (fn a => a - getOpt (b, zero)) a
    fun inRange d =
      d >= SOME (day (2000, Aug, 23))
      andalso d <= SOME (day (2000, Aug, 23 + 14))
    val ssr =
      from x in (from ss in tpcds.store_sales
            yield {key = ss.ss_store_sk, date_sk = ss.ss_sold_date_sk,
              sales_price = ss.ss_ext_sales_price,
              profit = ss.ss_net_profit, return_amt = SOME zero,
              net_loss = SOME zero})
          @ (from sr in tpcds.store_returns
            yield {key = sr.sr_store_sk, date_sk = sr.sr_returned_date_sk,
              sales_price = SOME zero, profit = SOME zero,
              return_amt = sr.sr_return_amt, net_loss = sr.sr_net_loss}),
          d in tpcds.date_dim,
          s in tpcds.store
        where x.date_sk = SOME d.d_date_sk
          andalso inRange d.d_date
          andalso x.key = SOME s.s_store_sk
        group {id = s.s_store_id}
          compute {sales = sumSome over x.sales_price,
            profit = sumSome over x.profit,
            returns = sumSome over x.return_amt,
            profit_loss = sumSome over x.net_loss}
    val csr =
      from x in (from cs in tpcds.catalog_sales
            yield {key = cs.cs_catalog_page_sk, date_sk = cs.cs_sold_date_sk,
              sales_price = cs.cs_ext_sales_price,
              profit = cs.cs_net_profit, return_amt = SOME zero,
              net_loss = SOME zero})
          @ (from cr in tpcds.catalog_returns
            yield {key = cr.cr_catalog_page_sk, date_sk = cr.cr_returned_date_sk,
              sales_price = SOME zero, profit = SOME zero,
              return_amt = cr.cr_return_amount, net_loss = cr.cr_net_loss}),
          d in tpcds.date_dim,
          cp in tpcds.catalog_page
        where x.date_sk = SOME d.d_date_sk
          andalso inRange d.d_date
          andalso x.key = SOME cp.cp_catalog_page_sk
        group {id = cp.cp_catalog_page_id}
          compute {sales = sumSome over x.sales_price,
            profit = sumSome over x.profit,
            returns = sumSome over x.return_amt,
            profit_loss = sumSome over x.net_loss}
    val wsr =
      from x in (from ws in tpcds.web_sales
            yield {key = ws.ws_web_site_sk, date_sk = ws.ws_sold_date_sk,
              sales_price = ws.ws_ext_sales_price,
              profit = ws.ws_net_profit, return_amt = SOME zero,
              net_loss = SOME zero})
          @ (from wr in tpcds.web_returns
              left join ws in tpcds.web_sales
                on wr.wr_item_sk = ws.ws_item_sk
                  andalso wr.wr_order_number = ws.ws_order_number
            yield {key = Option.`join` ws?.ws_web_site_sk, date_sk = wr.wr_returned_date_sk,
              sales_price = SOME zero, profit = SOME zero,
              return_amt = wr.wr_return_amt, net_loss = wr.wr_net_loss}),
          d in tpcds.date_dim,
          web in tpcds.web_site
        where x.date_sk = SOME d.d_date_sk
          andalso inRange d.d_date
          andalso x.key = SOME web.web_site_sk
        group {id = web.web_site_id}
          compute {sales = sumSome over x.sales_price,
            profit = sumSome over x.profit,
            returns = sumSome over x.return_amt,
            profit_loss = sumSome over x.net_loss}
    val x =
      (from r in ssr
        yield {channel = SOME "store channel", id = SOME ("store" ^ r.id),
          r.sales, r.returns, profit = minus (r.profit, r.profit_loss)})
      @
      (from r in csr
        yield {channel = SOME "catalog channel",
          id = SOME ("catalog_page" ^ r.id), r.sales, r.returns,
          profit = minus (r.profit, r.profit_loss)})
      @
      (from r in wsr
        yield {channel = SOME "web channel", id = SOME ("web_site" ^ r.id),
          r.sales, r.returns, profit = minus (r.profit, r.profit_loss)})
  in
    from r in (from b in x
          group {b.channel, b.id}
            compute {sales = sumSome over b.sales,
                returns = sumSome over b.returns,
                profit = sumSome over b.profit}
          yield {channel, id, sales, returns, profit})
        union
          (from b in x
              group {b.channel}
                compute {sales = sumSome over b.sales,
                    returns = sumSome over b.returns,
                    profit = sumSome over b.profit}
              yield {channel, id = NONE, sales, returns, profit}),
          (from b in x
              group {}
                compute {sales = sumSome over b.sales,
                    returns = sumSome over b.returns,
                    profit = sumSome over b.profit}
              yield {channel = NONE, id = NONE, sales, returns, profit})
      order (r.channel, r.id)
      take 100
  end;
> val q5 = fn
>   : unit
>      -> {channel:string option, id:string option, profit:decimal option,
>           returns:decimal option, sales:decimal option} list
val r5 = q5 ();
