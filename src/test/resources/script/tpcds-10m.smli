(* --- q47 -------------------------------------------------------- *)
(*
WITH v1 AS (
  SELECT
    i_category,
    i_brand,
    s_store_name,
    s_company_name,
    d_year,
    d_moy,
    sum(ss_sales_price) sum_sales,
    avg(sum(ss_sales_price))
    OVER
    (PARTITION BY i_category, i_brand,
      s_store_name, s_company_name, d_year)
    avg_monthly_sales,
    rank()
    OVER
    (PARTITION BY i_category, i_brand,
      s_store_name, s_company_name
      ORDER BY d_year, d_moy) rn
  FROM item, store_sales, date_dim, store
  WHERE ss_item_sk = i_item_sk AND
    ss_sold_date_sk = d_date_sk AND
    ss_store_sk = s_store_sk AND
    (
      d_year = 1999 OR
        (d_year = 1999 - 1 AND d_moy = 12) OR
        (d_year = 1999 + 1 AND d_moy = 1)
    )
  GROUP BY i_category, i_brand,
    s_store_name, s_company_name,
    d_year, d_moy),
    v2 AS (
    SELECT
      v1.i_category,
      v1.i_brand,
      v1.s_store_name,
      v1.s_company_name,
      v1.d_year,
      v1.d_moy,
      v1.avg_monthly_sales,
      v1.sum_sales,
      v1_lag.sum_sales psum,
      v1_lead.sum_sales nsum
    FROM v1, v1 v1_lag, v1 v1_lead
    WHERE v1.i_category = v1_lag.i_category AND
      v1.i_category = v1_lead.i_category AND
      v1.i_brand = v1_lag.i_brand AND
      v1.i_brand = v1_lead.i_brand AND
      v1.s_store_name = v1_lag.s_store_name AND
      v1.s_store_name = v1_lead.s_store_name AND
      v1.s_company_name = v1_lag.s_company_name AND
      v1.s_company_name = v1_lead.s_company_name AND
      v1.rn = v1_lag.rn + 1 AND
      v1.rn = v1_lead.rn - 1)
SELECT *
FROM v2
WHERE d_year = 1999 AND
  avg_monthly_sales > 0 AND
  CASE WHEN avg_monthly_sales > 0
    THEN abs(sum_sales - avg_monthly_sales) / avg_monthly_sales
  ELSE NULL END > 0.1
ORDER BY sum_sales - avg_monthly_sales, 3
LIMIT 100
*)
(* "avg(sum(x)) OVER (PARTITION BY p)" is the average of the groups' sums
 * for each "p", joined to the groups, as in q53. "rank() OVER (PARTITION
 * BY p ORDER BY d_year, d_moy)" is a group's position in its partition,
 * because the (year, month) of each group in a partition is distinct:
 * the groups are sorted by partition and month once, and a group's rank
 * is its position less its partition's first position, plus one. The lag
 * and lead are joins, whose equalities (unlike a partition's) drop a row
 * whose key is NONE. *)
fun q47 () =
  let
    val base =
      from i in tpcds.item,
          ss in tpcds.store_sales,
          d in tpcds.date_dim,
          s in tpcds.store
        where ss.ss_item_sk = i.i_item_sk
          andalso ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso (d.d_year = SOME 1999
            orelse d.d_year = SOME (1999 - 1) andalso d.d_moy = SOME 12
            orelse d.d_year = SOME (1999 + 1) andalso d.d_moy = SOME 1)
        yield {i.i_category, i.i_brand, s.s_store_name, s.s_company_name,
          d.d_year, d.d_moy, sales_price = ss.ss_sales_price}
    val groups =
      from b in base
        group {b.i_category, b.i_brand, b.s_store_name, b.s_company_name,
            b.d_year, b.d_moy}
          compute {sum_sales = sumSome over b.sales_price}
    val averages =
      from g in groups
        group {g.i_category, g.i_brand, g.s_store_name, g.s_company_name,
            g.d_year}
          compute {avg_monthly_sales = avgSome over g.sum_sales}
    val sorted =
      from g in groups
        order (g.i_category, g.i_brand, g.s_store_name, g.s_company_name,
          g.d_year, g.d_moy)
        yield {g, pos = ordinal}
    val firsts =
      from x in sorted
        group {x.g.i_category, x.g.i_brand, x.g.s_store_name,
            x.g.s_company_name}
          compute {first = min over x.pos}
    val v1s =
      from x in sorted,
          a in averages,
          f in firsts
        where a.i_category = x.g.i_category
          andalso a.i_brand = x.g.i_brand
          andalso a.s_store_name = x.g.s_store_name
          andalso a.s_company_name = x.g.s_company_name
          andalso a.d_year = x.g.d_year
          andalso f.i_category = x.g.i_category
          andalso f.i_brand = x.g.i_brand
          andalso f.s_store_name = x.g.s_store_name
          andalso f.s_company_name = x.g.s_company_name
        yield {x.g, a.avg_monthly_sales, rn = x.pos - f.first + 1}
        yield {g.i_category, g.i_brand, g.s_store_name, g.s_company_name,
          g.d_year, g.d_moy, sum_sales = g.sum_sales, avg_monthly_sales, rn}
  in
    from v1 in v1s,
        v1_lag in v1s,
        v1_lead in v1s
      where v1.i_category <> NONE
        andalso v1.i_category = v1_lag.i_category
        andalso v1.i_brand <> NONE
        andalso v1.i_brand = v1_lag.i_brand
        andalso v1.s_store_name <> NONE
        andalso v1.s_store_name = v1_lag.s_store_name
        andalso v1.s_company_name <> NONE
        andalso v1.s_company_name = v1_lag.s_company_name
        andalso v1.i_category = v1_lead.i_category
        andalso v1.i_brand = v1_lead.i_brand
        andalso v1.s_store_name = v1_lead.s_store_name
        andalso v1.s_company_name = v1_lead.s_company_name
        andalso v1.rn = v1_lag.rn + 1
        andalso v1.rn = v1_lead.rn - 1
        andalso v1.d_year = SOME 1999
        andalso v1.avg_monthly_sales > SOME (Decimal.fromInt 0)
        andalso (case (v1.sum_sales, v1.avg_monthly_sales) of
                    (SOME s, SOME a) =>
                      a > Decimal.fromInt 0
                      andalso Decimal.abs (s - a) / a > decimal "0.1"
                  | _ => false)
      order ((case (v1.sum_sales, v1.avg_monthly_sales) of
                 (SOME s, SOME a) => SOME (s - a)
               | _ => NONE),
        v1.s_store_name)
      yield {v1.i_category, v1.i_brand, v1.s_store_name, v1.s_company_name,
        v1.d_year, v1.d_moy, v1.avg_monthly_sales, v1.sum_sales,
        psum = v1_lag.sum_sales, nsum = v1_lead.sum_sales}
      take 100
  end;
> val q47 = fn
>   : unit
>      -> {avg_monthly_sales:decimal option, d_moy:int option,
>           d_year:int option, i_brand:string option, i_category:string option,
>           nsum:decimal option, psum:decimal option,
>           s_company_name:string option, s_store_name:string option,
>           sum_sales:decimal option} list
val r47 = q47 ();
> avg_monthly_sales                   d_moy d_year i_brand             i_category nsum    psum   s_company_name s_store_name sum_sales
> ----------------------------------- ----- ------ ------------------- ---------- ------- ------ -------------- ------------ ---------
> 829.9283333333333333333333333333333     6   1999 edu packedu pack #1 Shoes        253.1 354.24 Unknown        able            165.07
