(* --- q54 -------------------------------------------------------- *)
(*
WITH my_customers AS (
  SELECT DISTINCT
    c_customer_sk,
    c_current_addr_sk
  FROM
    (SELECT
       cs_sold_date_sk sold_date_sk,
       cs_bill_customer_sk customer_sk,
       cs_item_sk item_sk
     FROM catalog_sales
     UNION ALL
     SELECT
       ws_sold_date_sk sold_date_sk,
       ws_bill_customer_sk customer_sk,
       ws_item_sk item_sk
     FROM web_sales
    ) cs_or_ws_sales,
    item,
    date_dim,
    customer
  WHERE sold_date_sk = d_date_sk
    AND item_sk = i_item_sk
    AND i_category = 'Women'
    AND i_class = 'maternity'
    AND c_customer_sk = cs_or_ws_sales.customer_sk
    AND d_moy = 12
    AND d_year = 1998
)
  , my_revenue AS (
  SELECT
    c_customer_sk,
    sum(ss_ext_sales_price) AS revenue
  FROM my_customers,
    store_sales,
    customer_address,
    store,
    date_dim
  WHERE c_current_addr_sk = ca_address_sk
    AND ca_county = s_county
    AND ca_state = s_state
    AND ss_sold_date_sk = d_date_sk
    AND c_customer_sk = ss_customer_sk
    AND d_month_seq BETWEEN (SELECT DISTINCT d_month_seq + 1
  FROM date_dim
  WHERE d_year = 1998 AND d_moy = 12)
  AND (SELECT DISTINCT d_month_seq + 3
  FROM date_dim
  WHERE d_year = 1998 AND d_moy = 12)
  GROUP BY c_customer_sk
)
  , segments AS
(SELECT cast((revenue / 50) AS INT) AS segment
  FROM my_revenue)
SELECT
  segment,
  count(*) AS num_customers,
  segment * 50 AS segment_base
FROM segments
GROUP BY segment
ORDER BY segment, num_customers
LIMIT 100
*)
fun q54 () =
  let
    val my_customers =
      from cs_or_ws_sales in (
          from cs in tpcds.catalog_sales
            yield {sold_date_sk = cs.cs_sold_date_sk,
              customer_sk = cs.cs_bill_customer_sk, item_sk = cs.cs_item_sk}
          union
            (from ws in tpcds.web_sales
              yield {sold_date_sk = ws.ws_sold_date_sk,
                customer_sk = ws.ws_bill_customer_sk,
                item_sk = ws.ws_item_sk})),
          i in tpcds.item,
          d in tpcds.date_dim,
          c in tpcds.customer
        where cs_or_ws_sales.sold_date_sk = SOME d.d_date_sk
          andalso cs_or_ws_sales.item_sk = i.i_item_sk
          andalso i.i_category = SOME "Women"
          andalso i.i_class = SOME "maternity"
          andalso cs_or_ws_sales.customer_sk = SOME c.c_customer_sk
          andalso d.d_moy = SOME 12
          andalso d.d_year = SOME 1998
        yield {c.c_customer_sk, c.c_current_addr_sk}
        distinct
    val month_seq =
      from d in tpcds.date_dim
        where d.d_year = SOME 1998 andalso d.d_moy = SOME 12
        yield d.d_month_seq
        distinct
    val (lo, hi) =
      case month_seq of
          [SOME m] => (SOME (m + 1), SOME (m + 3))
        | _ => raise Fail "expected one month"
    val my_revenue =
      from mc in my_customers,
          ss in tpcds.store_sales,
          ca in tpcds.customer_address,
          s in tpcds.store,
          d in tpcds.date_dim
        where mc.c_current_addr_sk = SOME ca.ca_address_sk
          andalso ca.ca_county <> NONE
          andalso ca.ca_county = s.s_county
          andalso ca.ca_state <> NONE
          andalso ca.ca_state = s.s_state
          andalso ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_customer_sk = SOME mc.c_customer_sk
          andalso d.d_month_seq >= lo
          andalso d.d_month_seq <= hi
        group mc.c_customer_sk
          compute {revenue = sum over ss.ss_ext_sales_price}
    val segments =
      from r in my_revenue
        yield {segment =
          Option.map (fn v => Decimal.trunc (v / Decimal.fromInt 50))
            r.revenue}
  in
    from s in segments
      group s.segment compute {num_customers = count over ()}
      yield {segment, num_customers,
        segment_base = Option.map (fn g => g * 50) segment}
      order (segment, num_customers)
      take 100
  end;
> val q54 = fn
>   : unit
>      -> {num_customers:int, segment:int option, segment_base:int option} list
val r54 = q54 ();
> num_customers segment segment_base
> ------------- ------- ------------
>
> val r54 : {num_customers:int, segment:int option, segment_base:int option} list

(* --- q55 -------------------------------------------------------- *)
(*
SELECT
  i_brand_id brand_id,
  i_brand brand,
  sum(ss_ext_sales_price) ext_price
FROM date_dim, store_sales, item
WHERE d_date_sk = ss_sold_date_sk
  AND ss_item_sk = i_item_sk
  AND i_manager_id = 28
  AND d_moy = 11
