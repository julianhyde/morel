> val r88 : {h10_30_to_11:int, h10_to_10_30:int, h11_30_to_12:int, h11_to_11_30:int, h12_to_12_30:int, h8_30_to_9:int, h9_30_to_10:int, h9_to_9_30:int} list

(* --- q89 -------------------------------------------------------- *)
(*
SELECT *
FROM (
       SELECT
         i_category,
         i_class,
         i_brand,
         s_store_name,
         s_company_name,
         d_moy,
         sum(ss_sales_price) sum_sales,
         avg(sum(ss_sales_price))
         OVER
         (PARTITION BY i_category, i_brand, s_store_name, s_company_name)
         avg_monthly_sales
       FROM item, store_sales, date_dim, store
       WHERE ss_item_sk = i_item_sk AND
         ss_sold_date_sk = d_date_sk AND
         ss_store_sk = s_store_sk AND
         d_year IN (1999) AND
         ((i_category IN ('Books', 'Electronics', 'Sports') AND
           i_class IN ('computers', 'stereo', 'football'))
           OR (i_category IN ('Men', 'Jewelry', 'Women') AND
           i_class IN ('shirts', 'birdal', 'dresses')))
       GROUP BY i_category, i_class, i_brand,
         s_store_name, s_company_name, d_moy) tmp1
WHERE CASE WHEN (avg_monthly_sales <> 0)
  THEN (abs(sum_sales - avg_monthly_sales) / avg_monthly_sales)
      ELSE NULL END > 0.1
ORDER BY sum_sales - avg_monthly_sales, s_store_name
LIMIT 100
*)
(* "avg(sum(x)) OVER (PARTITION BY k)" is the average of the groups'
 * sums for each "k", joined to the groups. A partition is not a join:
 * its NONE key is one partition, as NONE = NONE. "d_month_seq IN (1200,
 * ..., 1200 + 11)" is a range. *)
fun q89 () =
  let
    val base =
      from i in tpcds.item,
          ss in tpcds.store_sales,
          d in tpcds.date_dim,
          s in tpcds.store
        where ss.ss_item_sk = i.i_item_sk
          andalso ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso d.d_year elem [SOME 1999]
          andalso (i.i_category
                elem [SOME "Books", SOME "Electronics", SOME "Sports"]
              andalso i.i_class
                elem [SOME "computers", SOME "stereo", SOME "football"]
            orelse i.i_category elem [SOME "Men", SOME "Jewelry", SOME "Women"]
              andalso i.i_class
                elem [SOME "shirts", SOME "birdal", SOME "dresses"])
        yield {i.i_category, i.i_class, i.i_brand, s.s_store_name,
          s.s_company_name, d.d_moy, ss.ss_sales_price}
    val groups =
      from b in base
        group {b.i_category, b.i_class, b.i_brand, b.s_store_name,
            b.s_company_name, b.d_moy}
          compute {sum_sales = sumSome over b.ss_sales_price}
    val averages =
      from r in groups
        group {r.i_category, r.i_brand, r.s_store_name, r.s_company_name}
          compute {avg_monthly_sales = avgSome over r.sum_sales}
  in
    from r in groups,
        a in averages
      where a.i_category = r.i_category
        andalso a.i_brand = r.i_brand
        andalso a.s_store_name = r.s_store_name
        andalso a.s_company_name = r.s_company_name
        andalso (case (r.sum_sales, a.avg_monthly_sales) of
                    (SOME s, SOME a) => a <> Decimal.fromInt 0
                      andalso Decimal.abs (s - a) / a > decimal "0.1"
                  | _ => false)
      order ((case (r.sum_sales, a.avg_monthly_sales) of
                  (SOME s, SOME a) => SOME (s - a)
                | _ => NONE),
        r.s_store_name)
      yield {r.i_category, r.i_class, r.i_brand, r.s_store_name,
        r.s_company_name, r.d_moy, r.sum_sales, a.avg_monthly_sales}
      take 100
  end;
> val q89 = fn
>   : unit
>      -> {avg_monthly_sales:decimal option, d_moy:int option,
>           i_brand:string option, i_category:string option,
>           i_class:string option, s_company_name:string option,
>           s_store_name:string option, sum_sales:decimal option} list
val r89 = q89 ();
> avg_monthly_sales                   d_moy i_brand           i_category i_class s_company_name s_store_name sum_sales
