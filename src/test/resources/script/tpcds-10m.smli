(* --- q98 -------------------------------------------------------- *)
(*
SELECT
  i_item_desc,
  i_category,
  i_class,
  i_current_price,
  sum(ss_ext_sales_price) AS itemrevenue,
  sum(ss_ext_sales_price) * 100 / sum(sum(ss_ext_sales_price))
  OVER
  (PARTITION BY i_class) AS revenueratio
FROM
  store_sales, item, date_dim
WHERE
  ss_item_sk = i_item_sk
    AND i_category IN ('Sports', 'Books', 'Home')
    AND ss_sold_date_sk = d_date_sk
    AND d_date BETWEEN cast('1999-02-22' AS DATE)
  AND (cast('1999-02-22' AS DATE) + INTERVAL 30 days)
GROUP BY
  i_item_id, i_item_desc, i_category, i_class, i_current_price
ORDER BY
  i_category, i_class, i_item_id, i_item_desc, revenueratio
*)
(* "SUM(...) OVER (PARTITION BY i_class)" is each class's total, joined
 * to the class's rows. A partition is not a join: its NONE class is one
 * partition, as NONE = NONE. *)
fun q98 () =
  let
    fun day (year, month, day) =
      Date.date {year, month, day, hour = 0, minute = 0, second = 0,
        offset = SOME Time.zeroTime}
    val items =
      from ss in tpcds.store_sales,
          i in tpcds.item,
          d in tpcds.date_dim
        where ss.ss_item_sk = i.i_item_sk
          andalso i.i_category elem [SOME "Sports", SOME "Books", SOME "Home"]
          andalso ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso d.d_date >= SOME (day (1999, Feb, 22))
          andalso d.d_date <= SOME (day (1999, Feb, 22 + 30))
        group {i.i_item_id, i.i_item_desc, i.i_category, i.i_class,
            i.i_current_price}
          compute {itemrevenue = sumSome over ss.ss_ext_sales_price}
    val classes =
      from r in items
        group r.i_class compute {total = sumSome over r.itemrevenue}
  in
    from r in items,
        c in classes
      where c.i_class = r.i_class
      yield {r.i_item_id, r.i_item_desc, r.i_category, r.i_class,
        r.i_current_price, r.itemrevenue,
        revenueratio =
          case (r.itemrevenue, c.total) of
              (SOME revenue, SOME total) =>
                SOME (revenue * Decimal.fromInt 100 / total)
            | _ => NONE}
      order (i_category, i_class, i_item_id, i_item_desc, revenueratio)
      yield {i_item_desc, i_category, i_class, i_current_price, itemrevenue,
        revenueratio}
  end;
> val q98 = fn
>   : unit
>      -> {i_category:string option, i_class:string option,
>           i_current_price:decimal option, i_item_desc:string option,
>           itemrevenue:decimal option, revenueratio:decimal option} list
