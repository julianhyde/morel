(* --- q14b ------------------------------------------------------- *)
(*
WITH cross_items AS
(SELECT i_item_sk ss_item_sk
  FROM item,
    (SELECT
      iss.i_brand_id brand_id,
      iss.i_class_id class_id,
      iss.i_category_id category_id
    FROM store_sales, item iss, date_dim d1
    WHERE ss_item_sk = iss.i_item_sk
      AND ss_sold_date_sk = d1.d_date_sk
      AND d1.d_year BETWEEN 1999 AND 1999 + 2
    INTERSECT
    SELECT
      ics.i_brand_id,
      ics.i_class_id,
      ics.i_category_id
    FROM catalog_sales, item ics, date_dim d2
    WHERE cs_item_sk = ics.i_item_sk
      AND cs_sold_date_sk = d2.d_date_sk
      AND d2.d_year BETWEEN 1999 AND 1999 + 2
    INTERSECT
    SELECT
      iws.i_brand_id,
      iws.i_class_id,
      iws.i_category_id
    FROM web_sales, item iws, date_dim d3
    WHERE ws_item_sk = iws.i_item_sk
      AND ws_sold_date_sk = d3.d_date_sk
      AND d3.d_year BETWEEN 1999 AND 1999 + 2) x
  WHERE i_brand_id = brand_id
    AND i_class_id = class_id
    AND i_category_id = category_id
),
    avg_sales AS
  (SELECT avg(quantity * list_price) average_sales
  FROM (SELECT
          ss_quantity quantity,
          ss_list_price list_price
        FROM store_sales, date_dim
        WHERE ss_sold_date_sk = d_date_sk AND d_year BETWEEN 1999 AND 1999 + 2
        UNION ALL
        SELECT
          cs_quantity quantity,
          cs_list_price list_price
        FROM catalog_sales, date_dim
        WHERE cs_sold_date_sk = d_date_sk AND d_year BETWEEN 1999 AND 1999 + 2
        UNION ALL
        SELECT
          ws_quantity quantity,
          ws_list_price list_price
        FROM web_sales, date_dim
        WHERE ws_sold_date_sk = d_date_sk AND d_year BETWEEN 1999 AND 1999 + 2) x)
SELECT *
FROM
  (SELECT
    'store' channel,
    i_brand_id,
    i_class_id,
    i_category_id,
    sum(ss_quantity * ss_list_price) sales,
    count(*) number_sales
  FROM store_sales, item, date_dim
  WHERE ss_item_sk IN (SELECT ss_item_sk
  FROM cross_items)
    AND ss_item_sk = i_item_sk
    AND ss_sold_date_sk = d_date_sk
    AND d_week_seq = (SELECT d_week_seq
  FROM date_dim
  WHERE d_year = 1999 + 1 AND d_moy = 12 AND d_dom = 11)
  GROUP BY i_brand_id, i_class_id, i_category_id
  HAVING sum(ss_quantity * ss_list_price) > (SELECT average_sales
  FROM avg_sales)) this_year,
  (SELECT
    'store' channel,
    i_brand_id,
    i_class_id,
    i_category_id,
    sum(ss_quantity * ss_list_price) sales,
    count(*) number_sales
  FROM store_sales, item, date_dim
  WHERE ss_item_sk IN (SELECT ss_item_sk
  FROM cross_items)
    AND ss_item_sk = i_item_sk
    AND ss_sold_date_sk = d_date_sk
    AND d_week_seq = (SELECT d_week_seq
  FROM date_dim
  WHERE d_year = 1999 AND d_moy = 12 AND d_dom = 11)
  GROUP BY i_brand_id, i_class_id, i_category_id
  HAVING sum(ss_quantity * ss_list_price) > (SELECT average_sales
  FROM avg_sales)) last_year
WHERE this_year.i_brand_id = last_year.i_brand_id
  AND this_year.i_class_id = last_year.i_class_id
  AND this_year.i_category_id = last_year.i_category_id
ORDER BY this_year.channel, this_year.i_brand_id, this_year.i_class_id, this_year.i_category_id
LIMIT 100
*)
fun q14b () =
  let
    (* "quantity * price" *)
    fun times (quantity, price) =
      case (quantity, price) of
          (SOME q, SOME p) => SOME (Decimal.fromInt q * p)
        | _ => NONE
    val years = [SOME 1999, SOME (1999 + 1), SOME (1999 + 2)]
    val cross_items =
      from i in tpcds.item,
          x in (
            from x in (
                from ss in tpcds.store_sales,
                    iss in tpcds.item,
                    d1 in tpcds.date_dim
                  where ss.ss_item_sk = iss.i_item_sk
                    andalso ss.ss_sold_date_sk = SOME d1.d_date_sk
                    andalso d1.d_year elem years
                  yield {brand_id = iss.i_brand_id,
                    class_id = iss.i_class_id,
                    category_id = iss.i_category_id})
              intersect distinct
                (from cs in tpcds.catalog_sales,
                    ics in tpcds.item,
                    d2 in tpcds.date_dim
                  where cs.cs_item_sk = ics.i_item_sk
                    andalso cs.cs_sold_date_sk = SOME d2.d_date_sk
                    andalso d2.d_year elem years
                  yield {brand_id = ics.i_brand_id,
                    class_id = ics.i_class_id,
                    category_id = ics.i_category_id}),
                (from ws in tpcds.web_sales,
                    iws in tpcds.item,
                    d3 in tpcds.date_dim
                  where ws.ws_item_sk = iws.i_item_sk
                    andalso ws.ws_sold_date_sk = SOME d3.d_date_sk
                    andalso d3.d_year elem years
                  yield {brand_id = iws.i_brand_id,
                    class_id = iws.i_class_id,
                    category_id = iws.i_category_id}))
        where i.i_brand_id <> NONE
          andalso i.i_brand_id = x.brand_id
          andalso i.i_class_id <> NONE
          andalso i.i_class_id = x.class_id
          andalso i.i_category_id <> NONE
          andalso i.i_category_id = x.category_id
        yield i.i_item_sk
    val average_sales =
      from x in (
          from ss in tpcds.store_sales,
              d in tpcds.date_dim
            where ss.ss_sold_date_sk = SOME d.d_date_sk
              andalso d.d_year elem years
            yield {quantity = ss.ss_quantity, list_price = ss.ss_list_price})
        union
          (from cs in tpcds.catalog_sales,
              d in tpcds.date_dim
            where cs.cs_sold_date_sk = SOME d.d_date_sk
              andalso d.d_year elem years
            yield {quantity = cs.cs_quantity, list_price = cs.cs_list_price}),
          (from ws in tpcds.web_sales,
              d in tpcds.date_dim
            where ws.ws_sold_date_sk = SOME d.d_date_sk
              andalso d.d_year elem years
            yield {quantity = ws.ws_quantity, list_price = ws.ws_list_price})
        compute avgSome over times (x.quantity, x.list_price)
    (* The week that holds December 11 of "year". *)
    fun week year =
      Relational.only
        (from d in tpcds.date_dim
          where d.d_year = SOME year
            andalso d.d_moy = SOME 12
            andalso d.d_dom = SOME 11
          yield d.d_week_seq)
    (* "ss_item_sk IN (SELECT ss_item_sk FROM cross_items)" is written
     * as "exists", which is the same for a key that is never NONE, and
     * which Morel evaluates as a semi-join; it searches the list for
     * "elem" once per row. *)
    fun sales year =
      let
        val w = week year
      in
        from ss in tpcds.store_sales,
            i in tpcds.item,
            d in tpcds.date_dim
          where (exists ci in cross_items where ci = ss.ss_item_sk)
            andalso ss.ss_item_sk = i.i_item_sk
            andalso ss.ss_sold_date_sk = SOME d.d_date_sk
            andalso w <> NONE
            andalso d.d_week_seq = w
          group {i.i_brand_id, i.i_class_id, i.i_category_id}
            compute {
              sales = sumSome over times (ss.ss_quantity, ss.ss_list_price),
              number_sales = count over ()}
          where (case (sales, average_sales) of
                    (SOME s, SOME a) => s > a
                  | _ => false)
          yield {channel = "store", i_brand_id, i_class_id, i_category_id,
            sales, number_sales}
      end
  in
    from this_year in sales (1999 + 1),
        last_year in sales 1999
      where this_year.i_brand_id <> NONE
        andalso this_year.i_brand_id = last_year.i_brand_id
        andalso this_year.i_class_id <> NONE
        andalso this_year.i_class_id = last_year.i_class_id
        andalso this_year.i_category_id <> NONE
        andalso this_year.i_category_id = last_year.i_category_id
      order (this_year.channel, this_year.i_brand_id, this_year.i_class_id,
        this_year.i_category_id)
      yield {this_year.channel, this_year.i_brand_id, this_year.i_class_id,
        this_year.i_category_id, this_year.sales, this_year.number_sales,
        channel_2 = last_year.channel, i_brand_id_2 = last_year.i_brand_id,
        i_class_id_2 = last_year.i_class_id,
        i_category_id_2 = last_year.i_category_id,
        sales_2 = last_year.sales, number_sales_2 = last_year.number_sales}
      take 100
  end;
> val q14b = fn
>   : unit
>      -> {channel:string, channel_2:string, i_brand_id:int option,
>           i_brand_id_2:int option, i_category_id:int option,
>           i_category_id_2:int option, i_class_id:int option,
>           i_class_id_2:int option, number_sales:int, number_sales_2:int,
>           sales:decimal option, sales_2:decimal option} list
val r14b = q14b ();
> channel channel_2 i_brand_id i_brand_id_2 i_category_id i_category_id_2 i_class_id i_class_id_2 number_sales number_sales_2 sales    sales_2
