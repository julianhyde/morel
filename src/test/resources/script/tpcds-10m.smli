(* --- q23a ------------------------------------------------------- *)
(*
WITH frequent_ss_items AS
(SELECT
    substr(i_item_desc, 1, 30) itemdesc,
    i_item_sk item_sk,
    d_date solddate,
    count(*) cnt
  FROM store_sales, date_dim, item
  WHERE ss_sold_date_sk = d_date_sk
    AND ss_item_sk = i_item_sk
    AND d_year IN (2000, 2000 + 1, 2000 + 2, 2000 + 3)
  GROUP BY substr(i_item_desc, 1, 30), i_item_sk, d_date
  HAVING count(*) > 4),
    max_store_sales AS
  (SELECT max(csales) tpcds_cmax
  FROM (SELECT
    c_customer_sk,
    sum(ss_quantity * ss_sales_price) csales
  FROM store_sales, customer, date_dim
  WHERE ss_customer_sk = c_customer_sk
    AND ss_sold_date_sk = d_date_sk
    AND d_year IN (2000, 2000 + 1, 2000 + 2, 2000 + 3)
  GROUP BY c_customer_sk) x),
    best_ss_customer AS
  (SELECT
    c_customer_sk,
    sum(ss_quantity * ss_sales_price) ssales
  FROM store_sales, customer
  WHERE ss_customer_sk = c_customer_sk
  GROUP BY c_customer_sk
  HAVING sum(ss_quantity * ss_sales_price) > (50 / 100.0) *
    (SELECT *
    FROM max_store_sales))
SELECT sum(sales)
FROM ((SELECT cs_quantity * cs_list_price sales
FROM catalog_sales, date_dim
WHERE d_year = 2000
  AND d_moy = 2
  AND cs_sold_date_sk = d_date_sk
  AND cs_item_sk IN (SELECT item_sk
FROM frequent_ss_items)
  AND cs_bill_customer_sk IN (SELECT c_customer_sk
FROM best_ss_customer))
      UNION ALL
      (SELECT ws_quantity * ws_list_price sales
      FROM web_sales, date_dim
      WHERE d_year = 2000
        AND d_moy = 2
        AND ws_sold_date_sk = d_date_sk
        AND ws_item_sk IN (SELECT item_sk
      FROM frequent_ss_items)
        AND ws_bill_customer_sk IN (SELECT c_customer_sk
      FROM best_ss_customer))) y
LIMIT 100
*)
fun q23a () =
  let
    (* "quantity * price" *)
    fun times (quantity, price) =
      case (quantity, price) of
          (SOME q, SOME p) => SOME (Decimal.fromInt q * p)
        | _ => NONE
    val years = [SOME 2000, SOME (2000 + 1), SOME (2000 + 2), SOME (2000 + 3)]
    val frequent_ss_items =
      from ss in tpcds.store_sales,
          d in tpcds.date_dim,
          i in tpcds.item
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_item_sk = i.i_item_sk
          andalso d.d_year elem years
        group {itemdesc =
            Option.map (fn s => String.substring (s, 0, Int.min (30, size s)))
              i.i_item_desc,
            item_sk = i.i_item_sk, solddate = d.d_date}
          compute {cnt = count over ()}
        where cnt > 4
    val max_store_sales =
      from x in (
          from ss in tpcds.store_sales,
              c in tpcds.customer,
              d in tpcds.date_dim
            where ss.ss_customer_sk = SOME c.c_customer_sk
              andalso ss.ss_sold_date_sk = SOME d.d_date_sk
              andalso d.d_year elem years
            group c.c_customer_sk
              compute {csales =
                sumSome over times (ss.ss_quantity, ss.ss_sales_price)})
        compute maxSome over x.csales
    val best_ss_customer =
      from ss in tpcds.store_sales,
          c in tpcds.customer
        where ss.ss_customer_sk = SOME c.c_customer_sk
        group c.c_customer_sk
          compute {ssales = sumSome over times (ss.ss_quantity, ss.ss_sales_price)}
        where (case (ssales, max_store_sales) of
                  (SOME s, SOME m) => s > decimal "0.5" * m
                | _ => false)
    val items = from f in frequent_ss_items yield f.item_sk
    val customers = from b in best_ss_customer yield SOME b.c_customer_sk
  in
    from y in (
        from cs in tpcds.catalog_sales,
            d in tpcds.date_dim
          where d.d_year = SOME 2000
            andalso d.d_moy = SOME 2
            andalso cs.cs_sold_date_sk = SOME d.d_date_sk
            andalso cs.cs_item_sk elem items
            andalso cs.cs_bill_customer_sk elem customers
          yield {sales = times (cs.cs_quantity, cs.cs_list_price)}
        union
          (from ws in tpcds.web_sales,
              d in tpcds.date_dim
            where d.d_year = SOME 2000
              andalso d.d_moy = SOME 2
              andalso ws.ws_sold_date_sk = SOME d.d_date_sk
              andalso ws.ws_item_sk elem items
              andalso ws.ws_bill_customer_sk elem customers
            yield {sales = times (ws.ws_quantity, ws.ws_list_price)}))
      compute sumSome over y.sales
  end;
> val q23a = fn : unit -> decimal option
val r23a = q23a ();
> val r23a = NONE : decimal option

(* --- q23b ------------------------------------------------------- *)
(*
WITH frequent_ss_items AS
(SELECT
    substr(i_item_desc, 1, 30) itemdesc,
    i_item_sk item_sk,
    d_date solddate,
    count(*) cnt
  FROM store_sales, date_dim, item
  WHERE ss_sold_date_sk = d_date_sk
    AND ss_item_sk = i_item_sk
    AND d_year IN (2000, 2000 + 1, 2000 + 2, 2000 + 3)
  GROUP BY substr(i_item_desc, 1, 30), i_item_sk, d_date
  HAVING count(*) > 4),
    max_store_sales AS
  (SELECT max(csales) tpcds_cmax
  FROM (SELECT
    c_customer_sk,
    sum(ss_quantity * ss_sales_price) csales
  FROM store_sales, customer, date_dim
  WHERE ss_customer_sk = c_customer_sk
    AND ss_sold_date_sk = d_date_sk
    AND d_year IN (2000, 2000 + 1, 2000 + 2, 2000 + 3)
  GROUP BY c_customer_sk) x),
    best_ss_customer AS
  (SELECT
    c_customer_sk,
    sum(ss_quantity * ss_sales_price) ssales
  FROM store_sales
    , customer
  WHERE ss_customer_sk = c_customer_sk
  GROUP BY c_customer_sk
  HAVING sum(ss_quantity * ss_sales_price) > (50 / 100.0) *
    (SELECT *
    FROM max_store_sales))
SELECT
  c_last_name,
  c_first_name,
  sales
FROM ((SELECT
  c_last_name,
  c_first_name,
  sum(cs_quantity * cs_list_price) sales
FROM catalog_sales, customer, date_dim
WHERE d_year = 2000
  AND d_moy = 2
  AND cs_sold_date_sk = d_date_sk
  AND cs_item_sk IN (SELECT item_sk
FROM frequent_ss_items)
  AND cs_bill_customer_sk IN (SELECT c_customer_sk
FROM best_ss_customer)
  AND cs_bill_customer_sk = c_customer_sk
GROUP BY c_last_name, c_first_name)
      UNION ALL
      (SELECT
        c_last_name,
        c_first_name,
        sum(ws_quantity * ws_list_price) sales
      FROM web_sales, customer, date_dim
      WHERE d_year = 2000
        AND d_moy = 2
        AND ws_sold_date_sk = d_date_sk
        AND ws_item_sk IN (SELECT item_sk
      FROM frequent_ss_items)
        AND ws_bill_customer_sk IN (SELECT c_customer_sk
      FROM best_ss_customer)
        AND ws_bill_customer_sk = c_customer_sk
      GROUP BY c_last_name, c_first_name)) y
ORDER BY c_last_name, c_first_name, sales
LIMIT 100
*)
fun q23b () =
  let
    (* "quantity * price" *)
    fun times (quantity, price) =
      case (quantity, price) of
          (SOME q, SOME p) => SOME (Decimal.fromInt q * p)
        | _ => NONE
    val years = [SOME 2000, SOME (2000 + 1), SOME (2000 + 2), SOME (2000 + 3)]
    val frequent_ss_items =
      from ss in tpcds.store_sales,
          d in tpcds.date_dim,
          i in tpcds.item
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_item_sk = i.i_item_sk
          andalso d.d_year elem years
        group {itemdesc =
            Option.map (fn s => String.substring (s, 0, Int.min (30, size s)))
              i.i_item_desc,
            item_sk = i.i_item_sk, solddate = d.d_date}
          compute {cnt = count over ()}
        where cnt > 4
    val max_store_sales =
      from x in (
          from ss in tpcds.store_sales,
              c in tpcds.customer,
              d in tpcds.date_dim
            where ss.ss_customer_sk = SOME c.c_customer_sk
              andalso ss.ss_sold_date_sk = SOME d.d_date_sk
              andalso d.d_year elem years
            group c.c_customer_sk
              compute {csales =
                sumSome over times (ss.ss_quantity, ss.ss_sales_price)})
        compute maxSome over x.csales
    val best_ss_customer =
      from ss in tpcds.store_sales,
          c in tpcds.customer
        where ss.ss_customer_sk = SOME c.c_customer_sk
        group c.c_customer_sk
          compute {ssales = sumSome over times (ss.ss_quantity, ss.ss_sales_price)}
        where (case (ssales, max_store_sales) of
                  (SOME s, SOME m) => s > decimal "0.5" * m
                | _ => false)
    val items = from f in frequent_ss_items yield f.item_sk
    val customers = from b in best_ss_customer yield SOME b.c_customer_sk
  in
    from y in (
        from cs in tpcds.catalog_sales,
            c in tpcds.customer,
            d in tpcds.date_dim
          where d.d_year = SOME 2000
            andalso d.d_moy = SOME 2
            andalso cs.cs_sold_date_sk = SOME d.d_date_sk
            andalso cs.cs_item_sk elem items
            andalso cs.cs_bill_customer_sk elem customers
            andalso cs.cs_bill_customer_sk = SOME c.c_customer_sk
          group {c.c_last_name, c.c_first_name}
            compute {sales =
              sumSome over times (cs.cs_quantity, cs.cs_list_price)}
        union
          (from ws in tpcds.web_sales,
              c in tpcds.customer,
              d in tpcds.date_dim
            where d.d_year = SOME 2000
              andalso d.d_moy = SOME 2
              andalso ws.ws_sold_date_sk = SOME d.d_date_sk
              andalso ws.ws_item_sk elem items
              andalso ws.ws_bill_customer_sk elem customers
              andalso ws.ws_bill_customer_sk = SOME c.c_customer_sk
            group {c.c_last_name, c.c_first_name}
              compute {sales =
                sumSome over times (ws.ws_quantity, ws.ws_list_price)}))
      order (y.c_last_name, y.c_first_name, y.sales)
      take 100
  end;
> val q23b = fn
>   : unit
>      -> {c_first_name:string option, c_last_name:string option,
>           sales:decimal option} list
val r23b = q23b ();
> c_first_name c_last_name sales
> ------------ ----------- -----
>
> val r23b : {c_first_name:string option, c_last_name:string option, sales:decimal option} list

(* --- q24a ------------------------------------------------------- *)
(*
WITH ssales AS
(SELECT
    c_last_name,
    c_first_name,
    s_store_name,
    ca_state,
    s_state,
    i_color,
    i_current_price,
    i_manager_id,
    i_units,
    i_size,
    sum(ss_net_paid) netpaid
  FROM store_sales, store_returns, store, item, customer, customer_address
  WHERE ss_ticket_number = sr_ticket_number
    AND ss_item_sk = sr_item_sk
    AND ss_customer_sk = c_customer_sk
    AND ss_item_sk = i_item_sk
    AND ss_store_sk = s_store_sk
    AND c_birth_country = upper(ca_country)
    AND s_zip = ca_zip
    AND s_market_id = 8
  GROUP BY c_last_name, c_first_name, s_store_name, ca_state, s_state, i_color,
    i_current_price, i_manager_id, i_units, i_size)
SELECT
  c_last_name,
  c_first_name,
  s_store_name,
  sum(netpaid) paid
FROM ssales
WHERE i_color = 'pale'
GROUP BY c_last_name, c_first_name, s_store_name
HAVING sum(netpaid) > (SELECT 0.05 * avg(netpaid)
FROM ssales)
*)
fun q24a () =
  let
    val ssales =
      from ss in tpcds.store_sales,
          sr in tpcds.store_returns,
          s in tpcds.store,
          i in tpcds.item,
          c in tpcds.customer,
          ca in tpcds.customer_address
        where ss.ss_ticket_number = sr.sr_ticket_number
          andalso ss.ss_item_sk = sr.sr_item_sk
          andalso ss.ss_customer_sk = SOME c.c_customer_sk
          andalso ss.ss_item_sk = i.i_item_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso (case (c.c_birth_country, ca.ca_country) of
                      (SOME birth, SOME country) =>
                        birth = String.map Char.toUpper country
                    | _ => false)
          andalso s.s_zip <> NONE
          andalso s.s_zip = ca.ca_zip
          andalso s.s_market_id = SOME 8
        group {c.c_last_name, c.c_first_name, s.s_store_name, ca.ca_state,
            s.s_state, i.i_color, i.i_current_price, i.i_manager_id,
            i.i_units, i.i_size}
          compute {netpaid = sumSome over ss.ss_net_paid}
    val threshold =
      Option.map (fn a => decimal "0.05" * a)
        (from s in ssales compute avgSome over s.netpaid)
  in
    from s in ssales
      where s.i_color = SOME "pale"
      group {s.c_last_name, s.c_first_name, s.s_store_name}
        compute {paid = sumSome over s.netpaid}
      where (case (paid, threshold) of
                (SOME p, SOME t) => p > t
              | _ => false)
  end;
> val q24a = fn
>   : unit
>      -> {c_first_name:string option, c_last_name:string option,
>           paid:decimal option, s_store_name:string option} list
val r24a = q24a ();
> c_first_name c_last_name paid s_store_name
> ------------ ----------- ---- ------------
>
> val r24a : {c_first_name:string option, c_last_name:string option, paid:decimal option, s_store_name:string option} list

(* --- q24b ------------------------------------------------------- *)
