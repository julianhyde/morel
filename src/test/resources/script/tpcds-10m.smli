(* --- q36 -------------------------------------------------------- *)
(*
SELECT
  sum(ss_net_profit) / sum(ss_ext_sales_price) AS gross_margin,
  i_category,
  i_class,
  grouping(i_category) + grouping(i_class) AS lochierarchy,
  rank()
  OVER (
    PARTITION BY grouping(i_category) + grouping(i_class),
      CASE WHEN grouping(i_class) = 0
        THEN i_category END
    ORDER BY sum(ss_net_profit) / sum(ss_ext_sales_price) ASC) AS rank_within_parent
FROM
  store_sales, date_dim d1, item, store
WHERE
  d1.d_year = 2001
    AND d1.d_date_sk = ss_sold_date_sk
    AND i_item_sk = ss_item_sk
    AND s_store_sk = ss_store_sk
    AND s_state IN ('TN', 'TN', 'TN', 'TN', 'TN', 'TN', 'TN', 'TN')
GROUP BY ROLLUP (i_category, i_class)
ORDER BY
  lochierarchy DESC
  , CASE WHEN lochierarchy = 0
  THEN i_category END
  , rank_within_parent
LIMIT 100
*)
(* "GROUP BY ROLLUP", as in q22. "rank() OVER (PARTITION BY p ORDER BY
 * m)" is one more than the number of rows in the row's partition whose
 * "m" comes before its own (ascending); NONE is less than any SOME, so it
 * is first ascending and last descending, as Spark's nulls are. *)
fun q36 () =
  let
    val base =
      from ss in tpcds.store_sales,
          d1 in tpcds.date_dim,
          i in tpcds.item,
          s in tpcds.store
        where d1.d_year = SOME 2001
          andalso ss.ss_sold_date_sk = SOME d1.d_date_sk
          andalso ss.ss_item_sk = i.i_item_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso s.s_state elem [SOME "TN"]
        yield {i.i_category, i.i_class, ss.ss_net_profit,
          ss.ss_ext_sales_price}
    val rolled =
      from r in (from b in base
          group {b.i_category, b.i_class}
            compute {profit = sumSome over b.ss_net_profit,
                sales = sumSome over b.ss_ext_sales_price}
          yield {i_category, i_class, g1 = 0, g2 = 0, profit, sales})
        union
          (from b in base
              group {b.i_category}
                compute {profit = sumSome over b.ss_net_profit,
                    sales = sumSome over b.ss_ext_sales_price}
              yield {i_category, i_class = NONE, g1 = 0, g2 = 1, profit, sales}),
          (from b in base
              group {}
                compute {profit = sumSome over b.ss_net_profit,
                    sales = sumSome over b.ss_ext_sales_price}
              yield {i_category = NONE, i_class = NONE, g1 = 1, g2 = 1, profit,
                sales})
      yield {gross_margin = case (r.profit, r.sales) of
            (SOME p, SOME s) => SOME (p / s)
          | _ => NONE, r.i_category, r.i_class,
        lochierarchy = r.g1 + r.g2,
        parent = if r.g2 = 0 then r.i_category else NONE}
  in
    from r in rolled
      yield {r.gross_margin, r.i_category, r.i_class, r.lochierarchy,
        rank_within_parent =
          1 + count (from s in rolled
            where s.lochierarchy = r.lochierarchy
              andalso s.parent = r.parent
              andalso s.gross_margin < r.gross_margin)}
      order (DESC lochierarchy,
        if lochierarchy = 0 then i_category else NONE, rank_within_parent)
      take 100
  end;
> val q36 = fn
>   : unit
>      -> {gross_margin:decimal option, i_category:string option,
>           i_class:string option, lochierarchy:int, rank_within_parent:int}
>         list
val r36 = q36 ();
