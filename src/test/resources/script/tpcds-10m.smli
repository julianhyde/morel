(* --- q28 -------------------------------------------------------- *)
(*
SELECT *
FROM (SELECT
  avg(ss_list_price) B1_LP,
  count(ss_list_price) B1_CNT,
  count(DISTINCT ss_list_price) B1_CNTD
FROM store_sales
WHERE ss_quantity BETWEEN 0 AND 5
  AND (ss_list_price BETWEEN 8 AND 8 + 10
  OR ss_coupon_amt BETWEEN 459 AND 459 + 1000
  OR ss_wholesale_cost BETWEEN 57 AND 57 + 20)) B1,
  (SELECT
    avg(ss_list_price) B2_LP,
    count(ss_list_price) B2_CNT,
    count(DISTINCT ss_list_price) B2_CNTD
  FROM store_sales
  WHERE ss_quantity BETWEEN 6 AND 10
    AND (ss_list_price BETWEEN 90 AND 90 + 10
    OR ss_coupon_amt BETWEEN 2323 AND 2323 + 1000
    OR ss_wholesale_cost BETWEEN 31 AND 31 + 20)) B2,
  (SELECT
    avg(ss_list_price) B3_LP,
    count(ss_list_price) B3_CNT,
    count(DISTINCT ss_list_price) B3_CNTD
  FROM store_sales
  WHERE ss_quantity BETWEEN 11 AND 15
    AND (ss_list_price BETWEEN 142 AND 142 + 10
    OR ss_coupon_amt BETWEEN 12214 AND 12214 + 1000
    OR ss_wholesale_cost BETWEEN 79 AND 79 + 20)) B3,
  (SELECT
    avg(ss_list_price) B4_LP,
    count(ss_list_price) B4_CNT,
    count(DISTINCT ss_list_price) B4_CNTD
  FROM store_sales
  WHERE ss_quantity BETWEEN 16 AND 20
    AND (ss_list_price BETWEEN 135 AND 135 + 10
    OR ss_coupon_amt BETWEEN 6071 AND 6071 + 1000
    OR ss_wholesale_cost BETWEEN 38 AND 38 + 20)) B4,
  (SELECT
    avg(ss_list_price) B5_LP,
    count(ss_list_price) B5_CNT,
    count(DISTINCT ss_list_price) B5_CNTD
  FROM store_sales
  WHERE ss_quantity BETWEEN 21 AND 25
    AND (ss_list_price BETWEEN 122 AND 122 + 10
    OR ss_coupon_amt BETWEEN 836 AND 836 + 1000
    OR ss_wholesale_cost BETWEEN 17 AND 17 + 20)) B5,
  (SELECT
    avg(ss_list_price) B6_LP,
    count(ss_list_price) B6_CNT,
    count(DISTINCT ss_list_price) B6_CNTD
  FROM store_sales
  WHERE ss_quantity BETWEEN 26 AND 30
    AND (ss_list_price BETWEEN 154 AND 154 + 10
    OR ss_coupon_amt BETWEEN 7326 AND 7326 + 1000
    OR ss_wholesale_cost BETWEEN 7 AND 7 + 20)) B6
LIMIT 100
*)
fun q28 () =
  let
    (* "x BETWEEN lo AND hi" *)
    fun between (x, lo, hi) =
      x >= SOME (Decimal.fromInt lo) andalso x <= SOME (Decimal.fromInt hi)
    (* "count(DISTINCT x)", which ignores nulls *)
    fun countDistinct xs =
      List.length (from x in xs where Option.isSome x distinct)
    val b1 =
      from ss in tpcds.store_sales
        where ss.ss_quantity >= SOME 0
          andalso ss.ss_quantity <= SOME 5
          andalso (between (ss.ss_list_price, 8, 8 + 10)
            orelse between (ss.ss_coupon_amt, 459, 459 + 1000)
            orelse between (ss.ss_wholesale_cost, 57, 57 + 20))
        compute {b1_lp = avgSome over ss.ss_list_price,
          b1_cnt = countSome over ss.ss_list_price,
          b1_cntd = countDistinct over ss.ss_list_price}
    val b2 =
      from ss in tpcds.store_sales
        where ss.ss_quantity >= SOME 6
          andalso ss.ss_quantity <= SOME 10
          andalso (between (ss.ss_list_price, 90, 90 + 10)
            orelse between (ss.ss_coupon_amt, 2323, 2323 + 1000)
            orelse between (ss.ss_wholesale_cost, 31, 31 + 20))
        compute {b2_lp = avgSome over ss.ss_list_price,
          b2_cnt = countSome over ss.ss_list_price,
          b2_cntd = countDistinct over ss.ss_list_price}
    val b3 =
      from ss in tpcds.store_sales
        where ss.ss_quantity >= SOME 11
          andalso ss.ss_quantity <= SOME 15
          andalso (between (ss.ss_list_price, 142, 142 + 10)
            orelse between (ss.ss_coupon_amt, 12214, 12214 + 1000)
            orelse between (ss.ss_wholesale_cost, 79, 79 + 20))
        compute {b3_lp = avgSome over ss.ss_list_price,
          b3_cnt = countSome over ss.ss_list_price,
          b3_cntd = countDistinct over ss.ss_list_price}
    val b4 =
      from ss in tpcds.store_sales
        where ss.ss_quantity >= SOME 16
          andalso ss.ss_quantity <= SOME 20
          andalso (between (ss.ss_list_price, 135, 135 + 10)
            orelse between (ss.ss_coupon_amt, 6071, 6071 + 1000)
            orelse between (ss.ss_wholesale_cost, 38, 38 + 20))
        compute {b4_lp = avgSome over ss.ss_list_price,
          b4_cnt = countSome over ss.ss_list_price,
          b4_cntd = countDistinct over ss.ss_list_price}
    val b5 =
      from ss in tpcds.store_sales
        where ss.ss_quantity >= SOME 21
          andalso ss.ss_quantity <= SOME 25
          andalso (between (ss.ss_list_price, 122, 122 + 10)
            orelse between (ss.ss_coupon_amt, 836, 836 + 1000)
            orelse between (ss.ss_wholesale_cost, 17, 17 + 20))
        compute {b5_lp = avgSome over ss.ss_list_price,
          b5_cnt = countSome over ss.ss_list_price,
          b5_cntd = countDistinct over ss.ss_list_price}
    val b6 =
      from ss in tpcds.store_sales
        where ss.ss_quantity >= SOME 26
          andalso ss.ss_quantity <= SOME 30
          andalso (between (ss.ss_list_price, 154, 154 + 10)
            orelse between (ss.ss_coupon_amt, 7326, 7326 + 1000)
            orelse between (ss.ss_wholesale_cost, 7, 7 + 20))
        compute {b6_lp = avgSome over ss.ss_list_price,
          b6_cnt = countSome over ss.ss_list_price,
          b6_cntd = countDistinct over ss.ss_list_price}
  in
    {
      b1.b1_lp, b1.b1_cnt, b1.b1_cntd,
      b2.b2_lp, b2.b2_cnt, b2.b2_cntd,
      b3.b3_lp, b3.b3_cnt, b3.b3_cntd,
      b4.b4_lp, b4.b4_cnt, b4.b4_cntd,
      b5.b5_lp, b5.b5_cnt, b5.b5_cntd,
      b6.b6_lp, b6.b6_cnt, b6.b6_cntd}
  end;
> val q28 = fn
>   : unit
>      -> {b1_cnt:int, b1_cntd:int, b1_lp:decimal option, b2_cnt:int,
>           b2_cntd:int, b2_lp:decimal option, b3_cnt:int, b3_cntd:int,
>           b3_lp:decimal option, b4_cnt:int, b4_cntd:int, b4_lp:decimal option,
>           b5_cnt:int, b5_cntd:int, b5_lp:decimal option, b6_cnt:int,
>           b6_cntd:int, b6_lp:decimal option}
