      OR
      (household_demographics.hd_dep_count = 0 AND
        household_demographics.hd_vehicle_count <= 0 + 2))
    AND store.s_store_name = 'ese') s1,
  (SELECT count(*) h9_to_9_30
  FROM store_sales, household_demographics, time_dim, store
  WHERE ss_sold_time_sk = time_dim.t_time_sk
    AND ss_hdemo_sk = household_demographics.hd_demo_sk
    AND ss_store_sk = s_store_sk
    AND time_dim.t_hour = 9
    AND time_dim.t_minute < 30
    AND (
    (household_demographics.hd_dep_count = 4 AND household_demographics.hd_vehicle_count <= 4 + 2)
      OR
      (household_demographics.hd_dep_count = 2 AND household_demographics.hd_vehicle_count <= 2 + 2)
      OR
      (household_demographics.hd_dep_count = 0 AND
        household_demographics.hd_vehicle_count <= 0 + 2))
    AND store.s_store_name = 'ese') s2,
  (SELECT count(*) h9_30_to_10
  FROM store_sales, household_demographics, time_dim, store
  WHERE ss_sold_time_sk = time_dim.t_time_sk
    AND ss_hdemo_sk = household_demographics.hd_demo_sk
    AND ss_store_sk = s_store_sk
    AND time_dim.t_hour = 9
    AND time_dim.t_minute >= 30
    AND (
    (household_demographics.hd_dep_count = 4 AND household_demographics.hd_vehicle_count <= 4 + 2)
      OR
      (household_demographics.hd_dep_count = 2 AND household_demographics.hd_vehicle_count <= 2 + 2)
      OR
      (household_demographics.hd_dep_count = 0 AND
        household_demographics.hd_vehicle_count <= 0 + 2))
    AND store.s_store_name = 'ese') s3,
  (SELECT count(*) h10_to_10_30
  FROM store_sales, household_demographics, time_dim, store
  WHERE ss_sold_time_sk = time_dim.t_time_sk
    AND ss_hdemo_sk = household_demographics.hd_demo_sk
    AND ss_store_sk = s_store_sk
    AND time_dim.t_hour = 10
    AND time_dim.t_minute < 30
    AND (
    (household_demographics.hd_dep_count = 4 AND household_demographics.hd_vehicle_count <= 4 + 2)
      OR
      (household_demographics.hd_dep_count = 2 AND household_demographics.hd_vehicle_count <= 2 + 2)
      OR
      (household_demographics.hd_dep_count = 0 AND
        household_demographics.hd_vehicle_count <= 0 + 2))
    AND store.s_store_name = 'ese') s4,
  (SELECT count(*) h10_30_to_11
  FROM store_sales, household_demographics, time_dim, store
  WHERE ss_sold_time_sk = time_dim.t_time_sk
    AND ss_hdemo_sk = household_demographics.hd_demo_sk
    AND ss_store_sk = s_store_sk
    AND time_dim.t_hour = 10
    AND time_dim.t_minute >= 30
    AND (
    (household_demographics.hd_dep_count = 4 AND household_demographics.hd_vehicle_count <= 4 + 2)
      OR
      (household_demographics.hd_dep_count = 2 AND household_demographics.hd_vehicle_count <= 2 + 2)
      OR
      (household_demographics.hd_dep_count = 0 AND
        household_demographics.hd_vehicle_count <= 0 + 2))
    AND store.s_store_name = 'ese') s5,
  (SELECT count(*) h11_to_11_30
  FROM store_sales, household_demographics, time_dim, store
  WHERE ss_sold_time_sk = time_dim.t_time_sk
    AND ss_hdemo_sk = household_demographics.hd_demo_sk
    AND ss_store_sk = s_store_sk
    AND time_dim.t_hour = 11
    AND time_dim.t_minute < 30
    AND (
    (household_demographics.hd_dep_count = 4 AND household_demographics.hd_vehicle_count <= 4 + 2)
      OR
      (household_demographics.hd_dep_count = 2 AND household_demographics.hd_vehicle_count <= 2 + 2)
      OR
      (household_demographics.hd_dep_count = 0 AND
        household_demographics.hd_vehicle_count <= 0 + 2))
    AND store.s_store_name = 'ese') s6,
  (SELECT count(*) h11_30_to_12
  FROM store_sales, household_demographics, time_dim, store
  WHERE ss_sold_time_sk = time_dim.t_time_sk
    AND ss_hdemo_sk = household_demographics.hd_demo_sk
    AND ss_store_sk = s_store_sk
    AND time_dim.t_hour = 11
    AND time_dim.t_minute >= 30
    AND (
    (household_demographics.hd_dep_count = 4 AND household_demographics.hd_vehicle_count <= 4 + 2)
      OR
      (household_demographics.hd_dep_count = 2 AND household_demographics.hd_vehicle_count <= 2 + 2)
      OR
      (household_demographics.hd_dep_count = 0 AND
        household_demographics.hd_vehicle_count <= 0 + 2))
    AND store.s_store_name = 'ese') s7,
  (SELECT count(*) h12_to_12_30
  FROM store_sales, household_demographics, time_dim, store
  WHERE ss_sold_time_sk = time_dim.t_time_sk
    AND ss_hdemo_sk = household_demographics.hd_demo_sk
    AND ss_store_sk = s_store_sk
    AND time_dim.t_hour = 12
    AND time_dim.t_minute < 30
    AND (
    (household_demographics.hd_dep_count = 4 AND household_demographics.hd_vehicle_count <= 4 + 2)
      OR
      (household_demographics.hd_dep_count = 2 AND household_demographics.hd_vehicle_count <= 2 + 2)
      OR
      (household_demographics.hd_dep_count = 0 AND
        household_demographics.hd_vehicle_count <= 0 + 2))
    AND store.s_store_name = 'ese') s8
*)
fun q88 () =
  let
    (* The number of sales in the half hour that starts at "hour", or
     * at half past it if not "early". *)
    fun sales (hour, early) =
      from ss in tpcds.store_sales,
          hd in tpcds.household_demographics,
          t in tpcds.time_dim,
          s in tpcds.store
        where ss.ss_sold_time_sk = SOME t.t_time_sk
          andalso ss.ss_hdemo_sk = SOME hd.hd_demo_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso t.t_hour = SOME hour
          andalso (if early
            then t.t_minute <> NONE andalso t.t_minute < SOME 30
            else t.t_minute >= SOME 30)
          andalso (case hd.hd_dep_count of
                SOME c =>
                  c elem [4, 2, 0]
                  andalso hd.hd_vehicle_count <> NONE
                  andalso hd.hd_vehicle_count <= SOME (c + 2)
              | NONE => false)
          andalso s.s_store_name = SOME "ese"
        compute count over ()
  in
    [{
      h8_30_to_9 = sales (8, false),
      h9_to_9_30 = sales (9, true),
      h9_30_to_10 = sales (9, false),
      h10_to_10_30 = sales (10, true),
      h10_30_to_11 = sales (10, false),
      h11_to_11_30 = sales (11, true),
      h11_30_to_12 = sales (11, false),
      h12_to_12_30 = sales (12, true)}]
  end;
> val q88 = fn
>   : unit
>      -> {h10_30_to_11:int, h10_to_10_30:int, h11_30_to_12:int,
>           h11_to_11_30:int, h12_to_12_30:int, h8_30_to_9:int, h9_30_to_10:int,
>           h9_to_9_30:int} list
val r88 = q88 ();
> h10_30_to_11 h10_to_10_30 h11_30_to_12 h11_to_11_30 h12_to_12_30 h8_30_to_9 h9_30_to_10 h9_to_9_30
> ------------ ------------ ------------ ------------ ------------ ---------- ----------- ----------
>            0            0            0            0            0          0           0          0
>
> val r88 : {h10_30_to_11:int, h10_to_10_30:int, h11_30_to_12:int, h11_to_11_30:int, h12_to_12_30:int, h8_30_to_9:int, h9_30_to_10:int, h9_to_9_30:int} list

(* --- q89 -------------------------------------------------------- *)
(*
SELECT *
FROM (
       SELECT
         i_category,
         i_class,
         i_brand,
         s_store_name,
         s_company_name,
         d_moy,
         sum(ss_sales_price) sum_sales,
         avg(sum(ss_sales_price))
         OVER
         (PARTITION BY i_category, i_brand, s_store_name, s_company_name)
         avg_monthly_sales
       FROM item, store_sales, date_dim, store
       WHERE ss_item_sk = i_item_sk AND
         ss_sold_date_sk = d_date_sk AND
         ss_store_sk = s_store_sk AND
         d_year IN (1999) AND
         ((i_category IN ('Books', 'Electronics', 'Sports') AND
           i_class IN ('computers', 'stereo', 'football'))
           OR (i_category IN ('Men', 'Jewelry', 'Women') AND
           i_class IN ('shirts', 'birdal', 'dresses')))
       GROUP BY i_category, i_class, i_brand,
         s_store_name, s_company_name, d_moy) tmp1
WHERE CASE WHEN (avg_monthly_sales <> 0)
  THEN (abs(sum_sales - avg_monthly_sales) / avg_monthly_sales)
      ELSE NULL END > 0.1
ORDER BY sum_sales - avg_monthly_sales, s_store_name
LIMIT 100
*)
(* "avg(sum(x)) OVER (PARTITION BY k)" is the average of the groups'
 * sums for each "k", joined to the groups. A partition is not a join:
 * its NONE key is one partition, as NONE = NONE. "d_month_seq IN (1200,
 * ..., 1200 + 11)" is a range. *)
fun q89 () =
  let
    val base =
      from i in tpcds.item,
          ss in tpcds.store_sales,
          d in tpcds.date_dim,
          s in tpcds.store
        where ss.ss_item_sk = i.i_item_sk
          andalso ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso d.d_year elem [SOME 1999]
          andalso (i.i_category
                elem [SOME "Books", SOME "Electronics", SOME "Sports"]
              andalso i.i_class
                elem [SOME "computers", SOME "stereo", SOME "football"]
            orelse i.i_category elem [SOME "Men", SOME "Jewelry", SOME "Women"]
              andalso i.i_class
                elem [SOME "shirts", SOME "birdal", SOME "dresses"])
        yield {i.i_category, i.i_class, i.i_brand, s.s_store_name,
          s.s_company_name, d.d_moy, ss.ss_sales_price}
    val groups =
      from b in base
        group {b.i_category, b.i_class, b.i_brand, b.s_store_name,
            b.s_company_name, b.d_moy}
          compute {sum_sales = sumSome over b.ss_sales_price}
    val averages =
      from r in groups
        group {r.i_category, r.i_brand, r.s_store_name, r.s_company_name}
          compute {avg_monthly_sales = avgSome over r.sum_sales}
  in
    from r in groups,
        a in averages
      where a.i_category = r.i_category
        andalso a.i_brand = r.i_brand
        andalso a.s_store_name = r.s_store_name
        andalso a.s_company_name = r.s_company_name
        andalso (case (r.sum_sales, a.avg_monthly_sales) of
                    (SOME s, SOME a) => a <> Decimal.fromInt 0
                      andalso Decimal.abs (s - a) / a > decimal "0.1"
                  | _ => false)
      order ((case (r.sum_sales, a.avg_monthly_sales) of
                  (SOME s, SOME a) => SOME (s - a)
                | _ => NONE),
        r.s_store_name)
      yield {r.i_category, r.i_class, r.i_brand, r.s_store_name,
        r.s_company_name, r.d_moy, r.sum_sales, a.avg_monthly_sales}
      take 100
  end;
> val q89 = fn
>   : unit
>      -> {avg_monthly_sales:decimal option, d_moy:int option,
>           i_brand:string option, i_category:string option,
>           i_class:string option, s_company_name:string option,
>           s_store_name:string option, sum_sales:decimal option} list
val r89 = q89 ();
