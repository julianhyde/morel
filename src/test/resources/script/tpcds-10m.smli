(* --- q34 -------------------------------------------------------- *)
(*
SELECT
  c_last_name,
  c_first_name,
  c_salutation,
  c_preferred_cust_flag,
  ss_ticket_number,
  cnt
FROM
  (SELECT
    ss_ticket_number,
    ss_customer_sk,
    count(*) cnt
  FROM store_sales, date_dim, store, household_demographics
  WHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk
    AND store_sales.ss_store_sk = store.s_store_sk
    AND store_sales.ss_hdemo_sk = household_demographics.hd_demo_sk
    AND (date_dim.d_dom BETWEEN 1 AND 3 OR date_dim.d_dom BETWEEN 25 AND 28)
    AND (household_demographics.hd_buy_potential = '>10000' OR
    household_demographics.hd_buy_potential = 'unknown')
    AND household_demographics.hd_vehicle_count > 0
    AND (CASE WHEN household_demographics.hd_vehicle_count > 0
    THEN household_demographics.hd_dep_count / household_demographics.hd_vehicle_count
         ELSE NULL
         END) > 1.2
    AND date_dim.d_year IN (1999, 1999 + 1, 1999 + 2)
    AND store.s_county IN
    ('Williamson County', 'Williamson County', 'Williamson County', 'Williamson County',
     'Williamson County', 'Williamson County', 'Williamson County', 'Williamson County')
  GROUP BY ss_ticket_number, ss_customer_sk) dn, customer
WHERE ss_customer_sk = c_customer_sk
  AND cnt BETWEEN 15 AND 20
ORDER BY c_last_name, c_first_name, c_salutation, c_preferred_cust_flag DESC
*)
fun q34 () =
  from dn in (
      from ss in tpcds.store_sales,
          d in tpcds.date_dim,
          s in tpcds.store,
          hd in tpcds.household_demographics
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso ss.ss_hdemo_sk = SOME hd.hd_demo_sk
          andalso (d.d_dom >= SOME 1 andalso d.d_dom <= SOME 3
            orelse d.d_dom >= SOME 25 andalso d.d_dom <= SOME 28)
          andalso (hd.hd_buy_potential = SOME ">10000"
            orelse hd.hd_buy_potential = SOME "unknown")
          andalso hd.hd_vehicle_count > SOME 0
          andalso (case (hd.hd_dep_count, hd.hd_vehicle_count) of
                      (SOME dc, SOME vc) =>
                        Real.fromInt dc / Real.fromInt vc > 1.2
                    | _ => false)
          andalso d.d_year elem [SOME 1999, SOME (1999 + 1), SOME (1999 + 2)]
          andalso s.s_county elem [SOME "Williamson County"]
        group {ss.ss_ticket_number, ss.ss_customer_sk}
          compute {cnt = count over ()}),
      c in tpcds.customer
    where dn.ss_customer_sk = SOME c.c_customer_sk
      andalso dn.cnt >= 15
      andalso dn.cnt <= 20
    yield {c.c_last_name, c.c_first_name, c.c_salutation,
      c.c_preferred_cust_flag, dn.ss_ticket_number, dn.cnt}
    order (c_last_name, c_first_name, c_salutation,
      DESC c_preferred_cust_flag);
> val q34 = fn
>   : unit
>      -> {c_first_name:string option, c_last_name:string option,
>           c_preferred_cust_flag:string option, c_salutation:string option,
>           cnt:int, ss_ticket_number:int} list
val r34 = q34 ();
