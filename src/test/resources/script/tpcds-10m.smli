      "46820", "88885", "84935", "69035", "83144", "47537", "56616",
      "94983", "48033", "69952", "25486", "61547", "27385", "61860",
      "58048", "56910", "16807", "17871", "35258", "31387", "35458",
      "35576"]
    val v1 =
      from z in (
          from ca in tpcds.customer_address
            where (case ca.ca_zip of
                      SOME z => String.substring (z, 0, 5) elem zips
                    | NONE => false)
            yield Option.map (fn z => String.substring (z, 0, 5)) ca.ca_zip)
        intersect distinct
          (from a1 in (
              from ca in tpcds.customer_address,
                  c in tpcds.customer
                where c.c_current_addr_sk = SOME ca.ca_address_sk
                  andalso c.c_preferred_cust_flag = SOME "Y"
                group {ca_zip =
                    Option.map (fn z => String.substring (z, 0, 5))
                      ca.ca_zip}
                  compute {cnt = count over ()})
            where a1.cnt > 10
            yield a1.ca_zip)
  in
    from ss in tpcds.store_sales,
        d in tpcds.date_dim,
        s in tpcds.store,
        v in v1
      where ss.ss_store_sk = SOME s.s_store_sk
        andalso ss.ss_sold_date_sk = SOME d.d_date_sk
        andalso d.d_qoy = SOME 2
        andalso d.d_year = SOME 1998
        andalso (case (s.s_zip, v) of
                    (SOME z1, SOME z2) =>
                      String.substring (z1, 0, 2) = String.substring (z2, 0, 2)
                  | _ => false)
      group s.s_store_name compute {sum = sumSome over ss.ss_net_profit}
      order s_store_name
      take 100
  end;
> val q8 = fn : unit -> {s_store_name:string option, sum:decimal option} list
val r8 = q8 ();
> s_store_name sum
> ------------ ---
>
> val r8 : {s_store_name:string option, sum:decimal option} list

(* --- q9 --------------------------------------------------------- *)
(*
SELECT
  CASE WHEN (SELECT count(*)
  FROM store_sales
  WHERE ss_quantity BETWEEN 1 AND 20) > 62316685
    THEN (SELECT avg(ss_ext_discount_amt)
    FROM store_sales
    WHERE ss_quantity BETWEEN 1 AND 20)
  ELSE (SELECT avg(ss_net_paid)
  FROM store_sales
  WHERE ss_quantity BETWEEN 1 AND 20) END bucket1,
  CASE WHEN (SELECT count(*)
  FROM store_sales
  WHERE ss_quantity BETWEEN 21 AND 40) > 19045798
    THEN (SELECT avg(ss_ext_discount_amt)
    FROM store_sales
    WHERE ss_quantity BETWEEN 21 AND 40)
  ELSE (SELECT avg(ss_net_paid)
  FROM store_sales
  WHERE ss_quantity BETWEEN 21 AND 40) END bucket2,
  CASE WHEN (SELECT count(*)
  FROM store_sales
  WHERE ss_quantity BETWEEN 41 AND 60) > 365541424
    THEN (SELECT avg(ss_ext_discount_amt)
    FROM store_sales
    WHERE ss_quantity BETWEEN 41 AND 60)
  ELSE (SELECT avg(ss_net_paid)
  FROM store_sales
  WHERE ss_quantity BETWEEN 41 AND 60) END bucket3,
  CASE WHEN (SELECT count(*)
  FROM store_sales
  WHERE ss_quantity BETWEEN 61 AND 80) > 216357808
    THEN (SELECT avg(ss_ext_discount_amt)
    FROM store_sales
    WHERE ss_quantity BETWEEN 61 AND 80)
  ELSE (SELECT avg(ss_net_paid)
  FROM store_sales
  WHERE ss_quantity BETWEEN 61 AND 80) END bucket4,
  CASE WHEN (SELECT count(*)
  FROM store_sales
  WHERE ss_quantity BETWEEN 81 AND 100) > 184483884
    THEN (SELECT avg(ss_ext_discount_amt)
    FROM store_sales
    WHERE ss_quantity BETWEEN 81 AND 100)
  ELSE (SELECT avg(ss_net_paid)
  FROM store_sales
  WHERE ss_quantity BETWEEN 81 AND 100) END bucket5
FROM reason
WHERE r_reason_sk = 1
*)
fun q9 () =
  let
    fun inRange (lo, hi) =
      from ss in tpcds.store_sales
        where ss.ss_quantity >= SOME lo andalso ss.ss_quantity <= SOME hi
    (* If more rows than "threshold" have a quantity in the range, the
     * average discount of those rows, else their average net paid. *)
    fun bucket (lo, hi, threshold) =
      if (from ss in inRange (lo, hi) compute count over ()) > threshold
      then from ss in inRange (lo, hi) compute avgSome over ss.ss_ext_discount_amt
      else from ss in inRange (lo, hi) compute avgSome over ss.ss_net_paid
  in
    {
      bucket1 = bucket (1, 20, 62316685),
      bucket2 = bucket (21, 40, 19045798),
      bucket3 = bucket (41, 60, 365541424),
      bucket4 = bucket (61, 80, 216357808),
      bucket5 = bucket (81, 100, 184483884)}
  end;
> val q9 = fn
>   : unit
>      -> {bucket1:decimal option, bucket2:decimal option,
>           bucket3:decimal option, bucket4:decimal option,
>           bucket5:decimal option}
val r9 = q9 ();
