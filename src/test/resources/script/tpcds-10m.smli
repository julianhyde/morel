(* --- q58 -------------------------------------------------------- *)
(*
WITH ss_items AS
(SELECT
    i_item_id item_id,
    sum(ss_ext_sales_price) ss_item_rev
  FROM store_sales, item, date_dim
  WHERE ss_item_sk = i_item_sk
    AND d_date IN (SELECT d_date
  FROM date_dim
  WHERE d_week_seq = (SELECT d_week_seq
  FROM date_dim
  WHERE d_date = '2000-01-03'))
    AND ss_sold_date_sk = d_date_sk
  GROUP BY i_item_id),
    cs_items AS
  (SELECT
    i_item_id item_id,
    sum(cs_ext_sales_price) cs_item_rev
  FROM catalog_sales, item, date_dim
  WHERE cs_item_sk = i_item_sk
    AND d_date IN (SELECT d_date
  FROM date_dim
  WHERE d_week_seq = (SELECT d_week_seq
  FROM date_dim
  WHERE d_date = '2000-01-03'))
    AND cs_sold_date_sk = d_date_sk
  GROUP BY i_item_id),
    ws_items AS
  (SELECT
    i_item_id item_id,
    sum(ws_ext_sales_price) ws_item_rev
  FROM web_sales, item, date_dim
  WHERE ws_item_sk = i_item_sk
    AND d_date IN (SELECT d_date
  FROM date_dim
  WHERE d_week_seq = (SELECT d_week_seq
  FROM date_dim
  WHERE d_date = '2000-01-03'))
    AND ws_sold_date_sk = d_date_sk
  GROUP BY i_item_id)
SELECT
  ss_items.item_id,
  ss_item_rev,
  ss_item_rev / (ss_item_rev + cs_item_rev + ws_item_rev) / 3 * 100 ss_dev,
  cs_item_rev,
  cs_item_rev / (ss_item_rev + cs_item_rev + ws_item_rev) / 3 * 100 cs_dev,
  ws_item_rev,
  ws_item_rev / (ss_item_rev + cs_item_rev + ws_item_rev) / 3 * 100 ws_dev,
  (ss_item_rev + cs_item_rev + ws_item_rev) / 3 average
FROM ss_items, cs_items, ws_items
WHERE ss_items.item_id = cs_items.item_id
  AND ss_items.item_id = ws_items.item_id
  AND ss_item_rev BETWEEN 0.9 * cs_item_rev AND 1.1 * cs_item_rev
  AND ss_item_rev BETWEEN 0.9 * ws_item_rev AND 1.1 * ws_item_rev
  AND cs_item_rev BETWEEN 0.9 * ss_item_rev AND 1.1 * ss_item_rev
  AND cs_item_rev BETWEEN 0.9 * ws_item_rev AND 1.1 * ws_item_rev
  AND ws_item_rev BETWEEN 0.9 * ss_item_rev AND 1.1 * ss_item_rev
  AND ws_item_rev BETWEEN 0.9 * cs_item_rev AND 1.1 * cs_item_rev
ORDER BY item_id, ss_item_rev
LIMIT 100
*)
fun q58 () =
  let
    fun day (year, month, day) =
      Date.date {year, month, day, hour = 0, minute = 0, second = 0,
        offset = SOME Time.zeroTime}
    (* The scalar subquery "(SELECT d_week_seq ... WHERE d_date = ...)" *)
    val week =
      Relational.only
        (from d in tpcds.date_dim
          where d.d_date = SOME (day (2000, Jan, 3))
          yield d.d_week_seq)
    val dates =
      from d in tpcds.date_dim
        where week <> NONE andalso d.d_week_seq = week
        yield d.d_date
    val ss_items =
      from ss in tpcds.store_sales,
          i in tpcds.item,
          d in tpcds.date_dim
        where ss.ss_item_sk = i.i_item_sk
          andalso d.d_date elem dates
          andalso ss.ss_sold_date_sk = SOME d.d_date_sk
        group {item_id = i.i_item_id}
          compute {ss_item_rev = sumSome over ss.ss_ext_sales_price}
    val cs_items =
      from cs in tpcds.catalog_sales,
          i in tpcds.item,
          d in tpcds.date_dim
        where cs.cs_item_sk = i.i_item_sk
          andalso d.d_date elem dates
          andalso cs.cs_sold_date_sk = SOME d.d_date_sk
        group {item_id = i.i_item_id}
          compute {cs_item_rev = sumSome over cs.cs_ext_sales_price}
    val ws_items =
      from ws in tpcds.web_sales,
          i in tpcds.item,
          d in tpcds.date_dim
        where ws.ws_item_sk = i.i_item_sk
          andalso d.d_date elem dates
          andalso ws.ws_sold_date_sk = SOME d.d_date_sk
        group {item_id = i.i_item_id}
          compute {ws_item_rev = sumSome over ws.ws_ext_sales_price}
    (* "x BETWEEN 0.9 * y AND 1.1 * y" *)
    fun near (x, y) =
      case (x, y) of
          (SOME x, SOME y) =>
            x >= decimal "0.9" * y andalso x <= decimal "1.1" * y
        | _ => false
    (* "rev / total / 3 * 100" *)
    fun dev (rev, total) =
      case (rev, total) of
          (SOME r, SOME t) =>
            SOME (r / t / Decimal.fromInt 3 * Decimal.fromInt 100)
        | _ => NONE
  in
    from ss in ss_items,
        cs in cs_items,
        ws in ws_items
      where ss.item_id = cs.item_id
        andalso ss.item_id = ws.item_id
        andalso near (ss.ss_item_rev, cs.cs_item_rev)
        andalso near (ss.ss_item_rev, ws.ws_item_rev)
        andalso near (cs.cs_item_rev, ss.ss_item_rev)
        andalso near (cs.cs_item_rev, ws.ws_item_rev)
        andalso near (ws.ws_item_rev, ss.ss_item_rev)
        andalso near (ws.ws_item_rev, cs.cs_item_rev)
      yield {ss, cs, ws,
        total =
          case (ss.ss_item_rev, cs.cs_item_rev, ws.ws_item_rev) of
              (SOME s, SOME c, SOME w) => SOME (s + c + w)
            | _ => NONE}
      yield {ss.item_id, ss.ss_item_rev,
        ss_dev = dev (ss.ss_item_rev, total),
        cs.cs_item_rev,
        cs_dev = dev (cs.cs_item_rev, total),
        ws.ws_item_rev,
        ws_dev = dev (ws.ws_item_rev, total),
        average = Option.map (fn t => t / Decimal.fromInt 3) total}
      order (item_id, ss_item_rev)
      take 100
  end;
> val q58 = fn
>   : unit
>      -> {average:decimal option, cs_dev:decimal option,
>           cs_item_rev:decimal option, item_id:string, ss_dev:decimal option,
>           ss_item_rev:decimal option, ws_dev:decimal option,
>           ws_item_rev:decimal option} list
val r58 = q58 ();
> average cs_dev cs_item_rev item_id ss_dev ss_item_rev ws_dev ws_item_rev
> ------- ------ ----------- ------- ------ ----------- ------ -----------
>
> val r58 : {average:decimal option, cs_dev:decimal option, cs_item_rev:decimal option, item_id:string, ss_dev:decimal option, ss_item_rev:decimal option, ws_dev:decimal option, ws_item_rev:decimal option} list

(* --- q59 -------------------------------------------------------- *)
(*
WITH wss AS
(SELECT
    d_week_seq,
    ss_store_sk,
    sum(CASE WHEN (d_day_name = 'Sunday')
      THEN ss_sales_price
        ELSE NULL END) sun_sales,
    sum(CASE WHEN (d_day_name = 'Monday')
      THEN ss_sales_price
        ELSE NULL END) mon_sales,
    sum(CASE WHEN (d_day_name = 'Tuesday')
      THEN ss_sales_price
        ELSE NULL END) tue_sales,
    sum(CASE WHEN (d_day_name = 'Wednesday')
      THEN ss_sales_price
        ELSE NULL END) wed_sales,
    sum(CASE WHEN (d_day_name = 'Thursday')
      THEN ss_sales_price
        ELSE NULL END) thu_sales,
    sum(CASE WHEN (d_day_name = 'Friday')
      THEN ss_sales_price
        ELSE NULL END) fri_sales,
    sum(CASE WHEN (d_day_name = 'Saturday')
      THEN ss_sales_price
        ELSE NULL END) sat_sales
  FROM store_sales, date_dim
  WHERE d_date_sk = ss_sold_date_sk
  GROUP BY d_week_seq, ss_store_sk
)
SELECT
  s_store_name1,
  s_store_id1,
  d_week_seq1,
  sun_sales1 / sun_sales2,
  mon_sales1 / mon_sales2,
  tue_sales1 / tue_sales2,
  wed_sales1 / wed_sales2,
  thu_sales1 / thu_sales2,
  fri_sales1 / fri_sales2,
  sat_sales1 / sat_sales2
FROM
  (SELECT
    s_store_name s_store_name1,
    wss.d_week_seq d_week_seq1,
    s_store_id s_store_id1,
    sun_sales sun_sales1,
    mon_sales mon_sales1,
    tue_sales tue_sales1,
    wed_sales wed_sales1,
    thu_sales thu_sales1,
    fri_sales fri_sales1,
    sat_sales sat_sales1
  FROM wss, store, date_dim d
  WHERE d.d_week_seq = wss.d_week_seq AND
    ss_store_sk = s_store_sk AND
    d_month_seq BETWEEN 1212 AND 1212 + 11) y,
  (SELECT
    s_store_name s_store_name2,
    wss.d_week_seq d_week_seq2,
    s_store_id s_store_id2,
    sun_sales sun_sales2,
    mon_sales mon_sales2,
    tue_sales tue_sales2,
    wed_sales wed_sales2,
    thu_sales thu_sales2,
    fri_sales fri_sales2,
    sat_sales sat_sales2
  FROM wss, store, date_dim d
  WHERE d.d_week_seq = wss.d_week_seq AND
    ss_store_sk = s_store_sk AND
    d_month_seq BETWEEN 1212 + 12 AND 1212 + 23) x
WHERE s_store_id1 = s_store_id2
  AND d_week_seq1 = d_week_seq2 - 52
ORDER BY s_store_name1, s_store_id1, d_week_seq1
LIMIT 100
*)
fun q59 () =
  let
    val wss =
      from ss in tpcds.store_sales,
          d in tpcds.date_dim
        where ss.ss_sold_date_sk = SOME d.d_date_sk
        group {d.d_week_seq, ss.ss_store_sk}
          compute {
        sun_sales = sumSome over (if d.d_day_name = SOME "Sunday"
          then ss.ss_sales_price else NONE),
        mon_sales = sumSome over (if d.d_day_name = SOME "Monday"
          then ss.ss_sales_price else NONE),
        tue_sales = sumSome over (if d.d_day_name = SOME "Tuesday"
          then ss.ss_sales_price else NONE),
        wed_sales = sumSome over (if d.d_day_name = SOME "Wednesday"
          then ss.ss_sales_price else NONE),
        thu_sales = sumSome over (if d.d_day_name = SOME "Thursday"
          then ss.ss_sales_price else NONE),
        fri_sales = sumSome over (if d.d_day_name = SOME "Friday"
          then ss.ss_sales_price else NONE),
        sat_sales = sumSome over (if d.d_day_name = SOME "Saturday"
          then ss.ss_sales_price else NONE)}
    (* "a / b" *)
    fun divide (a : decimal option, b) =
      case (a, b) of
          (SOME x, SOME y) => SOME (x / y)
        | _ => NONE
    fun weeks (lo, hi) =
      from w in wss,
          s in tpcds.store,
          d in tpcds.date_dim
        where d.d_week_seq <> NONE
          andalso d.d_week_seq = w.d_week_seq
          andalso w.ss_store_sk = SOME s.s_store_sk
          andalso d.d_month_seq >= SOME lo
          andalso d.d_month_seq <= SOME hi
        yield {w, s.s_store_name, s.s_store_id}
  in
    from y in weeks (1212, 1212 + 11),
        x in weeks (1212 + 12, 1212 + 23)
      where y.s_store_id = x.s_store_id
        andalso y.w.d_week_seq
          = Option.map (fn s => s - 52) x.w.d_week_seq
      yield {s_store_name1 = y.s_store_name, s_store_id1 = y.s_store_id,
        d_week_seq1 = y.w.d_week_seq,
        `(sun_sales1 / sun_sales2)` =
          divide (y.w.sun_sales, x.w.sun_sales),
        `(mon_sales1 / mon_sales2)` =
          divide (y.w.mon_sales, x.w.mon_sales),
        `(tue_sales1 / tue_sales2)` =
          divide (y.w.tue_sales, x.w.tue_sales),
        `(wed_sales1 / wed_sales2)` =
          divide (y.w.wed_sales, x.w.wed_sales),
        `(thu_sales1 / thu_sales2)` =
          divide (y.w.thu_sales, x.w.thu_sales),
        `(fri_sales1 / fri_sales2)` =
          divide (y.w.fri_sales, x.w.fri_sales),
        `(sat_sales1 / sat_sales2)` =
          divide (y.w.sat_sales, x.w.sat_sales)}
      order (s_store_name1, s_store_id1, d_week_seq1)
      take 100
  end;
> val q59 = fn
>   : unit
>      -> {`(fri_sales1 / fri_sales2)`:decimal option,
>           `(mon_sales1 / mon_sales2)`:decimal option,
>           `(sat_sales1 / sat_sales2)`:decimal option,
>           `(sun_sales1 / sun_sales2)`:decimal option,
>           `(thu_sales1 / thu_sales2)`:decimal option,
>           `(tue_sales1 / tue_sales2)`:decimal option,
>           `(wed_sales1 / wed_sales2)`:decimal option, d_week_seq1:int option,
>           s_store_id1:string, s_store_name1:string option} list
val r59 = q59 ();
