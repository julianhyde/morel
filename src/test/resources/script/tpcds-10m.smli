>
> val r50 : {`30 days `:int, `31 - 60 days `:int, `61 - 90 days `:int, `91 - 120 days `:int, `>120 days `:int, s_city:string option, s_company_id:int option, s_county:string option, s_state:string option, s_store_name:string option, s_street_name:string option, s_street_number:string option, s_street_type:string option, s_suite_number:string option, s_zip:string option} list

(* --- q51 -------------------------------------------------------- *)
(*
WITH web_v1 AS (
  SELECT
    ws_item_sk item_sk,
    d_date,
    sum(sum(ws_sales_price))
    OVER (PARTITION BY ws_item_sk
      ORDER BY d_date
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) cume_sales
  FROM web_sales, date_dim
  WHERE ws_sold_date_sk = d_date_sk
    AND d_month_seq BETWEEN 1200 AND 1200 + 11
    AND ws_item_sk IS NOT NULL
  GROUP BY ws_item_sk, d_date),
    store_v1 AS (
    SELECT
      ss_item_sk item_sk,
      d_date,
      sum(sum(ss_sales_price))
      OVER (PARTITION BY ss_item_sk
        ORDER BY d_date
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) cume_sales
    FROM store_sales, date_dim
    WHERE ss_sold_date_sk = d_date_sk
      AND d_month_seq BETWEEN 1200 AND 1200 + 11
      AND ss_item_sk IS NOT NULL
    GROUP BY ss_item_sk, d_date)
SELECT *
FROM (SELECT
  item_sk,
  d_date,
  web_sales,
  store_sales,
  max(web_sales)
  OVER (PARTITION BY item_sk
    ORDER BY d_date
    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) web_cumulative,
  max(store_sales)
  OVER (PARTITION BY item_sk
    ORDER BY d_date
    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) store_cumulative
FROM (SELECT
  CASE WHEN web.item_sk IS NOT NULL
    THEN web.item_sk
  ELSE store.item_sk END item_sk,
  CASE WHEN web.d_date IS NOT NULL
    THEN web.d_date
  ELSE store.d_date END d_date,
  web.cume_sales web_sales,
  store.cume_sales store_sales
FROM web_v1 web FULL OUTER JOIN store_v1 store ON (web.item_sk = store.item_sk
  AND web.d_date = store.d_date)
     ) x) y
WHERE web_cumulative > store_cumulative
ORDER BY item_sk, d_date
LIMIT 100
*)
(* "sum(sum(x)) OVER (PARTITION BY item ORDER BY d_date ROWS BETWEEN
 * UNBOUNDED PRECEDING AND CURRENT ROW)" is a running total of each item's
 * days, in date order; the days of each item are collected, sorted, and
 * folded. "max(...) OVER (...)" likewise. Both ignore NONE, as SQL's
 * aggregates ignore null. (A total for each row over the rows before it
 * would take time quadratic in the number of an item's days.) *)
fun q51 () =
  let
    (* "a + b" and the greater of "a" and "b", ignoring NONE *)
    fun plus (NONE, b) = b
      | plus (a, NONE) = a
      | plus (SOME (a : decimal), SOME b) = SOME (a + b)
    fun greater (NONE, b) = b
      | greater (a, NONE) = a
      | greater (SOME (a : decimal), SOME b) = SOME (if a > b then a else b)
    (* For each item, its days sorted by date, each with the running
     * value of "f" over "value" up to and including that day.
     * "running" is for the days of one channel, "running2" for the rows
     * of the join; Morel does not generalize one function to both row
     * types. *)
    fun running f item date value rows =
      from g in (from r in rows
            group {k = item r}
              compute {days = (fn rs => from x in rs order date x) over r}),
          x in List.rev (#2 (List.foldl
            (fn (day, (acc, out)) =>
              let
                val acc2 = f (acc, value day)
              in
                (acc2, {day, cume = acc2} :: out)
              end)
            (NONE, []) g.days))
        yield {item_sk = g.k, x.day, x.cume}
    fun running2 f item date value rows =
      from g in (from r in rows
            group {k = item r}
              compute {days = (fn rs => from x in rs order date x) over r}),
          x in List.rev (#2 (List.foldl
            (fn (day, (acc, out)) =>
              let
                val acc2 = f (acc, value day)
              in
                (acc2, {day, cume = acc2} :: out)
              end)
            (NONE, []) g.days))
        yield {item_sk = g.k, x.day, x.cume}
    val web_v1 =
      from x in running plus #item_sk #d_date #sales (
      from ws in tpcds.web_sales,
          d in tpcds.date_dim
        where ws.ws_sold_date_sk = SOME d.d_date_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        group {item_sk = ws.ws_item_sk, d.d_date}
          compute {sales = sumSome over ws.ws_sales_price})
        yield {x.item_sk, x.day.d_date, cume_sales = x.cume}
    val store_v1 =
      from x in running plus #item_sk #d_date #sales (
      from ss in tpcds.store_sales,
          d in tpcds.date_dim
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        group {item_sk = ss.ss_item_sk, d.d_date}
          compute {sales = sumSome over ss.ss_sales_price})
        yield {x.item_sk, x.day.d_date, cume_sales = x.cume}
    val joined =
      from web in web_v1
        full join store in store_v1
          on web.item_sk = store.item_sk
            andalso web.d_date <> NONE
            andalso web.d_date = store.d_date
        yield {item_sk =
            case (web, store) of
                (SOME w, _) => w.item_sk
              | (_, SOME s) => s.item_sk
              | _ => raise Fail "no side",
          d_date =
            case Option.`join` web?.d_date of
                SOME d => SOME d
              | NONE => Option.`join` store?.d_date,
          web_sales = Option.`join` web?.cume_sales,
          store_sales = Option.`join` store?.cume_sales}
    val web_cumulative =
      from x in running2 greater #item_sk #d_date #web_sales joined
        yield {x.item_sk, x.day.d_date, x.day.web_sales, x.day.store_sales,
          web_cumulative = x.cume}
  in
    from y in web_cumulative,
        z in running2 greater #item_sk #d_date #store_sales joined
      where z.item_sk = y.item_sk
        andalso z.day.d_date = y.d_date
        andalso z.day.web_sales = y.web_sales
        andalso (case (y.web_cumulative, z.cume) of
                    (SOME w, SOME s) => w > s
                  | _ => false)
      order (y.item_sk, y.d_date)
      yield {y.item_sk, y.d_date, y.web_sales, y.store_sales,
        y.web_cumulative, store_cumulative = z.cume}
      take 100
  end;
> val q51 = fn
>   : unit
>      -> {d_date:'a option, item_sk:int, store_cumulative:decimal option,
>           store_sales:decimal option, web_cumulative:decimal option,
>           web_sales:decimal option} list
val r51 = q51 ();
