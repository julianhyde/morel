> val r15 : {ca_zip:string option, sum:decimal option} list

(* --- q16 -------------------------------------------------------- *)
(*
SELECT
  count(DISTINCT cs_order_number) AS `order count `,
  sum(cs_ext_ship_cost) AS `total shipping cost `,
  sum(cs_net_profit) AS `total net profit `
FROM
  catalog_sales cs1, date_dim, customer_address, call_center
WHERE
  d_date BETWEEN '2002-02-01' AND (CAST('2002-02-01' AS DATE) + INTERVAL 60 days)
    AND cs1.cs_ship_date_sk = d_date_sk
    AND cs1.cs_ship_addr_sk = ca_address_sk
    AND ca_state = 'GA'
    AND cs1.cs_call_center_sk = cc_call_center_sk
    AND cc_county IN
    ('Williamson County', 'Williamson County', 'Williamson County', 'Williamson County', 'Williamson County')
    AND EXISTS(SELECT *
               FROM catalog_sales cs2
               WHERE cs1.cs_order_number = cs2.cs_order_number
                 AND cs1.cs_warehouse_sk <> cs2.cs_warehouse_sk)
    AND NOT EXISTS(SELECT *
                   FROM catalog_returns cr1
                   WHERE cs1.cs_order_number = cr1.cr_order_number)
ORDER BY count(DISTINCT cs_order_number)
LIMIT 100
*)
fun q16 () =
  let
    fun day (year, month, day) =
      Date.date {year, month, day, hour = 0, minute = 0, second = 0,
        offset = SOME Time.zeroTime}
  in
    from cs1 in tpcds.catalog_sales,
        d in tpcds.date_dim,
        ca in tpcds.customer_address,
        cc in tpcds.call_center
      where d.d_date >= SOME (day (2002, Feb, 1))
        andalso d.d_date <= SOME (day (2002, Feb, 1 + 60))
        andalso cs1.cs_ship_date_sk = SOME d.d_date_sk
        andalso cs1.cs_ship_addr_sk = SOME ca.ca_address_sk
        andalso ca.ca_state = SOME "GA"
        andalso cs1.cs_call_center_sk = SOME cc.cc_call_center_sk
        andalso cc.cc_county elem [SOME "Williamson County"]
        andalso (exists cs2 in tpcds.catalog_sales
          where cs1.cs_order_number = cs2.cs_order_number
            andalso cs1.cs_warehouse_sk <> NONE
            andalso cs2.cs_warehouse_sk <> NONE
            andalso cs1.cs_warehouse_sk <> cs2.cs_warehouse_sk)
        andalso not (exists cr1 in tpcds.catalog_returns
          where cs1.cs_order_number = cr1.cr_order_number)
      compute {
        `order count ` =
          (fn orders => List.length (from n in orders distinct))
            over cs1.cs_order_number,
        `total shipping cost ` = sumSome over cs1.cs_ext_ship_cost,
        `total net profit ` = sumSome over cs1.cs_net_profit}
  end;
> val q16 = fn
>   : unit
>      -> {`order count `:int, `total net profit `:decimal option,
>           `total shipping cost `:decimal option}
val r16 = q16 ();
> val r16 =
>   {`order count `=0,`total net profit `=NONE,`total shipping cost `=NONE}
>   : {`order count `:int, `total net profit `:decimal option,
>       `total shipping cost `:decimal option}

(* --- q17 -------------------------------------------------------- *)
(*
SELECT
  i_item_id,
  i_item_desc,
  s_state,
  count(ss_quantity) AS store_sales_quantitycount,
  avg(ss_quantity) AS store_sales_quantityave,
  stddev_samp(ss_quantity) AS store_sales_quantitystdev,
  stddev_samp(ss_quantity) / avg(ss_quantity) AS store_sales_quantitycov,
  count(sr_return_quantity) as_store_returns_quantitycount,
  avg(sr_return_quantity) as_store_returns_quantityave,
  stddev_samp(sr_return_quantity) as_store_returns_quantitystdev,
  stddev_samp(sr_return_quantity) / avg(sr_return_quantity) AS store_returns_quantitycov,
  count(cs_quantity) AS catalog_sales_quantitycount,
  avg(cs_quantity) AS catalog_sales_quantityave,
  stddev_samp(cs_quantity) / avg(cs_quantity) AS catalog_sales_quantitystdev,
  stddev_samp(cs_quantity) / avg(cs_quantity) AS catalog_sales_quantitycov
FROM store_sales, store_returns, catalog_sales, date_dim d1, date_dim d2, date_dim d3, store, item
WHERE d1.d_quarter_name = '2001Q1'
  AND d1.d_date_sk = ss_sold_date_sk
  AND i_item_sk = ss_item_sk
  AND s_store_sk = ss_store_sk
  AND ss_customer_sk = sr_customer_sk
  AND ss_item_sk = sr_item_sk
  AND ss_ticket_number = sr_ticket_number
  AND sr_returned_date_sk = d2.d_date_sk
  AND d2.d_quarter_name IN ('2001Q1', '2001Q2', '2001Q3')
  AND sr_customer_sk = cs_bill_customer_sk
  AND sr_item_sk = cs_item_sk
  AND cs_sold_date_sk = d3.d_date_sk
  AND d3.d_quarter_name IN ('2001Q1', '2001Q2', '2001Q3')
GROUP BY i_item_id, i_item_desc, s_state
ORDER BY i_item_id, i_item_desc, s_state
LIMIT 100
*)
fun q17 () =
  let
    (* "stddev_samp(x)": the sample standard deviation of the values of
     * the SOMEs, or NONE if there are fewer than two. The sums are exact
     * ints; only the square root is real. *)
    fun stddevSamp xs =
      let
        val vs = somes xs
        val n = count vs
        val s = sum vs
        val s2 = sum (from v in vs yield v * v)
      in
        if n < 2 then NONE
        else
          SOME (Math.sqrt (Real.fromInt (n * s2 - s * s)
            / Real.fromInt (n * (n - 1))))
      end
    (* "a / b" of two reals that may be NONE *)
    fun divide (a, b) =
      case (a, b) of
          (SOME a, SOME b) => SOME (a / b)
        | _ => NONE
  in
    from ss in tpcds.store_sales,
        sr in tpcds.store_returns,
        cs in tpcds.catalog_sales,
        d1 in tpcds.date_dim,
        d2 in tpcds.date_dim,
        d3 in tpcds.date_dim,
        s in tpcds.store,
        i in tpcds.item
      where d1.d_quarter_name = SOME "2001Q1"
        andalso ss.ss_sold_date_sk = SOME d1.d_date_sk
        andalso ss.ss_item_sk = i.i_item_sk
        andalso ss.ss_store_sk = SOME s.s_store_sk
        andalso ss.ss_customer_sk <> NONE
        andalso ss.ss_customer_sk = sr.sr_customer_sk
        andalso ss.ss_item_sk = sr.sr_item_sk
        andalso ss.ss_ticket_number = sr.sr_ticket_number
        andalso sr.sr_returned_date_sk = SOME d2.d_date_sk
        andalso d2.d_quarter_name
          elem [SOME "2001Q1", SOME "2001Q2", SOME "2001Q3"]
        andalso sr.sr_customer_sk = cs.cs_bill_customer_sk
        andalso sr.sr_item_sk = cs.cs_item_sk
        andalso cs.cs_sold_date_sk = SOME d3.d_date_sk
        andalso d3.d_quarter_name
          elem [SOME "2001Q1", SOME "2001Q2", SOME "2001Q3"]
      group {i.i_item_id, i.i_item_desc, s.s_state}
          compute {store_sales_quantitycount = countSome over ss.ss_quantity,
            store_sales_quantityave = avgSome over ss.ss_quantity,
            sd_store_sales = stddevSamp over ss.ss_quantity,
            as_store_returns_quantitycount = countSome over sr.sr_return_quantity,
            as_store_returns_quantityave = avgSome over sr.sr_return_quantity,
            sd_store_returns = stddevSamp over sr.sr_return_quantity,
            catalog_sales_quantitycount = countSome over cs.cs_quantity,
            catalog_sales_quantityave = avgSome over cs.cs_quantity,
            sd_catalog_sales = stddevSamp over cs.cs_quantity}
      order (i_item_id, i_item_desc, s_state)
      yield {i_item_id, i_item_desc, s_state, store_sales_quantitycount,
        store_sales_quantityave,
        store_sales_quantitystdev = sd_store_sales,
        store_sales_quantitycov =
          divide (sd_store_sales, store_sales_quantityave),
        as_store_returns_quantitycount, as_store_returns_quantityave,
        as_store_returns_quantitystdev = sd_store_returns,
        store_returns_quantitycov =
          divide (sd_store_returns, as_store_returns_quantityave),
        catalog_sales_quantitycount, catalog_sales_quantityave,
        (* As in the SQL, this "stdev" is the coefficient of variation. *)
        catalog_sales_quantitystdev =
          divide (sd_catalog_sales, catalog_sales_quantityave),
        catalog_sales_quantitycov =
          divide (sd_catalog_sales, catalog_sales_quantityave)}
      take 100
  end;
> val q17 = fn
>   : unit
>      -> {as_store_returns_quantityave:real option,
>           as_store_returns_quantitycount:int,
>           as_store_returns_quantitystdev:real option,
>           catalog_sales_quantityave:real option,
>           catalog_sales_quantitycount:int,
>           catalog_sales_quantitycov:real option,
>           catalog_sales_quantitystdev:real option, i_item_desc:string option,
>           i_item_id:string, s_state:string option,
>           store_returns_quantitycov:real option,
>           store_sales_quantityave:real option, store_sales_quantitycount:int,
>           store_sales_quantitycov:real option,
>           store_sales_quantitystdev:real option} list
val r17 = q17 ();
> as_store_returns_quantityave as_store_returns_quantitycount as_store_returns_quantitystdev catalog_sales_quantityave catalog_sales_quantitycount catalog_sales_quantitycov catalog_sales_quantitystdev i_item_desc                                                             i_item_id        s_state store_returns_quantitycov store_sales_quantityave store_sales_quantitycount store_sales_quantitycov store_sales_quantitystdev
