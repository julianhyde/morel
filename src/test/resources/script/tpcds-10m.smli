(* --- q97 -------------------------------------------------------- *)
(*
WITH ssci AS (
  SELECT
    ss_customer_sk customer_sk,
    ss_item_sk item_sk
  FROM store_sales, date_dim
  WHERE ss_sold_date_sk = d_date_sk
    AND d_month_seq BETWEEN 1200 AND 1200 + 11
  GROUP BY ss_customer_sk, ss_item_sk),
    csci AS (
    SELECT
      cs_bill_customer_sk customer_sk,
      cs_item_sk item_sk
    FROM catalog_sales, date_dim
    WHERE cs_sold_date_sk = d_date_sk
      AND d_month_seq BETWEEN 1200 AND 1200 + 11
    GROUP BY cs_bill_customer_sk, cs_item_sk)
SELECT
  sum(CASE WHEN ssci.customer_sk IS NOT NULL AND csci.customer_sk IS NULL
    THEN 1
      ELSE 0 END) store_only,
  sum(CASE WHEN ssci.customer_sk IS NULL AND csci.customer_sk IS NOT NULL
    THEN 1
      ELSE 0 END) catalog_only,
  sum(CASE WHEN ssci.customer_sk IS NOT NULL AND csci.customer_sk IS NOT NULL
    THEN 1
      ELSE 0 END) store_and_catalog
FROM ssci
  FULL OUTER JOIN csci ON (ssci.customer_sk = csci.customer_sk
    AND ssci.item_sk = csci.item_sk)
LIMIT 100
*)
fun q97 () =
  let
    val ssci =
      from ss in tpcds.store_sales,
          d in tpcds.date_dim
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        group {customer_sk = ss.ss_customer_sk, item_sk = ss.ss_item_sk}
    val csci =
      from cs in tpcds.catalog_sales,
          d in tpcds.date_dim
        where cs.cs_sold_date_sk = SOME d.d_date_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        group {customer_sk = cs.cs_bill_customer_sk, item_sk = cs.cs_item_sk}
  in
    from s in ssci
      full join c in csci
        on s.customer_sk <> NONE
          andalso s.customer_sk = c.customer_sk
          andalso s.item_sk = c.item_sk
      compute {
        store_only = sum over
          (case (Option.`join` s?.customer_sk,
              Option.`join` c?.customer_sk) of
              (SOME _, NONE) => 1
            | _ => 0),
        catalog_only = sum over
          (case (Option.`join` s?.customer_sk,
              Option.`join` c?.customer_sk) of
              (NONE, SOME _) => 1
            | _ => 0),
        store_and_catalog = sum over
          (case (Option.`join` s?.customer_sk,
              Option.`join` c?.customer_sk) of
              (SOME _, SOME _) => 1
            | _ => 0)}
  end;
> val q97 = fn
>   : unit -> {catalog_only:int, store_and_catalog:int, store_only:int}
val r97 = q97 ();
> val r97 = {catalog_only=16944,store_and_catalog=391,store_only=22255}
>   : {catalog_only:int, store_and_catalog:int, store_only:int}

(* --- q98 -------------------------------------------------------- *)
(*
SELECT
  i_item_desc,
  i_category,
  i_class,
  i_current_price,
  sum(ss_ext_sales_price) AS itemrevenue,
  sum(ss_ext_sales_price) * 100 / sum(sum(ss_ext_sales_price))
  OVER
  (PARTITION BY i_class) AS revenueratio
FROM
  store_sales, item, date_dim
WHERE
  ss_item_sk = i_item_sk
    AND i_category IN ('Sports', 'Books', 'Home')
    AND ss_sold_date_sk = d_date_sk
    AND d_date BETWEEN cast('1999-02-22' AS DATE)
  AND (cast('1999-02-22' AS DATE) + INTERVAL 30 days)
GROUP BY
  i_item_id, i_item_desc, i_category, i_class, i_current_price
ORDER BY
  i_category, i_class, i_item_id, i_item_desc, revenueratio
*)
(* "SUM(...) OVER (PARTITION BY i_class)" is each class's total, joined
 * to the class's rows. A partition is not a join: its NONE class is one
 * partition, as NONE = NONE. *)
fun q98 () =
  let
    val items =
      from ss in tpcds.store_sales,
          i in tpcds.item,
          d in tpcds.date_dim
        where ss.ss_item_sk = i.i_item_sk
          andalso i.i_category elem [SOME "Sports", SOME "Books", SOME "Home"]
          andalso ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso d.d_date >= SOME (day (1999, Feb, 22))
          andalso d.d_date <= SOME (day (1999, Feb, 22 + 30))
        group {i.i_item_id, i.i_item_desc, i.i_category, i.i_class,
            i.i_current_price}
          compute {itemrevenue = sumSome over ss.ss_ext_sales_price}
    val classes =
      from r in items
        group r.i_class compute {total = sumSome over r.itemrevenue}
  in
    from r in items,
        c in classes
      where c.i_class = r.i_class
      yield {r.i_item_id, r.i_item_desc, r.i_category, r.i_class,
        r.i_current_price, r.itemrevenue,
        revenueratio =
          case (r.itemrevenue, c.total) of
              (SOME revenue, SOME total) =>
                SOME (revenue * Decimal.fromInt 100 / total)
            | _ => NONE}
      order (i_category, i_class, i_item_id, i_item_desc, revenueratio)
      yield {i_item_desc, i_category, i_class, i_current_price, itemrevenue,
        revenueratio}
  end;
