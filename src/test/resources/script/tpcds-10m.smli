>    bucket3=SOME 1733.56394073478144274604451595602,
>    bucket4=SOME 2390.126369615112994350282485875706,
>    bucket5=SOME 3077.374826869499845221775085128024}
>   : {bucket1:decimal option, bucket2:decimal option, bucket3:decimal option,
>       bucket4:decimal option, bucket5:decimal option}

(* --- q10 -------------------------------------------------------- *)
(*
SELECT
  cd_gender,
  cd_marital_status,
  cd_education_status,
  count(*) cnt1,
  cd_purchase_estimate,
  count(*) cnt2,
  cd_credit_rating,
  count(*) cnt3,
  cd_dep_count,
  count(*) cnt4,
  cd_dep_employed_count,
  count(*) cnt5,
  cd_dep_college_count,
  count(*) cnt6
FROM
  customer c, customer_address ca, customer_demographics
WHERE
  c.c_current_addr_sk = ca.ca_address_sk AND
    ca_county IN ('Rush County', 'Toole County', 'Jefferson County',
                  'Dona Ana County', 'La Porte County') AND
    cd_demo_sk = c.c_current_cdemo_sk AND
    exists(SELECT *
           FROM store_sales, date_dim
           WHERE c.c_customer_sk = ss_customer_sk AND
             ss_sold_date_sk = d_date_sk AND
             d_year = 2002 AND
             d_moy BETWEEN 1 AND 1 + 3) AND
    (exists(SELECT *
            FROM web_sales, date_dim
            WHERE c.c_customer_sk = ws_bill_customer_sk AND
              ws_sold_date_sk = d_date_sk AND
              d_year = 2002 AND
              d_moy BETWEEN 1 AND 1 + 3) OR
      exists(SELECT *
             FROM catalog_sales, date_dim
             WHERE c.c_customer_sk = cs_ship_customer_sk AND
               cs_sold_date_sk = d_date_sk AND
               d_year = 2002 AND
               d_moy BETWEEN 1 AND 1 + 3))
GROUP BY cd_gender,
  cd_marital_status,
  cd_education_status,
  cd_purchase_estimate,
  cd_credit_rating,
  cd_dep_count,
  cd_dep_employed_count,
  cd_dep_college_count
ORDER BY cd_gender,
  cd_marital_status,
  cd_education_status,
  cd_purchase_estimate,
  cd_credit_rating,
  cd_dep_count,
  cd_dep_employed_count,
  cd_dep_college_count
LIMIT 100
*)
fun q10 () =
  from c in tpcds.customer,
      ca in tpcds.customer_address,
      cd in tpcds.customer_demographics
    where c.c_current_addr_sk = SOME ca.ca_address_sk
      andalso ca.ca_county elem [SOME "Rush County", SOME "Toole County",
        SOME "Jefferson County", SOME "Dona Ana County",
        SOME "La Porte County"]
      andalso c.c_current_cdemo_sk = SOME cd.cd_demo_sk
      andalso (exists ss in tpcds.store_sales, d in tpcds.date_dim
        where ss.ss_customer_sk = SOME c.c_customer_sk
          andalso ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso d.d_year = SOME 2002
          andalso d.d_moy >= SOME 1
          andalso d.d_moy <= SOME (1 + 3))
      andalso ((exists ws in tpcds.web_sales, d in tpcds.date_dim
          where ws.ws_bill_customer_sk = SOME c.c_customer_sk
            andalso ws.ws_sold_date_sk = SOME d.d_date_sk
            andalso d.d_year = SOME 2002
            andalso d.d_moy >= SOME 1
            andalso d.d_moy <= SOME (1 + 3))
        orelse (exists cs in tpcds.catalog_sales, d in tpcds.date_dim
          where cs.cs_ship_customer_sk = SOME c.c_customer_sk
            andalso cs.cs_sold_date_sk = SOME d.d_date_sk
            andalso d.d_year = SOME 2002
            andalso d.d_moy >= SOME 1
            andalso d.d_moy <= SOME (1 + 3)))
    group {cd.cd_gender, cd.cd_marital_status, cd.cd_education_status,
        cd.cd_purchase_estimate, cd.cd_credit_rating, cd.cd_dep_count,
        cd.cd_dep_employed_count, cd.cd_dep_college_count}
      compute {cnt1 = count over (), cnt2 = count over (),
        cnt3 = count over (), cnt4 = count over (), cnt5 = count over (),
        cnt6 = count over ()}
    order (cd_gender, cd_marital_status, cd_education_status,
      cd_purchase_estimate, cd_credit_rating, cd_dep_count,
      cd_dep_employed_count, cd_dep_college_count)
    take 100;
> val q10 = fn
>   : unit
>      -> {cd_credit_rating:string option, cd_dep_college_count:int option,
>           cd_dep_count:int option, cd_dep_employed_count:int option,
>           cd_education_status:string option, cd_gender:string option,
>           cd_marital_status:string option, cd_purchase_estimate:int option,
>           cnt1:int, cnt2:int, cnt3:int, cnt4:int, cnt5:int, cnt6:int} list
val r10 = q10 ();
> cd_credit_rating cd_dep_college_count cd_dep_count cd_dep_employed_count cd_education_status cd_gender cd_marital_status cd_purchase_estimate cnt1 cnt2 cnt3 cnt4 cnt5 cnt6
> ---------------- -------------------- ------------ --------------------- ------------------- --------- ----------------- -------------------- ---- ---- ---- ---- ---- ----
>
> val r10 : {cd_credit_rating:string option, cd_dep_college_count:int option, cd_dep_count:int option, cd_dep_employed_count:int option, cd_education_status:string option, cd_gender:string option, cd_marital_status:string option, cd_purchase_estimate:int option, cnt1:int, cnt2:int, cnt3:int, cnt4:int, cnt5:int, cnt6:int} list

(* --- q11 -------------------------------------------------------- *)
(*
WITH year_total AS (
  SELECT
    c_customer_id customer_id,
    c_first_name customer_first_name,
    c_last_name customer_last_name,
    c_preferred_cust_flag customer_preferred_cust_flag,
    c_birth_country customer_birth_country,
    c_login customer_login,
    c_email_address customer_email_address,
    d_year dyear,
    sum(ss_ext_list_price - ss_ext_discount_amt) year_total,
    's' sale_type
  FROM customer, store_sales, date_dim
  WHERE c_customer_sk = ss_customer_sk
    AND ss_sold_date_sk = d_date_sk
  GROUP BY c_customer_id
    , c_first_name
    , c_last_name
    , d_year
    , c_preferred_cust_flag
    , c_birth_country
    , c_login
    , c_email_address
    , d_year
  UNION ALL
  SELECT
    c_customer_id customer_id,
    c_first_name customer_first_name,
    c_last_name customer_last_name,
    c_preferred_cust_flag customer_preferred_cust_flag,
    c_birth_country customer_birth_country,
    c_login customer_login,
    c_email_address customer_email_address,
    d_year dyear,
    sum(ws_ext_list_price - ws_ext_discount_amt) year_total,
    'w' sale_type
  FROM customer, web_sales, date_dim
  WHERE c_customer_sk = ws_bill_customer_sk
    AND ws_sold_date_sk = d_date_sk
  GROUP BY
    c_customer_id, c_first_name, c_last_name, c_preferred_cust_flag, c_birth_country,
    c_login, c_email_address, d_year)
SELECT t_s_secyear.customer_preferred_cust_flag
FROM year_total t_s_firstyear
  , year_total t_s_secyear
  , year_total t_w_firstyear
  , year_total t_w_secyear
WHERE t_s_secyear.customer_id = t_s_firstyear.customer_id
  AND t_s_firstyear.customer_id = t_w_secyear.customer_id
  AND t_s_firstyear.customer_id = t_w_firstyear.customer_id
  AND t_s_firstyear.sale_type = 's'
  AND t_w_firstyear.sale_type = 'w'
  AND t_s_secyear.sale_type = 's'
  AND t_w_secyear.sale_type = 'w'
  AND t_s_firstyear.dyear = 2001
  AND t_s_secyear.dyear = 2001 + 1
  AND t_w_firstyear.dyear = 2001
  AND t_w_secyear.dyear = 2001 + 1
  AND t_s_firstyear.year_total > 0
  AND t_w_firstyear.year_total > 0
  AND CASE WHEN t_w_firstyear.year_total > 0
  THEN t_w_secyear.year_total / t_w_firstyear.year_total
      ELSE NULL END
  > CASE WHEN t_s_firstyear.year_total > 0
  THEN t_s_secyear.year_total / t_s_firstyear.year_total
    ELSE NULL END
ORDER BY t_s_secyear.customer_preferred_cust_flag
LIMIT 100
*)
fun q11 () =
  let
    val year_total =
      (from c in tpcds.customer,
          ss in tpcds.store_sales,
          d in tpcds.date_dim
        where ss.ss_customer_sk = SOME c.c_customer_sk
          andalso ss.ss_sold_date_sk = SOME d.d_date_sk
        group {customer_id = c.c_customer_id,
            customer_first_name = c.c_first_name,
            customer_last_name = c.c_last_name,
            customer_preferred_cust_flag = c.c_preferred_cust_flag,
            customer_birth_country = c.c_birth_country,
            customer_login = c.c_login,
            customer_email_address = c.c_email_address, dyear = d.d_year}
          compute {year_total = sumSome over
            (case (ss.ss_ext_list_price, ss.ss_ext_discount_amt) of
                (SOME lp, SOME da) => SOME (lp - da)
              | _ => NONE)}
        yield {customer_id, customer_first_name, customer_last_name,
          customer_preferred_cust_flag, customer_birth_country,
          customer_login, customer_email_address, dyear, year_total,
          sale_type = "s"})
      @
      (from c in tpcds.customer,
          ws in tpcds.web_sales,
          d in tpcds.date_dim
        where ws.ws_bill_customer_sk = SOME c.c_customer_sk
          andalso ws.ws_sold_date_sk = SOME d.d_date_sk
        group {customer_id = c.c_customer_id,
            customer_first_name = c.c_first_name,
            customer_last_name = c.c_last_name,
            customer_preferred_cust_flag = c.c_preferred_cust_flag,
            customer_birth_country = c.c_birth_country,
            customer_login = c.c_login,
            customer_email_address = c.c_email_address, dyear = d.d_year}
          compute {year_total = sumSome over
            (case (ws.ws_ext_list_price, ws.ws_ext_discount_amt) of
                (SOME lp, SOME da) => SOME (lp - da)
              | _ => NONE)}
        yield {customer_id, customer_first_name, customer_last_name,
          customer_preferred_cust_flag, customer_birth_country,
          customer_login, customer_email_address, dyear, year_total,
          sale_type = "w"})
    val zero = SOME (Decimal.fromInt 0)
    (* "CASE WHEN b > 0 THEN a / b ELSE NULL END" *)
    fun ratio (a, b) =
      case (a, b) of
          (SOME x, SOME y) =>
            if y > Decimal.fromInt 0 then SOME (x / y) else NONE
        | _ => NONE
  in
    from t_s_firstyear in year_total,
        t_s_secyear in year_total,
        t_w_firstyear in year_total,
        t_w_secyear in year_total
      where t_s_secyear.customer_id = t_s_firstyear.customer_id
        andalso t_s_firstyear.customer_id = t_w_secyear.customer_id
        andalso t_s_firstyear.customer_id = t_w_firstyear.customer_id
        andalso t_s_firstyear.sale_type = "s"
        andalso t_w_firstyear.sale_type = "w"
        andalso t_s_secyear.sale_type = "s"
        andalso t_w_secyear.sale_type = "w"
        andalso t_s_firstyear.dyear = SOME 2001
        andalso t_s_secyear.dyear = SOME (2001 + 1)
        andalso t_w_firstyear.dyear = SOME 2001
        andalso t_w_secyear.dyear = SOME (2001 + 1)
        andalso t_s_firstyear.year_total > zero
        andalso t_w_firstyear.year_total > zero
        andalso ratio (t_s_secyear.year_total, t_s_firstyear.year_total)
          <> NONE
        andalso ratio (t_w_secyear.year_total, t_w_firstyear.year_total)
          > ratio (t_s_secyear.year_total, t_s_firstyear.year_total)
      yield t_s_secyear.customer_preferred_cust_flag
      order current
      take 100
  end;
> val q11 = fn : unit -> string option list
val r11 = q11 ();
> val r11 =
>   [SOME "N",SOME "N",SOME "N",SOME "N",SOME "N",SOME "N",SOME "N",SOME "Y",
>    SOME "Y"] : string option list

(* --- q12 -------------------------------------------------------- *)
(*
SELECT
  i_item_desc,
  i_category,
  i_class,
  i_current_price,
  sum(ws_ext_sales_price) AS itemrevenue,
  sum(ws_ext_sales_price) * 100 / sum(sum(ws_ext_sales_price))
  OVER
  (PARTITION BY i_class) AS revenueratio
FROM
  web_sales, item, date_dim
WHERE
  ws_item_sk = i_item_sk
    AND i_category IN ('Sports', 'Books', 'Home')
    AND ws_sold_date_sk = d_date_sk
    AND d_date BETWEEN cast('1999-02-22' AS DATE)
  AND (cast('1999-02-22' AS DATE) + INTERVAL 30 days)
GROUP BY
  i_item_id, i_item_desc, i_category, i_class, i_current_price
ORDER BY
  i_category, i_class, i_item_id, i_item_desc, revenueratio
LIMIT 100
*)
(* "SUM(...) OVER (PARTITION BY i_class)" is each class's total, joined
 * to the class's rows. A partition is not a join: its NONE class is one
 * partition, as NONE = NONE. *)
fun q12 () =
  let
    fun day (year, month, day) =
      Date.date {year, month, day, hour = 0, minute = 0, second = 0,
        offset = SOME Time.zeroTime}
    val items =
      from ws in tpcds.web_sales,
          i in tpcds.item,
          d in tpcds.date_dim
        where ws.ws_item_sk = i.i_item_sk
          andalso i.i_category elem [SOME "Sports", SOME "Books", SOME "Home"]
          andalso ws.ws_sold_date_sk = SOME d.d_date_sk
          andalso d.d_date >= SOME (day (1999, Feb, 22))
          andalso d.d_date <= SOME (day (1999, Feb, 22 + 30))
        group {i.i_item_id, i.i_item_desc, i.i_category, i.i_class,
            i.i_current_price}
          compute {itemrevenue = sumSome over ws.ws_ext_sales_price}
    val classes =
      from r in items
        group r.i_class compute {total = sumSome over r.itemrevenue}
  in
    from r in items,
        c in classes
      where c.i_class = r.i_class
      yield {r.i_item_id, r.i_item_desc, r.i_category, r.i_class,
        r.i_current_price, r.itemrevenue,
        revenueratio =
          case (r.itemrevenue, c.total) of
              (SOME revenue, SOME total) =>
                SOME (revenue * Decimal.fromInt 100 / total)
            | _ => NONE}
      order (i_category, i_class, i_item_id, i_item_desc, revenueratio)
      yield {i_item_desc, i_category, i_class, i_current_price, itemrevenue,
        revenueratio}
      take 100
  end;
> val q12 = fn
>   : unit
>      -> {i_category:string option, i_class:string option,
>           i_current_price:decimal option, i_item_desc:string option,
>           itemrevenue:decimal option, revenueratio:decimal option} list
val r12 = q12 ();
> uncaught exception Div [divide by zero]
>   raised at: stdIn:30.22-30.61

(* --- q13 -------------------------------------------------------- *)
(*
SELECT
  avg(ss_quantity),
  avg(ss_ext_sales_price),
  avg(ss_ext_wholesale_cost),
  sum(ss_ext_wholesale_cost)
FROM store_sales
  , store
  , customer_demographics
  , household_demographics
  , customer_address
  , date_dim
WHERE s_store_sk = ss_store_sk
  AND ss_sold_date_sk = d_date_sk AND d_year = 2001
  AND ((ss_hdemo_sk = hd_demo_sk
  AND cd_demo_sk = ss_cdemo_sk
  AND cd_marital_status = 'M'
  AND cd_education_status = 'Advanced Degree'
  AND ss_sales_price BETWEEN 100.00 AND 150.00
  AND hd_dep_count = 3
) OR
  (ss_hdemo_sk = hd_demo_sk
    AND cd_demo_sk = ss_cdemo_sk
    AND cd_marital_status = 'S'
    AND cd_education_status = 'College'
    AND ss_sales_price BETWEEN 50.00 AND 100.00
    AND hd_dep_count = 1
  ) OR
  (ss_hdemo_sk = hd_demo_sk
    AND cd_demo_sk = ss_cdemo_sk
    AND cd_marital_status = 'W'
    AND cd_education_status = '2 yr Degree'
    AND ss_sales_price BETWEEN 150.00 AND 200.00
    AND hd_dep_count = 1
  ))
  AND ((ss_addr_sk = ca_address_sk
  AND ca_country = 'United States'
  AND ca_state IN ('TX', 'OH', 'TX')
  AND ss_net_profit BETWEEN 100 AND 200
) OR
  (ss_addr_sk = ca_address_sk
    AND ca_country = 'United States'
    AND ca_state IN ('OR', 'NM', 'KY')
    AND ss_net_profit BETWEEN 150 AND 300
  ) OR
  (ss_addr_sk = ca_address_sk
    AND ca_country = 'United States'
    AND ca_state IN ('VA', 'TX', 'MS')
    AND ss_net_profit BETWEEN 50 AND 250
  ))
*)
(* As in q48, each disjunct of the SQL's "OR"s repeats a join
 * condition; the conditions are factored by hand. *)
fun q13 () =
  from ss in tpcds.store_sales,
      s in tpcds.store,
      cd in tpcds.customer_demographics,
      hd in tpcds.household_demographics,
      ca in tpcds.customer_address,
      d in tpcds.date_dim
    where ss.ss_store_sk = SOME s.s_store_sk
      andalso ss.ss_sold_date_sk = SOME d.d_date_sk
      andalso d.d_year = SOME 2001
      andalso ss.ss_hdemo_sk = SOME hd.hd_demo_sk
      andalso ss.ss_cdemo_sk = SOME cd.cd_demo_sk
      andalso (cd.cd_marital_status = SOME "M"
          andalso cd.cd_education_status = SOME "Advanced Degree"
          andalso ss.ss_sales_price >= SOME (Decimal.fromInt 100)
          andalso ss.ss_sales_price <= SOME (Decimal.fromInt 150)
          andalso hd.hd_dep_count = SOME 3
        orelse cd.cd_marital_status = SOME "S"
          andalso cd.cd_education_status = SOME "College"
          andalso ss.ss_sales_price >= SOME (Decimal.fromInt 50)
          andalso ss.ss_sales_price <= SOME (Decimal.fromInt 100)
          andalso hd.hd_dep_count = SOME 1
        orelse cd.cd_marital_status = SOME "W"
          andalso cd.cd_education_status = SOME "2 yr Degree"
          andalso ss.ss_sales_price >= SOME (Decimal.fromInt 150)
          andalso ss.ss_sales_price <= SOME (Decimal.fromInt 200)
          andalso hd.hd_dep_count = SOME 1)
      andalso ss.ss_addr_sk = SOME ca.ca_address_sk
      andalso ca.ca_country = SOME "United States"
      andalso (ca.ca_state elem [SOME "TX", SOME "OH", SOME "TX"]
          andalso ss.ss_net_profit >= SOME (Decimal.fromInt 100)
          andalso ss.ss_net_profit <= SOME (Decimal.fromInt 200)
        orelse ca.ca_state elem [SOME "OR", SOME "NM", SOME "KY"]
          andalso ss.ss_net_profit >= SOME (Decimal.fromInt 150)
          andalso ss.ss_net_profit <= SOME (Decimal.fromInt 300)
        orelse ca.ca_state elem [SOME "VA", SOME "TX", SOME "MS"]
          andalso ss.ss_net_profit >= SOME (Decimal.fromInt 50)
          andalso ss.ss_net_profit <= SOME (Decimal.fromInt 250))
    compute {`avg(ss_quantity)` = avgSome over ss.ss_quantity,
      `avg(ss_ext_sales_price)` = avgSome over ss.ss_ext_sales_price,
      `avg(ss_ext_wholesale_cost)` = avgSome over ss.ss_ext_wholesale_cost,
      `sum(ss_ext_wholesale_cost)` = sumSome over ss.ss_ext_wholesale_cost};
> val q13 = fn
>   : unit
>      -> {avg(ss_ext_sales_price):decimal option,
>           avg(ss_ext_wholesale_cost):decimal option,
>           avg(ss_quantity):real option,
>           sum(ss_ext_wholesale_cost):decimal option}
val r13 = q13 ();
> val r13 =
>   {avg(ss_ext_sales_price)=SOME 3582.7,
>    avg(ss_ext_wholesale_cost)=SOME 3466.65,avg(ss_quantity)=SOME 55,
>    sum(ss_ext_wholesale_cost)=SOME 3466.65}
>   : {avg(ss_ext_sales_price):decimal option,
>       avg(ss_ext_wholesale_cost):decimal option, avg(ss_quantity):real option,
>       sum(ss_ext_wholesale_cost):decimal option}

(* --- q14a ------------------------------------------------------- *)
(*
WITH cross_items AS
(SELECT i_item_sk ss_item_sk
  FROM item,
    (SELECT
      iss.i_brand_id brand_id,
      iss.i_class_id class_id,
      iss.i_category_id category_id
    FROM store_sales, item iss, date_dim d1
    WHERE ss_item_sk = iss.i_item_sk
      AND ss_sold_date_sk = d1.d_date_sk
      AND d1.d_year BETWEEN 1999 AND 1999 + 2
    INTERSECT
    SELECT
      ics.i_brand_id,
      ics.i_class_id,
      ics.i_category_id
    FROM catalog_sales, item ics, date_dim d2
    WHERE cs_item_sk = ics.i_item_sk
      AND cs_sold_date_sk = d2.d_date_sk
      AND d2.d_year BETWEEN 1999 AND 1999 + 2
    INTERSECT
    SELECT
      iws.i_brand_id,
      iws.i_class_id,
      iws.i_category_id
    FROM web_sales, item iws, date_dim d3
    WHERE ws_item_sk = iws.i_item_sk
      AND ws_sold_date_sk = d3.d_date_sk
      AND d3.d_year BETWEEN 1999 AND 1999 + 2) x
  WHERE i_brand_id = brand_id
    AND i_class_id = class_id
    AND i_category_id = category_id
),
    avg_sales AS
  (SELECT avg(quantity * list_price) average_sales
  FROM (
         SELECT
           ss_quantity quantity,
           ss_list_price list_price
         FROM store_sales, date_dim
         WHERE ss_sold_date_sk = d_date_sk
           AND d_year BETWEEN 1999 AND 2001
         UNION ALL
         SELECT
           cs_quantity quantity,
           cs_list_price list_price
         FROM catalog_sales, date_dim
         WHERE cs_sold_date_sk = d_date_sk
           AND d_year BETWEEN 1999 AND 1999 + 2
         UNION ALL
         SELECT
           ws_quantity quantity,
           ws_list_price list_price
         FROM web_sales, date_dim
         WHERE ws_sold_date_sk = d_date_sk
           AND d_year BETWEEN 1999 AND 1999 + 2) x)
SELECT
  channel,
  i_brand_id,
  i_class_id,
  i_category_id,
  sum(sales),
  sum(number_sales)
FROM (
       SELECT
         'store' channel,
         i_brand_id,
         i_class_id,
         i_category_id,
         sum(ss_quantity * ss_list_price) sales,
         count(*) number_sales
       FROM store_sales, item, date_dim
       WHERE ss_item_sk IN (SELECT ss_item_sk
       FROM cross_items)
         AND ss_item_sk = i_item_sk
         AND ss_sold_date_sk = d_date_sk
         AND d_year = 1999 + 2
         AND d_moy = 11
       GROUP BY i_brand_id, i_class_id, i_category_id
       HAVING sum(ss_quantity * ss_list_price) > (SELECT average_sales
       FROM avg_sales)
       UNION ALL
       SELECT
         'catalog' channel,
         i_brand_id,
         i_class_id,
         i_category_id,
         sum(cs_quantity * cs_list_price) sales,
         count(*) number_sales
       FROM catalog_sales, item, date_dim
       WHERE cs_item_sk IN (SELECT ss_item_sk
       FROM cross_items)
         AND cs_item_sk = i_item_sk
         AND cs_sold_date_sk = d_date_sk
         AND d_year = 1999 + 2
         AND d_moy = 11
       GROUP BY i_brand_id, i_class_id, i_category_id
       HAVING sum(cs_quantity * cs_list_price) > (SELECT average_sales FROM avg_sales)
       UNION ALL
       SELECT
         'web' channel,
         i_brand_id,
         i_class_id,
         i_category_id,
         sum(ws_quantity * ws_list_price) sales,
         count(*) number_sales
       FROM web_sales, item, date_dim
       WHERE ws_item_sk IN (SELECT ss_item_sk
       FROM cross_items)
         AND ws_item_sk = i_item_sk
         AND ws_sold_date_sk = d_date_sk
         AND d_year = 1999 + 2
         AND d_moy = 11
       GROUP BY i_brand_id, i_class_id, i_category_id
       HAVING sum(ws_quantity * ws_list_price) > (SELECT average_sales
       FROM avg_sales)
     ) y
GROUP BY ROLLUP (channel, i_brand_id, i_class_id, i_category_id)
ORDER BY channel, i_brand_id, i_class_id, i_category_id
LIMIT 100
*)
(* "GROUP BY ROLLUP", as in q22; "IN (SELECT ...)" is "exists", as in
 * q14b, whose "cross_items" and "average_sales" this shares. *)
fun q14a () =
  let
    (* "quantity * price" *)
    fun times (quantity, price) =
      case (quantity, price) of
          (SOME q, SOME p) => SOME (Decimal.fromInt q * p)
        | _ => NONE
    val years = [SOME 1999, SOME (1999 + 1), SOME (1999 + 2)]
    val cross_items =
      from i in tpcds.item,
          x in (
            from x in (
                from ss in tpcds.store_sales,
                    iss in tpcds.item,
                    d1 in tpcds.date_dim
                  where ss.ss_item_sk = iss.i_item_sk
                    andalso ss.ss_sold_date_sk = SOME d1.d_date_sk
                    andalso d1.d_year elem years
                  yield {brand_id = iss.i_brand_id,
                    class_id = iss.i_class_id,
                    category_id = iss.i_category_id})
              intersect distinct
                (from cs in tpcds.catalog_sales,
                    ics in tpcds.item,
                    d2 in tpcds.date_dim
                  where cs.cs_item_sk = ics.i_item_sk
                    andalso cs.cs_sold_date_sk = SOME d2.d_date_sk
                    andalso d2.d_year elem years
                  yield {brand_id = ics.i_brand_id,
                    class_id = ics.i_class_id,
                    category_id = ics.i_category_id}),
                (from ws in tpcds.web_sales,
                    iws in tpcds.item,
                    d3 in tpcds.date_dim
                  where ws.ws_item_sk = iws.i_item_sk
                    andalso ws.ws_sold_date_sk = SOME d3.d_date_sk
                    andalso d3.d_year elem years
                  yield {brand_id = iws.i_brand_id,
                    class_id = iws.i_class_id,
                    category_id = iws.i_category_id}))
        where i.i_brand_id <> NONE
          andalso i.i_brand_id = x.brand_id
          andalso i.i_class_id <> NONE
          andalso i.i_class_id = x.class_id
          andalso i.i_category_id <> NONE
          andalso i.i_category_id = x.category_id
        yield i.i_item_sk
    val average_sales =
      from x in (
          from ss in tpcds.store_sales,
              d in tpcds.date_dim
            where ss.ss_sold_date_sk = SOME d.d_date_sk
              andalso d.d_year elem years
            yield {quantity = ss.ss_quantity, list_price = ss.ss_list_price})
        union
          (from cs in tpcds.catalog_sales,
              d in tpcds.date_dim
            where cs.cs_sold_date_sk = SOME d.d_date_sk
              andalso d.d_year elem years
            yield {quantity = cs.cs_quantity, list_price = cs.cs_list_price}),
          (from ws in tpcds.web_sales,
              d in tpcds.date_dim
            where ws.ws_sold_date_sk = SOME d.d_date_sk
              andalso d.d_year elem years
            yield {quantity = ws.ws_quantity, list_price = ws.ws_list_price})
        compute avgSome over times (x.quantity, x.list_price)
    val y =
      (from ss in tpcds.store_sales,
          i in tpcds.item,
          d in tpcds.date_dim
        where (exists ci in cross_items where ci = ss.ss_item_sk)
          andalso ss.ss_item_sk = i.i_item_sk
          andalso ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso d.d_year = SOME (1999 + 2)
          andalso d.d_moy = SOME 11
        group {i.i_brand_id, i.i_class_id, i.i_category_id}
          compute {
            sales = sumSome over times (ss.ss_quantity, ss.ss_list_price),
            number_sales = count over ()}
        where (case (sales, average_sales) of
                  (SOME s, SOME a) => s > a
                | _ => false)
        yield {channel = SOME "store", i_brand_id, i_class_id,
          i_category_id, sales, number_sales})
      @
      (from cs in tpcds.catalog_sales,
          i in tpcds.item,
          d in tpcds.date_dim
        where (exists ci in cross_items where ci = cs.cs_item_sk)
          andalso cs.cs_item_sk = i.i_item_sk
          andalso cs.cs_sold_date_sk = SOME d.d_date_sk
          andalso d.d_year = SOME (1999 + 2)
          andalso d.d_moy = SOME 11
        group {i.i_brand_id, i.i_class_id, i.i_category_id}
          compute {
            sales = sumSome over times (cs.cs_quantity, cs.cs_list_price),
            number_sales = count over ()}
        where (case (sales, average_sales) of
                  (SOME s, SOME a) => s > a
                | _ => false)
        yield {channel = SOME "catalog", i_brand_id, i_class_id,
          i_category_id, sales, number_sales})
      @
      (from ws in tpcds.web_sales,
          i in tpcds.item,
          d in tpcds.date_dim
        where (exists ci in cross_items where ci = ws.ws_item_sk)
          andalso ws.ws_item_sk = i.i_item_sk
          andalso ws.ws_sold_date_sk = SOME d.d_date_sk
          andalso d.d_year = SOME (1999 + 2)
          andalso d.d_moy = SOME 11
        group {i.i_brand_id, i.i_class_id, i.i_category_id}
          compute {
            sales = sumSome over times (ws.ws_quantity, ws.ws_list_price),
            number_sales = count over ()}
        where (case (sales, average_sales) of
                  (SOME s, SOME a) => s > a
                | _ => false)
        yield {channel = SOME "web", i_brand_id, i_class_id,
          i_category_id, sales, number_sales})
  in
    from r in (from b in y
          group {b.channel, b.i_brand_id, b.i_class_id, b.i_category_id}
            compute {`sum(sales)` = sumSome over b.sales,
                `sum(number_sales)` = sum over b.number_sales}
          yield {channel, i_brand_id, i_class_id, i_category_id, `sum(sales)`,
            `sum(number_sales)`})
        union
          (from b in y
              group {b.channel, b.i_brand_id, b.i_class_id}
                compute {`sum(sales)` = sumSome over b.sales,
                    `sum(number_sales)` = sum over b.number_sales}
              yield {channel, i_brand_id, i_class_id, i_category_id = NONE,
                `sum(sales)`, `sum(number_sales)`}),
          (from b in y
              group {b.channel, b.i_brand_id}
                compute {`sum(sales)` = sumSome over b.sales,
                    `sum(number_sales)` = sum over b.number_sales}
              yield {channel, i_brand_id, i_class_id = NONE, i_category_id = NONE,
                `sum(sales)`, `sum(number_sales)`}),
          (from b in y
              group {b.channel}
                compute {`sum(sales)` = sumSome over b.sales,
                    `sum(number_sales)` = sum over b.number_sales}
              yield {channel, i_brand_id = NONE, i_class_id = NONE,
                i_category_id = NONE, `sum(sales)`, `sum(number_sales)`}),
          (from b in y
              group {}
                compute {`sum(sales)` = sumSome over b.sales,
                    `sum(number_sales)` = sum over b.number_sales}
              yield {channel = NONE, i_brand_id = NONE, i_class_id = NONE,
                i_category_id = NONE, `sum(sales)`, `sum(number_sales)`})
      order (r.channel, r.i_brand_id, r.i_class_id, r.i_category_id)
      take 100
  end;
> val q14a = fn
>   : unit
>      -> {channel:string option, i_brand_id:int option,
>           i_category_id:int option, i_class_id:int option,
>           sum(number_sales):int, sum(sales):decimal option} list
val r14a = q14a ();
