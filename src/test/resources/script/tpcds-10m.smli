> val r66 : {apr_net:decimal option, apr_sales:decimal option, apr_sales_per_sq_foot:decimal option, aug_net:decimal option, aug_sales:decimal option, aug_sales_per_sq_foot:decimal option, dec_net:decimal option, dec_sales:decimal option, dec_sales_per_sq_foot:decimal option, feb_net:decimal option, feb_sales:decimal option, feb_sales_per_sq_foot:decimal option, jan_net:decimal option, jan_sales:decimal option, jan_sales_per_sq_foot:decimal option, jul_net:decimal option, jul_sales:decimal option, jul_sales_per_sq_foot:decimal option, jun_net:decimal option, jun_sales:decimal option, jun_sales_per_sq_foot:decimal option, mar_net:decimal option, mar_sales:decimal option, mar_sales_per_sq_foot:decimal option, may_net:decimal option, may_sales:decimal option, may_sales_per_sq_foot:decimal option, nov_net:decimal option, nov_sales:decimal option, nov_sales_per_sq_foot:decimal option, oct_net:decimal option, oct_sales:decimal option, oct_sales_per_sq_foot:decimal option, sep_net:decimal option, sep_sales:decimal option, sep_sales_per_sq_foot:decimal option, ship_carriers:string, w_city:string option, w_country:string option, w_county:string option, w_state:string option, w_warehouse_name:string option, w_warehouse_sq_ft:int option, year:int option} list

(* --- q67 -------------------------------------------------------- *)
(*
SELECT *
FROM
  (SELECT
    i_category,
    i_class,
    i_brand,
    i_product_name,
    d_year,
    d_qoy,
    d_moy,
    s_store_id,
    sumsales,
    rank()
    OVER (PARTITION BY i_category
      ORDER BY sumsales DESC) rk
  FROM
    (SELECT
      i_category,
      i_class,
      i_brand,
      i_product_name,
      d_year,
      d_qoy,
      d_moy,
      s_store_id,
      sum(coalesce(ss_sales_price * ss_quantity, 0)) sumsales
    FROM store_sales, date_dim, store, item
    WHERE ss_sold_date_sk = d_date_sk
      AND ss_item_sk = i_item_sk
      AND ss_store_sk = s_store_sk
      AND d_month_seq BETWEEN 1200 AND 1200 + 11
    GROUP BY ROLLUP (i_category, i_class, i_brand, i_product_name, d_year, d_qoy,
      d_moy, s_store_id)) dw1) dw2
WHERE rk <= 100
ORDER BY
  i_category, i_class, i_brand, i_product_name, d_year,
  d_qoy, d_moy, s_store_id, sumsales, rk
LIMIT 100
*)
(* "GROUP BY ROLLUP", as in q22. "rank() OVER (PARTITION BY i_category
 * ORDER BY sumsales DESC)": each partition is sorted, and a row's rank is
 * one more than the position ("ordinal") of the first row with its
 * "sumsales"; counting, for each row, the rows that rank above it would
 * take time quadratic in the size of the partition. *)
fun q67 () =
  let
    val base =
      from ss in tpcds.store_sales,
          d in tpcds.date_dim,
          s in tpcds.store,
          i in tpcds.item
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_item_sk = i.i_item_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        yield {i.i_category, i.i_class, i.i_brand, i.i_product_name,
          d.d_year, d.d_qoy, d.d_moy, s_store_id = SOME s.s_store_id,
          sales =
            case (ss.ss_sales_price, ss.ss_quantity) of
                (SOME p, SOME q) => p * Decimal.fromInt q
              | _ => Decimal.fromInt 0}
    val dw1 =
      from r in (from b in base
          group {b.i_category, b.i_class, b.i_brand, b.i_product_name,
                b.d_year, b.d_qoy, b.d_moy, b.s_store_id}
            compute {sumsales = sum over b.sales}
          yield {i_category, i_class, i_brand, i_product_name, d_year, d_qoy,
            d_moy, s_store_id, sumsales})
        union
          (from b in base
              group {b.i_category, b.i_class, b.i_brand, b.i_product_name,
                    b.d_year, b.d_qoy, b.d_moy}
                compute {sumsales = sum over b.sales}
              yield {i_category, i_class, i_brand, i_product_name, d_year, d_qoy,
                d_moy, s_store_id = NONE, sumsales}),
          (from b in base
              group {b.i_category, b.i_class, b.i_brand, b.i_product_name,
                    b.d_year, b.d_qoy}
                compute {sumsales = sum over b.sales}
              yield {i_category, i_class, i_brand, i_product_name, d_year, d_qoy,
                d_moy = NONE, s_store_id = NONE, sumsales}),
          (from b in base
              group {b.i_category, b.i_class, b.i_brand, b.i_product_name,
                    b.d_year}
                compute {sumsales = sum over b.sales}
              yield {i_category, i_class, i_brand, i_product_name, d_year,
                d_qoy = NONE, d_moy = NONE, s_store_id = NONE, sumsales}),
          (from b in base
              group {b.i_category, b.i_class, b.i_brand, b.i_product_name}
                compute {sumsales = sum over b.sales}
              yield {i_category, i_class, i_brand, i_product_name, d_year = NONE,
                d_qoy = NONE, d_moy = NONE, s_store_id = NONE, sumsales}),
          (from b in base
              group {b.i_category, b.i_class, b.i_brand}
                compute {sumsales = sum over b.sales}
              yield {i_category, i_class, i_brand, i_product_name = NONE,
                d_year = NONE, d_qoy = NONE, d_moy = NONE, s_store_id = NONE,
                sumsales}),
          (from b in base
              group {b.i_category, b.i_class}
                compute {sumsales = sum over b.sales}
              yield {i_category, i_class, i_brand = NONE, i_product_name = NONE,
                d_year = NONE, d_qoy = NONE, d_moy = NONE, s_store_id = NONE,
                sumsales}),
          (from b in base
              group {b.i_category}
                compute {sumsales = sum over b.sales}
              yield {i_category, i_class = NONE, i_brand = NONE,
                i_product_name = NONE, d_year = NONE, d_qoy = NONE, d_moy = NONE,
                s_store_id = NONE, sumsales}),
          (from b in base
              group {}
                compute {sumsales = sum over b.sales}
              yield {i_category = NONE, i_class = NONE, i_brand = NONE,
                i_product_name = NONE, d_year = NONE, d_qoy = NONE, d_moy = NONE,
                s_store_id = NONE, sumsales})
    (* Each partition, sorted, with each row's position in it. *)
    val sorted =
      from c in (from r in dw1 yield r.i_category distinct),
          x in (from r in dw1
            where r.i_category = c
            order DESC r.sumsales
            yield {r, pos = ordinal})
        yield x
    val firsts =
      from x in sorted
        group {x.r.i_category, x.r.sumsales} compute {first = min over x.pos}
    val dw2 =
      from x in sorted,
          f in firsts
        where f.i_category = x.r.i_category andalso f.sumsales = x.r.sumsales
        yield {x.r, rk = f.first + 1}
  in
    from x in dw2
      where x.rk <= 100
      yield {x.r.i_category, x.r.i_class, x.r.i_brand, x.r.i_product_name,
        x.r.d_year, x.r.d_qoy, x.r.d_moy, x.r.s_store_id, x.r.sumsales, x.rk}
      order (i_category, i_class, i_brand, i_product_name, d_year, d_qoy,
        d_moy, s_store_id, sumsales, rk)
      take 100
  end;
> val q67 = fn
>   : unit
>      -> {d_moy:int option, d_qoy:int option, d_year:int option,
>           i_brand:string option, i_category:string option,
>           i_class:string option, i_product_name:string option, rk:int,
>           s_store_id:string option, sumsales:decimal} list
val r67 = q67 ();
> d_moy d_qoy d_year i_brand      i_category i_class i_product_name rk s_store_id       sumsales
