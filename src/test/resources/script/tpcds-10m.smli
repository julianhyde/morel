    AND ss_store_sk = s_store_sk
    AND time_dim.t_hour = 11
    AND time_dim.t_minute < 30
    AND (
    (household_demographics.hd_dep_count = 4 AND household_demographics.hd_vehicle_count <= 4 + 2)
      OR
      (household_demographics.hd_dep_count = 2 AND household_demographics.hd_vehicle_count <= 2 + 2)
      OR
      (household_demographics.hd_dep_count = 0 AND
        household_demographics.hd_vehicle_count <= 0 + 2))
    AND store.s_store_name = 'ese') s6,
  (SELECT count(*) h11_30_to_12
  FROM store_sales, household_demographics, time_dim, store
  WHERE ss_sold_time_sk = time_dim.t_time_sk
    AND ss_hdemo_sk = household_demographics.hd_demo_sk
    AND ss_store_sk = s_store_sk
    AND time_dim.t_hour = 11
    AND time_dim.t_minute >= 30
    AND (
    (household_demographics.hd_dep_count = 4 AND household_demographics.hd_vehicle_count <= 4 + 2)
      OR
      (household_demographics.hd_dep_count = 2 AND household_demographics.hd_vehicle_count <= 2 + 2)
      OR
      (household_demographics.hd_dep_count = 0 AND
        household_demographics.hd_vehicle_count <= 0 + 2))
    AND store.s_store_name = 'ese') s7,
  (SELECT count(*) h12_to_12_30
  FROM store_sales, household_demographics, time_dim, store
  WHERE ss_sold_time_sk = time_dim.t_time_sk
    AND ss_hdemo_sk = household_demographics.hd_demo_sk
    AND ss_store_sk = s_store_sk
    AND time_dim.t_hour = 12
    AND time_dim.t_minute < 30
    AND (
    (household_demographics.hd_dep_count = 4 AND household_demographics.hd_vehicle_count <= 4 + 2)
      OR
      (household_demographics.hd_dep_count = 2 AND household_demographics.hd_vehicle_count <= 2 + 2)
      OR
      (household_demographics.hd_dep_count = 0 AND
        household_demographics.hd_vehicle_count <= 0 + 2))
    AND store.s_store_name = 'ese') s8
*)
fun q88 () =
  let
    (* The number of sales in the half hour that starts at "hour", or
     * at half past it if not "early". *)
    fun sales (hour, early) =
      from ss in tpcds.store_sales,
          hd in tpcds.household_demographics,
          t in tpcds.time_dim,
          s in tpcds.store
        where ss.ss_sold_time_sk = SOME t.t_time_sk
          andalso ss.ss_hdemo_sk = SOME hd.hd_demo_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso t.t_hour = SOME hour
          andalso (if early
            then t.t_minute <> NONE andalso t.t_minute < SOME 30
            else t.t_minute >= SOME 30)
          andalso (hd.hd_dep_count = SOME 4
              andalso hd.hd_vehicle_count <> NONE
              andalso hd.hd_vehicle_count <= SOME (4 + 2)
            orelse hd.hd_dep_count = SOME 2
              andalso hd.hd_vehicle_count <> NONE
              andalso hd.hd_vehicle_count <= SOME (2 + 2)
            orelse hd.hd_dep_count = SOME 0
              andalso hd.hd_vehicle_count <> NONE
              andalso hd.hd_vehicle_count <= SOME (0 + 2))
          andalso s.s_store_name = SOME "ese"
        compute count over ()
  in
    [{
      h8_30_to_9 = sales (8, false),
      h9_to_9_30 = sales (9, true),
      h9_30_to_10 = sales (9, false),
      h10_to_10_30 = sales (10, true),
      h10_30_to_11 = sales (10, false),
      h11_to_11_30 = sales (11, true),
      h11_30_to_12 = sales (11, false),
      h12_to_12_30 = sales (12, true)}]
  end;
