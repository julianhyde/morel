(* --- q92 -------------------------------------------------------- *)
(*
SELECT sum(ws_ext_discount_amt) AS `Excess Discount Amount `
FROM web_sales, item, date_dim
WHERE i_manufact_id = 350
  AND i_item_sk = ws_item_sk
  AND d_date BETWEEN '2000-01-27' AND (cast('2000-01-27' AS DATE) + INTERVAL 90 days)
  AND d_date_sk = ws_sold_date_sk
  AND ws_ext_discount_amt >
  (
    SELECT 1.3 * avg(ws_ext_discount_amt)
    FROM web_sales, date_dim
    WHERE ws_item_sk = i_item_sk
      AND d_date BETWEEN '2000-01-27' AND (cast('2000-01-27' AS DATE) + INTERVAL 90 days)
      AND d_date_sk = ws_sold_date_sk
  )
ORDER BY sum(ws_ext_discount_amt)
LIMIT 100
*)
fun q92 () =
  let
    fun day (year, month, day) =
      Date.date {year, month, day, hour = 0, minute = 0, second = 0,
        offset = SOME Time.zeroTime}
  in
    from ws in tpcds.web_sales,
        i in tpcds.item,
        d in tpcds.date_dim
      where i.i_manufact_id = SOME 350
        andalso ws.ws_item_sk = i.i_item_sk
        andalso d.d_date >= SOME (day (2000, Jan, 27))
        andalso d.d_date <= SOME (day (2000, Jan, 27 + 90))
        andalso ws.ws_sold_date_sk = SOME d.d_date_sk
        andalso (case (ws.ws_ext_discount_amt,
                from ws2 in tpcds.web_sales,
                    d2 in tpcds.date_dim
                  where ws2.ws_item_sk = i.i_item_sk
                    andalso d2.d_date >= SOME (day (2000, Jan, 27))
                    andalso d2.d_date <= SOME (day (2000, Jan, 27 + 90))
                    andalso ws2.ws_sold_date_sk = SOME d2.d_date_sk
                  compute avgSome over ws2.ws_ext_discount_amt) of
              (SOME amt, SOME average) => amt > decimal "1.3" * average
            | _ => false)
      compute {`Excess Discount Amount ` = sumSome over ws.ws_ext_discount_amt}
  end;
> val q92 = fn : unit -> {`Excess Discount Amount `:decimal option}
