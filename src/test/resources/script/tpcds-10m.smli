> val r34 : {c_first_name:string option, c_last_name:string option, c_preferred_cust_flag:string option, c_salutation:string option, cnt:int, ss_ticket_number:int} list

(* --- q38 -------------------------------------------------------- *)
(*
SELECT count(*)
FROM (
       SELECT DISTINCT
         c_last_name,
         c_first_name,
         d_date
       FROM store_sales, date_dim, customer
       WHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk
         AND store_sales.ss_customer_sk = customer.c_customer_sk
         AND d_month_seq BETWEEN 1200 AND 1200 + 11
       INTERSECT
       SELECT DISTINCT
         c_last_name,
         c_first_name,
         d_date
       FROM catalog_sales, date_dim, customer
       WHERE catalog_sales.cs_sold_date_sk = date_dim.d_date_sk
         AND catalog_sales.cs_bill_customer_sk = customer.c_customer_sk
         AND d_month_seq BETWEEN 1200 AND 1200 + 11
       INTERSECT
       SELECT DISTINCT
         c_last_name,
         c_first_name,
         d_date
       FROM web_sales, date_dim, customer
       WHERE web_sales.ws_sold_date_sk = date_dim.d_date_sk
         AND web_sales.ws_bill_customer_sk = customer.c_customer_sk
         AND d_month_seq BETWEEN 1200 AND 1200 + 11
     ) hot_cust
LIMIT 100
*)
fun q38 () =
  from r in (
      from ss in tpcds.store_sales,
          d in tpcds.date_dim,
          c in tpcds.customer
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_customer_sk = SOME c.c_customer_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        yield {c.c_last_name, c.c_first_name, d.d_date})
    intersect distinct
      (from cs in tpcds.catalog_sales,
          d in tpcds.date_dim,
          c in tpcds.customer
        where cs.cs_sold_date_sk = SOME d.d_date_sk
          andalso cs.cs_bill_customer_sk = SOME c.c_customer_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        yield {c.c_last_name, c.c_first_name, d.d_date}),
      (from ws in tpcds.web_sales,
          d in tpcds.date_dim,
          c in tpcds.customer
        where ws.ws_sold_date_sk = SOME d.d_date_sk
          andalso ws.ws_bill_customer_sk = SOME c.c_customer_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        yield {c.c_last_name, c.c_first_name, d.d_date})
    compute count over ();
> val q38 = fn : unit -> int
val r38 = q38 ();
> val r38 = 0 : int

(* --- q41 -------------------------------------------------------- *)
(*
SELECT DISTINCT (i_product_name)
FROM item i1
WHERE i_manufact_id BETWEEN 738 AND 738 + 40
  AND (SELECT count(*) AS item_cnt
FROM item
WHERE (i_manufact = i1.i_manufact AND
  ((i_category = 'Women' AND
    (i_color = 'powder' OR i_color = 'khaki') AND
    (i_units = 'Ounce' OR i_units = 'Oz') AND
    (i_size = 'medium' OR i_size = 'extra large')
  ) OR
    (i_category = 'Women' AND
      (i_color = 'brown' OR i_color = 'honeydew') AND
      (i_units = 'Bunch' OR i_units = 'Ton') AND
      (i_size = 'N/A' OR i_size = 'small')
    ) OR
    (i_category = 'Men' AND
      (i_color = 'floral' OR i_color = 'deep') AND
      (i_units = 'N/A' OR i_units = 'Dozen') AND
      (i_size = 'petite' OR i_size = 'large')
    ) OR
    (i_category = 'Men' AND
      (i_color = 'light' OR i_color = 'cornflower') AND
      (i_units = 'Box' OR i_units = 'Pound') AND
      (i_size = 'medium' OR i_size = 'extra large')
    ))) OR
  (i_manufact = i1.i_manufact AND
    ((i_category = 'Women' AND
      (i_color = 'midnight' OR i_color = 'snow') AND
      (i_units = 'Pallet' OR i_units = 'Gross') AND
      (i_size = 'medium' OR i_size = 'extra large')
    ) OR
      (i_category = 'Women' AND
        (i_color = 'cyan' OR i_color = 'papaya') AND
        (i_units = 'Cup' OR i_units = 'Dram') AND
        (i_size = 'N/A' OR i_size = 'small')
      ) OR
      (i_category = 'Men' AND
        (i_color = 'orange' OR i_color = 'frosted') AND
        (i_units = 'Each' OR i_units = 'Tbl') AND
        (i_size = 'petite' OR i_size = 'large')
      ) OR
      (i_category = 'Men' AND
        (i_color = 'forest' OR i_color = 'ghost') AND
        (i_units = 'Lb' OR i_units = 'Bundle') AND
        (i_size = 'medium' OR i_size = 'extra large')
      )))) > 0
ORDER BY i_product_name
LIMIT 100
*)
(* The SQL compares a count of matching items with 0; that is "exists". *)
fun q41 () =
  from i1 in tpcds.item
    where i1.i_manufact_id >= SOME 738
      andalso i1.i_manufact_id <= SOME (738 + 40)
      andalso i1.i_manufact <> NONE
      andalso (exists i in tpcds.item
        where i.i_manufact = i1.i_manufact
          andalso (i.i_category = SOME "Women"
                andalso (i.i_color = SOME "powder" orelse i.i_color = SOME "khaki")
                andalso (i.i_units = SOME "Ounce" orelse i.i_units = SOME "Oz")
                andalso (i.i_size = SOME "medium" orelse i.i_size = SOME "extra large")
              orelse i.i_category = SOME "Women"
                andalso (i.i_color = SOME "brown" orelse i.i_color = SOME "honeydew")
                andalso (i.i_units = SOME "Bunch" orelse i.i_units = SOME "Ton")
                andalso (i.i_size = SOME "N/A" orelse i.i_size = SOME "small")
              orelse i.i_category = SOME "Men"
                andalso (i.i_color = SOME "floral" orelse i.i_color = SOME "deep")
                andalso (i.i_units = SOME "N/A" orelse i.i_units = SOME "Dozen")
                andalso (i.i_size = SOME "petite" orelse i.i_size = SOME "large")
              orelse i.i_category = SOME "Men"
                andalso (i.i_color = SOME "light" orelse i.i_color = SOME "cornflower")
                andalso (i.i_units = SOME "Box" orelse i.i_units = SOME "Pound")
                andalso (i.i_size = SOME "medium" orelse i.i_size = SOME "extra large")
              orelse i.i_category = SOME "Women"
                andalso (i.i_color = SOME "midnight" orelse i.i_color = SOME "snow")
                andalso (i.i_units = SOME "Pallet" orelse i.i_units = SOME "Gross")
                andalso (i.i_size = SOME "medium" orelse i.i_size = SOME "extra large")
              orelse i.i_category = SOME "Women"
                andalso (i.i_color = SOME "cyan" orelse i.i_color = SOME "papaya")
                andalso (i.i_units = SOME "Cup" orelse i.i_units = SOME "Dram")
                andalso (i.i_size = SOME "N/A" orelse i.i_size = SOME "small")
              orelse i.i_category = SOME "Men"
                andalso (i.i_color = SOME "orange" orelse i.i_color = SOME "frosted")
                andalso (i.i_units = SOME "Each" orelse i.i_units = SOME "Tbl")
                andalso (i.i_size = SOME "petite" orelse i.i_size = SOME "large")
              orelse i.i_category = SOME "Men"
                andalso (i.i_color = SOME "forest" orelse i.i_color = SOME "ghost")
                andalso (i.i_units = SOME "Lb" orelse i.i_units = SOME "Bundle")
                andalso (i.i_size = SOME "medium" orelse i.i_size = SOME "extra large")))
    yield i1.i_product_name
    distinct
    order current
    take 100;
> val q41 = fn : unit -> string option list
val r41 = q41 ();
> val r41 = [] : string option list

(* --- q42 -------------------------------------------------------- *)
(*
SELECT
  dt.d_year,
  item.i_category_id,
  item.i_category,
  sum(ss_ext_sales_price)
FROM date_dim dt, store_sales, item
WHERE dt.d_date_sk = store_sales.ss_sold_date_sk
  AND store_sales.ss_item_sk = item.i_item_sk
  AND item.i_manager_id = 1
  AND dt.d_moy = 11
  AND dt.d_year = 2000
GROUP BY dt.d_year
  , item.i_category_id
  , item.i_category
ORDER BY sum(ss_ext_sales_price) DESC, dt.d_year
  , item.i_category_id
  , item.i_category
LIMIT 100
*)
fun q42 () =
  from dt in tpcds.date_dim,
      ss in tpcds.store_sales,
      i in tpcds.item
    where SOME dt.d_date_sk = ss.ss_sold_date_sk
      andalso ss.ss_item_sk = i.i_item_sk
      andalso i.i_manager_id = SOME 1
      andalso dt.d_moy = SOME 11
      andalso dt.d_year = SOME 2000
    group {dt.d_year, i.i_category_id, i.i_category}
      compute {sum = sum over ss.ss_ext_sales_price}
    order (DESC sum, d_year, i_category_id, i_category)
    take 100;
> val q42 = fn
>   : unit
>      -> {d_year:int option, i_category:string option,
>           i_category_id:int option, sum:decimal option} list
val r42 = q42 ();
