(* --- q64 -------------------------------------------------------- *)
(*
WITH cs_ui AS
(SELECT
    cs_item_sk,
    sum(cs_ext_list_price) AS sale,
    sum(cr_refunded_cash + cr_reversed_charge + cr_store_credit) AS refund
  FROM catalog_sales
    , catalog_returns
  WHERE cs_item_sk = cr_item_sk
    AND cs_order_number = cr_order_number
  GROUP BY cs_item_sk
  HAVING sum(cs_ext_list_price) > 2 * sum(cr_refunded_cash + cr_reversed_charge + cr_store_credit)),
    cross_sales AS
  (SELECT
    i_product_name product_name,
    i_item_sk item_sk,
    s_store_name store_name,
    s_zip store_zip,
    ad1.ca_street_number b_street_number,
    ad1.ca_street_name b_streen_name,
    ad1.ca_city b_city,
    ad1.ca_zip b_zip,
    ad2.ca_street_number c_street_number,
    ad2.ca_street_name c_street_name,
    ad2.ca_city c_city,
    ad2.ca_zip c_zip,
    d1.d_year AS syear,
    d2.d_year AS fsyear,
    d3.d_year s2year,
    count(*) cnt,
    sum(ss_wholesale_cost) s1,
    sum(ss_list_price) s2,
    sum(ss_coupon_amt) s3
  FROM store_sales, store_returns, cs_ui, date_dim d1, date_dim d2, date_dim d3,
    store, customer, customer_demographics cd1, customer_demographics cd2,
    promotion, household_demographics hd1, household_demographics hd2,
    customer_address ad1, customer_address ad2, income_band ib1, income_band ib2, item
  WHERE ss_store_sk = s_store_sk AND
    ss_sold_date_sk = d1.d_date_sk AND
    ss_customer_sk = c_customer_sk AND
    ss_cdemo_sk = cd1.cd_demo_sk AND
    ss_hdemo_sk = hd1.hd_demo_sk AND
    ss_addr_sk = ad1.ca_address_sk AND
    ss_item_sk = i_item_sk AND
    ss_item_sk = sr_item_sk AND
    ss_ticket_number = sr_ticket_number AND
    ss_item_sk = cs_ui.cs_item_sk AND
    c_current_cdemo_sk = cd2.cd_demo_sk AND
    c_current_hdemo_sk = hd2.hd_demo_sk AND
    c_current_addr_sk = ad2.ca_address_sk AND
    c_first_sales_date_sk = d2.d_date_sk AND
    c_first_shipto_date_sk = d3.d_date_sk AND
    ss_promo_sk = p_promo_sk AND
    hd1.hd_income_band_sk = ib1.ib_income_band_sk AND
    hd2.hd_income_band_sk = ib2.ib_income_band_sk AND
    cd1.cd_marital_status <> cd2.cd_marital_status AND
    i_color IN ('purple', 'burlywood', 'indian', 'spring', 'floral', 'medium') AND
    i_current_price BETWEEN 64 AND 64 + 10 AND
    i_current_price BETWEEN 64 + 1 AND 64 + 15
  GROUP BY i_product_name, i_item_sk, s_store_name, s_zip, ad1.ca_street_number,
    ad1.ca_street_name, ad1.ca_city, ad1.ca_zip, ad2.ca_street_number,
    ad2.ca_street_name, ad2.ca_city, ad2.ca_zip, d1.d_year, d2.d_year, d3.d_year
  )
SELECT
  cs1.product_name,
  cs1.store_name,
  cs1.store_zip,
  cs1.b_street_number,
  cs1.b_streen_name,
  cs1.b_city,
  cs1.b_zip,
  cs1.c_street_number,
  cs1.c_street_name,
  cs1.c_city,
  cs1.c_zip,
  cs1.syear,
  cs1.cnt,
  cs1.s1,
  cs1.s2,
  cs1.s3,
  cs2.s1,
  cs2.s2,
  cs2.s3,
  cs2.syear,
  cs2.cnt
FROM cross_sales cs1, cross_sales cs2
WHERE cs1.item_sk = cs2.item_sk AND
  cs1.syear = 1999 AND
  cs2.syear = 1999 + 1 AND
  cs2.cnt <= cs1.cnt AND
  cs1.store_name = cs2.store_name AND
  cs1.store_zip = cs2.store_zip
ORDER BY cs1.product_name, cs1.store_name, cs2.cnt
*)
fun q64 () =
  let
    (* "cr_refunded_cash + cr_reversed_charge + cr_store_credit" *)
    fun refund cr =
      case (cr.cr_refunded_cash, cr.cr_reversed_charge, cr.cr_store_credit) of
          (SOME a, SOME b, SOME c) => SOME (a + b + c)
        | _ => NONE
    val cs_ui =
      from cs in tpcds.catalog_sales,
          cr in tpcds.catalog_returns
        where cs.cs_item_sk = cr.cr_item_sk
          andalso cs.cs_order_number = cr.cr_order_number
        group cs.cs_item_sk
          compute {sale = sumSome over cs.cs_ext_list_price,
            refund = sumSome over refund cr}
        where (case (sale, refund) of
                  (SOME s, SOME r) => s > Decimal.fromInt 2 * r
                | _ => false)
    (* "store" and "customer" are scanned before "d2" and "d3", not after
     * as in the SQL, because Morel joins in the order written, and "d2"
     * and "d3" join only to "customer"; before it, each would be a cross
     * product. *)
    val cross_sales =
      from ss in tpcds.store_sales,
          sr in tpcds.store_returns,
          cs_ui in cs_ui,
          d1 in tpcds.date_dim,
          s in tpcds.store,
          c in tpcds.customer,
          d2 in tpcds.date_dim,
          d3 in tpcds.date_dim,
          cd1 in tpcds.customer_demographics,
          cd2 in tpcds.customer_demographics,
          p in tpcds.promotion,
          hd1 in tpcds.household_demographics,
          hd2 in tpcds.household_demographics,
          ad1 in tpcds.customer_address,
          ad2 in tpcds.customer_address,
          ib1 in tpcds.income_band,
          ib2 in tpcds.income_band,
          i in tpcds.item
        where ss.ss_store_sk = SOME s.s_store_sk
          andalso ss.ss_sold_date_sk = SOME d1.d_date_sk
          andalso ss.ss_customer_sk = SOME c.c_customer_sk
          andalso ss.ss_cdemo_sk = SOME cd1.cd_demo_sk
          andalso ss.ss_hdemo_sk = SOME hd1.hd_demo_sk
          andalso ss.ss_addr_sk = SOME ad1.ca_address_sk
          andalso ss.ss_item_sk = i.i_item_sk
          andalso ss.ss_item_sk = sr.sr_item_sk
          andalso ss.ss_ticket_number = sr.sr_ticket_number
          andalso ss.ss_item_sk = cs_ui.cs_item_sk
          andalso c.c_current_cdemo_sk = SOME cd2.cd_demo_sk
          andalso c.c_current_hdemo_sk = SOME hd2.hd_demo_sk
          andalso c.c_current_addr_sk = SOME ad2.ca_address_sk
          andalso c.c_first_sales_date_sk = SOME d2.d_date_sk
          andalso c.c_first_shipto_date_sk = SOME d3.d_date_sk
          andalso ss.ss_promo_sk = SOME p.p_promo_sk
          andalso hd1.hd_income_band_sk = SOME ib1.ib_income_band_sk
          andalso hd2.hd_income_band_sk = SOME ib2.ib_income_band_sk
          andalso cd1.cd_marital_status <> NONE
          andalso cd2.cd_marital_status <> NONE
          andalso cd1.cd_marital_status <> cd2.cd_marital_status
          andalso i.i_color elem [SOME "purple", SOME "burlywood",
            SOME "indian", SOME "spring", SOME "floral", SOME "medium"]
          andalso i.i_current_price >= SOME (Decimal.fromInt 64)
          andalso i.i_current_price <= SOME (Decimal.fromInt (64 + 10))
          andalso i.i_current_price >= SOME (Decimal.fromInt (64 + 1))
          andalso i.i_current_price <= SOME (Decimal.fromInt (64 + 15))
        group {product_name = i.i_product_name, item_sk = i.i_item_sk,
            store_name = s.s_store_name, store_zip = s.s_zip,
            b_street_number = ad1.ca_street_number,
            b_streen_name = ad1.ca_street_name, b_city = ad1.ca_city,
            b_zip = ad1.ca_zip, c_street_number = ad2.ca_street_number,
            c_street_name = ad2.ca_street_name, c_city = ad2.ca_city,
            c_zip = ad2.ca_zip, syear = d1.d_year, fsyear = d2.d_year,
            s2year = d3.d_year}
          compute {cnt = count over (), s1 = sumSome over ss.ss_wholesale_cost,
            s2 = sumSome over ss.ss_list_price, s3 = sumSome over ss.ss_coupon_amt}
  in
    from cs1 in cross_sales,
        cs2 in cross_sales
      where cs1.item_sk = cs2.item_sk
        andalso cs1.syear = SOME 1999
        andalso cs2.syear = SOME (1999 + 1)
        andalso cs2.cnt <= cs1.cnt
        andalso cs1.store_name <> NONE
        andalso cs1.store_name = cs2.store_name
        andalso cs1.store_zip <> NONE
        andalso cs1.store_zip = cs2.store_zip
      yield {cs1.product_name, cs1.store_name, cs1.store_zip,
        cs1.b_street_number, cs1.b_streen_name, cs1.b_city, cs1.b_zip,
        cs1.c_street_number, cs1.c_street_name, cs1.c_city, cs1.c_zip,
        cs1.syear, cs1.cnt, cs1.s1, cs1.s2, cs1.s3, s1_2 = cs2.s1,
        s2_2 = cs2.s2, s3_2 = cs2.s3, syear_2 = cs2.syear, cnt_2 = cs2.cnt}
      order (product_name, store_name, cnt_2)
  end;
