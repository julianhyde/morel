(* --- q60 -------------------------------------------------------- *)
(*
WITH ss AS (
  SELECT
    i_item_id,
    sum(ss_ext_sales_price) total_sales
  FROM store_sales, date_dim, customer_address, item
  WHERE
    i_item_id IN (SELECT i_item_id
    FROM item
    WHERE i_category IN ('Music'))
      AND ss_item_sk = i_item_sk
      AND ss_sold_date_sk = d_date_sk
      AND d_year = 1998
      AND d_moy = 9
      AND ss_addr_sk = ca_address_sk
      AND ca_gmt_offset = -5
  GROUP BY i_item_id),
    cs AS (
    SELECT
      i_item_id,
      sum(cs_ext_sales_price) total_sales
    FROM catalog_sales, date_dim, customer_address, item
    WHERE
      i_item_id IN (SELECT i_item_id
      FROM item
      WHERE i_category IN ('Music'))
        AND cs_item_sk = i_item_sk
        AND cs_sold_date_sk = d_date_sk
        AND d_year = 1998
        AND d_moy = 9
        AND cs_bill_addr_sk = ca_address_sk
        AND ca_gmt_offset = -5
    GROUP BY i_item_id),
    ws AS (
    SELECT
      i_item_id,
      sum(ws_ext_sales_price) total_sales
    FROM web_sales, date_dim, customer_address, item
    WHERE
      i_item_id IN (SELECT i_item_id
      FROM item
      WHERE i_category IN ('Music'))
        AND ws_item_sk = i_item_sk
        AND ws_sold_date_sk = d_date_sk
        AND d_year = 1998
        AND d_moy = 9
        AND ws_bill_addr_sk = ca_address_sk
        AND ca_gmt_offset = -5
    GROUP BY i_item_id)
SELECT
  i_item_id,
  sum(total_sales) total_sales
FROM (SELECT *
      FROM ss
      UNION ALL
      SELECT *
      FROM cs
      UNION ALL
      SELECT *
      FROM ws) tmp1
GROUP BY i_item_id
ORDER BY i_item_id, total_sales
LIMIT 100
*)
fun q60 () =
  let
    val keys =
      from i in tpcds.item
        where i.i_category elem [SOME "Music"]
        yield i.i_item_id
  in
    from tmp1 in (
        from ss in tpcds.store_sales,
            d in tpcds.date_dim,
            ca in tpcds.customer_address,
            i in tpcds.item
          where i.i_item_id elem keys
            andalso ss.ss_item_sk = i.i_item_sk
            andalso ss.ss_sold_date_sk = SOME d.d_date_sk
            andalso d.d_year = SOME 1998
            andalso d.d_moy = SOME 9
            andalso ss.ss_addr_sk = SOME ca.ca_address_sk
            andalso ca.ca_gmt_offset = SOME (Decimal.fromInt ~5)
          group i.i_item_id
            compute {total_sales = sumSome over ss.ss_ext_sales_price})
      union
        (from cs in tpcds.catalog_sales,
            d in tpcds.date_dim,
            ca in tpcds.customer_address,
            i in tpcds.item
          where i.i_item_id elem keys
            andalso cs.cs_item_sk = i.i_item_sk
            andalso cs.cs_sold_date_sk = SOME d.d_date_sk
            andalso d.d_year = SOME 1998
            andalso d.d_moy = SOME 9
            andalso cs.cs_bill_addr_sk = SOME ca.ca_address_sk
            andalso ca.ca_gmt_offset = SOME (Decimal.fromInt ~5)
          group i.i_item_id
            compute {total_sales = sumSome over cs.cs_ext_sales_price}),
        (from ws in tpcds.web_sales,
            d in tpcds.date_dim,
            ca in tpcds.customer_address,
            i in tpcds.item
          where i.i_item_id elem keys
            andalso ws.ws_item_sk = i.i_item_sk
            andalso ws.ws_sold_date_sk = SOME d.d_date_sk
            andalso d.d_year = SOME 1998
            andalso d.d_moy = SOME 9
            andalso ws.ws_bill_addr_sk = SOME ca.ca_address_sk
            andalso ca.ca_gmt_offset = SOME (Decimal.fromInt ~5)
          group i.i_item_id
            compute {total_sales = sumSome over ws.ws_ext_sales_price})
      group tmp1.i_item_id
        compute {total_sales = sumSome over tmp1.total_sales}
      order (i_item_id, total_sales)
      take 100
  end;
> val q60 = fn : unit -> {i_item_id:string, total_sales:decimal option} list
