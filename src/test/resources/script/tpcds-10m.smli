(* --- q48 -------------------------------------------------------- *)
(*
SELECT sum(ss_quantity)
FROM store_sales, store, customer_demographics, customer_address, date_dim
WHERE s_store_sk = ss_store_sk
  AND ss_sold_date_sk = d_date_sk AND d_year = 2001
  AND
  (
    (
      cd_demo_sk = ss_cdemo_sk
        AND
        cd_marital_status = 'M'
        AND
        cd_education_status = '4 yr Degree'
        AND
        ss_sales_price BETWEEN 100.00 AND 150.00
    )
      OR
      (
        cd_demo_sk = ss_cdemo_sk
          AND
          cd_marital_status = 'D'
          AND
          cd_education_status = '2 yr Degree'
          AND
          ss_sales_price BETWEEN 50.00 AND 100.00
      )
      OR
      (
        cd_demo_sk = ss_cdemo_sk
          AND
          cd_marital_status = 'S'
          AND
          cd_education_status = 'College'
          AND
          ss_sales_price BETWEEN 150.00 AND 200.00
      )
  )
  AND
  (
    (
      ss_addr_sk = ca_address_sk
        AND
        ca_country = 'United States'
        AND
        ca_state IN ('CO', 'OH', 'TX')
        AND ss_net_profit BETWEEN 0 AND 2000
    )
      OR
      (ss_addr_sk = ca_address_sk
        AND
        ca_country = 'United States'
        AND
        ca_state IN ('OR', 'MN', 'KY')
        AND ss_net_profit BETWEEN 150 AND 3000
      )
      OR
      (ss_addr_sk = ca_address_sk
        AND
        ca_country = 'United States'
        AND
        ca_state IN ('VA', 'CA', 'MS')
        AND ss_net_profit BETWEEN 50 AND 25000
      )
  )
*)
(* Each disjunct of the SQL's two "OR"s repeats a join condition
 * ("cd_demo_sk = ss_cdemo_sk", "ss_addr_sk = ca_address_sk"). Morel
 * does not factor a common conjunct out of a disjunction, so, written
 * as is, the query would be a cross product of store_sales and
 * customer_demographics; the conditions are factored by hand. *)
fun q48 () =
  from ss in tpcds.store_sales,
      s in tpcds.store,
      cd in tpcds.customer_demographics,
      ca in tpcds.customer_address,
      d in tpcds.date_dim
    where ss.ss_store_sk = SOME s.s_store_sk
      andalso ss.ss_sold_date_sk = SOME d.d_date_sk
      andalso d.d_year = SOME 2001
      andalso ss.ss_cdemo_sk = SOME cd.cd_demo_sk
      andalso (cd.cd_marital_status = SOME "M"
          andalso cd.cd_education_status = SOME "4 yr Degree"
          andalso ss.ss_sales_price >= SOME (Decimal.fromInt 100)
          andalso ss.ss_sales_price <= SOME (Decimal.fromInt 150)
        orelse cd.cd_marital_status = SOME "D"
          andalso cd.cd_education_status = SOME "2 yr Degree"
          andalso ss.ss_sales_price >= SOME (Decimal.fromInt 50)
          andalso ss.ss_sales_price <= SOME (Decimal.fromInt 100)
        orelse cd.cd_marital_status = SOME "S"
          andalso cd.cd_education_status = SOME "College"
          andalso ss.ss_sales_price >= SOME (Decimal.fromInt 150)
          andalso ss.ss_sales_price <= SOME (Decimal.fromInt 200))
      andalso ss.ss_addr_sk = SOME ca.ca_address_sk
      andalso ca.ca_country = SOME "United States"
      andalso (ca.ca_state elem [SOME "CO", SOME "OH", SOME "TX"]
          andalso ss.ss_net_profit >= SOME (Decimal.fromInt 0)
          andalso ss.ss_net_profit <= SOME (Decimal.fromInt 2000)
        orelse ca.ca_state elem [SOME "OR", SOME "MN", SOME "KY"]
          andalso ss.ss_net_profit >= SOME (Decimal.fromInt 150)
          andalso ss.ss_net_profit <= SOME (Decimal.fromInt 3000)
        orelse ca.ca_state elem [SOME "VA", SOME "CA", SOME "MS"]
          andalso ss.ss_net_profit >= SOME (Decimal.fromInt 50)
          andalso ss.ss_net_profit <= SOME (Decimal.fromInt 25000))
    compute sumSome over ss.ss_quantity;
> val q48 = fn : unit -> int option
val r48 = q48 ();
> val r48 = SOME 1858 : int option

(* --- q49 -------------------------------------------------------- *)
(*
SELECT
  'web' AS channel,
  web.item,
  web.return_ratio,
  web.return_rank,
  web.currency_rank
FROM (
       SELECT
         item,
         return_ratio,
         currency_ratio,
         rank()
         OVER (
           ORDER BY return_ratio) AS return_rank,
         rank()
         OVER (
           ORDER BY currency_ratio) AS currency_rank
       FROM
         (SELECT
           ws.ws_item_sk AS item,
           (cast(sum(coalesce(wr.wr_return_quantity, 0)) AS DECIMAL(15, 4)) /
             cast(sum(coalesce(ws.ws_quantity, 0)) AS DECIMAL(15, 4))) AS return_ratio,
           (cast(sum(coalesce(wr.wr_return_amt, 0)) AS DECIMAL(15, 4)) /
             cast(sum(coalesce(ws.ws_net_paid, 0)) AS DECIMAL(15, 4))) AS currency_ratio
         FROM
           web_sales ws LEFT OUTER JOIN web_returns wr
             ON (ws.ws_order_number = wr.wr_order_number AND
             ws.ws_item_sk = wr.wr_item_sk)
           , date_dim
         WHERE
           wr.wr_return_amt > 10000
             AND ws.ws_net_profit > 1
             AND ws.ws_net_paid > 0
             AND ws.ws_quantity > 0
             AND ws_sold_date_sk = d_date_sk
             AND d_year = 2001
             AND d_moy = 12
         GROUP BY ws.ws_item_sk
         ) in_web
     ) web
WHERE (web.return_rank <= 10 OR web.currency_rank <= 10)
UNION
SELECT
  'catalog' AS channel,
  catalog.item,
  catalog.return_ratio,
  catalog.return_rank,
  catalog.currency_rank
FROM (
       SELECT
         item,
         return_ratio,
         currency_ratio,
         rank()
         OVER (
           ORDER BY return_ratio) AS return_rank,
         rank()
         OVER (
           ORDER BY currency_ratio) AS currency_rank
       FROM
         (SELECT
           cs.cs_item_sk AS item,
           (cast(sum(coalesce(cr.cr_return_quantity, 0)) AS DECIMAL(15, 4)) /
             cast(sum(coalesce(cs.cs_quantity, 0)) AS DECIMAL(15, 4))) AS return_ratio,
           (cast(sum(coalesce(cr.cr_return_amount, 0)) AS DECIMAL(15, 4)) /
             cast(sum(coalesce(cs.cs_net_paid, 0)) AS DECIMAL(15, 4))) AS currency_ratio
         FROM
           catalog_sales cs LEFT OUTER JOIN catalog_returns cr
             ON (cs.cs_order_number = cr.cr_order_number AND
             cs.cs_item_sk = cr.cr_item_sk)
           , date_dim
         WHERE
           cr.cr_return_amount > 10000
             AND cs.cs_net_profit > 1
             AND cs.cs_net_paid > 0
             AND cs.cs_quantity > 0
             AND cs_sold_date_sk = d_date_sk
             AND d_year = 2001
             AND d_moy = 12
         GROUP BY cs.cs_item_sk
         ) in_cat
     ) catalog
WHERE (catalog.return_rank <= 10 OR catalog.currency_rank <= 10)
UNION
SELECT
  'store' AS channel,
  store.item,
  store.return_ratio,
  store.return_rank,
  store.currency_rank
FROM (
       SELECT
         item,
         return_ratio,
         currency_ratio,
         rank()
         OVER (
           ORDER BY return_ratio) AS return_rank,
         rank()
         OVER (
           ORDER BY currency_ratio) AS currency_rank
       FROM
         (SELECT
           sts.ss_item_sk AS item,
           (cast(sum(coalesce(sr.sr_return_quantity, 0)) AS DECIMAL(15, 4)) /
             cast(sum(coalesce(sts.ss_quantity, 0)) AS DECIMAL(15, 4))) AS return_ratio,
           (cast(sum(coalesce(sr.sr_return_amt, 0)) AS DECIMAL(15, 4)) /
             cast(sum(coalesce(sts.ss_net_paid, 0)) AS DECIMAL(15, 4))) AS currency_ratio
         FROM
           store_sales sts LEFT OUTER JOIN store_returns sr
             ON (sts.ss_ticket_number = sr.sr_ticket_number AND sts.ss_item_sk = sr.sr_item_sk)
           , date_dim
         WHERE
           sr.sr_return_amt > 10000
             AND sts.ss_net_profit > 1
             AND sts.ss_net_paid > 0
             AND sts.ss_quantity > 0
             AND ss_sold_date_sk = d_date_sk
             AND d_year = 2001
             AND d_moy = 12
         GROUP BY sts.ss_item_sk
         ) in_store
     ) store
WHERE (store.return_rank <= 10 OR store.currency_rank <= 10)
ORDER BY 1, 4, 5
LIMIT 100
*)
(* "rank() OVER (ORDER BY x)" is one more than the number of rows whose
 * "x" is less; there are few rows. "sum(coalesce(x, 0))" is "sum" of
 * "getOpt (x, 0)". The ranking is written out in each branch, rather
 * than in a function: a function whose query reads its argument
 * twice, called twice, raises ArrayIndexOutOfBoundsException. *)
fun q49 () =
  from x in
      (let
        val rows =
          from ws in tpcds.web_sales
            left join wr in tpcds.web_returns
              on ws.ws_order_number = wr.wr_order_number
                andalso ws.ws_item_sk = wr.wr_item_sk,
            d in tpcds.date_dim
            where Option.`join` wr?.wr_return_amt
                > SOME (Decimal.fromInt 10000)
              andalso ws.ws_net_profit > SOME (Decimal.fromInt 1)
              andalso ws.ws_net_paid > SOME (Decimal.fromInt 0)
              andalso ws.ws_quantity > SOME 0
              andalso ws.ws_sold_date_sk = SOME d.d_date_sk
              andalso d.d_year = SOME 2001
              andalso d.d_moy = SOME 12
            group {item = ws.ws_item_sk}
              compute {
                return_qty =
                  sum over getOpt (Option.`join` wr?.wr_return_quantity, 0),
                qty = sum over getOpt (ws.ws_quantity, 0),
                return_amt = sum over getOpt (Option.`join` wr?.wr_return_amt,
                  Decimal.fromInt 0),
                net_paid = sum over getOpt (ws.ws_net_paid,
                  Decimal.fromInt 0)}
            yield {item,
              return_ratio = Decimal.fromInt return_qty / Decimal.fromInt qty,
              currency_ratio = return_amt / net_paid}
      in
        from r in rows
          yield {channel = "web", r.item, r.return_ratio,
            return_rank =
              1 + count (from s in rows where s.return_ratio < r.return_ratio),
            currency_rank =
              1 + count (from s in rows
                where s.currency_ratio < r.currency_ratio)}
          where return_rank <= 10 orelse currency_rank <= 10
      end)
    union distinct
          (let
            val rows =
              from cs in tpcds.catalog_sales
                left join cr in tpcds.catalog_returns
                  on cs.cs_order_number = cr.cr_order_number
                    andalso cs.cs_item_sk = cr.cr_item_sk,
                d in tpcds.date_dim
                where Option.`join` cr?.cr_return_amount
                    > SOME (Decimal.fromInt 10000)
                  andalso cs.cs_net_profit > SOME (Decimal.fromInt 1)
                  andalso cs.cs_net_paid > SOME (Decimal.fromInt 0)
                  andalso cs.cs_quantity > SOME 0
                  andalso cs.cs_sold_date_sk = SOME d.d_date_sk
                  andalso d.d_year = SOME 2001
                  andalso d.d_moy = SOME 12
                group {item = cs.cs_item_sk}
                  compute {
                    return_qty =
                      sum over getOpt (Option.`join` cr?.cr_return_quantity, 0),
                    qty = sum over getOpt (cs.cs_quantity, 0),
                    return_amt = sum over getOpt (Option.`join` cr?.cr_return_amount,
                      Decimal.fromInt 0),
                    net_paid = sum over getOpt (cs.cs_net_paid,
                      Decimal.fromInt 0)}
                yield {item,
                  return_ratio = Decimal.fromInt return_qty / Decimal.fromInt qty,
                  currency_ratio = return_amt / net_paid}
          in
            from r in rows
              yield {channel = "catalog", r.item, r.return_ratio,
                return_rank =
                  1 + count (from s in rows where s.return_ratio < r.return_ratio),
                currency_rank =
                  1 + count (from s in rows
                    where s.currency_ratio < r.currency_ratio)}
              where return_rank <= 10 orelse currency_rank <= 10
          end),
          (let
            val rows =
              from ss in tpcds.store_sales
                left join sr in tpcds.store_returns
                  on ss.ss_ticket_number = sr.sr_ticket_number
                    andalso ss.ss_item_sk = sr.sr_item_sk,
                d in tpcds.date_dim
                where Option.`join` sr?.sr_return_amt
                    > SOME (Decimal.fromInt 10000)
                  andalso ss.ss_net_profit > SOME (Decimal.fromInt 1)
                  andalso ss.ss_net_paid > SOME (Decimal.fromInt 0)
                  andalso ss.ss_quantity > SOME 0
                  andalso ss.ss_sold_date_sk = SOME d.d_date_sk
                  andalso d.d_year = SOME 2001
                  andalso d.d_moy = SOME 12
                group {item = ss.ss_item_sk}
                  compute {
                    return_qty =
                      sum over getOpt (Option.`join` sr?.sr_return_quantity, 0),
                    qty = sum over getOpt (ss.ss_quantity, 0),
                    return_amt = sum over getOpt (Option.`join` sr?.sr_return_amt,
                      Decimal.fromInt 0),
                    net_paid = sum over getOpt (ss.ss_net_paid,
                      Decimal.fromInt 0)}
                yield {item,
                  return_ratio = Decimal.fromInt return_qty / Decimal.fromInt qty,
                  currency_ratio = return_amt / net_paid}
          in
            from r in rows
              yield {channel = "store", r.item, r.return_ratio,
                return_rank =
                  1 + count (from s in rows where s.return_ratio < r.return_ratio),
                currency_rank =
                  1 + count (from s in rows
                    where s.currency_ratio < r.currency_ratio)}
              where return_rank <= 10 orelse currency_rank <= 10
          end)
    yield {x.channel, x.item, x.return_ratio, x.return_rank, x.currency_rank}
    order (channel, return_rank, currency_rank)
    take 100;
> val q49 = fn
>   : unit
>      -> {channel:string, currency_rank:int, item:int, return_rank:int,
>           return_ratio:decimal} list
val r49 = q49 ();
> channel currency_rank item return_rank return_ratio
