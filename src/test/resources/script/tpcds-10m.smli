>   : unit
>      -> {catalog_sales_profit:decimal option, i_item_desc:string option,
>           i_item_id:string, s_store_id:string, s_store_name:string option,
>           store_returns_loss:decimal option,
>           store_sales_profit:decimal option} list
val r25 = q25 ();
