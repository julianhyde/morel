>   : unit
>      -> {c_birth_country:string option, c_birth_day:int option,
>           c_birth_month:int option, c_birth_year:int option,
>           c_customer_id:string, c_email_address:string option,
>           c_first_name:string option, c_last_name:string option,
>           c_last_review_date:int option, c_login:string option,
>           c_preferred_cust_flag:string option, c_salutation:string option,
>           ctr_total_return:decimal option} list
val r30 = q30 ();
