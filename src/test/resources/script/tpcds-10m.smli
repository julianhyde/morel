(* --- q40 -------------------------------------------------------- *)
(*
SELECT
  w_state,
  i_item_id,
  sum(CASE WHEN (cast(d_date AS DATE) < cast('2000-03-11' AS DATE))
    THEN cs_sales_price - coalesce(cr_refunded_cash, 0)
      ELSE 0 END) AS sales_before,
  sum(CASE WHEN (cast(d_date AS DATE) >= cast('2000-03-11' AS DATE))
    THEN cs_sales_price - coalesce(cr_refunded_cash, 0)
      ELSE 0 END) AS sales_after
FROM
  catalog_sales
  LEFT OUTER JOIN catalog_returns ON
                                    (cs_order_number = cr_order_number
                                      AND cs_item_sk = cr_item_sk)
  , warehouse, item, date_dim
WHERE
  i_current_price BETWEEN 0.99 AND 1.49
    AND i_item_sk = cs_item_sk
    AND cs_warehouse_sk = w_warehouse_sk
    AND cs_sold_date_sk = d_date_sk
    AND d_date BETWEEN (cast('2000-03-11' AS DATE) - INTERVAL 30 days)
  AND (cast('2000-03-11' AS DATE) + INTERVAL 30 days)
GROUP BY w_state, i_item_id
ORDER BY w_state, i_item_id
LIMIT 100
*)
fun q40 () =
  let
    fun day (year, month, day) =
      Date.date {year, month, day, hour = 0, minute = 0, second = 0,
        offset = SOME Time.zeroTime}
    val zero = Decimal.fromInt 0
    (* "cs_sales_price - coalesce(cr_refunded_cash, 0)" *)
    fun net (price, refunded) =
      Option.map (fn p => p - getOpt (refunded, zero)) price
  in
    from cs in tpcds.catalog_sales
      left join cr in tpcds.catalog_returns
        on cs.cs_order_number = cr.cr_order_number
          andalso cs.cs_item_sk = cr.cr_item_sk,
      w in tpcds.warehouse,
      i in tpcds.item,
      d in tpcds.date_dim
      where i.i_current_price >= SOME (decimal "0.99")
        andalso i.i_current_price <= SOME (decimal "1.49")
        andalso cs.cs_item_sk = i.i_item_sk
        andalso cs.cs_warehouse_sk = SOME w.w_warehouse_sk
        andalso cs.cs_sold_date_sk = SOME d.d_date_sk
        andalso d.d_date >= SOME (day (2000, Mar, 11 - 30))
        andalso d.d_date <= SOME (day (2000, Mar, 11 + 30))
      group {w.w_state, i.i_item_id}
        compute {
          sales_before = sumSome over
            (if d.d_date <> NONE andalso d.d_date < SOME (day (2000, Mar, 11))
              then net (cs.cs_sales_price, Option.`join` cr?.cr_refunded_cash)
              else SOME zero),
          sales_after = sumSome over
            (if d.d_date >= SOME (day (2000, Mar, 11))
              then net (cs.cs_sales_price, Option.`join` cr?.cr_refunded_cash)
              else SOME zero)}
      order (w_state, i_item_id)
      take 100
  end;
> val q40 = fn
>   : unit
>      -> {i_item_id:string, sales_after:decimal option,
>           sales_before:decimal option, w_state:string option} list
val r40 = q40 ();
