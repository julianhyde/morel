 * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
 * either express or implied.  See the License for the specific
 * language governing permissions and limitations under the
 * License.
 *
 * Queries derived from TPC-DS, at scale factor 0.01 (about 10 MB),
 * translated into Morel. The data is generated by
 * src/test/resources/tpcds/generate.sh; the SQL of each query, in a
 * comment, is Spark's copy (src/test/resources/tpcds/queries).
 *
 * The harness sets "directory" to the data, so "file" holds its
 * tables, and checks each value bound as "qN" against Spark SQL's
 * answer to the same query (TpcdsChecker), as a multiset of rows.
 *
 * A column that the TPC-DS schema does not declare "not null" is an
 * option. An aggregate over an option ignores NONE, as SQL ignores
 * null. A comparison with an option is written as a comparison with
 * "SOME c"; because NONE < SOME c, that drops the rows where the
 * column is NONE, as SQL's three-valued "where" does, for "=", ">"
 * and ">=", and so for "between" too. For "<", "<=" and "<>" alone it
 * would keep them, so those are written with a guard, as is any
 * function of a column (such as "substr").
 *)
(*) requires: tpcds

val tpcds = file;
> val tpcds =
>   {VERSION={},answers={},call_center=<relation>,catalog_page=<relation>,
>    catalog_returns=<relation>,catalog_sales=<relation>,customer=<relation>,
>    customer_address=<relation>,customer_demographics=<relation>,
>    date_dim=<relation>,household_demographics=<relation>,
>    income_band=<relation>,inventory=<relation>,item=<relation>,
>    promotion=<relation>,reason=<relation>,ship_mode=<relation>,
>    store=<relation>,store_returns=<relation>,store_sales=<relation>,
>    time_dim=<relation>,warehouse=<relation>,web_page=<relation>,
>    web_returns=<relation>,web_sales=<relation>,web_site=<relation>}
>   : {VERSION:{...}, answers:{...}, call_center:{...} list,
>       catalog_page:{...} list, catalog_returns:{...} list,
>       catalog_sales:{...} list, customer:{...} list,
>       customer_address:{...} list, customer_demographics:{...} list,
>       date_dim:{...} list, household_demographics:{...} list,
>       income_band:{...} list, inventory:{...} list, item:{...} list,
>       promotion:{...} list, reason:{...} list, ship_mode:{...} list,
>       store:{...} list, store_returns:{...} list, store_sales:{...} list,
>       time_dim:{...} list, warehouse:{...} list, web_page:{...} list,
>       web_returns:{...} list, web_sales:{...} list, web_site:{...} list, ...}
Sys.set ("output", "tabular");
> val it = () : unit
Sys.set ("printLength", 10);
> val it = () : unit

(* --- q3 --------------------------------------------------------- *)
(*
SELECT
  dt.d_year,
  item.i_brand_id brand_id,
  item.i_brand brand,
  SUM(ss_ext_sales_price) sum_agg
FROM date_dim dt, store_sales, item
WHERE dt.d_date_sk = store_sales.ss_sold_date_sk
  AND store_sales.ss_item_sk = item.i_item_sk
  AND item.i_manufact_id = 128
  AND dt.d_moy = 11
GROUP BY dt.d_year, item.i_brand, item.i_brand_id
ORDER BY dt.d_year, sum_agg DESC, brand_id
LIMIT 100
*)
fun q3 () =
  from dt in tpcds.date_dim,
      ss in tpcds.store_sales,
      i in tpcds.item
    where SOME dt.d_date_sk = ss.ss_sold_date_sk
      andalso ss.ss_item_sk = i.i_item_sk
      andalso i.i_manufact_id = SOME 128
      andalso dt.d_moy = SOME 11
    group {dt.d_year, brand_id = i.i_brand_id, brand = i.i_brand}
      compute {sum_agg = sum over ss.ss_ext_sales_price}
    order (d_year, DESC sum_agg, brand_id)
    take 100;
> val q3 = fn
>   : unit
>      -> {brand:string option, brand_id:int option, d_year:int option,
>           sum_agg:decimal option} list
val r3 = q3 ();
> brand            brand_id d_year sum_agg
> ---------------- -------- ------ --------
> brandbrand #10    7007010   1998 14247.33
> amalgexporti #1   3001001   1998  8134.69
> edu packamalg #1  1004001   1998  2206.52
> edu packcorp #8   6004008   1998   984.85
> amalgexporti #1   3001001   1999  7830.78
> edu packcorp #8   6004008   1999  6224.95
> edu packamalg #1  1004001   1999  6131.62
> brandbrand #10    7007010   1999   4792.9
> edu packcorp #8   6004008   2000  9502.59
> amalgexporti #1   3001001   2000  6823.96
> ...
>
> val r3 : {brand:string option, brand_id:int option, d_year:int option, sum_agg:decimal option} list

(* --- q15 -------------------------------------------------------- *)
(*
SELECT
  ca_zip,
  sum(cs_sales_price)
FROM catalog_sales, customer, customer_address, date_dim
WHERE cs_bill_customer_sk = c_customer_sk
  AND c_current_addr_sk = ca_address_sk
  AND (substr(ca_zip, 1, 5) IN ('85669', '86197', '88274', '83405', '86475',
                                '85392', '85460', '80348', '81792')
  OR ca_state IN ('CA', 'WA', 'GA')
  OR cs_sales_price > 500)
  AND cs_sold_date_sk = d_date_sk
  AND d_qoy = 2 AND d_year = 2001
GROUP BY ca_zip
ORDER BY ca_zip
LIMIT 100
*)
fun q15 () =
  from cs in tpcds.catalog_sales,
      c in tpcds.customer,
      ca in tpcds.customer_address,
      d in tpcds.date_dim
    where cs.cs_bill_customer_sk = SOME c.c_customer_sk
      andalso c.c_current_addr_sk = SOME ca.ca_address_sk
      andalso (Option.map (fn z => String.substring (z, 0, 5)) ca.ca_zip
            elem [SOME "85669", SOME "86197", SOME "88274", SOME "83405",
              SOME "86475", SOME "85392", SOME "85460", SOME "80348",
              SOME "81792"]
        orelse ca.ca_state elem [SOME "CA", SOME "WA", SOME "GA"]
        orelse cs.cs_sales_price > SOME (Decimal.fromInt 500))
      andalso cs.cs_sold_date_sk = SOME d.d_date_sk
      andalso d.d_qoy = SOME 2
      andalso d.d_year = SOME 2001
    group ca.ca_zip compute {sum = sum over cs.cs_sales_price}
    order ca_zip
    take 100;
> val q15 = fn : unit -> {ca_zip:string option, sum:decimal option} list
val r15 = q15 ();
> ca_zip sum
> ------ -------
>         481.17
> 30059   581.35
> 30399   1175.8
> 30411  1307.33
> 30534   244.73
> 32293   731.64
> 33394   196.27
> 34136  1118.87
> 36060   378.46
> 36557   483.62
> ...
>
> val r15 : {ca_zip:string option, sum:decimal option} list

(* --- q19 -------------------------------------------------------- *)
(*
SELECT
  i_brand_id brand_id,
  i_brand brand,
  i_manufact_id,
  i_manufact,
  sum(ss_ext_sales_price) ext_price
FROM date_dim, store_sales, item, customer, customer_address, store
WHERE d_date_sk = ss_sold_date_sk
  AND ss_item_sk = i_item_sk
  AND i_manager_id = 8
  AND d_moy = 11
  AND d_year = 1998
  AND ss_customer_sk = c_customer_sk
  AND c_current_addr_sk = ca_address_sk
  AND substr(ca_zip, 1, 5) <> substr(s_zip, 1, 5)
  AND ss_store_sk = s_store_sk
GROUP BY i_brand, i_brand_id, i_manufact_id, i_manufact
ORDER BY ext_price DESC, brand, brand_id, i_manufact_id, i_manufact
LIMIT 100
*)
fun q19 () =
  from d in tpcds.date_dim,
      ss in tpcds.store_sales,
      i in tpcds.item,
      c in tpcds.customer,
      ca in tpcds.customer_address,
      s in tpcds.store
    where ss.ss_sold_date_sk = SOME d.d_date_sk
      andalso ss.ss_item_sk = i.i_item_sk
      andalso i.i_manager_id = SOME 8
      andalso d.d_moy = SOME 11
      andalso d.d_year = SOME 1998
      andalso ss.ss_customer_sk = SOME c.c_customer_sk
      andalso c.c_current_addr_sk = SOME ca.ca_address_sk
      andalso (case (ca.ca_zip, s.s_zip) of
                  (SOME z1, SOME z2) =>
                    String.substring (z1, 0, 5) <> String.substring (z2, 0, 5)
                | _ => false)
      andalso ss.ss_store_sk = SOME s.s_store_sk
    group {brand_id = i.i_brand_id, brand = i.i_brand, i.i_manufact_id,
        i.i_manufact}
      compute {ext_price = sum over ss.ss_ext_sales_price}
    order (DESC ext_price, brand, brand_id, i_manufact_id, i_manufact)
    take 100;
> val q19 = fn
>   : unit
>      -> {brand:string option, brand_id:int option, ext_price:decimal option,
>           i_manufact:string option, i_manufact_id:int option} list
val r19 = q19 ();
> brand              brand_id ext_price i_manufact     i_manufact_id
