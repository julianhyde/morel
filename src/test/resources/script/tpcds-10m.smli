(* --- q22 -------------------------------------------------------- *)
(*
SELECT
  i_product_name,
  i_brand,
  i_class,
  i_category,
  avg(inv_quantity_on_hand) qoh
FROM inventory, date_dim, item, warehouse
WHERE inv_date_sk = d_date_sk
  AND inv_item_sk = i_item_sk
  AND inv_warehouse_sk = w_warehouse_sk
  AND d_month_seq BETWEEN 1200 AND 1200 + 11
GROUP BY ROLLUP (i_product_name, i_brand, i_class, i_category)
ORDER BY qoh, i_product_name, i_brand, i_class, i_category
LIMIT 100
*)
(* "GROUP BY ROLLUP (a, b, c, d)" is a union of the groupings by (a, b,
 * c, d), (a, b, c), (a, b), (a) and (), a key that is rolled up being
 * NONE. *)
fun q22 () =
  let
    val base =
      from inv in tpcds.inventory,
          d in tpcds.date_dim,
          i in tpcds.item,
          w in tpcds.warehouse
        where inv.inv_date_sk = d.d_date_sk
          andalso inv.inv_item_sk = i.i_item_sk
          andalso inv.inv_warehouse_sk = w.w_warehouse_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        yield {i.i_product_name, i.i_brand, i.i_class, i.i_category,
          qoh = inv.inv_quantity_on_hand}
  in
    from r in (from b in base
          group {b.i_product_name, b.i_brand, b.i_class, b.i_category}
            compute {qoh = avgSome over b.qoh}
          yield {i_product_name, i_brand, i_class, i_category, qoh})
        union
          (from b in base
              group {b.i_product_name, b.i_brand, b.i_class}
                compute {qoh = avgSome over b.qoh}
              yield {i_product_name, i_brand, i_class, i_category = NONE, qoh}),
          (from b in base
              group {b.i_product_name, b.i_brand}
                compute {qoh = avgSome over b.qoh}
              yield {i_product_name, i_brand, i_class = NONE, i_category = NONE,
                qoh}),
          (from b in base
              group {b.i_product_name}
                compute {qoh = avgSome over b.qoh}
              yield {i_product_name, i_brand = NONE, i_class = NONE,
                i_category = NONE, qoh}),
          (from b in base
              group {}
                compute {qoh = avgSome over b.qoh}
              yield {i_product_name = NONE, i_brand = NONE, i_class = NONE,
                i_category = NONE, qoh})
      order (r.qoh, r.i_product_name, r.i_brand, r.i_class, r.i_category)
      take 100
  end;
> val q22 = fn
>   : unit
>      -> {i_brand:string option, i_category:string option,
>           i_class:string option, i_product_name:string option,
>           qoh:real option} list
val r22 = q22 ();
