(* --- q50 -------------------------------------------------------- *)
(*
SELECT
  s_store_name,
  s_company_id,
  s_street_number,
  s_street_name,
  s_street_type,
  s_suite_number,
  s_city,
  s_county,
  s_state,
  s_zip,
  sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk <= 30)
    THEN 1
      ELSE 0 END)  AS `30 days `,
  sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk > 30) AND
    (sr_returned_date_sk - ss_sold_date_sk <= 60)
    THEN 1
      ELSE 0 END)  AS `31 - 60 days `,
  sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk > 60) AND
    (sr_returned_date_sk - ss_sold_date_sk <= 90)
    THEN 1
      ELSE 0 END)  AS `61 - 90 days `,
  sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk > 90) AND
    (sr_returned_date_sk - ss_sold_date_sk <= 120)
    THEN 1
      ELSE 0 END)  AS `91 - 120 days `,
  sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk > 120)
    THEN 1
      ELSE 0 END)  AS `>120 days `
FROM
  store_sales, store_returns, store, date_dim d1, date_dim d2
WHERE
  d2.d_year = 2001
    AND d2.d_moy = 8
    AND ss_ticket_number = sr_ticket_number
    AND ss_item_sk = sr_item_sk
    AND ss_sold_date_sk = d1.d_date_sk
    AND sr_returned_date_sk = d2.d_date_sk
    AND ss_customer_sk = sr_customer_sk
    AND ss_store_sk = s_store_sk
GROUP BY
  s_store_name, s_company_id, s_street_number, s_street_name, s_street_type,
  s_suite_number, s_city, s_county, s_state, s_zip
ORDER BY
  s_store_name, s_company_id, s_street_number, s_street_name, s_street_type,
  s_suite_number, s_city, s_county, s_state, s_zip
LIMIT 100
*)
fun q50 () =
  from ss in tpcds.store_sales,
      sr in tpcds.store_returns,
      s in tpcds.store,
      d1 in tpcds.date_dim,
      d2 in tpcds.date_dim
    where d2.d_year = SOME 2001
      andalso d2.d_moy = SOME 8
      andalso ss.ss_ticket_number = sr.sr_ticket_number
      andalso ss.ss_item_sk = sr.sr_item_sk
      andalso ss.ss_sold_date_sk = SOME d1.d_date_sk
      andalso sr.sr_returned_date_sk = SOME d2.d_date_sk
      andalso ss.ss_customer_sk <> NONE
      andalso ss.ss_customer_sk = sr.sr_customer_sk
      andalso ss.ss_store_sk = SOME s.s_store_sk
    yield {s.s_store_name, s.s_company_id, s.s_street_number,
      s.s_street_name, s.s_street_type, s.s_suite_number, s.s_city,
      s.s_county, s.s_state, s.s_zip,
      lag =
        case (sr.sr_returned_date_sk, ss.ss_sold_date_sk) of
            (SOME returned, SOME sold) => SOME (returned - sold)
          | _ => NONE}
    group {s_store_name, s_company_id, s_street_number, s_street_name,
        s_street_type, s_suite_number, s_city, s_county, s_state, s_zip}
      compute {
        `30 days ` = sum over
          (if lag <> NONE andalso lag <= SOME 30 then 1 else 0),
        `31 - 60 days ` = sum over
          (if lag > SOME 30 andalso lag <= SOME 60 then 1 else 0),
        `61 - 90 days ` = sum over
          (if lag > SOME 60 andalso lag <= SOME 90 then 1 else 0),
        `91 - 120 days ` = sum over
          (if lag > SOME 90 andalso lag <= SOME 120 then 1 else 0),
        `>120 days ` = sum over (if lag > SOME 120 then 1 else 0)}
    order (s_store_name, s_company_id, s_street_number, s_street_name,
      s_street_type, s_suite_number, s_city, s_county, s_state, s_zip)
    take 100;
> val q50 = fn
>   : unit
>      -> {`30 days `:int, `31 - 60 days `:int, `61 - 90 days `:int,
>           `91 - 120 days `:int, `>120 days `:int, s_city:string option,
>           s_company_id:int option, s_county:string option,
>           s_state:string option, s_store_name:string option,
>           s_street_name:string option, s_street_number:string option,
>           s_street_type:string option, s_suite_number:string option,
>           s_zip:string option} list
val r50 = q50 ();
> 30 days  31 - 60 days  61 - 90 days  91 - 120 days  >120 days  s_city s_company_id s_county          s_state s_store_name s_street_name s_street_number s_street_type s_suite_number s_zip
