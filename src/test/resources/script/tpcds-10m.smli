(* --- q62 -------------------------------------------------------- *)
(*
SELECT
  substr(w_warehouse_name, 1, 20),
  sm_type,
  web_name,
  sum(CASE WHEN (ws_ship_date_sk - ws_sold_date_sk <= 30)
    THEN 1
      ELSE 0 END)  AS `30 days `,
  sum(CASE WHEN (ws_ship_date_sk - ws_sold_date_sk > 30) AND
    (ws_ship_date_sk - ws_sold_date_sk <= 60)
    THEN 1
      ELSE 0 END)  AS `31 - 60 days `,
  sum(CASE WHEN (ws_ship_date_sk - ws_sold_date_sk > 60) AND
    (ws_ship_date_sk - ws_sold_date_sk <= 90)
    THEN 1
      ELSE 0 END)  AS `61 - 90 days `,
  sum(CASE WHEN (ws_ship_date_sk - ws_sold_date_sk > 90) AND
    (ws_ship_date_sk - ws_sold_date_sk <= 120)
    THEN 1
      ELSE 0 END)  AS `91 - 120 days `,
  sum(CASE WHEN (ws_ship_date_sk - ws_sold_date_sk > 120)
    THEN 1
      ELSE 0 END)  AS `>120 days `
FROM
  web_sales, warehouse, ship_mode, web_site, date_dim
WHERE
  d_month_seq BETWEEN 1200 AND 1200 + 11
    AND ws_ship_date_sk = d_date_sk
    AND ws_warehouse_sk = w_warehouse_sk
    AND ws_ship_mode_sk = sm_ship_mode_sk
    AND ws_web_site_sk = web_site_sk
GROUP BY
  substr(w_warehouse_name, 1, 20), sm_type, web_name
ORDER BY
  substr(w_warehouse_name, 1, 20), sm_type, web_name
LIMIT 100
*)
fun q62 () =
  from ws in tpcds.web_sales,
      w in tpcds.warehouse,
      sm in tpcds.ship_mode,
      web in tpcds.web_site,
      d in tpcds.date_dim
    where d.d_month_seq >= SOME 1200
      andalso d.d_month_seq <= SOME (1200 + 11)
      andalso ws.ws_ship_date_sk = SOME d.d_date_sk
      andalso ws.ws_warehouse_sk = SOME w.w_warehouse_sk
      andalso ws.ws_ship_mode_sk = SOME sm.sm_ship_mode_sk
      andalso ws.ws_web_site_sk = SOME web.web_site_sk
    yield {w_warehouse_name =
        Option.map (fn s => String.substring (s, 0, Int.min (20, size s)))
          w.w_warehouse_name,
      sm.sm_type, web.web_name,
      lag =
        case (ws.ws_ship_date_sk, ws.ws_sold_date_sk) of
            (SOME ship, SOME sold) => SOME (ship - sold)
          | _ => NONE}
    group {w_warehouse_name, sm_type, web_name}
      compute {
        `30 days ` = sum over
          (if lag <> NONE andalso lag <= SOME 30 then 1 else 0),
        `31 - 60 days ` = sum over
          (if lag > SOME 30 andalso lag <= SOME 60 then 1 else 0),
        `61 - 90 days ` = sum over
          (if lag > SOME 60 andalso lag <= SOME 90 then 1 else 0),
        `91 - 120 days ` = sum over
          (if lag > SOME 90 andalso lag <= SOME 120 then 1 else 0),
        `>120 days ` = sum over (if lag > SOME 120 then 1 else 0)}
    order (w_warehouse_name, sm_type, web_name)
    take 100;
> val q62 = fn
>   : unit
>      -> {`30 days `:int, `31 - 60 days `:int, `61 - 90 days `:int,
>           `91 - 120 days `:int, `>120 days `:int, sm_type:string option,
>           w_warehouse_name:string option, web_name:string option} list
val r62 = q62 ();
