>   : unit
>      -> {cd_credit_rating:string option, cd_education_status:string option,
>           cd_gender:string option, cd_marital_status:string option,
>           cd_purchase_estimate:int option, cnt1:int, cnt2:int, cnt3:int} list
val r69 = q69 ();
