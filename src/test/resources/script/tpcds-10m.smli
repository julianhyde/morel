>
> val r17 : {as_store_returns_quantityave:real option, as_store_returns_quantitycount:int, as_store_returns_quantitystdev:real option, catalog_sales_quantityave:real option, catalog_sales_quantitycount:int, catalog_sales_quantitycov:real option, catalog_sales_quantitystdev:real option, i_item_desc:string option, i_item_id:string, s_state:string option, store_returns_quantitycov:real option, store_sales_quantityave:real option, store_sales_quantitycount:int, store_sales_quantitycov:real option, store_sales_quantitystdev:real option} list

(* --- q18 -------------------------------------------------------- *)
(*
SELECT
  i_item_id,
  ca_country,
  ca_state,
  ca_county,
  avg(cast(cs_quantity AS DECIMAL(12, 2))) agg1,
  avg(cast(cs_list_price AS DECIMAL(12, 2))) agg2,
  avg(cast(cs_coupon_amt AS DECIMAL(12, 2))) agg3,
  avg(cast(cs_sales_price AS DECIMAL(12, 2))) agg4,
  avg(cast(cs_net_profit AS DECIMAL(12, 2))) agg5,
  avg(cast(c_birth_year AS DECIMAL(12, 2))) agg6,
  avg(cast(cd1.cd_dep_count AS DECIMAL(12, 2))) agg7
FROM catalog_sales, customer_demographics cd1,
  customer_demographics cd2, customer, customer_address, date_dim, item
WHERE cs_sold_date_sk = d_date_sk AND
  cs_item_sk = i_item_sk AND
  cs_bill_cdemo_sk = cd1.cd_demo_sk AND
  cs_bill_customer_sk = c_customer_sk AND
  cd1.cd_gender = 'F' AND
  cd1.cd_education_status = 'Unknown' AND
  c_current_cdemo_sk = cd2.cd_demo_sk AND
  c_current_addr_sk = ca_address_sk AND
  c_birth_month IN (1, 6, 8, 9, 12, 2) AND
  d_year = 1998 AND
  ca_state IN ('MS', 'IN', 'ND', 'OK', 'NM', 'VA', 'MS')
GROUP BY ROLLUP (i_item_id, ca_country, ca_state, ca_county)
ORDER BY ca_country, ca_state, ca_county, i_item_id
LIMIT 100
*)
(* "GROUP BY ROLLUP", as in q22; "cast(x AS DECIMAL(12, 2))" of an int is
 * "Decimal.fromInt". "customer" is scanned before "cd2", not after as in
 * the SQL, because Morel joins in the order written, and "cd2" joins
 * only to "customer". *)
fun q18 () =
  let
    val dec = Option.map Decimal.fromInt
    val base =
      from cs in tpcds.catalog_sales,
          cd1 in tpcds.customer_demographics,
          c in tpcds.customer,
          cd2 in tpcds.customer_demographics,
          ca in tpcds.customer_address,
          d in tpcds.date_dim,
          i in tpcds.item
        where cs.cs_sold_date_sk = SOME d.d_date_sk
          andalso cs.cs_item_sk = i.i_item_sk
          andalso cs.cs_bill_cdemo_sk = SOME cd1.cd_demo_sk
          andalso cs.cs_bill_customer_sk = SOME c.c_customer_sk
          andalso cd1.cd_gender = SOME "F"
          andalso cd1.cd_education_status = SOME "Unknown"
          andalso c.c_current_cdemo_sk = SOME cd2.cd_demo_sk
          andalso c.c_current_addr_sk = SOME ca.ca_address_sk
          andalso c.c_birth_month
            elem [SOME 1, SOME 6, SOME 8, SOME 9, SOME 12, SOME 2]
          andalso d.d_year = SOME 1998
          andalso ca.ca_state elem [SOME "MS", SOME "IN", SOME "ND",
            SOME "OK", SOME "NM", SOME "VA", SOME "MS"]
        yield {i_item_id = SOME i.i_item_id, ca.ca_country, ca.ca_state,
          ca.ca_county, quantity = dec cs.cs_quantity,
          list_price = cs.cs_list_price, coupon_amt = cs.cs_coupon_amt,
          sales_price = cs.cs_sales_price, net_profit = cs.cs_net_profit,
          birth_year = dec c.c_birth_year, dep_count = dec cd1.cd_dep_count}
  in
    from r in (from b in base
          group {b.i_item_id, b.ca_country, b.ca_state, b.ca_county}
            compute {agg1 = avgSome over b.quantity,
                agg2 = avgSome over b.list_price,
                agg3 = avgSome over b.coupon_amt,
                agg4 = avgSome over b.sales_price,
                agg5 = avgSome over b.net_profit,
                agg6 = avgSome over b.birth_year,
                agg7 = avgSome over b.dep_count}
          yield {i_item_id, ca_country, ca_state, ca_county, agg1, agg2, agg3,
            agg4, agg5, agg6, agg7})
        union
          (from b in base
              group {b.i_item_id, b.ca_country, b.ca_state}
                compute {agg1 = avgSome over b.quantity,
                    agg2 = avgSome over b.list_price,
                    agg3 = avgSome over b.coupon_amt,
                    agg4 = avgSome over b.sales_price,
                    agg5 = avgSome over b.net_profit,
                    agg6 = avgSome over b.birth_year,
                    agg7 = avgSome over b.dep_count}
              yield {i_item_id, ca_country, ca_state, ca_county = NONE, agg1,
                agg2, agg3, agg4, agg5, agg6, agg7}),
          (from b in base
              group {b.i_item_id, b.ca_country}
                compute {agg1 = avgSome over b.quantity,
                    agg2 = avgSome over b.list_price,
                    agg3 = avgSome over b.coupon_amt,
                    agg4 = avgSome over b.sales_price,
                    agg5 = avgSome over b.net_profit,
                    agg6 = avgSome over b.birth_year,
                    agg7 = avgSome over b.dep_count}
              yield {i_item_id, ca_country, ca_state = NONE, ca_county = NONE,
                agg1, agg2, agg3, agg4, agg5, agg6, agg7}),
          (from b in base
              group {b.i_item_id}
                compute {agg1 = avgSome over b.quantity,
                    agg2 = avgSome over b.list_price,
                    agg3 = avgSome over b.coupon_amt,
                    agg4 = avgSome over b.sales_price,
                    agg5 = avgSome over b.net_profit,
                    agg6 = avgSome over b.birth_year,
                    agg7 = avgSome over b.dep_count}
              yield {i_item_id, ca_country = NONE, ca_state = NONE,
                ca_county = NONE, agg1, agg2, agg3, agg4, agg5, agg6, agg7}),
          (from b in base
              group {}
                compute {agg1 = avgSome over b.quantity,
                    agg2 = avgSome over b.list_price,
                    agg3 = avgSome over b.coupon_amt,
                    agg4 = avgSome over b.sales_price,
                    agg5 = avgSome over b.net_profit,
                    agg6 = avgSome over b.birth_year,
                    agg7 = avgSome over b.dep_count}
              yield {i_item_id = NONE, ca_country = NONE, ca_state = NONE,
                ca_county = NONE, agg1, agg2, agg3, agg4, agg5, agg6, agg7})
      order (r.ca_country, r.ca_state, r.ca_county, r.i_item_id)
      take 100
  end;
