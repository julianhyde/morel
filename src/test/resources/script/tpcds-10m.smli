(* --- q35 -------------------------------------------------------- *)
(*
SELECT
  ca_state,
  cd_gender,
  cd_marital_status,
  count(*) cnt1,
  min(cd_dep_count),
  max(cd_dep_count),
  avg(cd_dep_count),
  cd_dep_employed_count,
  count(*) cnt2,
  min(cd_dep_employed_count),
  max(cd_dep_employed_count),
  avg(cd_dep_employed_count),
  cd_dep_college_count,
  count(*) cnt3,
  min(cd_dep_college_count),
  max(cd_dep_college_count),
  avg(cd_dep_college_count)
FROM
  customer c, customer_address ca, customer_demographics
WHERE
  c.c_current_addr_sk = ca.ca_address_sk AND
    cd_demo_sk = c.c_current_cdemo_sk AND
    exists(SELECT *
           FROM store_sales, date_dim
           WHERE c.c_customer_sk = ss_customer_sk AND
             ss_sold_date_sk = d_date_sk AND
             d_year = 2002 AND
             d_qoy < 4) AND
    (exists(SELECT *
            FROM web_sales, date_dim
            WHERE c.c_customer_sk = ws_bill_customer_sk AND
              ws_sold_date_sk = d_date_sk AND
              d_year = 2002 AND
              d_qoy < 4) OR
      exists(SELECT *
             FROM catalog_sales, date_dim
             WHERE c.c_customer_sk = cs_ship_customer_sk AND
               cs_sold_date_sk = d_date_sk AND
               d_year = 2002 AND
               d_qoy < 4))
GROUP BY ca_state, cd_gender, cd_marital_status, cd_dep_count,
  cd_dep_employed_count, cd_dep_college_count
ORDER BY ca_state, cd_gender, cd_marital_status, cd_dep_count,
  cd_dep_employed_count, cd_dep_college_count
LIMIT 100
*)
fun q35 () =
  from c in tpcds.customer,
      ca in tpcds.customer_address,
      cd in tpcds.customer_demographics
    where c.c_current_addr_sk = SOME ca.ca_address_sk
      andalso c.c_current_cdemo_sk = SOME cd.cd_demo_sk
      andalso (exists ss in tpcds.store_sales, d in tpcds.date_dim
          where ss.ss_customer_sk = SOME c.c_customer_sk
            andalso ss.ss_sold_date_sk = SOME d.d_date_sk
            andalso d.d_year = SOME 2002
            andalso d.d_qoy <> NONE
            andalso d.d_qoy < SOME 4)
      andalso ((exists ws in tpcds.web_sales, d in tpcds.date_dim
            where ws.ws_bill_customer_sk = SOME c.c_customer_sk
              andalso ws.ws_sold_date_sk = SOME d.d_date_sk
              andalso d.d_year = SOME 2002
              andalso d.d_qoy <> NONE
              andalso d.d_qoy < SOME 4)
        orelse (exists cs in tpcds.catalog_sales, d in tpcds.date_dim
            where cs.cs_ship_customer_sk = SOME c.c_customer_sk
              andalso cs.cs_sold_date_sk = SOME d.d_date_sk
              andalso d.d_year = SOME 2002
              andalso d.d_qoy <> NONE
              andalso d.d_qoy < SOME 4))
    group {ca.ca_state, cd.cd_gender, cd.cd_marital_status, cd.cd_dep_count,
        cd.cd_dep_employed_count, cd.cd_dep_college_count}
      compute {cnt1 = count over (),
          `min(cd_dep_count)` = minSome over cd.cd_dep_count,
          `max(cd_dep_count)` = maxSome over cd.cd_dep_count,
          `avg(cd_dep_count)` = avgSome over cd.cd_dep_count,
          cnt2 = count over (),
          `min(cd_dep_employed_count)` = minSome over cd.cd_dep_employed_count,
          `max(cd_dep_employed_count)` = maxSome over cd.cd_dep_employed_count,
          `avg(cd_dep_employed_count)` = avgSome over cd.cd_dep_employed_count,
          cnt3 = count over (),
          `min(cd_dep_college_count)` = minSome over cd.cd_dep_college_count,
          `max(cd_dep_college_count)` = maxSome over cd.cd_dep_college_count,
          `avg(cd_dep_college_count)` = avgSome over cd.cd_dep_college_count}
    order (ca_state, cd_gender, cd_marital_status, cd_dep_count,
      cd_dep_employed_count, cd_dep_college_count)
    (* The query groups by "cd_dep_count", but does not select it. *)
    yield {ca_state, cd_gender, cd_marital_status, cnt1,
      `min(cd_dep_count)`, `max(cd_dep_count)`, `avg(cd_dep_count)`,
      cd_dep_employed_count, cnt2, `min(cd_dep_employed_count)`,
      `max(cd_dep_employed_count)`, `avg(cd_dep_employed_count)`,
      cd_dep_college_count, cnt3, `min(cd_dep_college_count)`,
      `max(cd_dep_college_count)`, `avg(cd_dep_college_count)`}
    take 100;
