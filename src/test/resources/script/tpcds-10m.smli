(* --- q25 -------------------------------------------------------- *)
(*
SELECT
  i_item_id,
  i_item_desc,
  s_store_id,
  s_store_name,
  sum(ss_net_profit) AS store_sales_profit,
  sum(sr_net_loss) AS store_returns_loss,
  sum(cs_net_profit) AS catalog_sales_profit
FROM
  store_sales, store_returns, catalog_sales, date_dim d1, date_dim d2, date_dim d3,
  store, item
WHERE
  d1.d_moy = 4
    AND d1.d_year = 2001
    AND d1.d_date_sk = ss_sold_date_sk
    AND i_item_sk = ss_item_sk
    AND s_store_sk = ss_store_sk
    AND ss_customer_sk = sr_customer_sk
    AND ss_item_sk = sr_item_sk
    AND ss_ticket_number = sr_ticket_number
    AND sr_returned_date_sk = d2.d_date_sk
    AND d2.d_moy BETWEEN 4 AND 10
    AND d2.d_year = 2001
    AND sr_customer_sk = cs_bill_customer_sk
    AND sr_item_sk = cs_item_sk
    AND cs_sold_date_sk = d3.d_date_sk
    AND d3.d_moy BETWEEN 4 AND 10
    AND d3.d_year = 2001
GROUP BY
  i_item_id, i_item_desc, s_store_id, s_store_name
ORDER BY
  i_item_id, i_item_desc, s_store_id, s_store_name
LIMIT 100
*)
fun q25 () =
  from ss in tpcds.store_sales,
      sr in tpcds.store_returns,
      cs in tpcds.catalog_sales,
      d1 in tpcds.date_dim,
      d2 in tpcds.date_dim,
      d3 in tpcds.date_dim,
      s in tpcds.store,
      i in tpcds.item
    where d1.d_moy = SOME 4
      andalso d1.d_year = SOME 2001
      andalso ss.ss_sold_date_sk = SOME d1.d_date_sk
      andalso ss.ss_item_sk = i.i_item_sk
      andalso ss.ss_store_sk = SOME s.s_store_sk
      andalso ss.ss_customer_sk <> NONE
      andalso ss.ss_customer_sk = sr.sr_customer_sk
      andalso ss.ss_item_sk = sr.sr_item_sk
      andalso ss.ss_ticket_number = sr.sr_ticket_number
      andalso sr.sr_returned_date_sk = SOME d2.d_date_sk
      andalso d2.d_moy >= SOME 4
      andalso d2.d_moy <= SOME 10
      andalso d2.d_year = SOME 2001
      andalso sr.sr_customer_sk = cs.cs_bill_customer_sk
      andalso sr.sr_item_sk = cs.cs_item_sk
      andalso cs.cs_sold_date_sk = SOME d3.d_date_sk
      andalso d3.d_moy >= SOME 4
      andalso d3.d_moy <= SOME 10
      andalso d3.d_year = SOME 2001
    group {i.i_item_id, i.i_item_desc, s.s_store_id, s.s_store_name}
      compute {store_sales_profit = sumSome over ss.ss_net_profit,
        store_returns_loss = sumSome over sr.sr_net_loss,
        catalog_sales_profit = sumSome over cs.cs_net_profit}
    order (i_item_id, i_item_desc, s_store_id, s_store_name)
    take 100;
