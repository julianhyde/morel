                else zero),
            jul_net = sumSome over
              (if d.d_moy = SOME 7
                then times (cs.cs_net_paid_inc_tax,
                  cs.cs_quantity)
                else zero),
            aug_net = sumSome over
              (if d.d_moy = SOME 8
                then times (cs.cs_net_paid_inc_tax,
                  cs.cs_quantity)
                else zero),
            sep_net = sumSome over
              (if d.d_moy = SOME 9
                then times (cs.cs_net_paid_inc_tax,
                  cs.cs_quantity)
                else zero),
            oct_net = sumSome over
              (if d.d_moy = SOME 10
                then times (cs.cs_net_paid_inc_tax,
