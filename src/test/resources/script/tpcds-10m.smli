(* --- q37 -------------------------------------------------------- *)
(*
SELECT
  i_item_id,
  i_item_desc,
  i_current_price
FROM item, inventory, date_dim, catalog_sales
WHERE i_current_price BETWEEN 68 AND 68 + 30
  AND inv_item_sk = i_item_sk
  AND d_date_sk = inv_date_sk
  AND d_date BETWEEN cast('2000-02-01' AS DATE) AND (cast('2000-02-01' AS DATE) + INTERVAL 60 days)
  AND i_manufact_id IN (677, 940, 694, 808)
  AND inv_quantity_on_hand BETWEEN 100 AND 500
  AND cs_item_sk = i_item_sk
GROUP BY i_item_id, i_item_desc, i_current_price
ORDER BY i_item_id
LIMIT 100
*)
fun q37 () =
  let
    fun day (year, month, day) =
      Date.date {year, month, day, hour = 0, minute = 0, second = 0,
        offset = SOME Time.zeroTime}
  in
    from i in tpcds.item,
        inv in tpcds.inventory,
        d in tpcds.date_dim,
        cs in tpcds.catalog_sales
      where i.i_current_price >= SOME (Decimal.fromInt 68)
        andalso i.i_current_price <= SOME (Decimal.fromInt (68 + 30))
        andalso inv.inv_item_sk = i.i_item_sk
        andalso inv.inv_date_sk = d.d_date_sk
        andalso d.d_date >= SOME (day (2000, Feb, 1))
        andalso d.d_date <= SOME (day (2000, Feb, 1 + 60))
        andalso i.i_manufact_id elem [SOME 677, SOME 940, SOME 694, SOME 808]
        andalso inv.inv_quantity_on_hand >= SOME 100
        andalso inv.inv_quantity_on_hand <= SOME 500
        andalso cs.cs_item_sk = i.i_item_sk
      group {i.i_item_id, i.i_item_desc, i.i_current_price}
      order i_item_id
      take 100
  end;
> val q37 = fn
>   : unit
>      -> {i_current_price:decimal option, i_item_desc:string option,
>           i_item_id:string} list
val r37 = q37 ();
> i_current_price i_item_desc i_item_id
> --------------- ----------- ---------
>
> val r37 : {i_current_price:decimal option, i_item_desc:string option, i_item_id:string} list

(* --- q38 -------------------------------------------------------- *)
(*
SELECT count(*)
FROM (
       SELECT DISTINCT
         c_last_name,
         c_first_name,
         d_date
       FROM store_sales, date_dim, customer
       WHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk
         AND store_sales.ss_customer_sk = customer.c_customer_sk
         AND d_month_seq BETWEEN 1200 AND 1200 + 11
       INTERSECT
       SELECT DISTINCT
         c_last_name,
         c_first_name,
         d_date
       FROM catalog_sales, date_dim, customer
       WHERE catalog_sales.cs_sold_date_sk = date_dim.d_date_sk
         AND catalog_sales.cs_bill_customer_sk = customer.c_customer_sk
         AND d_month_seq BETWEEN 1200 AND 1200 + 11
       INTERSECT
       SELECT DISTINCT
         c_last_name,
         c_first_name,
         d_date
       FROM web_sales, date_dim, customer
       WHERE web_sales.ws_sold_date_sk = date_dim.d_date_sk
         AND web_sales.ws_bill_customer_sk = customer.c_customer_sk
         AND d_month_seq BETWEEN 1200 AND 1200 + 11
     ) hot_cust
LIMIT 100
*)
fun q38 () =
  from r in (
      from ss in tpcds.store_sales,
          d in tpcds.date_dim,
          c in tpcds.customer
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_customer_sk = SOME c.c_customer_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        yield {c.c_last_name, c.c_first_name, d.d_date})
    intersect distinct
      (from cs in tpcds.catalog_sales,
          d in tpcds.date_dim,
          c in tpcds.customer
        where cs.cs_sold_date_sk = SOME d.d_date_sk
          andalso cs.cs_bill_customer_sk = SOME c.c_customer_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        yield {c.c_last_name, c.c_first_name, d.d_date}),
      (from ws in tpcds.web_sales,
          d in tpcds.date_dim,
          c in tpcds.customer
        where ws.ws_sold_date_sk = SOME d.d_date_sk
          andalso ws.ws_bill_customer_sk = SOME c.c_customer_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        yield {c.c_last_name, c.c_first_name, d.d_date})
    compute count over ();
> val q38 = fn : unit -> int
val r38 = q38 ();
> val r38 = 0 : int

(* --- q39a ------------------------------------------------------- *)
(*
WITH inv AS
(SELECT
    w_warehouse_name,
    w_warehouse_sk,
    i_item_sk,
    d_moy,
    stdev,
    mean,
    CASE mean
    WHEN 0
      THEN NULL
    ELSE stdev / mean END cov
  FROM (SELECT
    w_warehouse_name,
    w_warehouse_sk,
    i_item_sk,
    d_moy,
    stddev_samp(inv_quantity_on_hand) stdev,
    avg(inv_quantity_on_hand) mean
  FROM inventory, item, warehouse, date_dim
  WHERE inv_item_sk = i_item_sk
    AND inv_warehouse_sk = w_warehouse_sk
    AND inv_date_sk = d_date_sk
    AND d_year = 2001
  GROUP BY w_warehouse_name, w_warehouse_sk, i_item_sk, d_moy) foo
  WHERE CASE mean
        WHEN 0
          THEN 0
        ELSE stdev / mean END > 1)
SELECT
  inv1.w_warehouse_sk,
  inv1.i_item_sk,
  inv1.d_moy,
  inv1.mean,
  inv1.cov,
  inv2.w_warehouse_sk,
  inv2.i_item_sk,
  inv2.d_moy,
  inv2.mean,
  inv2.cov
FROM inv inv1, inv inv2
WHERE inv1.i_item_sk = inv2.i_item_sk
  AND inv1.w_warehouse_sk = inv2.w_warehouse_sk
  AND inv1.d_moy = 1
  AND inv2.d_moy = 1 + 1
ORDER BY inv1.w_warehouse_sk, inv1.i_item_sk, inv1.d_moy, inv1.mean, inv1.cov
  , inv2.d_moy, inv2.mean, inv2.cov
*)
fun q39a () =
  let
    (* "stddev_samp(x)": the sample standard deviation of the values of
     * the SOMEs, or NONE if there are fewer than two. The sums are exact
     * ints; only the square root is real. *)
    fun stddevSamp xs =
      let
        val vs = somes xs
        val n = count vs
        val s = sum vs
        val s2 = sum (from v in vs yield v * v)
      in
        if n < 2 then NONE
        else
          SOME (Math.sqrt (Real.fromInt (n * s2 - s * s)
            / Real.fromInt (n * (n - 1))))
      end
    (* "a / b" of two reals that may be NONE *)
    fun divide (a, b) =
      case (a, b) of
          (SOME a, SOME b) => SOME (a / b)
        | _ => NONE
    val inv =
      from inv in tpcds.inventory,
          i in tpcds.item,
          w in tpcds.warehouse,
          d in tpcds.date_dim
        where inv.inv_item_sk = i.i_item_sk
          andalso inv.inv_warehouse_sk = w.w_warehouse_sk
          andalso inv.inv_date_sk = d.d_date_sk
          andalso d.d_year = SOME 2001
        group {w.w_warehouse_name, w.w_warehouse_sk, i.i_item_sk, d.d_moy}
          compute {stdev = stddevSamp over inv.inv_quantity_on_hand,
            mean = avgSome over inv.inv_quantity_on_hand}
        (* "CASE mean WHEN 0 THEN NULL ELSE stdev / mean END" *)
        yield {w_warehouse_name, w_warehouse_sk, i_item_sk, d_moy, stdev,
          mean,
          cov = if mean = SOME 0.0 then NONE else divide (stdev, mean)}
        (* "CASE mean WHEN 0 THEN 0 ELSE stdev / mean END > 1" *)
        where (if mean = SOME 0.0 then false else cov > SOME 1.0)
  in
    from inv1 in inv,
        inv2 in inv
      where inv1.i_item_sk = inv2.i_item_sk
        andalso inv1.w_warehouse_sk = inv2.w_warehouse_sk
        andalso inv1.d_moy = SOME 1
        andalso inv2.d_moy = SOME (1 + 1)
      order (inv1.w_warehouse_sk, inv1.i_item_sk, inv1.d_moy, inv1.mean,
        inv1.cov, inv2.d_moy, inv2.mean, inv2.cov)
      yield {inv1.w_warehouse_sk, inv1.i_item_sk, inv1.d_moy, inv1.mean,
        inv1.cov, w_warehouse_sk_2 = inv2.w_warehouse_sk,
        i_item_sk_2 = inv2.i_item_sk, d_moy_2 = inv2.d_moy,
        mean_2 = inv2.mean, cov_2 = inv2.cov}
  end;
> val q39a = fn
>   : unit
>      -> {cov:real option, cov_2:real option, d_moy:int option,
>           d_moy_2:int option, i_item_sk:int, i_item_sk_2:int,
>           mean:real option, mean_2:real option, w_warehouse_sk:int,
>           w_warehouse_sk_2:int} list
val r39a = q39a ();
> cov       cov_2     d_moy d_moy_2 i_item_sk i_item_sk_2 mean   mean_2    w_warehouse_sk w_warehouse_sk_2
> --------- --------- ----- ------- --------- ----------- ------ --------- -------------- ----------------
> 1.0202744 1.3849913     1       2       633         633    222 349.33334              1                1
> 1.1177534 1.0149925     1       2       675         675 381.25     255.5              1                1
> 1.2868938 1.2386651     1       2      1157        1157    338    354.25              1                1
> 1.1390924 1.1236527     1       2      1637        1637    298       234              1                1
>
> val r39a : {cov:real option, cov_2:real option, d_moy:int option, d_moy_2:int option, i_item_sk:int, i_item_sk_2:int, mean:real option, mean_2:real option, w_warehouse_sk:int, w_warehouse_sk_2:int} list

