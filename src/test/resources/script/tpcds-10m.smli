(* --- q46 -------------------------------------------------------- *)
(*
SELECT
  c_last_name,
  c_first_name,
  ca_city,
  bought_city,
  ss_ticket_number,
  amt,
  profit
FROM
  (SELECT
    ss_ticket_number,
    ss_customer_sk,
    ca_city bought_city,
    sum(ss_coupon_amt) amt,
    sum(ss_net_profit) profit
  FROM store_sales, date_dim, store, household_demographics, customer_address
  WHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk
    AND store_sales.ss_store_sk = store.s_store_sk
    AND store_sales.ss_hdemo_sk = household_demographics.hd_demo_sk
    AND store_sales.ss_addr_sk = customer_address.ca_address_sk
    AND (household_demographics.hd_dep_count = 4 OR
    household_demographics.hd_vehicle_count = 3)
    AND date_dim.d_dow IN (6, 0)
    AND date_dim.d_year IN (1999, 1999 + 1, 1999 + 2)
    AND store.s_city IN ('Fairview', 'Midway', 'Fairview', 'Fairview', 'Fairview')
  GROUP BY ss_ticket_number, ss_customer_sk, ss_addr_sk, ca_city) dn, customer,
  customer_address current_addr
WHERE ss_customer_sk = c_customer_sk
  AND customer.c_current_addr_sk = current_addr.ca_address_sk
  AND current_addr.ca_city <> bought_city
ORDER BY c_last_name, c_first_name, ca_city, bought_city, ss_ticket_number
LIMIT 100
*)
fun q46 () =
  from dn in (
      from ss in tpcds.store_sales,
          d in tpcds.date_dim,
          s in tpcds.store,
          hd in tpcds.household_demographics,
          ca in tpcds.customer_address
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso ss.ss_hdemo_sk = SOME hd.hd_demo_sk
          andalso ss.ss_addr_sk = SOME ca.ca_address_sk
          andalso (hd.hd_dep_count = SOME 4
            orelse hd.hd_vehicle_count = SOME 3)
          andalso d.d_dow elem [SOME 6, SOME 0]
          andalso d.d_year elem [SOME 1999, SOME (1999 + 1), SOME (1999 + 2)]
          andalso s.s_city elem [SOME "Fairview", SOME "Midway",
            SOME "Fairview", SOME "Fairview", SOME "Fairview"]
        group {ss.ss_ticket_number, ss.ss_customer_sk, ss.ss_addr_sk,
            bought_city = ca.ca_city}
          compute {amt = sum over ss.ss_coupon_amt,
            profit = sum over ss.ss_net_profit}),
      c in tpcds.customer,
      current_addr in tpcds.customer_address
    where dn.ss_customer_sk = SOME c.c_customer_sk
      andalso c.c_current_addr_sk = SOME current_addr.ca_address_sk
      andalso (case (current_addr.ca_city, dn.bought_city) of
                  (SOME c1, SOME c2) => c1 <> c2
                | _ => false)
    yield {c.c_last_name, c.c_first_name, current_addr.ca_city,
      dn.bought_city, dn.ss_ticket_number, dn.amt, dn.profit}
    order (c_last_name, c_first_name, ca_city, bought_city, ss_ticket_number)
    take 100;
> val q46 = fn
>   : unit
>      -> {amt:decimal option, bought_city:string option,
>           c_first_name:string option, c_last_name:string option,
>           ca_city:string option, profit:decimal option, ss_ticket_number:int}
>         list
val r46 = q46 ();
