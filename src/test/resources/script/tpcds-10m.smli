      andalso ss.ss_item_sk = i.i_item_sk
      andalso i.i_manager_id = SOME 28
      andalso d.d_moy = SOME 11
      andalso d.d_year = SOME 1999
    group {brand_id = i.i_brand_id, brand = i.i_brand}
      compute {ext_price = sum over ss.ss_ext_sales_price}
    order (DESC ext_price, brand_id)
    take 100;
