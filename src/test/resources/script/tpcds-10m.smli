(* --- q48 -------------------------------------------------------- *)
(*
SELECT sum(ss_quantity)
FROM store_sales, store, customer_demographics, customer_address, date_dim
WHERE s_store_sk = ss_store_sk
  AND ss_sold_date_sk = d_date_sk AND d_year = 2001
  AND
  (
    (
      cd_demo_sk = ss_cdemo_sk
        AND
        cd_marital_status = 'M'
        AND
        cd_education_status = '4 yr Degree'
        AND
        ss_sales_price BETWEEN 100.00 AND 150.00
    )
      OR
      (
        cd_demo_sk = ss_cdemo_sk
          AND
          cd_marital_status = 'D'
          AND
          cd_education_status = '2 yr Degree'
          AND
          ss_sales_price BETWEEN 50.00 AND 100.00
      )
      OR
      (
        cd_demo_sk = ss_cdemo_sk
          AND
          cd_marital_status = 'S'
          AND
          cd_education_status = 'College'
          AND
          ss_sales_price BETWEEN 150.00 AND 200.00
      )
  )
  AND
  (
    (
      ss_addr_sk = ca_address_sk
        AND
        ca_country = 'United States'
        AND
        ca_state IN ('CO', 'OH', 'TX')
        AND ss_net_profit BETWEEN 0 AND 2000
    )
      OR
      (ss_addr_sk = ca_address_sk
        AND
        ca_country = 'United States'
        AND
        ca_state IN ('OR', 'MN', 'KY')
        AND ss_net_profit BETWEEN 150 AND 3000
      )
      OR
      (ss_addr_sk = ca_address_sk
        AND
        ca_country = 'United States'
        AND
        ca_state IN ('VA', 'CA', 'MS')
        AND ss_net_profit BETWEEN 50 AND 25000
      )
  )
*)
(* Each disjunct of the SQL's two "OR"s repeats a join condition
 * ("cd_demo_sk = ss_cdemo_sk", "ss_addr_sk = ca_address_sk"). Morel
 * does not factor a common conjunct out of a disjunction, so, written
 * as is, the query would be a cross product of store_sales and
 * customer_demographics; the conditions are factored by hand. *)
fun q48 () =
  from ss in tpcds.store_sales,
      s in tpcds.store,
      cd in tpcds.customer_demographics,
      ca in tpcds.customer_address,
      d in tpcds.date_dim
    where ss.ss_store_sk = SOME s.s_store_sk
      andalso ss.ss_sold_date_sk = SOME d.d_date_sk
      andalso d.d_year = SOME 2001
      andalso ss.ss_cdemo_sk = SOME cd.cd_demo_sk
      andalso (cd.cd_marital_status = SOME "M"
          andalso cd.cd_education_status = SOME "4 yr Degree"
          andalso ss.ss_sales_price >= SOME (Decimal.fromInt 100)
          andalso ss.ss_sales_price <= SOME (Decimal.fromInt 150)
        orelse cd.cd_marital_status = SOME "D"
          andalso cd.cd_education_status = SOME "2 yr Degree"
          andalso ss.ss_sales_price >= SOME (Decimal.fromInt 50)
          andalso ss.ss_sales_price <= SOME (Decimal.fromInt 100)
        orelse cd.cd_marital_status = SOME "S"
          andalso cd.cd_education_status = SOME "College"
          andalso ss.ss_sales_price >= SOME (Decimal.fromInt 150)
          andalso ss.ss_sales_price <= SOME (Decimal.fromInt 200))
      andalso ss.ss_addr_sk = SOME ca.ca_address_sk
      andalso ca.ca_country = SOME "United States"
      andalso (ca.ca_state elem [SOME "CO", SOME "OH", SOME "TX"]
          andalso ss.ss_net_profit >= SOME (Decimal.fromInt 0)
          andalso ss.ss_net_profit <= SOME (Decimal.fromInt 2000)
        orelse ca.ca_state elem [SOME "OR", SOME "MN", SOME "KY"]
          andalso ss.ss_net_profit >= SOME (Decimal.fromInt 150)
          andalso ss.ss_net_profit <= SOME (Decimal.fromInt 3000)
        orelse ca.ca_state elem [SOME "VA", SOME "CA", SOME "MS"]
          andalso ss.ss_net_profit >= SOME (Decimal.fromInt 50)
          andalso ss.ss_net_profit <= SOME (Decimal.fromInt 25000))
    compute sum over ss.ss_quantity;
> val q48 = fn : unit -> int option
val r48 = q48 ();
> val r48 = SOME 1858 : int option

(* --- q50 -------------------------------------------------------- *)
(*
SELECT
  s_store_name,
  s_company_id,
  s_street_number,
  s_street_name,
  s_street_type,
  s_suite_number,
  s_city,
  s_county,
  s_state,
  s_zip,
  sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk <= 30)
    THEN 1
      ELSE 0 END)  AS `30 days `,
  sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk > 30) AND
    (sr_returned_date_sk - ss_sold_date_sk <= 60)
    THEN 1
      ELSE 0 END)  AS `31 - 60 days `,
  sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk > 60) AND
    (sr_returned_date_sk - ss_sold_date_sk <= 90)
    THEN 1
      ELSE 0 END)  AS `61 - 90 days `,
  sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk > 90) AND
    (sr_returned_date_sk - ss_sold_date_sk <= 120)
    THEN 1
      ELSE 0 END)  AS `91 - 120 days `,
  sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk > 120)
    THEN 1
      ELSE 0 END)  AS `>120 days `
FROM
  store_sales, store_returns, store, date_dim d1, date_dim d2
WHERE
  d2.d_year = 2001
    AND d2.d_moy = 8
    AND ss_ticket_number = sr_ticket_number
    AND ss_item_sk = sr_item_sk
    AND ss_sold_date_sk = d1.d_date_sk
    AND sr_returned_date_sk = d2.d_date_sk
    AND ss_customer_sk = sr_customer_sk
    AND ss_store_sk = s_store_sk
GROUP BY
  s_store_name, s_company_id, s_street_number, s_street_name, s_street_type,
  s_suite_number, s_city, s_county, s_state, s_zip
ORDER BY
  s_store_name, s_company_id, s_street_number, s_street_name, s_street_type,
  s_suite_number, s_city, s_county, s_state, s_zip
LIMIT 100
*)
fun q50 () =
  from ss in tpcds.store_sales,
      sr in tpcds.store_returns,
      s in tpcds.store,
      d1 in tpcds.date_dim,
      d2 in tpcds.date_dim
    where d2.d_year = SOME 2001
      andalso d2.d_moy = SOME 8
      andalso ss.ss_ticket_number = sr.sr_ticket_number
      andalso ss.ss_item_sk = sr.sr_item_sk
      andalso ss.ss_sold_date_sk = SOME d1.d_date_sk
      andalso sr.sr_returned_date_sk = SOME d2.d_date_sk
      andalso ss.ss_customer_sk <> NONE
      andalso ss.ss_customer_sk = sr.sr_customer_sk
      andalso ss.ss_store_sk = SOME s.s_store_sk
    yield {s.s_store_name, s.s_company_id, s.s_street_number,
      s.s_street_name, s.s_street_type, s.s_suite_number, s.s_city,
      s.s_county, s.s_state, s.s_zip,
      lag =
        case (sr.sr_returned_date_sk, ss.ss_sold_date_sk) of
            (SOME returned, SOME sold) => SOME (returned - sold)
          | _ => NONE}
    group {s_store_name, s_company_id, s_street_number, s_street_name,
        s_street_type, s_suite_number, s_city, s_county, s_state, s_zip}
      compute {
        `30 days ` = sum over
          (if lag <> NONE andalso lag <= SOME 30 then 1 else 0),
        `31 - 60 days ` = sum over
          (if lag > SOME 30 andalso lag <= SOME 60 then 1 else 0),
        `61 - 90 days ` = sum over
          (if lag > SOME 60 andalso lag <= SOME 90 then 1 else 0),
        `91 - 120 days ` = sum over
          (if lag > SOME 90 andalso lag <= SOME 120 then 1 else 0),
        `>120 days ` = sum over (if lag > SOME 120 then 1 else 0)}
    order (s_store_name, s_company_id, s_street_number, s_street_name,
      s_street_type, s_suite_number, s_city, s_county, s_state, s_zip)
    take 100;
> val q50 = fn
>   : unit
>      -> {`30 days `:int, `31 - 60 days `:int, `61 - 90 days `:int,
>           `91 - 120 days `:int, `>120 days `:int, s_city:string option,
>           s_company_id:int option, s_county:string option,
>           s_state:string option, s_store_name:string option,
>           s_street_name:string option, s_street_number:string option,
>           s_street_type:string option, s_suite_number:string option,
>           s_zip:string option} list
val r50 = q50 ();
> 30 days  31 - 60 days  61 - 90 days  91 - 120 days  >120 days  s_city s_company_id s_county          s_state s_store_name s_street_name s_street_number s_street_type s_suite_number s_zip
> -------- ------------- ------------- -------------- ---------- ------ ------------ ----------------- ------- ------------ ------------- --------------- ------------- -------------- -----
>        9             7             3              6         16 Midway            1 Williamson County TN      able         Sycamore      255             Dr.           Suite 410      31904
>        8             9             4              6         10 Midway            1 Williamson County TN      ought        Spring        767             Wy            Suite 250      31904
>
> val r50 : {`30 days `:int, `31 - 60 days `:int, `61 - 90 days `:int, `91 - 120 days `:int, `>120 days `:int, s_city:string option, s_company_id:int option, s_county:string option, s_state:string option, s_store_name:string option, s_street_name:string option, s_street_number:string option, s_street_type:string option, s_suite_number:string option, s_zip:string option} list

(* --- q52 -------------------------------------------------------- *)
(*
SELECT
  dt.d_year,
  item.i_brand_id brand_id,
  item.i_brand brand,
  sum(ss_ext_sales_price) ext_price
FROM date_dim dt, store_sales, item
WHERE dt.d_date_sk = store_sales.ss_sold_date_sk
  AND store_sales.ss_item_sk = item.i_item_sk
  AND item.i_manager_id = 1
  AND dt.d_moy = 11
  AND dt.d_year = 2000
GROUP BY dt.d_year, item.i_brand, item.i_brand_id
ORDER BY dt.d_year, ext_price DESC, brand_id
LIMIT 100
*)
fun q52 () =
  from dt in tpcds.date_dim,
      ss in tpcds.store_sales,
      i in tpcds.item
    where SOME dt.d_date_sk = ss.ss_sold_date_sk
      andalso ss.ss_item_sk = i.i_item_sk
      andalso i.i_manager_id = SOME 1
      andalso dt.d_moy = SOME 11
      andalso dt.d_year = SOME 2000
    group {dt.d_year, brand_id = i.i_brand_id, brand = i.i_brand}
      compute {ext_price = sum over ss.ss_ext_sales_price}
    order (d_year, DESC ext_price, brand_id)
    take 100;
> val q52 = fn
>   : unit
>      -> {brand:string option, brand_id:int option, d_year:int option,
>           ext_price:decimal option} list
val r52 = q52 ();
