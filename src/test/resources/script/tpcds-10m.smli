(* --- q30 -------------------------------------------------------- *)
(*
WITH customer_total_return AS
(SELECT
    wr_returning_customer_sk AS ctr_customer_sk,
    ca_state AS ctr_state,
    sum(wr_return_amt) AS ctr_total_return
  FROM web_returns, date_dim, customer_address
  WHERE wr_returned_date_sk = d_date_sk
    AND d_year = 2002
    AND wr_returning_addr_sk = ca_address_sk
  GROUP BY wr_returning_customer_sk, ca_state)
SELECT
  c_customer_id,
  c_salutation,
  c_first_name,
  c_last_name,
  c_preferred_cust_flag,
  c_birth_day,
  c_birth_month,
  c_birth_year,
  c_birth_country,
  c_login,
  c_email_address,
  c_last_review_date,
  ctr_total_return
FROM customer_total_return ctr1, customer_address, customer
WHERE ctr1.ctr_total_return > (SELECT avg(ctr_total_return) * 1.2
FROM customer_total_return ctr2
WHERE ctr1.ctr_state = ctr2.ctr_state)
  AND ca_address_sk = c_current_addr_sk
  AND ca_state = 'GA'
  AND ctr1.ctr_customer_sk = c_customer_sk
ORDER BY c_customer_id, c_salutation, c_first_name, c_last_name, c_preferred_cust_flag
  , c_birth_day, c_birth_month, c_birth_year, c_birth_country, c_login, c_email_address
  , c_last_review_date, ctr_total_return
LIMIT 100
*)
fun q30 () =
  let
    val customer_total_return =
      from wr in tpcds.web_returns,
          d in tpcds.date_dim,
          ca in tpcds.customer_address
        where wr.wr_returned_date_sk = SOME d.d_date_sk
          andalso d.d_year = SOME 2002
          andalso wr.wr_returning_addr_sk = SOME ca.ca_address_sk
        group {ctr_customer_sk = wr.wr_returning_customer_sk,
            ctr_state = ca.ca_state}
          compute {ctr_total_return = sumSome over wr.wr_return_amt}
  in
    from ctr1 in customer_total_return,
        ca in tpcds.customer_address,
        c in tpcds.customer
      where (case (ctr1.ctr_total_return,
              from ctr2 in customer_total_return
                where ctr2.ctr_state <> NONE
                  andalso ctr1.ctr_state = ctr2.ctr_state
                compute avgSome over ctr2.ctr_total_return) of
            (SOME total, SOME average) => total > average * decimal "1.2"
          | _ => false)
        andalso c.c_current_addr_sk = SOME ca.ca_address_sk
        andalso ca.ca_state = SOME "GA"
        andalso ctr1.ctr_customer_sk = SOME c.c_customer_sk
      yield {c.c_customer_id, c.c_salutation, c.c_first_name, c.c_last_name,
        c.c_preferred_cust_flag, c.c_birth_day, c.c_birth_month,
        c.c_birth_year, c.c_birth_country, c.c_login, c.c_email_address,
        c.c_last_review_date,
        ctr1.ctr_total_return}
      order (c_customer_id, c_salutation, c_first_name, c_last_name,
        c_preferred_cust_flag, c_birth_day, c_birth_month, c_birth_year,
        c_birth_country, c_login, c_email_address, c_last_review_date,
        ctr_total_return)
      take 100
  end;
