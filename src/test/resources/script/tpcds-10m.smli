(* --- q6 --------------------------------------------------------- *)
(*
SELECT
  a.ca_state state,
  count(*) cnt
FROM
  customer_address a, customer c, store_sales s, date_dim d, item i
WHERE a.ca_address_sk = c.c_current_addr_sk
  AND c.c_customer_sk = s.ss_customer_sk
  AND s.ss_sold_date_sk = d.d_date_sk
  AND s.ss_item_sk = i.i_item_sk
  AND d.d_month_seq =
  (SELECT DISTINCT (d_month_seq)
  FROM date_dim
  WHERE d_year = 2000 AND d_moy = 1)
  AND i.i_current_price > 1.2 *
  (SELECT avg(j.i_current_price)
  FROM item j
  WHERE j.i_category = i.i_category)
GROUP BY a.ca_state
HAVING count(*) >= 10
ORDER BY cnt
LIMIT 100
*)
fun q6 () =
  let
    val month_seq =
      Relational.only
        (from d in tpcds.date_dim
          where d.d_year = SOME 2000 andalso d.d_moy = SOME 1
          yield d.d_month_seq
          distinct)
  in
    from a in tpcds.customer_address,
        c in tpcds.customer,
        s in tpcds.store_sales,
        d in tpcds.date_dim,
        i in tpcds.item
      where c.c_current_addr_sk = SOME a.ca_address_sk
        andalso s.ss_customer_sk = SOME c.c_customer_sk
        andalso s.ss_sold_date_sk = SOME d.d_date_sk
        andalso s.ss_item_sk = i.i_item_sk
        andalso month_seq <> NONE
        andalso d.d_month_seq = month_seq
        andalso (case (i.i_current_price,
                from j in tpcds.item
                  where j.i_category <> NONE
                    andalso j.i_category = i.i_category
                  compute avgSome over j.i_current_price) of
              (SOME price, SOME average) => price > decimal "1.2" * average
            | _ => false)
      group {state = a.ca_state} compute {cnt = count over ()}
      where cnt >= 10
      order cnt
      take 100
  end;
> val q6 = fn : unit -> {cnt:int, state:string option} list
val r6 = q6 ();
> cnt state
> --- -----
>  10 VA
>
> val r6 : {cnt:int, state:string option} list

(* --- q7 --------------------------------------------------------- *)
(*
SELECT
  i_item_id,
  avg(ss_quantity) agg1,
  avg(ss_list_price) agg2,
  avg(ss_coupon_amt) agg3,
  avg(ss_sales_price) agg4
FROM store_sales, customer_demographics, date_dim, item, promotion
WHERE ss_sold_date_sk = d_date_sk AND
  ss_item_sk = i_item_sk AND
  ss_cdemo_sk = cd_demo_sk AND
  ss_promo_sk = p_promo_sk AND
  cd_gender = 'M' AND
  cd_marital_status = 'S' AND
  cd_education_status = 'College' AND
  (p_channel_email = 'N' OR p_channel_event = 'N') AND
  d_year = 2000
GROUP BY i_item_id
ORDER BY i_item_id
LIMIT 100
*)
fun q7 () =
  from ss in tpcds.store_sales,
      cd in tpcds.customer_demographics,
      d in tpcds.date_dim,
      i in tpcds.item,
      p in tpcds.promotion
    where ss.ss_sold_date_sk = SOME d.d_date_sk
      andalso ss.ss_item_sk = i.i_item_sk
      andalso ss.ss_cdemo_sk = SOME cd.cd_demo_sk
      andalso ss.ss_promo_sk = SOME p.p_promo_sk
      andalso cd.cd_gender = SOME "M"
      andalso cd.cd_marital_status = SOME "S"
      andalso cd.cd_education_status = SOME "College"
      andalso (p.p_channel_email = SOME "N"
        orelse p.p_channel_event = SOME "N")
      andalso d.d_year = SOME 2000
    group i.i_item_id
      compute {agg1 = avgSome over ss.ss_quantity,
        agg2 = avgSome over ss.ss_list_price,
        agg3 = avgSome over ss.ss_coupon_amt,
        agg4 = avgSome over ss.ss_sales_price}
    order i_item_id
    take 100;
> val q7 = fn
>   : unit
>      -> {agg1:real option, agg2:decimal option, agg3:decimal option,
>           agg4:decimal option, i_item_id:string} list
