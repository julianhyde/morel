(* --- q27 -------------------------------------------------------- *)
(*
SELECT
  i_item_id,
  s_state,
  grouping(s_state) g_state,
  avg(ss_quantity) agg1,
  avg(ss_list_price) agg2,
  avg(ss_coupon_amt) agg3,
  avg(ss_sales_price) agg4
FROM store_sales, customer_demographics, date_dim, store, item
WHERE ss_sold_date_sk = d_date_sk AND
  ss_item_sk = i_item_sk AND
  ss_store_sk = s_store_sk AND
  ss_cdemo_sk = cd_demo_sk AND
  cd_gender = 'M' AND
  cd_marital_status = 'S' AND
  cd_education_status = 'College' AND
  d_year = 2002 AND
  s_state IN ('TN', 'TN', 'TN', 'TN', 'TN', 'TN')
GROUP BY ROLLUP (i_item_id, s_state)
ORDER BY i_item_id, s_state
LIMIT 100
*)
(* "GROUP BY ROLLUP (i_item_id, s_state)" is a union of groupings, as in
 * q22; "grouping(s_state)" is 1 where "s_state" is rolled up. *)
fun q27 () =
  let
    val base =
      from ss in tpcds.store_sales,
          cd in tpcds.customer_demographics,
          d in tpcds.date_dim,
          s in tpcds.store,
          i in tpcds.item
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_item_sk = i.i_item_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso ss.ss_cdemo_sk = SOME cd.cd_demo_sk
          andalso cd.cd_gender = SOME "M"
          andalso cd.cd_marital_status = SOME "S"
          andalso cd.cd_education_status = SOME "College"
          andalso d.d_year = SOME 2002
          andalso s.s_state elem [SOME "TN"]
        yield {i_item_id = SOME i.i_item_id, s.s_state, ss.ss_quantity,
          ss.ss_list_price, ss.ss_coupon_amt, ss.ss_sales_price}
  in
    from r in (from b in base
          group {b.i_item_id, b.s_state}
            compute {agg1 = avgSome over b.ss_quantity,
                agg2 = avgSome over b.ss_list_price,
                agg3 = avgSome over b.ss_coupon_amt,
                agg4 = avgSome over b.ss_sales_price}
          yield {i_item_id, s_state, g_state = 0, agg1, agg2, agg3, agg4})
        union
          (from b in base
              group {b.i_item_id}
                compute {agg1 = avgSome over b.ss_quantity,
                    agg2 = avgSome over b.ss_list_price,
                    agg3 = avgSome over b.ss_coupon_amt,
                    agg4 = avgSome over b.ss_sales_price}
              yield {i_item_id, s_state = NONE, g_state = 1, agg1, agg2, agg3,
                agg4}),
          (from b in base
              group {}
                compute {agg1 = avgSome over b.ss_quantity,
                    agg2 = avgSome over b.ss_list_price,
                    agg3 = avgSome over b.ss_coupon_amt,
                    agg4 = avgSome over b.ss_sales_price}
              yield {i_item_id = NONE, s_state = NONE, g_state = 1, agg1, agg2,
                agg3, agg4})
      order (r.i_item_id, r.s_state)
      take 100
  end;
> val q27 = fn
>   : unit
>      -> {agg1:real option, agg2:decimal option, agg3:decimal option,
>           agg4:decimal option, g_state:int, i_item_id:string option,
>           s_state:string option} list
