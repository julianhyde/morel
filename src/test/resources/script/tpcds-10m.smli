> val r56 : {i_item_id:string, total_sales:decimal option} list

(* --- q57 -------------------------------------------------------- *)
(*
WITH v1 AS (
  SELECT
    i_category,
    i_brand,
    cc_name,
    d_year,
    d_moy,
    sum(cs_sales_price) sum_sales,
    avg(sum(cs_sales_price))
    OVER
    (PARTITION BY i_category, i_brand, cc_name, d_year)
    avg_monthly_sales,
    rank()
    OVER
    (PARTITION BY i_category, i_brand, cc_name
      ORDER BY d_year, d_moy) rn
  FROM item, catalog_sales, date_dim, call_center
  WHERE cs_item_sk = i_item_sk AND
    cs_sold_date_sk = d_date_sk AND
    cc_call_center_sk = cs_call_center_sk AND
    (
      d_year = 1999 OR
        (d_year = 1999 - 1 AND d_moy = 12) OR
        (d_year = 1999 + 1 AND d_moy = 1)
    )
  GROUP BY i_category, i_brand,
    cc_name, d_year, d_moy),
    v2 AS (
    SELECT
      v1.i_category,
      v1.i_brand,
      v1.cc_name,
      v1.d_year,
      v1.d_moy,
      v1.avg_monthly_sales,
      v1.sum_sales,
      v1_lag.sum_sales psum,
      v1_lead.sum_sales nsum
    FROM v1, v1 v1_lag, v1 v1_lead
    WHERE v1.i_category = v1_lag.i_category AND
      v1.i_category = v1_lead.i_category AND
      v1.i_brand = v1_lag.i_brand AND
      v1.i_brand = v1_lead.i_brand AND
      v1.cc_name = v1_lag.cc_name AND
      v1.cc_name = v1_lead.cc_name AND
      v1.rn = v1_lag.rn + 1 AND
      v1.rn = v1_lead.rn - 1)
SELECT *
FROM v2
WHERE d_year = 1999 AND
  avg_monthly_sales > 0 AND
  CASE WHEN avg_monthly_sales > 0
    THEN abs(sum_sales - avg_monthly_sales) / avg_monthly_sales
  ELSE NULL END > 0.1
ORDER BY sum_sales - avg_monthly_sales, 3
LIMIT 100
*)
(* "avg(sum(x)) OVER (PARTITION BY p)" is the average of the groups' sums
 * for each "p", joined to the groups, as in q53. "rank() OVER (PARTITION
 * BY p ORDER BY d_year, d_moy)" is a group's position in its partition,
 * because the (year, month) of each group in a partition is distinct:
 * the groups are sorted by partition and month once, and a group's rank
 * is its position less its partition's first position, plus one. The lag
 * and lead are joins, whose equalities (unlike a partition's) drop a row
 * whose key is NONE. *)
fun q57 () =
  let
    val base =
      from i in tpcds.item,
          cs in tpcds.catalog_sales,
          d in tpcds.date_dim,
          cc in tpcds.call_center
        where cs.cs_item_sk = i.i_item_sk
          andalso cs.cs_sold_date_sk = SOME d.d_date_sk
          andalso cs.cs_call_center_sk = SOME cc.cc_call_center_sk
          andalso (d.d_year = SOME 1999
            orelse d.d_year = SOME (1999 - 1) andalso d.d_moy = SOME 12
            orelse d.d_year = SOME (1999 + 1) andalso d.d_moy = SOME 1)
        yield {i.i_category, i.i_brand, cc.cc_name, d.d_year, d.d_moy,
          sales_price = cs.cs_sales_price}
    val groups =
      from b in base
        group {b.i_category, b.i_brand, b.cc_name, b.d_year, b.d_moy}
          compute {sum_sales = sumSome over b.sales_price}
    val averages =
      from g in groups
        group {g.i_category, g.i_brand, g.cc_name, g.d_year}
          compute {avg_monthly_sales = avgSome over g.sum_sales}
    val sorted =
      from g in groups
        order (g.i_category, g.i_brand, g.cc_name, g.d_year, g.d_moy)
        yield {g, pos = ordinal}
    val firsts =
      from x in sorted
        group {x.g.i_category, x.g.i_brand, x.g.cc_name}
          compute {first = min over x.pos}
    val v1s =
      from x in sorted,
          a in averages,
          f in firsts
        where a.i_category = x.g.i_category
          andalso a.i_brand = x.g.i_brand
          andalso a.cc_name = x.g.cc_name
          andalso a.d_year = x.g.d_year
          andalso f.i_category = x.g.i_category
          andalso f.i_brand = x.g.i_brand
          andalso f.cc_name = x.g.cc_name
        yield {x.g, a.avg_monthly_sales, rn = x.pos - f.first + 1}
        yield {g.i_category, g.i_brand, g.cc_name, g.d_year, g.d_moy,
          sum_sales = g.sum_sales, avg_monthly_sales, rn}
  in
    from v1 in v1s,
        v1_lag in v1s,
        v1_lead in v1s
      where v1.i_category <> NONE
        andalso v1.i_category = v1_lag.i_category
        andalso v1.i_brand <> NONE
        andalso v1.i_brand = v1_lag.i_brand
        andalso v1.cc_name <> NONE
        andalso v1.cc_name = v1_lag.cc_name
        andalso v1.i_category = v1_lead.i_category
        andalso v1.i_brand = v1_lead.i_brand
        andalso v1.cc_name = v1_lead.cc_name
        andalso v1.rn = v1_lag.rn + 1
        andalso v1.rn = v1_lead.rn - 1
        andalso v1.d_year = SOME 1999
        andalso v1.avg_monthly_sales > SOME (Decimal.fromInt 0)
        andalso (case (v1.sum_sales, v1.avg_monthly_sales) of
                    (SOME s, SOME a) =>
                      a > Decimal.fromInt 0
                      andalso Decimal.abs (s - a) / a > decimal "0.1"
                  | _ => false)
      order ((case (v1.sum_sales, v1.avg_monthly_sales) of
                 (SOME s, SOME a) => SOME (s - a)
               | _ => NONE),
        v1.cc_name)
      yield {v1.i_category, v1.i_brand, v1.cc_name, v1.d_year, v1.d_moy,
        v1.avg_monthly_sales, v1.sum_sales, psum = v1_lag.sum_sales,
        nsum = v1_lead.sum_sales}
      take 100
  end;
> val q57 = fn
>   : unit
>      -> {avg_monthly_sales:decimal option, cc_name:string option,
>           d_moy:int option, d_year:int option, i_brand:string option,
>           i_category:string option, nsum:decimal option, psum:decimal option,
>           sum_sales:decimal option} list
val r57 = q57 ();
