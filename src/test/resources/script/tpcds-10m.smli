(* --- q70 -------------------------------------------------------- *)
(*
SELECT
  sum(ss_net_profit) AS total_sum,
  s_state,
  s_county,
  grouping(s_state) + grouping(s_county) AS lochierarchy,
  rank()
  OVER (
    PARTITION BY grouping(s_state) + grouping(s_county),
      CASE WHEN grouping(s_county) = 0
        THEN s_state END
    ORDER BY sum(ss_net_profit) DESC) AS rank_within_parent
FROM
  store_sales, date_dim d1, store
WHERE
  d1.d_month_seq BETWEEN 1200 AND 1200 + 11
    AND d1.d_date_sk = ss_sold_date_sk
    AND s_store_sk = ss_store_sk
    AND s_state IN
    (SELECT s_state
    FROM
      (SELECT
        s_state AS s_state,
        rank()
        OVER (PARTITION BY s_state
          ORDER BY sum(ss_net_profit) DESC) AS ranking
      FROM store_sales, store, date_dim
      WHERE d_month_seq BETWEEN 1200 AND 1200 + 11
        AND d_date_sk = ss_sold_date_sk
        AND s_store_sk = ss_store_sk
      GROUP BY s_state) tmp1
    WHERE ranking <= 5)
GROUP BY ROLLUP (s_state, s_county)
ORDER BY
  lochierarchy DESC
  , CASE WHEN lochierarchy = 0
  THEN s_state END
  , rank_within_parent
LIMIT 100
*)
(* "GROUP BY ROLLUP", as in q22. "rank() OVER (PARTITION BY p ORDER BY
 * m)" is one more than the number of rows in the row's partition whose
 * "m" comes before its own (descending); NONE is less than any SOME, so it
 * is first ascending and last descending, as Spark's nulls are. *)
fun q70 () =
  let
    (* The states whose rank, within the partition of their own state,
     * is at most 5; each state is its own partition, so all of them. *)
    val states =
      let
        val totals =
          from ss in tpcds.store_sales,
              s in tpcds.store,
              d in tpcds.date_dim
            where d.d_month_seq >= SOME 1200
              andalso d.d_month_seq <= SOME (1200 + 11)
              andalso ss.ss_sold_date_sk = SOME d.d_date_sk
              andalso ss.ss_store_sk = SOME s.s_store_sk
            group s.s_state compute {total = sumSome over ss.ss_net_profit}
      in
        from t in totals
          where 1 + count (from u in totals
              where u.s_state = t.s_state andalso u.total > t.total) <= 5
          yield t.s_state
      end
    val base =
      from ss in tpcds.store_sales,
          d1 in tpcds.date_dim,
          s in tpcds.store
        where d1.d_month_seq >= SOME 1200
          andalso d1.d_month_seq <= SOME (1200 + 11)
          andalso ss.ss_sold_date_sk = SOME d1.d_date_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso s.s_state <> NONE
          andalso s.s_state elem states
        yield {s.s_state, s.s_county, ss.ss_net_profit}
    val rolled =
      from r in (from b in base
          group {b.s_state, b.s_county}
            compute {total = sumSome over b.ss_net_profit}
          yield {s_state, s_county, g1 = 0, g2 = 0, total})
        union
          (from b in base
              group {b.s_state}
                compute {total = sumSome over b.ss_net_profit}
              yield {s_state, s_county = NONE, g1 = 0, g2 = 1, total}),
          (from b in base
              group {}
                compute {total = sumSome over b.ss_net_profit}
              yield {s_state = NONE, s_county = NONE, g1 = 1, g2 = 1, total})
      yield {total_sum = r.total, r.s_state, r.s_county,
        lochierarchy = r.g1 + r.g2,
        parent = if r.g2 = 0 then r.s_state else NONE}
  in
    from r in rolled
      yield {r.total_sum, r.s_state, r.s_county, r.lochierarchy,
        rank_within_parent =
          1 + count (from s in rolled
            where s.lochierarchy = r.lochierarchy
              andalso s.parent = r.parent
              andalso s.total_sum > r.total_sum)}
      order (DESC lochierarchy,
        if lochierarchy = 0 then s_state else NONE, rank_within_parent)
      take 100
  end;
> val q70 = fn
>   : unit
>      -> {lochierarchy:int, rank_within_parent:int, s_county:string option,
>           s_state:string option, total_sum:decimal option} list
val r70 = q70 ();
> lochierarchy rank_within_parent s_county          s_state total_sum
> ------------ ------------------ ----------------- ------- ------------
>            2                  1                           -18926197.59
>            1                  1                   TN      -18926197.59
>            0                  1 Williamson County TN      -18926197.59
>
> val r70 : {lochierarchy:int, rank_within_parent:int, s_county:string option, s_state:string option, total_sum:decimal option} list

(* --- q71 -------------------------------------------------------- *)
(*
SELECT
  i_brand_id brand_id,
  i_brand brand,
  t_hour,
  t_minute,
  sum(ext_price) ext_price
FROM item,
  (SELECT
     ws_ext_sales_price AS ext_price,
     ws_sold_date_sk AS sold_date_sk,
     ws_item_sk AS sold_item_sk,
     ws_sold_time_sk AS time_sk
   FROM web_sales, date_dim
   WHERE d_date_sk = ws_sold_date_sk
     AND d_moy = 11
     AND d_year = 1999
   UNION ALL
   SELECT
     cs_ext_sales_price AS ext_price,
     cs_sold_date_sk AS sold_date_sk,
     cs_item_sk AS sold_item_sk,
     cs_sold_time_sk AS time_sk
   FROM catalog_sales, date_dim
   WHERE d_date_sk = cs_sold_date_sk
     AND d_moy = 11
     AND d_year = 1999
   UNION ALL
   SELECT
     ss_ext_sales_price AS ext_price,
     ss_sold_date_sk AS sold_date_sk,
     ss_item_sk AS sold_item_sk,
     ss_sold_time_sk AS time_sk
   FROM store_sales, date_dim
   WHERE d_date_sk = ss_sold_date_sk
     AND d_moy = 11
     AND d_year = 1999
  ) AS tmp, time_dim
WHERE
  sold_item_sk = i_item_sk
    AND i_manager_id = 1
    AND time_sk = t_time_sk
    AND (t_meal_time = 'breakfast' OR t_meal_time = 'dinner')
GROUP BY i_brand, i_brand_id, t_hour, t_minute
ORDER BY ext_price DESC, brand_id
*)
fun q71 () =
  from i in tpcds.item,
      tmp in (
        from ws in tpcds.web_sales,
            d in tpcds.date_dim
          where ws.ws_sold_date_sk = SOME d.d_date_sk
            andalso d.d_moy = SOME 11
            andalso d.d_year = SOME 1999
          yield {ext_price = ws.ws_ext_sales_price,
            sold_date_sk = ws.ws_sold_date_sk, sold_item_sk = ws.ws_item_sk,
            time_sk = ws.ws_sold_time_sk}
        union
          (from cs in tpcds.catalog_sales,
              d in tpcds.date_dim
            where cs.cs_sold_date_sk = SOME d.d_date_sk
              andalso d.d_moy = SOME 11
              andalso d.d_year = SOME 1999
            yield {ext_price = cs.cs_ext_sales_price,
              sold_date_sk = cs.cs_sold_date_sk,
              sold_item_sk = cs.cs_item_sk, time_sk = cs.cs_sold_time_sk}),
          (from ss in tpcds.store_sales,
              d in tpcds.date_dim
            where ss.ss_sold_date_sk = SOME d.d_date_sk
              andalso d.d_moy = SOME 11
              andalso d.d_year = SOME 1999
            yield {ext_price = ss.ss_ext_sales_price,
              sold_date_sk = ss.ss_sold_date_sk,
              sold_item_sk = ss.ss_item_sk, time_sk = ss.ss_sold_time_sk})),
      t in tpcds.time_dim
    where tmp.sold_item_sk = i.i_item_sk
      andalso i.i_manager_id = SOME 1
      andalso tmp.time_sk = SOME t.t_time_sk
      andalso (t.t_meal_time = SOME "breakfast"
        orelse t.t_meal_time = SOME "dinner")
    group {brand_id = i.i_brand_id, brand = i.i_brand, t.t_hour, t.t_minute}
      compute {ext_price = sumSome over tmp.ext_price}
    order (DESC ext_price, brand_id);
> val q71 = fn
>   : unit
>      -> {brand:string option, brand_id:int option, ext_price:decimal option,
>           t_hour:int option, t_minute:int option} list
val r71 = q71 ();
