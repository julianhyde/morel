                else zero),
            oct_sales = sumSome over
              (if d.d_moy = SOME 10
                then times (cs.cs_sales_price,
                  cs.cs_quantity)
                else zero),
            nov_sales = sumSome over
              (if d.d_moy = SOME 11
                then times (cs.cs_sales_price,
                  cs.cs_quantity)
                else zero),
            dec_sales = sumSome over
              (if d.d_moy = SOME 12
                then times (cs.cs_sales_price,
                  cs.cs_quantity)
                else zero),
            jan_net = sumSome over
              (if d.d_moy = SOME 1
                then times (cs.cs_net_paid_inc_tax,
                  cs.cs_quantity)
                else zero),
            feb_net = sumSome over
              (if d.d_moy = SOME 2
