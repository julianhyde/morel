(* --- q43 -------------------------------------------------------- *)
(*
SELECT
  s_store_name,
  s_store_id,
  sum(CASE WHEN (d_day_name = 'Sunday')
    THEN ss_sales_price
      ELSE NULL END) sun_sales,
  sum(CASE WHEN (d_day_name = 'Monday')
    THEN ss_sales_price
      ELSE NULL END) mon_sales,
  sum(CASE WHEN (d_day_name = 'Tuesday')
    THEN ss_sales_price
      ELSE NULL END) tue_sales,
  sum(CASE WHEN (d_day_name = 'Wednesday')
    THEN ss_sales_price
      ELSE NULL END) wed_sales,
  sum(CASE WHEN (d_day_name = 'Thursday')
    THEN ss_sales_price
      ELSE NULL END) thu_sales,
  sum(CASE WHEN (d_day_name = 'Friday')
    THEN ss_sales_price
      ELSE NULL END) fri_sales,
  sum(CASE WHEN (d_day_name = 'Saturday')
    THEN ss_sales_price
      ELSE NULL END) sat_sales
FROM date_dim, store_sales, store
WHERE d_date_sk = ss_sold_date_sk AND
  s_store_sk = ss_store_sk AND
  s_gmt_offset = -5 AND
  d_year = 2000
GROUP BY s_store_name, s_store_id
ORDER BY s_store_name, s_store_id, sun_sales, mon_sales, tue_sales, wed_sales,
  thu_sales, fri_sales, sat_sales
LIMIT 100
*)
fun q43 () =
  from d in tpcds.date_dim,
      ss in tpcds.store_sales,
      s in tpcds.store
    where ss.ss_sold_date_sk = SOME d.d_date_sk
      andalso ss.ss_store_sk = SOME s.s_store_sk
      andalso s.s_gmt_offset = SOME (Decimal.fromInt ~5)
      andalso d.d_year = SOME 2000
    group {s.s_store_name, s.s_store_id}
      compute {
        sun_sales = sumSome over (if d.d_day_name = SOME "Sunday"
          then ss.ss_sales_price else NONE),
        mon_sales = sumSome over (if d.d_day_name = SOME "Monday"
          then ss.ss_sales_price else NONE),
        tue_sales = sumSome over (if d.d_day_name = SOME "Tuesday"
          then ss.ss_sales_price else NONE),
        wed_sales = sumSome over (if d.d_day_name = SOME "Wednesday"
          then ss.ss_sales_price else NONE),
        thu_sales = sumSome over (if d.d_day_name = SOME "Thursday"
          then ss.ss_sales_price else NONE),
        fri_sales = sumSome over (if d.d_day_name = SOME "Friday"
          then ss.ss_sales_price else NONE),
        sat_sales = sumSome over (if d.d_day_name = SOME "Saturday"
          then ss.ss_sales_price else NONE)}
    order (s_store_name, s_store_id, sun_sales, mon_sales, tue_sales,
      wed_sales, thu_sales, fri_sales, sat_sales)
    take 100;
> val q43 = fn
>   : unit
>      -> {fri_sales:decimal option, mon_sales:decimal option,
>           s_store_id:string, s_store_name:string option,
>           sat_sales:decimal option, sun_sales:decimal option,
>           thu_sales:decimal option, tue_sales:decimal option,
>           wed_sales:decimal option} list
val r43 = q43 ();
