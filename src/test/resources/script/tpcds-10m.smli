(* --- q41 -------------------------------------------------------- *)
(*
SELECT DISTINCT (i_product_name)
FROM item i1
WHERE i_manufact_id BETWEEN 738 AND 738 + 40
  AND (SELECT count(*) AS item_cnt
FROM item
WHERE (i_manufact = i1.i_manufact AND
  ((i_category = 'Women' AND
    (i_color = 'powder' OR i_color = 'khaki') AND
    (i_units = 'Ounce' OR i_units = 'Oz') AND
    (i_size = 'medium' OR i_size = 'extra large')
  ) OR
    (i_category = 'Women' AND
      (i_color = 'brown' OR i_color = 'honeydew') AND
      (i_units = 'Bunch' OR i_units = 'Ton') AND
      (i_size = 'N/A' OR i_size = 'small')
    ) OR
    (i_category = 'Men' AND
      (i_color = 'floral' OR i_color = 'deep') AND
      (i_units = 'N/A' OR i_units = 'Dozen') AND
      (i_size = 'petite' OR i_size = 'large')
    ) OR
    (i_category = 'Men' AND
      (i_color = 'light' OR i_color = 'cornflower') AND
      (i_units = 'Box' OR i_units = 'Pound') AND
      (i_size = 'medium' OR i_size = 'extra large')
    ))) OR
  (i_manufact = i1.i_manufact AND
    ((i_category = 'Women' AND
      (i_color = 'midnight' OR i_color = 'snow') AND
      (i_units = 'Pallet' OR i_units = 'Gross') AND
      (i_size = 'medium' OR i_size = 'extra large')
    ) OR
      (i_category = 'Women' AND
        (i_color = 'cyan' OR i_color = 'papaya') AND
        (i_units = 'Cup' OR i_units = 'Dram') AND
        (i_size = 'N/A' OR i_size = 'small')
      ) OR
      (i_category = 'Men' AND
        (i_color = 'orange' OR i_color = 'frosted') AND
        (i_units = 'Each' OR i_units = 'Tbl') AND
        (i_size = 'petite' OR i_size = 'large')
      ) OR
      (i_category = 'Men' AND
        (i_color = 'forest' OR i_color = 'ghost') AND
        (i_units = 'Lb' OR i_units = 'Bundle') AND
        (i_size = 'medium' OR i_size = 'extra large')
      )))) > 0
ORDER BY i_product_name
LIMIT 100
*)
(* The SQL compares a count of matching items with 0; that is "exists". *)
fun q41 () =
  from i1 in tpcds.item
    where i1.i_manufact_id >= SOME 738
      andalso i1.i_manufact_id <= SOME (738 + 40)
      andalso i1.i_manufact <> NONE
      andalso (exists i in tpcds.item
        where i.i_manufact = i1.i_manufact
          andalso (i.i_category = SOME "Women"
                andalso i.i_color elem [SOME "powder", SOME "khaki"]
                andalso i.i_units elem [SOME "Ounce", SOME "Oz"]
                andalso i.i_size elem [SOME "medium", SOME "extra large"]
              orelse i.i_category = SOME "Women"
                andalso i.i_color elem [SOME "brown", SOME "honeydew"]
                andalso i.i_units elem [SOME "Bunch", SOME "Ton"]
                andalso i.i_size elem [SOME "N/A", SOME "small"]
              orelse i.i_category = SOME "Men"
                andalso i.i_color elem [SOME "floral", SOME "deep"]
                andalso i.i_units elem [SOME "N/A", SOME "Dozen"]
                andalso i.i_size elem [SOME "petite", SOME "large"]
              orelse i.i_category = SOME "Men"
                andalso i.i_color elem [SOME "light", SOME "cornflower"]
                andalso i.i_units elem [SOME "Box", SOME "Pound"]
                andalso i.i_size elem [SOME "medium", SOME "extra large"]
              orelse i.i_category = SOME "Women"
                andalso i.i_color elem [SOME "midnight", SOME "snow"]
                andalso i.i_units elem [SOME "Pallet", SOME "Gross"]
                andalso i.i_size elem [SOME "medium", SOME "extra large"]
              orelse i.i_category = SOME "Women"
                andalso i.i_color elem [SOME "cyan", SOME "papaya"]
                andalso i.i_units elem [SOME "Cup", SOME "Dram"]
                andalso i.i_size elem [SOME "N/A", SOME "small"]
              orelse i.i_category = SOME "Men"
                andalso i.i_color elem [SOME "orange", SOME "frosted"]
                andalso i.i_units elem [SOME "Each", SOME "Tbl"]
                andalso i.i_size elem [SOME "petite", SOME "large"]
              orelse i.i_category = SOME "Men"
                andalso i.i_color elem [SOME "forest", SOME "ghost"]
                andalso i.i_units elem [SOME "Lb", SOME "Bundle"]
                andalso i.i_size elem [SOME "medium", SOME "extra large"]))
    yield i1.i_product_name
    distinct
    order current
    take 100;
> val q41 = fn : unit -> string option list
val r41 = q41 ();
> val r41 = [] : string option list

(* --- q42 -------------------------------------------------------- *)
(*
SELECT
  dt.d_year,
  item.i_category_id,
  item.i_category,
  sum(ss_ext_sales_price)
FROM date_dim dt, store_sales, item
WHERE dt.d_date_sk = store_sales.ss_sold_date_sk
  AND store_sales.ss_item_sk = item.i_item_sk
  AND item.i_manager_id = 1
  AND dt.d_moy = 11
  AND dt.d_year = 2000
GROUP BY dt.d_year
  , item.i_category_id
  , item.i_category
ORDER BY sum(ss_ext_sales_price) DESC, dt.d_year
  , item.i_category_id
  , item.i_category
LIMIT 100
*)
fun q42 () =
  from dt in tpcds.date_dim,
      ss in tpcds.store_sales,
      i in tpcds.item
    where SOME dt.d_date_sk = ss.ss_sold_date_sk
      andalso ss.ss_item_sk = i.i_item_sk
      andalso i.i_manager_id = SOME 1
      andalso dt.d_moy = SOME 11
      andalso dt.d_year = SOME 2000
    group {dt.d_year, i.i_category_id, i.i_category}
      compute {sum = sumSome over ss.ss_ext_sales_price}
    order (DESC sum, d_year, i_category_id, i_category)
    take 100;
> val q42 = fn
>   : unit
>      -> {d_year:int option, i_category:string option,
>           i_category_id:int option, sum:decimal option} list
val r42 = q42 ();
