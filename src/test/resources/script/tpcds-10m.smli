WITH ss AS (
  SELECT
    i_manufact_id,
    sum(ss_ext_sales_price) total_sales
  FROM
    store_sales, date_dim, customer_address, item
  WHERE
    i_manufact_id IN (SELECT i_manufact_id
    FROM item
    WHERE i_category IN ('Electronics'))
      AND ss_item_sk = i_item_sk
      AND ss_sold_date_sk = d_date_sk
      AND d_year = 1998
      AND d_moy = 5
      AND ss_addr_sk = ca_address_sk
      AND ca_gmt_offset = -5
  GROUP BY i_manufact_id), cs AS
(SELECT
    i_manufact_id,
    sum(cs_ext_sales_price) total_sales
  FROM catalog_sales, date_dim, customer_address, item
  WHERE
    i_manufact_id IN (
      SELECT i_manufact_id
      FROM item
      WHERE
        i_category IN ('Electronics'))
      AND cs_item_sk = i_item_sk
      AND cs_sold_date_sk = d_date_sk
      AND d_year = 1998
      AND d_moy = 5
      AND cs_bill_addr_sk = ca_address_sk
      AND ca_gmt_offset = -5
  GROUP BY i_manufact_id),
    ws AS (
    SELECT
      i_manufact_id,
      sum(ws_ext_sales_price) total_sales
    FROM
      web_sales, date_dim, customer_address, item
    WHERE
      i_manufact_id IN (SELECT i_manufact_id
      FROM item
      WHERE i_category IN ('Electronics'))
        AND ws_item_sk = i_item_sk
        AND ws_sold_date_sk = d_date_sk
        AND d_year = 1998
        AND d_moy = 5
        AND ws_bill_addr_sk = ca_address_sk
        AND ca_gmt_offset = -5
    GROUP BY i_manufact_id)
SELECT
  i_manufact_id,
  sum(total_sales) total_sales
FROM (SELECT *
      FROM ss
      UNION ALL
      SELECT *
      FROM cs
      UNION ALL
      SELECT *
      FROM ws) tmp1
GROUP BY i_manufact_id
ORDER BY total_sales
LIMIT 100
*)
fun q33 () =
  let
    val keys =
      from i in tpcds.item
        where i.i_category elem [SOME "Electronics"]
        yield i.i_manufact_id
  in
    from tmp1 in (
        from ss in tpcds.store_sales,
            d in tpcds.date_dim,
            ca in tpcds.customer_address,
            i in tpcds.item
          where i.i_manufact_id <> NONE
            andalso i.i_manufact_id elem keys
            andalso ss.ss_item_sk = i.i_item_sk
            andalso ss.ss_sold_date_sk = SOME d.d_date_sk
            andalso d.d_year = SOME 1998
            andalso d.d_moy = SOME 5
            andalso ss.ss_addr_sk = SOME ca.ca_address_sk
            andalso ca.ca_gmt_offset = SOME (Decimal.fromInt ~5)
          group i.i_manufact_id
            compute {total_sales = sum over ss.ss_ext_sales_price})
      union
        (from cs in tpcds.catalog_sales,
            d in tpcds.date_dim,
            ca in tpcds.customer_address,
            i in tpcds.item
          where i.i_manufact_id <> NONE
            andalso i.i_manufact_id elem keys
            andalso cs.cs_item_sk = i.i_item_sk
            andalso cs.cs_sold_date_sk = SOME d.d_date_sk
            andalso d.d_year = SOME 1998
            andalso d.d_moy = SOME 5
            andalso cs.cs_bill_addr_sk = SOME ca.ca_address_sk
            andalso ca.ca_gmt_offset = SOME (Decimal.fromInt ~5)
          group i.i_manufact_id
            compute {total_sales = sum over cs.cs_ext_sales_price}),
        (from ws in tpcds.web_sales,
            d in tpcds.date_dim,
            ca in tpcds.customer_address,
            i in tpcds.item
          where i.i_manufact_id <> NONE
            andalso i.i_manufact_id elem keys
            andalso ws.ws_item_sk = i.i_item_sk
            andalso ws.ws_sold_date_sk = SOME d.d_date_sk
            andalso d.d_year = SOME 1998
            andalso d.d_moy = SOME 5
            andalso ws.ws_bill_addr_sk = SOME ca.ca_address_sk
            andalso ca.ca_gmt_offset = SOME (Decimal.fromInt ~5)
          group i.i_manufact_id
            compute {total_sales = sum over ws.ws_ext_sales_price})
      group tmp1.i_manufact_id
        compute {total_sales = sum over tmp1.total_sales}
      order total_sales
      take 100
  end;
> val q33 = fn
>   : unit -> {i_manufact_id:int option, total_sales:decimal option} list
val r33 = q33 ();
