(* --- q31 -------------------------------------------------------- *)
(*
WITH ss AS
(SELECT
    ca_county,
    d_qoy,
    d_year,
    sum(ss_ext_sales_price) AS store_sales
  FROM store_sales, date_dim, customer_address
  WHERE ss_sold_date_sk = d_date_sk
    AND ss_addr_sk = ca_address_sk
  GROUP BY ca_county, d_qoy, d_year),
    ws AS
  (SELECT
    ca_county,
    d_qoy,
    d_year,
    sum(ws_ext_sales_price) AS web_sales
  FROM web_sales, date_dim, customer_address
  WHERE ws_sold_date_sk = d_date_sk
    AND ws_bill_addr_sk = ca_address_sk
  GROUP BY ca_county, d_qoy, d_year)
SELECT
  ss1.ca_county,
  ss1.d_year,
  ws2.web_sales / ws1.web_sales web_q1_q2_increase,
  ss2.store_sales / ss1.store_sales store_q1_q2_increase,
  ws3.web_sales / ws2.web_sales web_q2_q3_increase,
  ss3.store_sales / ss2.store_sales store_q2_q3_increase
FROM
  ss ss1, ss ss2, ss ss3, ws ws1, ws ws2, ws ws3
WHERE
  ss1.d_qoy = 1
    AND ss1.d_year = 2000
    AND ss1.ca_county = ss2.ca_county
    AND ss2.d_qoy = 2
    AND ss2.d_year = 2000
    AND ss2.ca_county = ss3.ca_county
    AND ss3.d_qoy = 3
    AND ss3.d_year = 2000
    AND ss1.ca_county = ws1.ca_county
    AND ws1.d_qoy = 1
    AND ws1.d_year = 2000
    AND ws1.ca_county = ws2.ca_county
    AND ws2.d_qoy = 2
    AND ws2.d_year = 2000
    AND ws1.ca_county = ws3.ca_county
    AND ws3.d_qoy = 3
    AND ws3.d_year = 2000
    AND CASE WHEN ws1.web_sales > 0
    THEN ws2.web_sales / ws1.web_sales
        ELSE NULL END
    > CASE WHEN ss1.store_sales > 0
    THEN ss2.store_sales / ss1.store_sales
      ELSE NULL END
    AND CASE WHEN ws2.web_sales > 0
    THEN ws3.web_sales / ws2.web_sales
        ELSE NULL END
    > CASE WHEN ss2.store_sales > 0
    THEN ss3.store_sales / ss2.store_sales
      ELSE NULL END
ORDER BY ss1.ca_county
*)
fun q31 () =
  let
    val ss =
      from ss in tpcds.store_sales,
          d in tpcds.date_dim,
          ca in tpcds.customer_address
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_addr_sk = SOME ca.ca_address_sk
        group {ca.ca_county, d.d_qoy, d.d_year}
          compute {store_sales = sum over ss.ss_ext_sales_price}
    val ws =
      from ws in tpcds.web_sales,
          d in tpcds.date_dim,
          ca in tpcds.customer_address
        where ws.ws_sold_date_sk = SOME d.d_date_sk
          andalso ws.ws_bill_addr_sk = SOME ca.ca_address_sk
        group {ca.ca_county, d.d_qoy, d.d_year}
          compute {web_sales = sum over ws.ws_ext_sales_price}
    (* "a / b", which raises if "b" is zero *)
    fun divide (a : decimal option, b) =
      case (a, b) of
          (SOME x, SOME y) => SOME (x / y)
        | _ => NONE
    (* "CASE WHEN b > 0 THEN a / b ELSE NULL END" *)
    fun ratio (a, b) =
      case (a, b) of
          (SOME x, SOME y) =>
            if y > Decimal.fromInt 0 then SOME (x / y) else NONE
        | _ => NONE
  in
    from ss1 in ss, ss2 in ss, ss3 in ss, ws1 in ws, ws2 in ws, ws3 in ws
      where ss1.d_qoy = SOME 1
        andalso ss1.d_year = SOME 2000
        andalso ss1.ca_county <> NONE
        andalso ss1.ca_county = ss2.ca_county
        andalso ss2.d_qoy = SOME 2
        andalso ss2.d_year = SOME 2000
        andalso ss2.ca_county = ss3.ca_county
        andalso ss3.d_qoy = SOME 3
        andalso ss3.d_year = SOME 2000
        andalso ss1.ca_county = ws1.ca_county
        andalso ws1.d_qoy = SOME 1
        andalso ws1.d_year = SOME 2000
        andalso ws1.ca_county = ws2.ca_county
        andalso ws2.d_qoy = SOME 2
        andalso ws2.d_year = SOME 2000
        andalso ws1.ca_county = ws3.ca_county
        andalso ws3.d_qoy = SOME 3
        andalso ws3.d_year = SOME 2000
        andalso ratio (ss2.store_sales, ss1.store_sales) <> NONE
        andalso ratio (ws2.web_sales, ws1.web_sales)
          > ratio (ss2.store_sales, ss1.store_sales)
        andalso ratio (ss3.store_sales, ss2.store_sales) <> NONE
        andalso ratio (ws3.web_sales, ws2.web_sales)
          > ratio (ss3.store_sales, ss2.store_sales)
      yield {ss1.ca_county, ss1.d_year,
        web_q1_q2_increase = divide (ws2.web_sales, ws1.web_sales),
        store_q1_q2_increase = divide (ss2.store_sales, ss1.store_sales),
        web_q2_q3_increase = divide (ws3.web_sales, ws2.web_sales),
        store_q2_q3_increase = divide (ss3.store_sales, ss2.store_sales)}
      order ca_county
  end;
> val q31 = fn
>   : unit
>      -> {ca_county:string option, d_year:int option,
>           store_q1_q2_increase:decimal option,
>           store_q2_q3_increase:decimal option,
>           web_q1_q2_increase:decimal option,
>           web_q2_q3_increase:decimal option} list
val r31 = q31 ();
> ca_county d_year store_q1_q2_increase store_q2_q3_increase web_q1_q2_increase web_q2_q3_increase
> --------- ------ -------------------- -------------------- ------------------ ------------------
>
> val r31 : {ca_county:string option, d_year:int option, store_q1_q2_increase:decimal option, store_q2_q3_increase:decimal option, web_q1_q2_increase:decimal option, web_q2_q3_increase:decimal option} list

(* --- q33 -------------------------------------------------------- *)
