(* --- q76 -------------------------------------------------------- *)
(*
SELECT
  channel,
  col_name,
  d_year,
  d_qoy,
  i_category,
  COUNT(*) sales_cnt,
  SUM(ext_sales_price) sales_amt
FROM (
       SELECT
         'store' AS channel,
         ss_store_sk col_name,
         d_year,
         d_qoy,
         i_category,
         ss_ext_sales_price ext_sales_price
       FROM store_sales, item, date_dim
       WHERE ss_store_sk IS NULL
         AND ss_sold_date_sk = d_date_sk
         AND ss_item_sk = i_item_sk
       UNION ALL
       SELECT
         'web' AS channel,
         ws_ship_customer_sk col_name,
         d_year,
         d_qoy,
         i_category,
         ws_ext_sales_price ext_sales_price
       FROM web_sales, item, date_dim
       WHERE ws_ship_customer_sk IS NULL
         AND ws_sold_date_sk = d_date_sk
         AND ws_item_sk = i_item_sk
       UNION ALL
       SELECT
         'catalog' AS channel,
         cs_ship_addr_sk col_name,
         d_year,
         d_qoy,
         i_category,
         cs_ext_sales_price ext_sales_price
       FROM catalog_sales, item, date_dim
       WHERE cs_ship_addr_sk IS NULL
         AND cs_sold_date_sk = d_date_sk
         AND cs_item_sk = i_item_sk) foo
GROUP BY channel, col_name, d_year, d_qoy, i_category
ORDER BY channel, col_name, d_year, d_qoy, i_category
LIMIT 100
*)
fun q76 () =
  from foo in (
      from ss in tpcds.store_sales,
          i in tpcds.item,
          d in tpcds.date_dim
        where ss.ss_store_sk = NONE
          andalso ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_item_sk = i.i_item_sk
        yield {channel = "store", col_name = ss.ss_store_sk, d.d_year,
          d.d_qoy, i.i_category, ext_sales_price = ss.ss_ext_sales_price})
    union
      (from ws in tpcds.web_sales,
          i in tpcds.item,
          d in tpcds.date_dim
        where ws.ws_ship_customer_sk = NONE
          andalso ws.ws_sold_date_sk = SOME d.d_date_sk
          andalso ws.ws_item_sk = i.i_item_sk
        yield {channel = "web", col_name = ws.ws_ship_customer_sk, d.d_year,
          d.d_qoy, i.i_category, ext_sales_price = ws.ws_ext_sales_price}),
      (from cs in tpcds.catalog_sales,
          i in tpcds.item,
          d in tpcds.date_dim
        where cs.cs_ship_addr_sk = NONE
          andalso cs.cs_sold_date_sk = SOME d.d_date_sk
          andalso cs.cs_item_sk = i.i_item_sk
        yield {channel = "catalog", col_name = cs.cs_ship_addr_sk, d.d_year,
          d.d_qoy, i.i_category, ext_sales_price = cs.cs_ext_sales_price})
    group {foo.channel, foo.col_name, foo.d_year, foo.d_qoy, foo.i_category}
      compute {sales_cnt = count over (),
        sales_amt = sum over foo.ext_sales_price}
    order (channel, col_name, d_year, d_qoy, i_category)
    take 100;
> val q76 = fn
>   : unit
>      -> {channel:string, col_name:int option, d_qoy:int option,
