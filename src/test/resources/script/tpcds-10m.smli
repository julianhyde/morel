(* --- q93 -------------------------------------------------------- *)
(*
SELECT
  ss_customer_sk,
  sum(act_sales) sumsales
FROM (SELECT
  ss_item_sk,
  ss_ticket_number,
  ss_customer_sk,
  CASE WHEN sr_return_quantity IS NOT NULL
    THEN (ss_quantity - sr_return_quantity) * ss_sales_price
  ELSE (ss_quantity * ss_sales_price) END act_sales
FROM store_sales
  LEFT OUTER JOIN store_returns
    ON (sr_item_sk = ss_item_sk AND sr_ticket_number = ss_ticket_number)
  ,
  reason
WHERE sr_reason_sk = r_reason_sk AND r_reason_desc = 'reason 28') t
GROUP BY ss_customer_sk
ORDER BY sumsales, ss_customer_sk
LIMIT 100
*)
fun q93 () =
  from t in (
      from ss in tpcds.store_sales
        left join sr in tpcds.store_returns
          on sr.sr_item_sk = ss.ss_item_sk
            andalso sr.sr_ticket_number = ss.ss_ticket_number,
        r in tpcds.reason
        where Option.`join` sr?.sr_reason_sk = SOME r.r_reason_sk
          andalso r.r_reason_desc = SOME "reason 28"
        yield {ss.ss_item_sk, ss.ss_ticket_number, ss.ss_customer_sk,
          act_sales =
            case (ss.ss_quantity, Option.`join` sr?.sr_return_quantity,
                ss.ss_sales_price) of
                (SOME q, SOME rq, SOME p) =>
                  SOME (Decimal.fromInt (q - rq) * p)
              | (SOME q, NONE, SOME p) => SOME (Decimal.fromInt q * p)
              | _ => NONE})
    group t.ss_customer_sk compute {sumsales = sumSome over t.act_sales}
    order (sumsales, ss_customer_sk)
    take 100;
> val q93 = fn
>   : unit -> {ss_customer_sk:int option, sumsales:decimal option} list
val r93 = q93 ();
> ss_customer_sk sumsales
> -------------- --------
>
> val r93 : {ss_customer_sk:int option, sumsales:decimal option} list

(* --- q94 -------------------------------------------------------- *)
(*
SELECT
  count(DISTINCT ws_order_number) AS `order count `,
  sum(ws_ext_ship_cost) AS `total shipping cost `,
  sum(ws_net_profit) AS `total net profit `
FROM
  web_sales ws1, date_dim, customer_address, web_site
WHERE
  d_date BETWEEN '1999-02-01' AND
  (CAST('1999-02-01' AS DATE) + INTERVAL 60 days)
    AND ws1.ws_ship_date_sk = d_date_sk
    AND ws1.ws_ship_addr_sk = ca_address_sk
    AND ca_state = 'IL'
    AND ws1.ws_web_site_sk = web_site_sk
    AND web_company_name = 'pri'
    AND EXISTS(SELECT *
               FROM web_sales ws2
               WHERE ws1.ws_order_number = ws2.ws_order_number
                 AND ws1.ws_warehouse_sk <> ws2.ws_warehouse_sk)
    AND NOT EXISTS(SELECT *
                   FROM web_returns wr1
                   WHERE ws1.ws_order_number = wr1.wr_order_number)
ORDER BY count(DISTINCT ws_order_number)
LIMIT 100
*)
fun q94 () =
  from ws1 in tpcds.web_sales,
      d in tpcds.date_dim,
      ca in tpcds.customer_address,
      web in tpcds.web_site
    where d.d_date >= SOME (day (1999, Feb, 1))
      andalso d.d_date <= SOME (day (1999, Feb, 1 + 60))
      andalso ws1.ws_ship_date_sk = SOME d.d_date_sk
      andalso ws1.ws_ship_addr_sk = SOME ca.ca_address_sk
      andalso ca.ca_state = SOME "IL"
      andalso ws1.ws_web_site_sk = SOME web.web_site_sk
      andalso web.web_company_name = SOME "pri"
      andalso (exists ws2 in tpcds.web_sales
        where ws1.ws_order_number = ws2.ws_order_number
          andalso ws1.ws_warehouse_sk <> NONE
          andalso ws2.ws_warehouse_sk <> NONE
          andalso ws1.ws_warehouse_sk <> ws2.ws_warehouse_sk)
      andalso not (exists wr1 in tpcds.web_returns
        where ws1.ws_order_number = wr1.wr_order_number)
    compute {
      `order count ` =
        (fn orders => count (from n in orders distinct))
          over ws1.ws_order_number,
      `total shipping cost ` = sumSome over ws1.ws_ext_ship_cost,
      `total net profit ` = sumSome over ws1.ws_net_profit};
> val q94 = fn
>   : unit
>      -> {`order count `:int, `total net profit `:decimal option,
>           `total shipping cost `:decimal option}
val r94 = q94 ();
> val r94 =
>   {`order count `=0,`total net profit `=NONE,`total shipping cost `=NONE}
>   : {`order count `:int, `total net profit `:decimal option,
>       `total shipping cost `:decimal option}

(* --- q95 -------------------------------------------------------- *)
(*
WITH ws_wh AS
(SELECT
    ws1.ws_order_number,
    ws1.ws_warehouse_sk wh1,
    ws2.ws_warehouse_sk wh2
  FROM web_sales ws1, web_sales ws2
  WHERE ws1.ws_order_number = ws2.ws_order_number
    AND ws1.ws_warehouse_sk <> ws2.ws_warehouse_sk)
SELECT
  count(DISTINCT ws_order_number) AS `order count `,
  sum(ws_ext_ship_cost) AS `total shipping cost `,
  sum(ws_net_profit) AS `total net profit `
FROM
  web_sales ws1, date_dim, customer_address, web_site
WHERE
  d_date BETWEEN '1999-02-01' AND
  (CAST('1999-02-01' AS DATE) + INTERVAL 60 DAY)
    AND ws1.ws_ship_date_sk = d_date_sk
    AND ws1.ws_ship_addr_sk = ca_address_sk
    AND ca_state = 'IL'
    AND ws1.ws_web_site_sk = web_site_sk
    AND web_company_name = 'pri'
    AND ws1.ws_order_number IN (SELECT ws_order_number
  FROM ws_wh)
    AND ws1.ws_order_number IN (SELECT wr_order_number
  FROM web_returns, ws_wh
  WHERE wr_order_number = ws_wh.ws_order_number)
ORDER BY count(DISTINCT ws_order_number)
LIMIT 100
*)
fun q95 () =
  let
    val ws_wh =
      from ws1 in tpcds.web_sales,
          ws2 in tpcds.web_sales
        where ws1.ws_order_number = ws2.ws_order_number
          andalso ws1.ws_warehouse_sk <> NONE
          andalso ws2.ws_warehouse_sk <> NONE
          andalso ws1.ws_warehouse_sk <> ws2.ws_warehouse_sk
        yield {ws1.ws_order_number, wh1 = ws1.ws_warehouse_sk,
          wh2 = ws2.ws_warehouse_sk}
    val wh_orders = from w in ws_wh yield w.ws_order_number
    val returned_orders =
      from wr in tpcds.web_returns,
          w in ws_wh
        where wr.wr_order_number = w.ws_order_number
        yield wr.wr_order_number
  in
    from ws1 in tpcds.web_sales,
        d in tpcds.date_dim,
        ca in tpcds.customer_address,
        web in tpcds.web_site
      where d.d_date >= SOME (day (1999, Feb, 1))
        andalso d.d_date <= SOME (day (1999, Feb, 1 + 60))
        andalso ws1.ws_ship_date_sk = SOME d.d_date_sk
        andalso ws1.ws_ship_addr_sk = SOME ca.ca_address_sk
        andalso ca.ca_state = SOME "IL"
        andalso ws1.ws_web_site_sk = SOME web.web_site_sk
        andalso web.web_company_name = SOME "pri"
        andalso ws1.ws_order_number elem wh_orders
        andalso ws1.ws_order_number elem returned_orders
      compute {
        `order count ` =
          (fn orders => count (from n in orders distinct))
            over ws1.ws_order_number,
        `total shipping cost ` = sumSome over ws1.ws_ext_ship_cost,
        `total net profit ` = sumSome over ws1.ws_net_profit}
  end;
> val q95 = fn
>   : unit
>      -> {`order count `:int, `total net profit `:decimal option,
>           `total shipping cost `:decimal option}
val r95 = q95 ();
> val r95 =
>   {`order count `=0,`total net profit `=NONE,`total shipping cost `=NONE}
>   : {`order count `:int, `total net profit `:decimal option,
>       `total shipping cost `:decimal option}

