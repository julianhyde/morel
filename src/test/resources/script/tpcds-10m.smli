(* --- q82 -------------------------------------------------------- *)
(*
SELECT
  i_item_id,
  i_item_desc,
  i_current_price
FROM item, inventory, date_dim, store_sales
WHERE i_current_price BETWEEN 62 AND 62 + 30
  AND inv_item_sk = i_item_sk
  AND d_date_sk = inv_date_sk
  AND d_date BETWEEN cast('2000-05-25' AS DATE) AND (cast('2000-05-25' AS DATE) + INTERVAL 60 days)
  AND i_manufact_id IN (129, 270, 821, 423)
  AND inv_quantity_on_hand BETWEEN 100 AND 500
  AND ss_item_sk = i_item_sk
GROUP BY i_item_id, i_item_desc, i_current_price
ORDER BY i_item_id
LIMIT 100
*)
fun q82 () =
  let
    fun day (year, month, day) =
      Date.date {year, month, day, hour = 0, minute = 0, second = 0,
        offset = SOME Time.zeroTime}
  in
    from i in tpcds.item,
        inv in tpcds.inventory,
        d in tpcds.date_dim,
        ss in tpcds.store_sales
      where i.i_current_price >= SOME (Decimal.fromInt 62)
        andalso i.i_current_price <= SOME (Decimal.fromInt (62 + 30))
        andalso inv.inv_item_sk = i.i_item_sk
        andalso inv.inv_date_sk = d.d_date_sk
        andalso d.d_date >= SOME (day (2000, May, 25))
        andalso d.d_date <= SOME (day (2000, May, 25 + 60))
        andalso i.i_manufact_id elem [SOME 129, SOME 270, SOME 821, SOME 423]
        andalso inv.inv_quantity_on_hand >= SOME 100
        andalso inv.inv_quantity_on_hand <= SOME 500
        andalso ss.ss_item_sk = i.i_item_sk
      group {i.i_item_id, i.i_item_desc, i.i_current_price}
      order i_item_id
      take 100
  end;
> val q82 = fn
>   : unit
>      -> {i_current_price:decimal option, i_item_desc:string option,
>           i_item_id:string} list
val r82 = q82 ();
> i_current_price i_item_desc i_item_id
> --------------- ----------- ---------
>
> val r82 : {i_current_price:decimal option, i_item_desc:string option, i_item_id:string} list

(* --- q83 -------------------------------------------------------- *)
(*
WITH sr_items AS
(SELECT
    i_item_id item_id,
    sum(sr_return_quantity) sr_item_qty
  FROM store_returns, item, date_dim
  WHERE sr_item_sk = i_item_sk
    AND d_date IN (SELECT d_date
  FROM date_dim
  WHERE d_week_seq IN
    (SELECT d_week_seq
    FROM date_dim
    WHERE d_date IN ('2000-06-30', '2000-09-27', '2000-11-17')))
    AND sr_returned_date_sk = d_date_sk
  GROUP BY i_item_id),
    cr_items AS
  (SELECT
    i_item_id item_id,
    sum(cr_return_quantity) cr_item_qty
  FROM catalog_returns, item, date_dim
  WHERE cr_item_sk = i_item_sk
    AND d_date IN (SELECT d_date
  FROM date_dim
  WHERE d_week_seq IN
    (SELECT d_week_seq
    FROM date_dim
    WHERE d_date IN ('2000-06-30', '2000-09-27', '2000-11-17')))
    AND cr_returned_date_sk = d_date_sk
  GROUP BY i_item_id),
    wr_items AS
  (SELECT
    i_item_id item_id,
    sum(wr_return_quantity) wr_item_qty
  FROM web_returns, item, date_dim
  WHERE wr_item_sk = i_item_sk AND d_date IN
    (SELECT d_date
    FROM date_dim
    WHERE d_week_seq IN
      (SELECT d_week_seq
      FROM date_dim
      WHERE d_date IN ('2000-06-30', '2000-09-27', '2000-11-17')))
    AND wr_returned_date_sk = d_date_sk
  GROUP BY i_item_id)
SELECT
  sr_items.item_id,
  sr_item_qty,
  sr_item_qty / (sr_item_qty + cr_item_qty + wr_item_qty) / 3.0 * 100 sr_dev,
  cr_item_qty,
  cr_item_qty / (sr_item_qty + cr_item_qty + wr_item_qty) / 3.0 * 100 cr_dev,
  wr_item_qty,
  wr_item_qty / (sr_item_qty + cr_item_qty + wr_item_qty) / 3.0 * 100 wr_dev,
  (sr_item_qty + cr_item_qty + wr_item_qty) / 3.0 average
FROM sr_items, cr_items, wr_items
WHERE sr_items.item_id = cr_items.item_id
  AND sr_items.item_id = wr_items.item_id
ORDER BY sr_items.item_id, sr_item_qty
LIMIT 100
*)
fun q83 () =
  let
    fun day (year, month, day) =
      Date.date {year, month, day, hour = 0, minute = 0, second = 0,
        offset = SOME Time.zeroTime}
    val weeks =
      from d in tpcds.date_dim
        where d.d_date elem [SOME (day (2000, Jun, 30)),
          SOME (day (2000, Sep, 27)), SOME (day (2000, Nov, 17))]
        yield d.d_week_seq
    val dates =
      from d in tpcds.date_dim
        where d.d_week_seq <> NONE andalso d.d_week_seq elem weeks
        yield d.d_date
    val sr_items =
      from sr in tpcds.store_returns,
          i in tpcds.item,
          d in tpcds.date_dim
        where sr.sr_item_sk = i.i_item_sk
          andalso d.d_date elem dates
          andalso sr.sr_returned_date_sk = SOME d.d_date_sk
        group {item_id = i.i_item_id}
          compute {sr_item_qty = sumSome over sr.sr_return_quantity}
    val cr_items =
      from cr in tpcds.catalog_returns,
          i in tpcds.item,
          d in tpcds.date_dim
        where cr.cr_item_sk = i.i_item_sk
          andalso d.d_date elem dates
          andalso cr.cr_returned_date_sk = SOME d.d_date_sk
        group {item_id = i.i_item_id}
          compute {cr_item_qty = sumSome over cr.cr_return_quantity}
    val wr_items =
      from wr in tpcds.web_returns,
          i in tpcds.item,
          d in tpcds.date_dim
        where wr.wr_item_sk = i.i_item_sk
          andalso d.d_date elem dates
          andalso wr.wr_returned_date_sk = SOME d.d_date_sk
        group {item_id = i.i_item_id}
          compute {wr_item_qty = sumSome over wr.wr_return_quantity}
    fun ratio (q, total) =
      case (q, total) of
          (SOME q, SOME t) =>
            SOME (Real.fromInt q / Real.fromInt t / 3.0 * 100.0)
        | _ => NONE
  in
    from sr in sr_items,
        cr in cr_items,
        wr in wr_items
      where sr.item_id = cr.item_id
        andalso sr.item_id = wr.item_id
      yield {sr, cr, wr,
        total =
          case (sr.sr_item_qty, cr.cr_item_qty, wr.wr_item_qty) of
              (SOME s, SOME c, SOME w) => SOME (s + c + w)
            | _ => NONE}
      yield {sr.item_id, sr.sr_item_qty,
        sr_dev = ratio (sr.sr_item_qty, total),
        cr.cr_item_qty,
        cr_dev = ratio (cr.cr_item_qty, total),
        wr.wr_item_qty,
        wr_dev = ratio (wr.wr_item_qty, total),
        average =
          Option.map (fn t => Decimal.fromInt t / decimal "3.0") total}
      order (item_id, sr_item_qty)
      take 100
  end;
> val q83 = fn
>   : unit
>      -> {average:decimal option, cr_dev:real option, cr_item_qty:int option,
>           item_id:string, sr_dev:real option, sr_item_qty:int option,
>           wr_dev:real option, wr_item_qty:int option} list
val r83 = q83 ();
> average cr_dev cr_item_qty item_id sr_dev sr_item_qty wr_dev wr_item_qty
> ------- ------ ----------- ------- ------ ----------- ------ -----------
>
> val r83 : {average:decimal option, cr_dev:real option, cr_item_qty:int option, item_id:string, sr_dev:real option, sr_item_qty:int option, wr_dev:real option, wr_item_qty:int option} list

(* --- q84 -------------------------------------------------------- *)
(*
SELECT
  c_customer_id AS customer_id,
  concat(c_last_name, ', ', c_first_name) AS customername
FROM customer
  , customer_address
  , customer_demographics
  , household_demographics
  , income_band
  , store_returns
WHERE ca_city = 'Edgewood'
  AND c_current_addr_sk = ca_address_sk
  AND ib_lower_bound >= 38128
  AND ib_upper_bound <= 38128 + 50000
  AND ib_income_band_sk = hd_income_band_sk
  AND cd_demo_sk = c_current_cdemo_sk
  AND hd_demo_sk = c_current_hdemo_sk
  AND sr_cdemo_sk = cd_demo_sk
ORDER BY c_customer_id
LIMIT 100
*)
fun q84 () =
  from c in tpcds.customer,
      ca in tpcds.customer_address,
      cd in tpcds.customer_demographics,
      hd in tpcds.household_demographics,
      ib in tpcds.income_band,
      sr in tpcds.store_returns
    where ca.ca_city = SOME "Edgewood"
      andalso c.c_current_addr_sk = SOME ca.ca_address_sk
      andalso ib.ib_lower_bound >= SOME 38128
      andalso Option.isSome ib.ib_upper_bound
      andalso ib.ib_upper_bound <= SOME (38128 + 50000)
      andalso hd.hd_income_band_sk = SOME ib.ib_income_band_sk
      andalso c.c_current_cdemo_sk = SOME cd.cd_demo_sk
      andalso c.c_current_hdemo_sk = SOME hd.hd_demo_sk
      andalso sr.sr_cdemo_sk = SOME cd.cd_demo_sk
    yield {customer_id = c.c_customer_id,
      customername =
        case (c.c_last_name, c.c_first_name) of
            (SOME l, SOME f) => SOME (l ^ ", " ^ f)
          | _ => NONE}
    order customer_id
    take 100;
> val q84 = fn : unit -> {customer_id:string, customername:string option} list
val r84 = q84 ();
> customer_id customername
> ----------- ------------
>
> val r84 : {customer_id:string, customername:string option} list

(* --- q85 -------------------------------------------------------- *)
(*
SELECT
  substr(r_reason_desc, 1, 20),
  avg(ws_quantity),
  avg(wr_refunded_cash),
  avg(wr_fee)
FROM web_sales, web_returns, web_page, customer_demographics cd1,
  customer_demographics cd2, customer_address, date_dim, reason
WHERE ws_web_page_sk = wp_web_page_sk
  AND ws_item_sk = wr_item_sk
  AND ws_order_number = wr_order_number
  AND ws_sold_date_sk = d_date_sk AND d_year = 2000
  AND cd1.cd_demo_sk = wr_refunded_cdemo_sk
  AND cd2.cd_demo_sk = wr_returning_cdemo_sk
  AND ca_address_sk = wr_refunded_addr_sk
  AND r_reason_sk = wr_reason_sk
  AND
  (
    (
      cd1.cd_marital_status = 'M'
        AND
        cd1.cd_marital_status = cd2.cd_marital_status
        AND
        cd1.cd_education_status = 'Advanced Degree'
        AND
        cd1.cd_education_status = cd2.cd_education_status
        AND
        ws_sales_price BETWEEN 100.00 AND 150.00
    )
      OR
      (
        cd1.cd_marital_status = 'S'
          AND
          cd1.cd_marital_status = cd2.cd_marital_status
          AND
          cd1.cd_education_status = 'College'
          AND
          cd1.cd_education_status = cd2.cd_education_status
          AND
          ws_sales_price BETWEEN 50.00 AND 100.00
      )
      OR
      (
        cd1.cd_marital_status = 'W'
          AND
          cd1.cd_marital_status = cd2.cd_marital_status
          AND
          cd1.cd_education_status = '2 yr Degree'
          AND
          cd1.cd_education_status = cd2.cd_education_status
          AND
          ws_sales_price BETWEEN 150.00 AND 200.00
      )
  )
  AND
  (
    (
      ca_country = 'United States'
        AND
        ca_state IN ('IN', 'OH', 'NJ')
        AND ws_net_profit BETWEEN 100 AND 200
    )
      OR
      (
        ca_country = 'United States'
          AND
          ca_state IN ('WI', 'CT', 'KY')
          AND ws_net_profit BETWEEN 150 AND 300
      )
      OR
      (
        ca_country = 'United States'
          AND
          ca_state IN ('LA', 'IA', 'AR')
          AND ws_net_profit BETWEEN 50 AND 250
      )
  )
GROUP BY r_reason_desc
ORDER BY substr(r_reason_desc, 1, 20)
  , avg(ws_quantity)
  , avg(wr_refunded_cash)
  , avg(wr_fee)
LIMIT 100
*)
(* As in q48, each disjunct of the SQL's "OR"s repeats a join
 * condition; the conditions are factored by hand. *)
fun q85 () =
  let
    fun between (x, lo, hi) =
      x >= SOME (Decimal.fromInt lo) andalso x <= SOME (Decimal.fromInt hi)
  in
    from ws in tpcds.web_sales,
        wp in tpcds.web_page,
        wr in tpcds.web_returns,
        cd1 in tpcds.customer_demographics,
        cd2 in tpcds.customer_demographics,
        ca in tpcds.customer_address,
        d in tpcds.date_dim,
        r in tpcds.reason
      where ws.ws_web_page_sk = SOME wp.wp_web_page_sk
        andalso ws.ws_item_sk = wr.wr_item_sk
        andalso ws.ws_order_number = wr.wr_order_number
        andalso ws.ws_sold_date_sk = SOME d.d_date_sk
        andalso d.d_year = SOME 2000
        andalso wr.wr_refunded_cdemo_sk = SOME cd1.cd_demo_sk
        andalso wr.wr_returning_cdemo_sk = SOME cd2.cd_demo_sk
        andalso cd1.cd_marital_status <> NONE
        andalso cd1.cd_marital_status = cd2.cd_marital_status
        andalso cd1.cd_education_status <> NONE
        andalso cd1.cd_education_status = cd2.cd_education_status
        andalso (cd1.cd_marital_status = SOME "M"
            andalso cd1.cd_education_status = SOME "Advanced Degree"
            andalso between (ws.ws_sales_price, 100, 150)
          orelse cd1.cd_marital_status = SOME "S"
            andalso cd1.cd_education_status = SOME "College"
            andalso between (ws.ws_sales_price, 50, 100)
          orelse cd1.cd_marital_status = SOME "W"
            andalso cd1.cd_education_status = SOME "2 yr Degree"
            andalso between (ws.ws_sales_price, 150, 200))
        andalso wr.wr_refunded_addr_sk = SOME ca.ca_address_sk
        andalso ca.ca_country = SOME "United States"
        andalso (ca.ca_state elem [SOME "IN", SOME "OH", SOME "NJ"]
            andalso between (ws.ws_net_profit, 100, 200)
          orelse ca.ca_state elem [SOME "WI", SOME "CT", SOME "KY"]
            andalso between (ws.ws_net_profit, 150, 300)
          orelse ca.ca_state elem [SOME "LA", SOME "IA", SOME "AR"]
            andalso between (ws.ws_net_profit, 50, 250))
        andalso wr.wr_reason_sk = SOME r.r_reason_sk
      group r.r_reason_desc
        compute {`avg(ws_quantity)` = avgSome over ws.ws_quantity,
          `avg(wr_refunded_cash)` = avgSome over wr.wr_refunded_cash,
          `avg(wr_fee)` = avgSome over wr.wr_fee}
      yield {reason =
          Option.map (fn s => String.substring (s, 0, Int.min (20, size s)))
            r_reason_desc,
        `avg(ws_quantity)`, `avg(wr_refunded_cash)`, `avg(wr_fee)`}
      order (reason, `avg(ws_quantity)`, `avg(wr_refunded_cash)`,
        `avg(wr_fee)`)
      take 100
  end;
> val q85 = fn
>   : unit
>      -> {avg(wr_fee):decimal option, avg(wr_refunded_cash):decimal option,
>           avg(ws_quantity):real option, reason:string option} list
val r85 = q85 ();
> avg(wr_fee) avg(wr_refunded_cash) avg(ws_quantity) reason
> ----------- --------------------- ---------------- ------
>
> val r85 : {avg(wr_fee):decimal option, avg(wr_refunded_cash):decimal option, avg(ws_quantity):real option, reason:string option} list

(* --- q86 -------------------------------------------------------- *)
(*
SELECT
  sum(ws_net_paid) AS total_sum,
  i_category,
  i_class,
  grouping(i_category) + grouping(i_class) AS lochierarchy,
  rank()
  OVER (
    PARTITION BY grouping(i_category) + grouping(i_class),
      CASE WHEN grouping(i_class) = 0
        THEN i_category END
    ORDER BY sum(ws_net_paid) DESC) AS rank_within_parent
FROM
  web_sales, date_dim d1, item
WHERE
  d1.d_month_seq BETWEEN 1200 AND 1200 + 11
    AND d1.d_date_sk = ws_sold_date_sk
    AND i_item_sk = ws_item_sk
GROUP BY ROLLUP (i_category, i_class)
ORDER BY
  lochierarchy DESC,
  CASE WHEN lochierarchy = 0
    THEN i_category END,
  rank_within_parent
LIMIT 100
*)
(* "GROUP BY ROLLUP", as in q22. "rank() OVER (PARTITION BY p ORDER BY
 * m)" is one more than the number of rows in the row's partition whose
 * "m" comes before its own (descending); NONE is less than any SOME, so it
 * is first ascending and last descending, as Spark's nulls are. *)
fun q86 () =
  let
    val base =
      from ws in tpcds.web_sales,
          d1 in tpcds.date_dim,
          i in tpcds.item
        where d1.d_month_seq >= SOME 1200
          andalso d1.d_month_seq <= SOME (1200 + 11)
          andalso ws.ws_sold_date_sk = SOME d1.d_date_sk
          andalso ws.ws_item_sk = i.i_item_sk
        yield {i.i_category, i.i_class, ws.ws_net_paid}
    val rolled =
      from r in (from b in base
          group {b.i_category, b.i_class}
            compute {total = sumSome over b.ws_net_paid}
          yield {i_category, i_class, g1 = 0, g2 = 0, total})
        union
          (from b in base
              group {b.i_category}
                compute {total = sumSome over b.ws_net_paid}
              yield {i_category, i_class = NONE, g1 = 0, g2 = 1, total}),
          (from b in base
              group {}
                compute {total = sumSome over b.ws_net_paid}
              yield {i_category = NONE, i_class = NONE, g1 = 1, g2 = 1, total})
      yield {total_sum = r.total, r.i_category, r.i_class,
        lochierarchy = r.g1 + r.g2,
        parent = if r.g2 = 0 then r.i_category else NONE}
  in
    from r in rolled
      yield {r.total_sum, r.i_category, r.i_class, r.lochierarchy,
        rank_within_parent =
          1 + count (from s in rolled
            where s.lochierarchy = r.lochierarchy
              andalso s.parent = r.parent
              andalso s.total_sum > r.total_sum)}
      order (DESC lochierarchy,
        if lochierarchy = 0 then i_category else NONE, rank_within_parent)
      take 100
  end;
> val q86 = fn
>   : unit
>      -> {i_category:string option, i_class:string option, lochierarchy:int,
>           rank_within_parent:int, total_sum:decimal option} list
val r86 = q86 ();
> i_category  i_class lochierarchy rank_within_parent total_sum
> ----------- ------- ------------ ------------------ ----------
>                                2                  1 5189585.33
> Men                            1                  1  655046.32
> Women                          1                  2  626624.82
> Books                          1                  3  581067.68
> Music                          1                  4  561790.19
> Shoes                          1                  5  510840.54
> Electronics                    1                  6  495178.04
> Jewelry                        1                  7  472123.12
> Children                       1                  8  459386.12
> Sports                         1                  9  405665.89
> ...
>
> val r86 : {i_category:string option, i_class:string option, lochierarchy:int, rank_within_parent:int, total_sum:decimal option} list

(* --- q87 -------------------------------------------------------- *)
(*
SELECT count(*)
FROM ((SELECT DISTINCT
  c_last_name,
  c_first_name,
  d_date
FROM store_sales, date_dim, customer
WHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk
  AND store_sales.ss_customer_sk = customer.c_customer_sk
  AND d_month_seq BETWEEN 1200 AND 1200 + 11)
      EXCEPT
      (SELECT DISTINCT
        c_last_name,
        c_first_name,
        d_date
      FROM catalog_sales, date_dim, customer
      WHERE catalog_sales.cs_sold_date_sk = date_dim.d_date_sk
        AND catalog_sales.cs_bill_customer_sk = customer.c_customer_sk
        AND d_month_seq BETWEEN 1200 AND 1200 + 11)
      EXCEPT
      (SELECT DISTINCT
        c_last_name,
        c_first_name,
        d_date
      FROM web_sales, date_dim, customer
      WHERE web_sales.ws_sold_date_sk = date_dim.d_date_sk
        AND web_sales.ws_bill_customer_sk = customer.c_customer_sk
        AND d_month_seq BETWEEN 1200 AND 1200 + 11)
     ) cool_cust
*)
fun q87 () =
  from r in (
      from ss in tpcds.store_sales,
          d in tpcds.date_dim,
          c in tpcds.customer
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_customer_sk = SOME c.c_customer_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        yield {c.c_last_name, c.c_first_name, d.d_date})
    except distinct
      (from cs in tpcds.catalog_sales,
          d in tpcds.date_dim,
          c in tpcds.customer
        where cs.cs_sold_date_sk = SOME d.d_date_sk
          andalso cs.cs_bill_customer_sk = SOME c.c_customer_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        yield {c.c_last_name, c.c_first_name, d.d_date}),
      (from ws in tpcds.web_sales,
          d in tpcds.date_dim,
          c in tpcds.customer
        where ws.ws_sold_date_sk = SOME d.d_date_sk
          andalso ws.ws_bill_customer_sk = SOME c.c_customer_sk
          andalso d.d_month_seq >= SOME 1200
          andalso d.d_month_seq <= SOME (1200 + 11)
        yield {c.c_last_name, c.c_first_name, d.d_date})
    compute count over ();
> val q87 = fn : unit -> int
val r87 = q87 ();
> val r87 = 1994 : int

