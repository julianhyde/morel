> val r67 : {d_moy:int option, d_qoy:int option, d_year:int option, i_brand:string option, i_category:string option, i_class:string option, i_product_name:string option, rk:int, s_store_id:string option, sumsales:decimal} list

(* --- q68 -------------------------------------------------------- *)
(*
SELECT
  c_last_name,
  c_first_name,
  ca_city,
  bought_city,
  ss_ticket_number,
  extended_price,
  extended_tax,
  list_price
FROM (SELECT
  ss_ticket_number,
  ss_customer_sk,
  ca_city bought_city,
  sum(ss_ext_sales_price) extended_price,
  sum(ss_ext_list_price) list_price,
  sum(ss_ext_tax) extended_tax
FROM store_sales, date_dim, store, household_demographics, customer_address
WHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk
  AND store_sales.ss_store_sk = store.s_store_sk
  AND store_sales.ss_hdemo_sk = household_demographics.hd_demo_sk
  AND store_sales.ss_addr_sk = customer_address.ca_address_sk
  AND date_dim.d_dom BETWEEN 1 AND 2
  AND (household_demographics.hd_dep_count = 4 OR
  household_demographics.hd_vehicle_count = 3)
  AND date_dim.d_year IN (1999, 1999 + 1, 1999 + 2)
  AND store.s_city IN ('Midway', 'Fairview')
GROUP BY ss_ticket_number, ss_customer_sk, ss_addr_sk, ca_city) dn,
  customer,
  customer_address current_addr
WHERE ss_customer_sk = c_customer_sk
  AND customer.c_current_addr_sk = current_addr.ca_address_sk
  AND current_addr.ca_city <> bought_city
ORDER BY c_last_name, ss_ticket_number
LIMIT 100
*)
fun q68 () =
  from dn in (
      from ss in tpcds.store_sales,
          d in tpcds.date_dim,
          s in tpcds.store,
          hd in tpcds.household_demographics,
          ca in tpcds.customer_address
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso ss.ss_hdemo_sk = SOME hd.hd_demo_sk
          andalso ss.ss_addr_sk = SOME ca.ca_address_sk
          andalso d.d_dom >= SOME 1
          andalso d.d_dom <= SOME 2
          andalso (hd.hd_dep_count = SOME 4
            orelse hd.hd_vehicle_count = SOME 3)
          andalso d.d_year elem [SOME 1999, SOME (1999 + 1), SOME (1999 + 2)]
          andalso s.s_city elem [SOME "Midway", SOME "Fairview"]
        group {ss.ss_ticket_number, ss.ss_customer_sk, ss.ss_addr_sk,
            bought_city = ca.ca_city}
          compute {extended_price = sumSome over ss.ss_ext_sales_price,
            list_price = sumSome over ss.ss_ext_list_price,
            extended_tax = sumSome over ss.ss_ext_tax}),
      c in tpcds.customer,
      current_addr in tpcds.customer_address
    where dn.ss_customer_sk = SOME c.c_customer_sk
      andalso c.c_current_addr_sk = SOME current_addr.ca_address_sk
      andalso (case (current_addr.ca_city, dn.bought_city) of
                  (SOME c1, SOME c2) => c1 <> c2
                | _ => false)
    yield {c.c_last_name, c.c_first_name, current_addr.ca_city,
      dn.bought_city, dn.ss_ticket_number, dn.extended_price,
      dn.extended_tax, dn.list_price}
    order (c_last_name, ss_ticket_number)
    take 100;
> val q68 = fn
>   : unit
>      -> {bought_city:string option, c_first_name:string option,
>           c_last_name:string option, ca_city:string option,
>           extended_price:decimal option, extended_tax:decimal option,
>           list_price:decimal option, ss_ticket_number:int} list
val r68 = q68 ();
