>      -> {avg(cd_dep_college_count):real option, avg(cd_dep_count):real option,
>           avg(cd_dep_employed_count):real option, ca_state:string option,
>           cd_dep_college_count:int option, cd_dep_employed_count:int option,
>           cd_gender:string option, cd_marital_status:string option, cnt1:int,
