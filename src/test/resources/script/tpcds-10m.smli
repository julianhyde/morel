(* --- q80 -------------------------------------------------------- *)
(*
WITH ssr AS
(SELECT
    s_store_id AS store_id,
    sum(ss_ext_sales_price) AS sales,
    sum(coalesce(sr_return_amt, 0)) AS returns,
    sum(ss_net_profit - coalesce(sr_net_loss, 0)) AS profit
  FROM store_sales
    LEFT OUTER JOIN store_returns ON
                                    (ss_item_sk = sr_item_sk AND
                                      ss_ticket_number = sr_ticket_number)
    ,
    date_dim, store, item, promotion
  WHERE ss_sold_date_sk = d_date_sk
    AND d_date BETWEEN cast('2000-08-23' AS DATE)
  AND (cast('2000-08-23' AS DATE) + INTERVAL 30 days)
    AND ss_store_sk = s_store_sk
    AND ss_item_sk = i_item_sk
    AND i_current_price > 50
    AND ss_promo_sk = p_promo_sk
    AND p_channel_tv = 'N'
  GROUP BY s_store_id),
    csr AS
  (SELECT
    cp_catalog_page_id AS catalog_page_id,
    sum(cs_ext_sales_price) AS sales,
    sum(coalesce(cr_return_amount, 0)) AS returns,
    sum(cs_net_profit - coalesce(cr_net_loss, 0)) AS profit
  FROM catalog_sales
    LEFT OUTER JOIN catalog_returns ON
                                      (cs_item_sk = cr_item_sk AND
                                        cs_order_number = cr_order_number)
    ,
    date_dim, catalog_page, item, promotion
  WHERE cs_sold_date_sk = d_date_sk
    AND d_date BETWEEN cast('2000-08-23' AS DATE)
  AND (cast('2000-08-23' AS DATE) + INTERVAL 30 days)
    AND cs_catalog_page_sk = cp_catalog_page_sk
    AND cs_item_sk = i_item_sk
    AND i_current_price > 50
    AND cs_promo_sk = p_promo_sk
    AND p_channel_tv = 'N'
  GROUP BY cp_catalog_page_id),
    wsr AS
  (SELECT
    web_site_id,
    sum(ws_ext_sales_price) AS sales,
    sum(coalesce(wr_return_amt, 0)) AS returns,
    sum(ws_net_profit - coalesce(wr_net_loss, 0)) AS profit
  FROM web_sales
    LEFT OUTER JOIN web_returns ON
                                  (ws_item_sk = wr_item_sk AND ws_order_number = wr_order_number)
    ,
    date_dim, web_site, item, promotion
  WHERE ws_sold_date_sk = d_date_sk
    AND d_date BETWEEN cast('2000-08-23' AS DATE)
  AND (cast('2000-08-23' AS DATE) + INTERVAL 30 days)
    AND ws_web_site_sk = web_site_sk
    AND ws_item_sk = i_item_sk
    AND i_current_price > 50
    AND ws_promo_sk = p_promo_sk
    AND p_channel_tv = 'N'
  GROUP BY web_site_id)
SELECT
  channel,
  id,
  sum(sales) AS sales,
  sum(returns) AS returns,
  sum(profit) AS profit
FROM (SELECT
        'store channel' AS channel,
        concat('store', store_id) AS id,
        sales,
        returns,
        profit
      FROM ssr
      UNION ALL
      SELECT
        'catalog channel' AS channel,
        concat('catalog_page', catalog_page_id) AS id,
        sales,
        returns,
        profit
      FROM csr
      UNION ALL
      SELECT
        'web channel' AS channel,
        concat('web_site', web_site_id) AS id,
        sales,
        returns,
        profit
      FROM wsr) x
GROUP BY ROLLUP (channel, id)
ORDER BY channel, id
LIMIT 100
*)
(* "GROUP BY ROLLUP", as in q22; "sum(coalesce(x, 0))" is "sum" of
 * "getOpt (x, 0)". *)
fun q80 () =
  let
    fun day (year, month, day) =
      Date.date {year, month, day, hour = 0, minute = 0, second = 0,
        offset = SOME Time.zeroTime}
    val zero = Decimal.fromInt 0
    (* "a - b" and "a - coalesce(b, 0)", where "a" and "b" may be NONE *)
    fun minus (a : decimal option, b) =
      case (a, b) of
          (SOME a, SOME b) => SOME (a - b)
        | _ => NONE
    fun minus0 (a, b) = Option.map (fn a => a - getOpt (b, zero)) a
    fun inRange d =
      d >= SOME (day (2000, Aug, 23))
      andalso d <= SOME (day (2000, Aug, 23 + 30))
    val ssr =
      from ss in tpcds.store_sales
        left join sr in tpcds.store_returns
          on ss.ss_item_sk = sr.sr_item_sk
            andalso ss.ss_ticket_number = sr.sr_ticket_number,
        d in tpcds.date_dim,
        s in tpcds.store,
        i in tpcds.item,
        p in tpcds.promotion
        where ss.ss_sold_date_sk = SOME d.d_date_sk
          andalso inRange d.d_date
          andalso ss.ss_store_sk = SOME s.s_store_sk
          andalso ss.ss_item_sk = i.i_item_sk
          andalso i.i_current_price > SOME (Decimal.fromInt 50)
          andalso ss.ss_promo_sk = SOME p.p_promo_sk
          andalso p.p_channel_tv = SOME "N"
        group {id = s.s_store_id}
          compute {sales = sumSome over ss.ss_ext_sales_price,
            returns =
              sum over getOpt (Option.`join` sr?.sr_return_amt, zero),
            profit =
              sumSome over minus0 (ss.ss_net_profit,
                Option.`join` sr?.sr_net_loss)}
    val csr =
      from cs in tpcds.catalog_sales
        left join cr in tpcds.catalog_returns
          on cs.cs_item_sk = cr.cr_item_sk
            andalso cs.cs_order_number = cr.cr_order_number,
        d in tpcds.date_dim,
        cp in tpcds.catalog_page,
        i in tpcds.item,
        p in tpcds.promotion
        where cs.cs_sold_date_sk = SOME d.d_date_sk
          andalso inRange d.d_date
          andalso cs.cs_catalog_page_sk = SOME cp.cp_catalog_page_sk
          andalso cs.cs_item_sk = i.i_item_sk
          andalso i.i_current_price > SOME (Decimal.fromInt 50)
          andalso cs.cs_promo_sk = SOME p.p_promo_sk
          andalso p.p_channel_tv = SOME "N"
        group {id = cp.cp_catalog_page_id}
          compute {sales = sumSome over cs.cs_ext_sales_price,
            returns =
              sum over getOpt (Option.`join` cr?.cr_return_amount, zero),
            profit =
              sumSome over minus0 (cs.cs_net_profit,
                Option.`join` cr?.cr_net_loss)}
    val wsr =
      from ws in tpcds.web_sales
        left join wr in tpcds.web_returns
          on ws.ws_item_sk = wr.wr_item_sk
            andalso ws.ws_order_number = wr.wr_order_number,
        d in tpcds.date_dim,
        web in tpcds.web_site,
        i in tpcds.item,
        p in tpcds.promotion
        where ws.ws_sold_date_sk = SOME d.d_date_sk
          andalso inRange d.d_date
          andalso ws.ws_web_site_sk = SOME web.web_site_sk
          andalso ws.ws_item_sk = i.i_item_sk
          andalso i.i_current_price > SOME (Decimal.fromInt 50)
          andalso ws.ws_promo_sk = SOME p.p_promo_sk
          andalso p.p_channel_tv = SOME "N"
        group {id = web.web_site_id}
          compute {sales = sumSome over ws.ws_ext_sales_price,
            returns =
              sum over getOpt (Option.`join` wr?.wr_return_amt, zero),
            profit =
              sumSome over minus0 (ws.ws_net_profit,
                Option.`join` wr?.wr_net_loss)}
    val x =
      (from r in ssr
        yield {channel = SOME "store channel", id = SOME ("store" ^ r.id),
          r.sales, returns = SOME r.returns, r.profit})
      @
      (from r in csr
        yield {channel = SOME "catalog channel",
          id = SOME ("catalog_page" ^ r.id), r.sales,
          returns = SOME r.returns, r.profit})
      @
      (from r in wsr
        yield {channel = SOME "web channel", id = SOME ("web_site" ^ r.id),
          r.sales, returns = SOME r.returns, r.profit})
  in
    from r in (from b in x
          group {b.channel, b.id}
            compute {sales = sumSome over b.sales,
                returns = sumSome over b.returns,
                profit = sumSome over b.profit}
          yield {channel, id, sales, returns, profit})
        union
          (from b in x
              group {b.channel}
                compute {sales = sumSome over b.sales,
                    returns = sumSome over b.returns,
                    profit = sumSome over b.profit}
              yield {channel, id = NONE, sales, returns, profit}),
          (from b in x
              group {}
                compute {sales = sumSome over b.sales,
                    returns = sumSome over b.returns,
                    profit = sumSome over b.profit}
              yield {channel = NONE, id = NONE, sales, returns, profit})
      order (r.channel, r.id)
      take 100
  end;
> val q80 = fn
>   : unit
>      -> {channel:string option, id:string option, profit:decimal option,
>           returns:decimal option, sales:decimal option} list
