FROM inv inv1, inv inv2
WHERE inv1.i_item_sk = inv2.i_item_sk
  AND inv1.w_warehouse_sk = inv2.w_warehouse_sk
  AND inv1.d_moy = 1
  AND inv2.d_moy = 1 + 1
  AND inv1.cov > 1.5
ORDER BY inv1.w_warehouse_sk, inv1.i_item_sk, inv1.d_moy, inv1.mean, inv1.cov
  , inv2.d_moy, inv2.mean, inv2.cov
*)
fun q39b () =
  let
    (* "stddev_samp(x)": the sample standard deviation of the values of
     * the SOMEs, or NONE if there are fewer than two. The sums are exact
     * ints; only the square root is real. *)
    fun stddevSamp xs =
      let
        val vs = somes xs
        val n = count vs
        val s = sum vs
        val s2 = sum (from v in vs yield v * v)
      in
        if n < 2 then NONE
        else
          SOME (Math.sqrt (Real.fromInt (n * s2 - s * s)
            / Real.fromInt (n * (n - 1))))
      end
    (* "a / b" of two reals that may be NONE *)
    fun divide (a, b) =
      case (a, b) of
          (SOME a, SOME b) => SOME (a / b)
        | _ => NONE
    val inv =
      from inv in tpcds.inventory,
          i in tpcds.item,
          w in tpcds.warehouse,
          d in tpcds.date_dim
        where inv.inv_item_sk = i.i_item_sk
          andalso inv.inv_warehouse_sk = w.w_warehouse_sk
          andalso inv.inv_date_sk = d.d_date_sk
          andalso d.d_year = SOME 2001
        group {w.w_warehouse_name, w.w_warehouse_sk, i.i_item_sk, d.d_moy}
          compute {stdev = stddevSamp over inv.inv_quantity_on_hand,
            mean = avgSome over inv.inv_quantity_on_hand}
        (* "CASE mean WHEN 0 THEN NULL ELSE stdev / mean END" *)
        yield {w_warehouse_name, w_warehouse_sk, i_item_sk, d_moy, stdev,
          mean,
          cov = if mean = SOME 0.0 then NONE else divide (stdev, mean)}
        (* "CASE mean WHEN 0 THEN 0 ELSE stdev / mean END > 1" *)
        where (if mean = SOME 0.0 then false else cov > SOME 1.0)
  in
    from inv1 in inv,
        inv2 in inv
      where inv1.i_item_sk = inv2.i_item_sk
        andalso inv1.w_warehouse_sk = inv2.w_warehouse_sk
        andalso inv1.d_moy = SOME 1
        andalso inv2.d_moy = SOME (1 + 1)
        andalso inv1.cov > SOME 1.5
      order (inv1.w_warehouse_sk, inv1.i_item_sk, inv1.d_moy, inv1.mean,
        inv1.cov, inv2.d_moy, inv2.mean, inv2.cov)
      yield {inv1.w_warehouse_sk, inv1.i_item_sk, inv1.d_moy, inv1.mean,
        inv1.cov, w_warehouse_sk_2 = inv2.w_warehouse_sk,
        i_item_sk_2 = inv2.i_item_sk, d_moy_2 = inv2.d_moy,
        mean_2 = inv2.mean, cov_2 = inv2.cov}
  end;
