        jan_net = sumSome over x.jan_net,
        feb_net = sumSome over x.feb_net,
        mar_net = sumSome over x.mar_net,
        apr_net = sumSome over x.apr_net,
        may_net = sumSome over x.may_net,
        jun_net = sumSome over x.jun_net,
        jul_net = sumSome over x.jul_net,
        aug_net = sumSome over x.aug_net,
        sep_net = sumSome over x.sep_net,
        oct_net = sumSome over x.oct_net,
        nov_net = sumSome over x.nov_net,
        dec_net = sumSome over x.dec_net}
      order w_warehouse_name
      take 100
  end;
