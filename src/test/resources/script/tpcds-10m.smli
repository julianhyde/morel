>   : unit
>      -> {catalog_sales_quantity:int option, i_item_desc:string option,
>           i_item_id:string, s_store_id:string, s_store_name:string option,
>           store_returns_quantity:int option, store_sales_quantity:int option}
>         list
val r29 = q29 ();
