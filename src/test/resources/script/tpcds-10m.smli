(* --- q26 -------------------------------------------------------- *)
(*
SELECT
  i_item_id,
  avg(cs_quantity) agg1,
  avg(cs_list_price) agg2,
  avg(cs_coupon_amt) agg3,
  avg(cs_sales_price) agg4
FROM catalog_sales, customer_demographics, date_dim, item, promotion
WHERE cs_sold_date_sk = d_date_sk AND
  cs_item_sk = i_item_sk AND
  cs_bill_cdemo_sk = cd_demo_sk AND
  cs_promo_sk = p_promo_sk AND
  cd_gender = 'M' AND
  cd_marital_status = 'S' AND
  cd_education_status = 'College' AND
  (p_channel_email = 'N' OR p_channel_event = 'N') AND
  d_year = 2000
GROUP BY i_item_id
ORDER BY i_item_id
LIMIT 100
*)
fun q26 () =
  from cs in tpcds.catalog_sales,
      cd in tpcds.customer_demographics,
      d in tpcds.date_dim,
      i in tpcds.item,
      p in tpcds.promotion
    where cs.cs_sold_date_sk = SOME d.d_date_sk
      andalso cs.cs_item_sk = i.i_item_sk
      andalso cs.cs_bill_cdemo_sk = SOME cd.cd_demo_sk
      andalso cs.cs_promo_sk = SOME p.p_promo_sk
      andalso cd.cd_gender = SOME "M"
      andalso cd.cd_marital_status = SOME "S"
      andalso cd.cd_education_status = SOME "College"
      andalso (p.p_channel_email = SOME "N"
        orelse p.p_channel_event = SOME "N")
      andalso d.d_year = SOME 2000
    group i.i_item_id
      compute {agg1 = avgSome over cs.cs_quantity,
        agg2 = avgSome over cs.cs_list_price,
        agg3 = avgSome over cs.cs_coupon_amt,
        agg4 = avgSome over cs.cs_sales_price}
    order i_item_id
    take 100;
