 *
 * Rules over the relational tree.
 *
 * `Sys.planOf` prints the tree the resolver built, before any rule;
 * `Sys.planEx "-1"` prints the tree the compiler is given, after the
 * rules have run. Each case shows both, and runs the query.
 *)
Sys.set ("lineWidth", 78);
> val it = () : unit
Sys.set ("stringDepth", ~1);
> val it = () : unit

(* ---------------------------------------------------------------- *)
(* Unorder pushdown.
 *
 * `unorder` discards its input's order. Pushed down through the nodes
 * that do not depend on order, it meets a `sort` -- whose order it
 * discards, so both go -- or a bag, which has no order to discard.
 *)
val es = [{id = 3, name = "c"}, {id = 1, name = "a"}, {id = 2, name = "b"}];
> val es = [{id=3,name="c"},{id=1,name="a"},{id=2,name="b"}]
>   : {id:int, name:string} list

(*) A sort under an unorder goes.
from e in es order e.id unorder;
> val it = [{id=3,name="c"},{id=1,name="a"},{id=2,name="b"}]
>   : {id:int, name:string} bag
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   unorder : t$0
>     es : t$1
>
> t$0 {id:int, name:string} bag
> t$1 {id:int, name:string} list
> |_} : string
Sys.planOf (from e in es order e.id unorder);
> val it =
>   {_|
> unorder : t$0
>   sort [#id $0] : t$1
>     es : t$1
>
> t$0 {id:int, name:string} bag
> t$1 {id:int, name:string} list
> |_} : string

(*) Through a filter and a projection; the list at the bottom keeps it.
from e in es where e.id > 1 order e.id yield e.name unorder;
> val it = ["c","b"] : string bag
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project [#name $0] : string bag
>     filter [#id $0 > 1] : t$0
>       unorder : t$0
>         es : t$1
>
> t$0 {id:int, name:string} bag
> t$1 {id:int, name:string} list
> |_} : string
Sys.planOf (from e in es where e.id > 1 order e.id yield e.name unorder);
> val it =
>   {_|
> unorder : string bag
>   project [#name $0] : string list
>     sort [#id $0] : t$0
>       filter [#id $0 > 1] : t$0
>         es : t$0
>
> t$0 {id:int, name:string} list
> |_} : string

(*) Not through a skip or a take, which depend on order.
from e in es order e.id skip 1 unorder;
> val it = [{id=2,name="b"},{id=3,name="c"}] : {id:int, name:string} bag
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   unorder : t$0
>     skip [1] : t$1
>       sort [#id $0] : t$1
>         es : t$1
>
> t$0 {id:int, name:string} bag
> t$1 {id:int, name:string} list
> |_} : string
Sys.planOf (from e in es order e.id skip 1 unorder);
> val it =
>   {_|
> unorder : t$0
>   skip [1] : t$1
>     sort [#id $0] : t$1
>       es : t$1
>
> t$0 {id:int, name:string} bag
> t$1 {id:int, name:string} list
> |_} : string

(*) Not through a node that reads the ordinal.
from e in es order e.id where ordinal > 0 unorder;
> val it = [{id=2,name="b"},{id=3,name="c"}] : {id:int, name:string} bag
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   unorder : t$0
>     filter [$ordinal > 0] : t$1
>       sort [#id $0] : t$1
>         es : t$1
>
> t$0 {id:int, name:string} bag
> t$1 {id:int, name:string} list
> |_} : string
Sys.planOf (from e in es order e.id where ordinal > 0 unorder);
> val it =
>   {_|
> unorder : t$0
>   filter [$ordinal > 0] : t$1
>     sort [#id $0] : t$1
>       es : t$1
>
> t$0 {id:int, name:string} bag
> t$1 {id:int, name:string} list
> |_} : string

(*) An unorder over a bag is nothing at all; the resolver drops it.
from e in bag es unorder;
> val it = [{id=3,name="c"},{id=1,name="a"},{id=2,name="b"}]
>   : {id:int, name:string} bag
Sys.planEx "-1";
> val it = "val it = #fromList Bag es" : string
Sys.planOf (from e in bag es unorder);
> val it = {|bag es : t$0
>
> t$0 {id:int, name:string} bag
> |} : string

(* ---------------------------------------------------------------- *)
(* Merges.
 *
 * The resolver leaves the `where` steps the user wrote as they were
 * written, so that the plan of a query reads as the query does; and a
 * query nested in a query, or bound to a name and read by a query, is a
 * leaf until inlining puts one tree under the other. The rules merge
 * what those leave: a filter under a filter, a projection under a
 * projection, and a skip of nought.
 *)

(*) Two where steps become one condition.
from e in es where e.id > 1 where e.name <> "b";
> val it = [{id=3,name="c"}] : {id:int, name:string} list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   filter [#id $0 > 1 andalso #name $0 <> "b"] : t$0
>     es : t$0
>
> t$0 {id:int, name:string} list
> |_} : string
Sys.planOf (from e in es where e.id > 1 where e.name <> "b");
> val it =
>   {_|
> filter [#name $0 <> "b"] : t$0
>   filter [#id $0 > 1] : t$0
>     es : t$0
>
> t$0 {id:int, name:string} list
> |_} : string

(* Not where the outer reads the ordinal, which counts the rows the
 * inner let through. *)
from e in es where e.id > 1 where ordinal > 0;
> val it = [{id=2,name="b"}] : {id:int, name:string} list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   filter [$ordinal > 0] : t$0
>     filter [#id $0 > 1] : t$0
>       es : t$0
>
> t$0 {id:int, name:string} list
> |_} : string

(*) A nested query's filter and its enclosing query's filter.
from x in (from e in es where e.id > 1) where x.id < 3;
> val it = [{id=2,name="b"}] : {id:int, name:string} list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   filter [#id $0 > 1 andalso #id $0 < 3] : t$0
>     es : t$0
>
> t$0 {id:int, name:string} list
> |_} : string
Sys.planOf (from x in (from e in es where e.id > 1) where x.id < 3);
> val it =
>   {_|
> filter [#id $0 < 3] : t$0
>   filter [#id $0 > 1] : t$0
>     es : t$0
>
> t$0 {id:int, name:string} list
> |_} : string

(* A query bound to a name is inlined into the query that reads it,
 * and the two projections become one. A field read costs nothing to
 * repeat, and is substituted as often as the outer reads its element;
 * an expression that computes is bound once. *)
let val q = from e in es yield e.name in from n in q yield String.size n end;
> val it = [1,1,1] : int list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project [#size String (#name $0)] : int list
>     es : t$0
>
> t$0 {id:int, name:string} list
> |_} : string
let val q = from e in es yield e.name in from n in q yield n ^ n end;
> val it = ["cc","aa","bb"] : string list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project [#^ String (#name $0, #name $0)] : string list
>     es : t$0
>
> t$0 {id:int, name:string} list
> |_} : string
let val q = from e in es yield String.size e.name
  in from n in q yield n + n end;
> val it = [2,2,2] : int list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project [let val v$0 = #size String (#name $0) in v$0 + v$0 end] : int list
>     es : t$0
>
> t$0 {id:int, name:string} list
> |_} : string

(*) A field of a record the inner projection builds is folded away.
let val q = from e in es yield {id = e.id} in from x in q yield x.id end;
> val it = [3,1,2] : int list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project [#id $0] : int list
>     es : t$0
>
> t$0 {id:int, name:string} list
> |_} : string

(*) A skip whose count is inlined to nought goes.
let val n = 0 in from e in es skip n end;
> val it = [{id=3,name="c"},{id=1,name="a"},{id=2,name="b"}]
>   : {id:int, name:string} list
Sys.planEx "-1";
> val it = "val it = es" : string

(*) End rel-rule.smli
