(* A query that reads two engines: a JDBC table, which is anchored to the
 * database that holds it, and a list the query wrote, which is Morel's.
 * Today the decision is taken at the root, so one side being Morel's sends
 * the whole query local -- including the filter on "dname", which the
 * database could have done. Cleaving is what would push the part that can
 * go; until it does, this is the baseline, and when it lands this plan is
 * where the improvement shows. *)
val dnames = ["SALES", "RESEARCH"];
> val dnames = ["SALES","RESEARCH"] : string list
from d in scott.depts, n in dnames
  where d.dname = n
  yield d.deptno;
> val it = [20,30] : int bag
String.isPrefix "globalMarshal(globals [scott], body from(" (Sys.plan ());
> val it = true : bool

(*) The same query without the list is pushed down in full.
from d in scott.depts where d.dname = "SALES" yield d.deptno;
> val it = [30] : int bag
Sys.plan ();
> val it =
>   {_|
> globalMarshal(globals [scott], body calcite(plan LogicalProject(deptno=[$0])
>   LogicalFilter(condition=[=($1, 'SALES')])
>     LogicalProject(deptno=[$0], dname=[$1], loc=[$2])
>       JdbcTableScan(table=[[scott, DEPT]])
> ))|_} : string

(* Cleaving. With an engine named, a conjunct that reads one side of the
 * join moves below it, coloring puts a boundary at the top of the largest
 * subtree the engine can run, and the compiler runs that part there. So the
 * filter on "loc" happens in the database; the join with Morel's list, and
 * the conjunct that reads both sides, stay local. *)
Sys.set ("engine", "calcite");
> val it = () : unit
from d in scott.depts, n in dnames
  where d.loc = "CHICAGO" andalso d.dname = n
  yield d.deptno;
> val it = [30] : int bag
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project [#deptno (#1 $0)] : int bag
>     filter [#dname (#1 $0) = #2 $0] : t$0
>       join : t$0
>         boundary [calcite] : t$1
>           filter [#loc $0 = "CHICAGO"] : t$1
>             #depts scott : t$1
>         dnames : string list
>
> t$0 ({deptno:int, dname:string, loc:string} * string) bag
> t$1 {deptno:int, dname:string, loc:string} bag
> |_} : string
from d in scott.depts, n in dnames
  where d.loc = "CHICAGO" andalso d.dname = n
  yield d.deptno;
> val it = [30] : int bag
Sys.plan ();
> val it =
>   {_|
> globalMarshal(globals [scott], body from(sink join(pat $0_154, exp calcite(plan LogicalFilter(condition=[=($2, 'CHICAGO')])
>   LogicalProject(deptno=[$0], dname=[$1], loc=[$2])
>     JdbcTableScan(table=[[scott, DEPT]])
> ), sink join(pat $1_157, exp constant([SALES, RESEARCH]), sink where(condition apply2(fnValue =, apply(fnValue nth:1, argCode stack(offset 2, name $0)), stack(offset 1, name $1)), sink collect(apply(fnValue nth:0, argCode stack(offset 2, name $0))))))))|_} : string
Sys.set ("engine", "");
> val it = () : unit

(*) Recursive query, 3
Sys.set ("hybrid", false);
> val it = () : unit
let
  fun descendants2 descendants newDescendants =
    if empty newDescendants then
      descendants
    else
      descendants2 (from d in descendants union newDescendants)
          (from d in newDescendants,
              e in scott.emps
            where e.mgr = d.e.empno
            yield {e, level = d.level + 1})
in
  from d in descendants2 Bag.nil
      (from e in scott.emps
        where e.mgr = 0
        yield {e, level = 0})
    yield {d.e.empno, d.e.mgr, d.e.ename, d.level}
end;
> val it =
>   [{empno=7839,ename="KING",level=0,mgr=0},
>    {empno=7566,ename="JONES",level=1,mgr=7839},
>    {empno=7698,ename="BLAKE",level=1,mgr=7839},
>    {empno=7782,ename="CLARK",level=1,mgr=7839},
>    {empno=7788,ename="SCOTT",level=2,mgr=7566},
>    {empno=7902,ename="FORD",level=2,mgr=7566},
>    {empno=7499,ename="ALLEN",level=2,mgr=7698},
>    {empno=7521,ename="WARD",level=2,mgr=7698},
>    {empno=7654,ename="MARTIN",level=2,mgr=7698},
>    {empno=7844,ename="TURNER",level=2,mgr=7698},
>    {empno=7900,ename="JAMES",level=2,mgr=7698},
>    {empno=7934,ename="MILLER",level=2,mgr=7782},
>    {empno=7876,ename="ADAMS",level=3,mgr=7788},
>    {empno=7369,ename="SMITH",level=3,mgr=7902}]
>   : {empno:int, ename:string, level:int, mgr:int} bag

(* 'max' and 'min' over a type that the Calcite adapter cannot order the way
 * Morel does -- 'word' (which Calcite compares as a signed integer) or a
 * composite type such as a tuple or 'option' -- run locally rather than being
 * pushed to Calcite, giving the right answer rather than crashing. 'Sys.plan'
 * confirms the plan has no 'calcite' node. See the Calcite adapter limitations
 * in 'docs/reference.md'. *)
Sys.set ("hybrid", true);
> val it = () : unit
from w in [0w1, 0wxFFFFFFFFFFFFFFFF] compute max over w;
> val it = 0wxFFFFFFFFFFFFFFFF : word
Sys.plan ();
> val it =
>   "apply(fnValue Relational.only, argCode from(sink join(pat $0_198, exp tuple(constant(1), constant(-1)), sink group(key tuple, agg aggregate, sink yield(codes [tuple(get(name max))], sink collect(apply(fnValue nth:0, argCode stack(offset 1, name $0))))))))"
>   : string
from p in [(1, 2), (2, 1), (1, 9)] compute max over p;
> val it = (2,1) : int * int
Sys.plan ();
> val it =
>   "apply(fnValue Relational.only, argCode from(sink join(pat $0_207, exp tuple(tuple(constant(1), constant(2)), tuple(constant(2), constant(1)), tuple(constant(1), constant(9))), sink group(key tuple, agg aggregate, sink yield(codes [tuple(get(name max))], sink collect(apply(fnValue nth:0, argCode stack(offset 1, name $0))))))))"
>   : string
from ox in [SOME 1, NONE, SOME 3] compute min over ox;
> val it = NONE : int option
Sys.plan ();
> val it =
>   "globalMarshal(globals [SOME], body apply(fnValue Relational.only, argCode from(sink join(pat $0_216, exp tuple(apply(fnValue tyCon, argCode constant(1)), constant([NONE]), apply(fnValue tyCon, argCode constant(3))), sink group(key tuple, agg aggregate, sink yield(codes [tuple(get(name min))], sink collect(apply(fnValue nth:0, argCode stack(offset 1, name $0)))))))))"
>   : string
Sys.set ("hybrid", false);
> val it = () : unit

"end";
> val it = "end" : string

(*) End hybrid.smli
