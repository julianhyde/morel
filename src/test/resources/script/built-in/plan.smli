 *
 * Unit tests for the built-in `Plan` structure.
 *)
Sys.set ("lineWidth", 78);
> val it = () : unit
Sys.set ("stringDepth", ~1);
> val it = () : unit

Plan;
> val it = {bodyOf=fn} : {bodyOf:('a -> 'b) -> string}

(*) val bodyOf : ('a -> 'b) -> string
Plan.bodyOf;
> val it = fn : ('a -> 'b) -> string

(* The body of a function whose body is a query is the query's tree, after
 * every pass and rule; the parameter is a free name in it. *)
val es = [{id = 3, name = "c"}, {id = 1, name = "a"}, {id = 2, name = "b"}];
> val es = [{id=3,name="c"},{id=1,name="a"},{id=2,name="b"}]
>   : {id:int, name:string} list
fun above n = from e in es where e.id > n where e.name <> "b" yield e.name;
> val above = fn : int -> string list
(*) The tree is the one the compiler was given, which Sys.planEx "-1" shows.
Sys.planEx "-1";
> val it =
>   {|val above = fn n => r$0[n]
>
> r$0[n] =
>   project [#name $0] : string list
>     filter [#id $0 > n andalso #name $0 <> "b"] : t$0
>       es : t$0
>
> t$0 {id:int, name:string} list
> |} : string
Plan.bodyOf above;
> val it =
>   {_|
> project [#name $0] : string list
>   filter [#id $0 > n andalso #name $0 <> "b"] : t$0
>     es : t$0
>
> t$0 {id:int, name:string} list
> |_} : string
above 1;
> val it = ["c"] : string list

(*) A body that is not a query prints as an expression.
fun twice x = x + x;
> val twice = fn : int -> int
Plan.bodyOf twice;
> val it = "x + x" : string

(*) A closure's body is what the compiler made of it: a constant is inlined.
val f = let val k = 2 in fn x => x * k end;
> val f = fn : int -> int
Plan.bodyOf f;
> val it = "#* Int (x, 2)" : string
f 21;
> val it = 42 : int

(*) A built-in function has no body the compiler made.
Plan.bodyOf String.size;
> uncaught exception Fail [Fail: not a compiled function]
>   raised at: stdIn:1.1-1.24

(*) End plan.smli
