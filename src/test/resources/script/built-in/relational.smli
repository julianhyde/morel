Sys.set ("lineWidth", 78);
> val it = () : unit
Sys.set ("printLength", NONE);
> val it = () : unit
Sys.set ("stringDepth", NONE);
> val it = () : unit

Relational;
> val it =
>   {avg=fn,avgOpt=fn,avgSome=fn,compare=fn,count=fn,countSome=fn,empty=fn,
>    iterate=fn,max=fn,maxBy=fn,maxOpt=fn,maxSome=fn,min=fn,minBy=fn,minOpt=fn,
>    minSome=fn,nonEmpty=fn,only=fn,somes=fn,stddevPop=fn,stddevPopOpt=fn,
>    stddevPopSome=fn,stddevSamp=fn,stddevSampOpt=fn,stddevSampSome=fn,sum=fn,
>    sumOpt=fn,sumSome=fn,varPop=fn,varPopOpt=fn,varPopSome=fn,varSamp=fn,
>    varSampOpt=fn,varSampSome=fn}
>   : {avg:int bag -> real, avgOpt:int bag -> real option,
>       avgSome:int option bag -> real option, compare:'a * 'a -> order,
>       count:'b bag -> int, countSome:'c option bag -> int,
>       empty:'d bag -> bool,
>       iterate:'e bag -> ('e bag * 'e bag -> 'e bag) -> 'e bag,
>       max:'f bag -> 'f, maxBy:('g -> 'h) -> 'g bag -> 'g,
>       maxOpt:'i bag -> 'i option, maxSome:'j option bag -> 'j option,
>       min:'k bag -> 'k, minBy:('l -> 'm) -> 'l bag -> 'l,
>       minOpt:'n bag -> 'n option, minSome:'o option bag -> 'o option,
>       nonEmpty:'p bag -> bool, only:'q bag -> 'q,
>       somes:'r option bag -> 'r bag, stddevPop:int bag -> real,
>       stddevPopOpt:int bag -> real option,
>       stddevPopSome:int option bag -> real option,
>       stddevSamp:int bag -> real, stddevSampOpt:int bag -> real option,
>       stddevSampSome:int option bag -> real option, sum:'s bag -> 's,
>       sumOpt:'t bag -> 't option, sumSome:'u option bag -> 'u option,
>       varPop:int bag -> real, varPopOpt:int bag -> real option,
>       varPopSome:int option bag -> real option, varSamp:int bag -> real,
>       varSampOpt:int bag -> real option,
>       varSampSome:int option bag -> real option}

(* Descending:
 *   datatype descending = DESC of 'a
*)
DESC;
> val it = fn : 'a -> 'a descending
DESC "a";
> val it = DESC "a" : string descending
DESC (DESC "a");
> val it = DESC (DESC "a") : string descending descending

(* "avg" returns the mean. Its type is overloaded: the mean of int values is
 * a real; of real values, a real; of decimal values, a decimal. *)
Relational.avg [1, 2, 4];
> val it = 2.3333333 : real
Sys.plan ();
> val it =
>   "apply(fnValue Relational.avg, argCode tuple(constant(1), constant(2), constant(4)))"
>   : string
Relational.avg (bag [1, 2, 4]);
> val it = 2.3333333 : real
Relational.avg [1.0, 2.5, 4.5];
> val it = 2.6666667 : real
Relational.avg [decimal "1.5", decimal "2.25"];
> val it = 1.875 : decimal
Relational.avg [decimal "1", decimal "2", decimal "2"];
> val it = 1.666666666666666666666666666666667 : decimal
[1, 2, 6].avg ();
> val it = 3 : real
avg [1, 2];
> val it = 1.5 : real
(*) The mean of an int is computed exactly, and then rounded to a real.
Relational.avg [valOf Int.maxInt, valOf Int.maxInt];
> val it = 2.1474836E9 : real
(*) "avg" of an empty collection raises Empty, as "min" and "max" do.
Relational.avg ([] : int list);
> uncaught exception Empty
>   raised at: stdIn:1.1-1.31
Relational.avg (bag [] : decimal bag);
> uncaught exception Empty
>   raised at: stdIn:1.1-1.38
(*) There is no mean of strings.
Relational.avg ["a", "b"];
> stdIn:1.1-1.26 Error: Cannot deduce type: no valid overloads
>   raised at: stdIn:1.1-1.26
(* "avg" over options is not defined; "avgSome" (below) is SQL's AVG,
 * which ignores nulls. *)
Relational.avg [SOME 1, NONE, SOME 4];
> stdIn:1.1-1.38 Error: Cannot deduce type: no valid overloads
>   raised at: stdIn:1.1-1.38
from i in [1, 2] compute avg over i;
> val it = 1.5 : real

(* "avgOpt" is "avg", but NONE on an empty collection rather than raising
 * Empty, and otherwise SOME of the mean. *)
Relational.avgOpt [1, 2, 6];
> val it = SOME 3 : real option
Relational.avgOpt ([] : int list);
> val it = NONE : real option
Relational.avgOpt (bag [decimal "1.5", decimal "2.25"]);
> val it = SOME 1.875 : decimal option
avgOpt [1.5];
> val it = SOME 1.5 : real option
(* "avgSome" is SQL's AVG: the mean of the values of the SOMEs, ignoring
 * NONE, or NONE if there are none. *)
Relational.avgSome [SOME 1, NONE, SOME 4];
> val it = SOME 2.5 : real option
avgSome (bag [NONE, SOME (decimal "1.5"), SOME (decimal "2.5")]);
> val it = SOME 2 : decimal option
avgSome ([NONE, NONE] : real option list);
> val it = NONE : real option
avgSome ([] : int option list);
> val it = NONE : real option
from i in [SOME 1, NONE, SOME 4] compute avgSome over i;
> val it = SOME 2.5 : real option
(*) "avgSome" is "avgOpt" of "somes".
avgOpt (somes [SOME 1, NONE, SOME 4]);
> val it = SOME 2.5 : real option

Relational.count (bag [1, 2, 3]);
> val it = 3 : int
Relational.count (bag []);
> val it = 0 : int
Relational.count (bag [false]);
> val it = 1 : int
Sys.plan ();
> val it =
>   "apply(fnValue Relational.count, argCode apply(fnValue Bag.fromList, argCode tuple(constant(false))))"
>   : string
(* "count" counts elements, whatever they are, NONE among them;
 * "countSome" counts the SOMEs, as SQL's COUNT(x) ignores nulls. *)
Relational.count [SOME 1, NONE, SOME 3];
> val it = 3 : int
Relational.count [SOME NONE, NONE];
> val it = 2 : int
Relational.countSome [SOME 1, NONE, SOME 3];
> val it = 2 : int
countSome [SOME NONE, NONE];
> val it = 1 : int
countSome ([] : int option list);
> val it = 0 : int
from i in [SOME 1, NONE, SOME 3]
  compute {c = countSome over i, n = count over ()};
> val it = {c=2,n=3} : {c:int, n:int}

Relational.nonEmpty (bag [1, 2, 3]);
> val it = true : bool
Relational.nonEmpty (bag []);
> val it = false : bool
Relational.nonEmpty (bag [false]);
> val it = true : bool
Sys.plan ();
> val it =
>   "apply(fnValue Relational.nonEmpty, argCode apply(fnValue Bag.fromList, argCode tuple(constant(false))))"
>   : string

Relational.empty (bag [1, 2, 3]);
> val it = false : bool
Relational.empty (bag []);
> val it = true : bool
Relational.empty (bag [false]);
> val it = false : bool
Sys.plan ();
> val it =
>   "apply(fnValue Relational.empty, argCode apply(fnValue Bag.fromList, argCode tuple(constant(false))))"
>   : string

val emps = [
  {empno=7839, ename="KING", mgr=0},
  {empno=7566, ename="JONES", mgr=7839},
  {empno=7698, ename="BLAKE", mgr=7839},
  {empno=7782, ename="CLARK", mgr=7839},
  {empno=7788, ename="SCOTT", mgr=7566},
  {empno=7902, ename="FORD", mgr=7566},
  {empno=7499, ename="ALLEN", mgr=7698},
  {empno=7521, ename="WARD", mgr=7698},
  {empno=7654, ename="MARTIN", mgr=7698},
  {empno=7844, ename="TURNER", mgr=7698},
  {empno=7900, ename="JAMES", mgr=7698},
  {empno=7934, ename="MILLER", mgr=7782},
  {empno=7876, ename="ADAMS", mgr=7788},
  {empno=7369, ename="SMITH", mgr=7902}];
> val emps =
>   [{empno=7839,ename="KING",mgr=0},{empno=7566,ename="JONES",mgr=7839},
>    {empno=7698,ename="BLAKE",mgr=7839},{empno=7782,ename="CLARK",mgr=7839},
>    {empno=7788,ename="SCOTT",mgr=7566},{empno=7902,ename="FORD",mgr=7566},
>    {empno=7499,ename="ALLEN",mgr=7698},{empno=7521,ename="WARD",mgr=7698},
>    {empno=7654,ename="MARTIN",mgr=7698},{empno=7844,ename="TURNER",mgr=7698},
>    {empno=7900,ename="JAMES",mgr=7698},{empno=7934,ename="MILLER",mgr=7782},
>    {empno=7876,ename="ADAMS",mgr=7788},{empno=7369,ename="SMITH",mgr=7902}]
>   : {empno:int, ename:string, mgr:int} list
(* "iterate" computes a fixed point: starting from the initial rows,
 * the rows the update function returns are added each round, until a
 * round produces none. *)
Relational.iterate (bag [1]) (fn (oldList, newList) => (from n in newList where n < 4 yield n + 1));
> val it = [1,2,3,4] : int bag

Relational.iterate
  (from e in emps where e.mgr = 0)
  fn (oldList, newList) =>
      (from d in newList,
          e in emps
      where e.mgr = d.empno
      yield e);
> val it =
>   [{empno=7839,ename="KING",mgr=0},{empno=7566,ename="JONES",mgr=7839},
>    {empno=7698,ename="BLAKE",mgr=7839},{empno=7782,ename="CLARK",mgr=7839},
>    {empno=7788,ename="SCOTT",mgr=7566},{empno=7902,ename="FORD",mgr=7566},
>    {empno=7499,ename="ALLEN",mgr=7698},{empno=7521,ename="WARD",mgr=7698},
>    {empno=7654,ename="MARTIN",mgr=7698},{empno=7844,ename="TURNER",mgr=7698},
>    {empno=7900,ename="JAMES",mgr=7698},{empno=7934,ename="MILLER",mgr=7782},
>    {empno=7876,ename="ADAMS",mgr=7788},{empno=7369,ename="SMITH",mgr=7902}]
>   : {empno:int, ename:string, mgr:int} list
Sys.plan ();
> val it =
>   "apply2(fnValue Relational.iterate, from(sink join(pat e, exp constant([[7839, KING, 0], [7566, JONES, 7839], [7698, BLAKE, 7839], [7782, CLARK, 7839], [7788, SCOTT, 7566], [7902, FORD, 7566], [7499, ALLEN, 7698], [7521, WARD, 7698], [7654, MARTIN, 7698], [7844, TURNER, 7698], [7900, JAMES, 7698], [7934, MILLER, 7782], [7876, ADAMS, 7788], [7369, SMITH, 7902]]), sink where(condition apply2(fnValue =, apply(fnValue nth:2, argCode stack(offset 1, name e)), constant(0)), sink collect(stack(offset 1, name e))))), match(v, tailApply(fnCode match((oldList, newList), from(sink join(pat d, exp stack(offset 1, name newList), sink hashJoin(pat e, exp constant([[7839, KING, 0], [7566, JONES, 7839], [7698, BLAKE, 7839], [7782, CLARK, 7839], [7788, SCOTT, 7566], [7902, FORD, 7566], [7499, ALLEN, 7698], [7521, WARD, 7698], [7654, MARTIN, 7698], [7844, TURNER, 7698], [7900, JAMES, 7698], [7934, MILLER, 7782], [7876, ADAMS, 7788], [7369, SMITH, 7902]]), leftKey apply(fnValue nth:0, argCode stack(offset 1, name d)), rightKey apply(fnValue nth:2, argCode stack(offset 1, name e)), condition apply2(fnValue =, apply(fnValue nth:2, argCode stack(offset 1, name e)), apply(fnValue nth:0, argCode stack(offset 2, name d))), sink collect(stack(offset 1, name e)))))), argCode stack(offset 1, name v))))"
>   : string

Relational.sum (bag [1, 2, 3]);
> val it = 6 : int
Sys.plan ();
> val it =
>   "apply(fnValue Relational.sum$int, argCode apply(fnValue Bag.fromList, argCode tuple(constant(1), constant(2), constant(3))))"
>   : string
Relational.sum (bag [1.0, 2.5, 3.5]);
> val it = 7 : real
Sys.plan ();
> val it =
>   "apply(fnValue Relational.sum$real, argCode apply(fnValue Bag.fromList, argCode tuple(constant(1.0), constant(2.5), constant(3.5))))"
>   : string
Relational.sum (bag [decimal "0.1", decimal "0.2", decimal "12.30"]);
> val it = 12.6 : decimal
Sys.plan ();
> val it =
>   "apply(fnValue Relational.sum$decimal, argCode apply(fnValue Bag.fromList, argCode tuple(constant(0.1), constant(0.2), constant(12.3))))"
>   : string
Relational.sum (bag [Decimal.maxFinite, Decimal.maxFinite]);
> uncaught exception Overflow [overflow]
>   raised at: stdIn:1.1-1.60
from d in [decimal "1.5", decimal "2.25"] compute sum over d;
> val it = 3.75 : decimal
(* "sum" over options is not defined. *)
Relational.sum [SOME 1, NONE, SOME 3];
> stdIn:1.1-1.38 Error: operator 'sum' not defined for type 'int option list'
>   raised at: stdIn:1.1-1.38

(* "sumOpt" is SOME of the sum, or NONE on an empty collection. *)
Relational.sumOpt [1, 2, 3];
> val it = SOME 6 : int option
Sys.plan ();
> val it =
>   "apply(fnValue Relational.sumOpt$int, argCode tuple(constant(1), constant(2), constant(3)))"
>   : string
Relational.sumOpt ([] : int list);
> val it = NONE : int option
Relational.sumOpt (bag [1.5, 2.5]);
> val it = SOME 4 : real option
Relational.sumOpt [decimal "0.1", decimal "0.2"];
> val it = SOME 0.3 : decimal option
sumOpt ([] : decimal list);
> val it = NONE : decimal option
Relational.sumOpt [Decimal.maxFinite, Decimal.maxFinite];
> uncaught exception Overflow [overflow]
>   raised at: stdIn:1.1-1.57
(*) It is "sumOpt o somes"; "sumSome" is SQL's SUM.
from i in [SOME 1, NONE, SOME 3] compute (sumOpt o somes) over i;
> val it = SOME 4 : int option

(* "sumSome" is SQL's SUM: the sum of the values of the SOMEs, ignoring
 * NONE, or NONE if there are none. *)
Relational.sumSome [SOME 1, NONE, SOME 3];
> val it = SOME 4 : int option
sumSome (bag [SOME 1.5, NONE]);
> val it = SOME 1.5 : real option
sumSome [NONE, SOME (decimal "0.1"), SOME (decimal "0.2")];
> val it = SOME 0.3 : decimal option
sumSome ([NONE] : int option list);
> val it = NONE : int option
sumSome ([] : decimal option list);
> val it = NONE : decimal option
from i in [SOME 1, NONE, SOME 3] compute sumSome over i;
> val it = SOME 4 : int option

(* "somes" drops each NONE, and gives the values of the SOMEs. *)
Relational.somes [SOME 1, NONE, SOME 3];
> val it = [1,3] : int bag
somes (bag [NONE, SOME "a"]);
> val it = ["a"] : string bag
somes ([] : int option list);
> val it = [] : int bag
somes [SOME NONE, NONE, SOME (SOME 2)];
> val it = [NONE,SOME 2] : int option bag

(* "stddevSamp" and "varSamp" are the sample standard deviation and
 * variance, dividing by one less than the number of elements;
 * "stddevPop" and "varPop" divide by the number of elements. The
 * elements may be int, real or decimal; the result is a real. *)
Relational.stddevSamp [2, 4, 4, 4, 5, 5, 7, 9];
> val it = 2.13809 : real
Relational.stddevPop [2, 4, 4, 4, 5, 5, 7, 9];
> val it = 2 : real
Relational.varSamp [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0];
> val it = 4.571429 : real
Relational.varPop (bag [decimal "1.5", decimal "2.5"]);
> val it = 0.25 : real
[1, 2, 3, 4].stddevSamp ();
> val it = 1.2909944 : real
from i in [1, 2, 3, 4] compute {s = stddevSamp over i, v = varPop over i};
> val it = {s=1.2909944,v=1.25} : {s:real, v:real}
(*) A sample statistic needs two elements; a population statistic, one.
stddevPop [7];
> val it = 0 : real
stddevSamp [7];
> uncaught exception Empty
>   raised at: stdIn:1.1-1.15
varPop ([] : real list);
> uncaught exception Empty
>   raised at: stdIn:1.1-1.24
Relational.varSamp ["a", "b"];
> stdIn:1.1-1.30 Error: Cannot deduce type: no valid overloads
>   raised at: stdIn:1.1-1.30
(* The "Opt" forms return NONE where the plain forms raise Empty, and
 * otherwise SOME of the result. *)
stddevSampOpt [7];
> val it = NONE : real option
stddevPopOpt [7];
> val it = SOME 0 : real option
varSampOpt [1, 2, 3, 4];
> val it = SOME 1.6666666 : real option
varPopOpt ([] : decimal list);
> val it = NONE : real option
(* The "Some" forms are SQL's STDDEV_SAMP, STDDEV_POP, VAR_SAMP and
 * VAR_POP: they ignore NONE, and return NONE if there are too few SOMEs. *)
stddevSampSome [SOME 1, NONE, SOME 3];
> val it = SOME 1.4142135 : real option
stddevSampSome [SOME 1, NONE];
> val it = NONE : real option
stddevPopSome [SOME 1, NONE];
> val it = SOME 0 : real option
varSampSome (bag [SOME 1.5, SOME 2.5, NONE]);
> val it = SOME 0.5 : real option
varPopSome ([NONE] : int option list);
> val it = NONE : real option
from i in [SOME 1, NONE, SOME 3] compute stddevSampSome over i;
> val it = SOME 1.4142135 : real option
(*) "stddevSampSome" is "stddevSampOpt" of "somes".
stddevSampOpt (somes [SOME 1, NONE, SOME 3]);
> val it = SOME 1.4142135 : real option

(* "maxOpt" and "minOpt" are "max" and "min", but NONE on an empty
 * collection rather than raising Empty. *)
Relational.maxOpt [1, 3, 2];
> val it = SOME 3 : int option
Relational.minOpt (bag ["b", "a"]);
> val it = SOME "a" : string option
maxOpt ([] : int list);
> val it = NONE : int option
minOpt ([] : string list);
> val it = NONE : string option
(*) Over options, NONE is the least, as "compare" says.
Relational.minOpt [SOME 1, NONE];
> val it = SOME NONE : int option option
(*) With "somes", they are SQL's MAX and MIN; so are "maxSome", "minSome".
from i in [SOME 2, NONE, SOME 1]
  compute {lo = (minOpt o somes) over i, hi = (maxOpt o somes) over i};
> val it = {hi=SOME 2,lo=SOME 1} : {hi:int option, lo:int option}

(* "maxSome" and "minSome" are SQL's MAX and MIN: the greatest and least
 * values of the SOMEs, ignoring NONE, or NONE if there are none. *)
Relational.maxSome [SOME 1, NONE, SOME 3];
> val it = SOME 3 : int option
minSome (bag [NONE, SOME "b", SOME "a"]);
> val it = SOME "a" : string option
maxSome ([NONE] : int option list);
> val it = NONE : int option
minSome ([] : int option list);
> val it = NONE : int option
from i in [SOME 2, NONE, SOME 1]
  compute {lo = minSome over i, hi = maxSome over i};
> val it = {hi=SOME 2,lo=SOME 1} : {hi:int option, lo:int option}

Relational.max (bag [1, 2, 3]);
> val it = 3 : int
(bag [1, 2, 3]).max ();
> val it = 3 : int
Relational.max (bag [1.0, 2.5, 3.5]);
> val it = 3.5 : real
Relational.max (bag ["a", "bc", "ab"]);
> val it = "bc" : string
Relational.max (bag [] : int bag);
> uncaught exception Empty
>   raised at: stdIn:1.1-1.34
Relational.max (bag [0w1, 0wxFFFFFFFFFFFFFFFF]);
> val it = 0wxFFFFFFFFFFFFFFFF : word
Relational.max (bag [(1, 2), (2, 1), (1, 9)]);
> val it = (2,1) : int * int
(* Over options, "max" orders by "compare", in which NONE is less than any
 * SOME, and raises Empty on an empty collection; "maxSome" is SQL's MAX,
 * which ignores nulls. *)
Relational.max (bag [SOME 1, NONE, SOME 3]);
> val it = SOME 3 : int option
Relational.max [NONE, SOME "b", SOME "a"];
> val it = SOME "b" : string option
Relational.max ([NONE] : int option list);
> val it = NONE : int option
Relational.max ([] : int option list);
> uncaught exception Empty
>   raised at: stdIn:1.1-1.38
Relational.max (bag [INL 1, INR "a", INL 2]);
> val it = INR "a" : (int,string) either
Relational.max (bag [false, true]);
> val it = true : bool
Sys.plan ();
> val it =
>   "apply(fnValue Relational.max, argCode apply(fnValue Bag.fromList, argCode tuple(constant(false), constant(true))))"
>   : string

(* `maxBy keyFn` returns the element with the greatest key. The key need not
 * be the element itself, and need not be of the same type. *)
Relational.maxBy String.size ["john", "paul", "george", "ringo"];
> val it = "george" : string
maxBy String.size ["john", "paul", "george", "ringo"];
> val it = "george" : string
maxBy String.size (bag ["john", "paul", "george", "ringo"]);
> val it = "george" : string
maxBy #deptno [{deptno=20, ename="b"}, {deptno=30, ename="a"},
    {deptno=10, ename="c"}];
> val it = {deptno=30,ename="a"} : {deptno:int, ename:string}
maxBy Fn.id [1];
> val it = 1 : int
maxBy (fn w => w) [0w1, 0wxFFFFFFFFFFFFFFFF];
> val it = 0wxFFFFFFFFFFFFFFFF : word
maxBy (fn i => (i mod 3, i)) [1, 2, 3, 4, 5];
> val it = 5 : int
maxBy (fn i => DESC i) [3, 1, 2];
> val it = 1 : int
maxBy String.size ([] : string list);
> uncaught exception Empty
>   raised at: stdIn:1.1-1.37
maxBy String.size (bag [] : string bag);
> uncaught exception Empty
>   raised at: stdIn:1.1-1.40
Sys.plan ();
> val it =
>   "apply2(fnValue Relational.maxBy, constant(String.size), apply(fnValue Bag.fromList, argCode tuple))"
>   : string

Relational.min (bag [1, 2, 3]);
> val it = 1 : int
(bag [1, 2, 3]).min ();
> val it = 1 : int
Relational.min (bag [1.0, 2.5, 3.5]);
> val it = 1 : real
Relational.min (bag ["a", "bc", "ab"]);
> val it = "a" : string
Relational.min (bag [] : int bag);
> uncaught exception Empty
>   raised at: stdIn:1.1-1.34
Relational.min (bag [0w1, 0wxFFFFFFFFFFFFFFFF]);
> val it = 0wx1 : word
Relational.min (bag [(1, 2), (2, 1), (1, 9)]);
> val it = (1,2) : int * int
(* Over options, "min" orders by "compare", in which NONE is less than any
 * SOME, and raises Empty on an empty collection; "minSome" is SQL's MIN,
 * which ignores nulls. *)
Relational.min (bag [SOME 1, NONE, SOME 3]);
> val it = NONE : int option
Relational.min [NONE, SOME "b", SOME "a"];
> val it = NONE : string option
Relational.min ([NONE] : int option list);
> val it = NONE : int option
Relational.min ([] : int option list);
> uncaught exception Empty
>   raised at: stdIn:1.1-1.38
Relational.min (bag [INL 1, INR "a", INL 2]);
> val it = INL 1 : (int,string) either
Relational.min (bag [false, true]);
> val it = false : bool
Sys.plan ();
> val it =
