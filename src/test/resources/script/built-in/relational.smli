>   : string

(* `minBy keyFn` returns the element with the least key. Both `john` and
 * `paul` have 4 characters; which of them is returned is not specified, and
 * for a bag may vary from run to run. *)
Relational.minBy String.size ["john", "paul", "george", "ringo"];
> val it = "john" : string
minBy String.size ["john", "paul", "george", "ringo"];
> val it = "john" : string
minBy String.size (bag ["john", "paul", "george", "ringo"]);
> val it = "john" : string
minBy #deptno [{deptno=20, ename="b"}, {deptno=30, ename="a"},
    {deptno=10, ename="c"}];
> val it = {deptno=10,ename="c"} : {deptno:int, ename:string}
minBy Fn.id [1];
> val it = 1 : int
minBy (fn w => w) [0w1, 0wxFFFFFFFFFFFFFFFF];
> val it = 0wx1 : word
minBy (fn i => DESC i) [3, 1, 2];
> val it = 3 : int
minBy String.size ([] : string list);
> uncaught exception Empty
>   raised at: stdIn:1.1-1.37
minBy String.size (bag [] : string bag);
> uncaught exception Empty
>   raised at: stdIn:1.1-1.40
