 *
 * The corpus of spark.smli, each query prepared and executed on a
 * live Spark Connect server, the test container at
 * sc://localhost:15002 (start-spark.sh), whose scott database holds
 * Morel's scott rows; so the results are those of spark.smli. Runs
 * once the translator exists (Spark.prepare) and a server is
 * available; see docs/script-format.md.
 *)
(*) requires: spark spark-prepare

Sys.set ("printLength", 64);
> val it = () : unit
Sys.set ("output", "tabular");
> val it = () : unit
val spark = Spark.connect "sc://localhost:15002";
> val spark = {catalog={},connection=<connection sc://localhost:15002>}
>   : {catalog:{...}, connection:connection, ...}

(*) Query 1: filter and project over an inline relation.
(spark.connection.prepare (fn () =>
  from r in [{i = 1, s = "one", b = true, x = 1.5},
             {i = 2, s = "two", b = false, x = 2.5},
             {i = 3, s = "three", b = true, x = 3.5}]
    where r.b andalso r.i > 1
    yield {r.s, y = r.x * 2.0}
)).execute ();
> s     y
> ----- -
> three 7
>
> val it : {s:string, y:real} list

(*) Query 2: equijoin.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps
    join d in spark.catalog.scott.depts on e.deptno = d.deptno
    yield {e.ename, d.dname}
)).execute ();
> dname      ename
> ---------- ------
> RESEARCH   SMITH
> SALES      ALLEN
> SALES      WARD
> RESEARCH   JONES
> SALES      MARTIN
> SALES      BLAKE
> ACCOUNTING CLARK
> RESEARCH   SCOTT
> ACCOUNTING KING
> SALES      TURNER
> RESEARCH   ADAMS
> SALES      JAMES
> RESEARCH   FORD
> ACCOUNTING MILLER
>
> val it : {dname:string, ename:string} bag

(*) Query 3: group by with aggregates.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps
    group e.deptno
      compute {c = count over (), total = sum over e.sal, top = max over e.sal}
)).execute ();
> c deptno top  total
> - ------ ---- -----
> 5     20 3000 10875
> 6     30 2850  9400
> 3     10 5000  8750
>
> val it : {c:int, deptno:int, top:real, total:real} bag

(*) Query 4: sort and limit.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps
    yield {e.ename, e.sal}
    order (DESC sal, ename)
    take 3
)).execute ();
> ename sal
> ----- ----
> KING  5000
> FORD  3000
> SCOTT 3000
>
> val it : {ename:string, sal:real} list

(*) Query 5: correlated exists subquery.
(spark.connection.prepare (fn () =>
  from d in spark.catalog.scott.depts
    where (exists e in spark.catalog.scott.emps
           where e.deptno = d.deptno andalso e.job = "CLERK")
    yield d.dname
)).execute ();
> val it = ["ACCOUNTING","RESEARCH","SALES"] : string bag

(*) Query 6: order, skip, take, then project.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps
    order e.empno
    skip 2
    take 3
    yield {e.empno, e.ename}
)).execute ();
> empno ename
> ----- ------
>  7521 WARD
>  7566 JONES
>  7654 MARTIN
>
> val it : {empno:int, ename:string} list

(*) Query 7: distinct, a group with no aggregates.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps group e.job
)).execute ();
> val it = ["CLERK","SALESMAN","MANAGER","ANALYST","PRESIDENT"] : string bag

(*) Query 8: left join.
(spark.connection.prepare (fn () =>
  from d in spark.catalog.scott.depts
    left join e in spark.catalog.scott.emps on d.deptno = e.deptno
    where d.deptno >= 30
    yield {d.dname, e}
)).execute ();
> dname      e
>            comm deptno empno ename  hiredate   job      mgr  sal
> ---------- ---- ------ ----- ------ ---------- -------- ---- ----
> SALES       300     30  7499 ALLEN  1981-02-20 SALESMAN 7698 1600
> SALES       500     30  7521 WARD   1981-02-22 SALESMAN 7698 1250
> SALES      1400     30  7654 MARTIN 1981-09-28 SALESMAN 7698 1250
> SALES         0     30  7698 BLAKE  1981-01-05 MANAGER  7839 2850
> SALES         0     30  7844 TURNER 1981-09-08 SALESMAN 7698 1500
> SALES         0     30  7900 JAMES  1981-12-03 CLERK    7698  950
> OPERATIONS
>
> val it : {dname:string, e:{comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} option} bag

(*) Query 9: union, of bags, so every row is kept.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps where e.deptno = 10 yield {n = e.empno}
    union (from d in spark.catalog.scott.depts yield {n = d.deptno})
)).execute ();
> n
> ----
> 7782
> 7839
> 7934
>   10
>   20
>   30
>   40
>
> val it : {n:int} bag

(*) Query 10: arithmetic, including div and mod.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps
    where e.deptno = 10
    yield {e.empno, w = ~e.empno, x = e.sal * 2.0, y = e.empno div 7,
           z = e.empno mod 7}
)).execute ();
> empno w     x     y    z
> ----- ----- ----- ---- -
>  7782 -7782  4900 1111 5
>  7839 -7839 10000 1119 6
>  7934 -7934  2600 1133 3
>
> val it : {empno:int, w:int, x:real, y:int, z:int} bag

(*) Query 11: string functions.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps
    where String.isPrefix "S" e.ename
    yield {e.ename, n = String.size e.ename,
           s = String.substring (e.ename, 0, 2), t = e.ename ^ "!"}
)).execute ();
> ename n s  t
> ----- - -- ------
> SMITH 5 SM SMITH!
> SCOTT 5 SC SCOTT!
>
> val it : {ename:string, n:int, s:string, t:string} bag

(*) Query 12: elem, an IN subquery.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps
    where e.deptno elem
      (from d in spark.catalog.scott.depts
       where d.loc = "CHICAGO" yield d.deptno)
    yield e.ename
)).execute ();
> val it = ["ALLEN","WARD","MARTIN","BLAKE","TURNER","JAMES"] : string bag

(*) Query 13: a correlated scalar subquery.
(spark.connection.prepare (fn () =>
  from d in spark.catalog.scott.depts
    yield {d.dname,
           n = (from e in spark.catalog.scott.emps where e.deptno = d.deptno
                compute count over ())}
)).execute ();
> dname      n
> ---------- -
> ACCOUNTING 3
> RESEARCH   5
> SALES      6
> OPERATIONS 0
>
> val it : {dname:string, n:int} bag

(*) Query 14: a result that is not a collection.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps compute count over ()
)).execute ();
> val it = 14 : int

(*) Query 15: except and intersect, of bags.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps yield {n = e.deptno}
    except (from d in spark.catalog.scott.depts
            where d.deptno > 20 yield {n = d.deptno})
)).execute ();
> n
> --
> 20
> 30
> 20
> 30
> 30
> 10
> 20
> 10
> 30
> 20
> 30
> 20
> 10
>
> val it : {n:int} bag

(*) Query 15: except and intersect, of bags.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps yield {n = e.deptno}
    intersect (from d in spark.catalog.scott.depts
               where d.deptno > 20 yield {n = d.deptno})
)).execute ();
> n
> --
> 30
>
> val it : {n:int} bag

(*) Query 16: group by two keys with two aggregates, then sort.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps
    group {e.deptno, e.job}
      compute {n = count over (), s = sum over e.sal}
    order (deptno, job)
)).execute ();
> deptno job       n s
> ------ --------- - ----
>     10 CLERK     1 1300
>     10 MANAGER   1 2450
>     10 PRESIDENT 1 5000
>     20 ANALYST   2 6000
>     20 CLERK     2 1900
>     20 MANAGER   1 2975
>     30 CLERK     1  950
>     30 MANAGER   1 2850
>     30 SALESMAN  4 5600
>
> val it : {deptno:int, job:string, n:int, s:real} list

(*) A plan with a parameter, executed twice.
val byDept = spark.connection.prepare (fn d =>
  from e in spark.catalog.scott.emps where e.deptno = d yield e.ename);
> val byDept = <plan> : (int, string bag) plan
byDept.execute 10;
> val it = ["CLARK","KING","MILLER"] : string bag
byDept.execute 40;
> val it = [] : string bag

(*) "remote" prepares and executes in one step.
(spark.connection.remote (fn () =>
  from e in spark.catalog.scott.emps where e.job = "CLERK" yield e.ename)) ();
> val it = ["SMITH","ADAMS","JAMES","MILLER"] : string bag

spark.connection.close ();
> val it = () : unit

(*) End spark-exec.smli
