 *
 * Tests type aliases, i.e. types declared using the 'type' keyword.
 *)

(*) Type alias
type myInt = int;
> type myInt = int
val x: myInt = 5;
> val x = 5 : myInt
val x = 6 : myInt;
> val x = 6 : myInt
val x = (6 : myInt) + 1;
> val x = 7 : myInt

(*) Deduce list type based on first element
val list = [1: myInt];
> val list = [1] : myInt list
val list = [2: myInt, 3: myInt, 4];
> val list = [2,3,4] : myInt list
val list = [5, 6: myInt];
> val list = [5,6] : int list
val list = []: myInt list;
> val list = [] : myInt list
val list = []: int list;
> val list = [] : int list

type intPair = int * int;
> type intPair = int * int
val x: intPair = (4, 5);
> val x = (4,5) : intPair
val x2 = (4, 5): intPair;
> val x2 = (4,5) : intPair
val x3 = (4, 5);
> val x3 = (4,5) : int * int
val y: int * int = x;
> val y = (4,5) : int * int
val z: intPair = y;
> val z = (4,5) : intPair

(*) Define two aliases at once
type myInt = int and myRealList = real list;
> type myInt = int
> type myRealList = real list
val reals = [1.0, 2.0, 3.0]: myRealList;
> val reals = [1,2,3] : myRealList

(* A "type" declaration is not recursive, and the bindings in a
 * "type ... and ..." group are simultaneous, so a name that the
 * declaration itself introduces is not in scope in its body.
 * Expanding such a name once overflowed the stack. *)
type t = t list;
> stdIn:1.10 Error: unbound type constructor: t
>   raised at: stdIn:1.10
type a = int and b = a list;
> stdIn:1.22 Error: unbound type constructor: a
>   raised at: stdIn:1.22

(* A name that the declaration itself rebinds means the definition
 * being displaced, not the one being declared. A type alias is
 * transparent, so it is expanded. *)
type t2 = int;
> type t2 = int
type t2 = t2 list;
> type t2 = int list
val x2 : t2 = [1,2];
> val x2 = [1,2] : t2

(*) The bindings of a 'type ... and ...' group are simultaneous.
type u2 = int;
> type u2 = int
type u2 = u2 list and v2 = u2;
> type u2 = int list
> type v2 = int

(* A datatype is generative, so it cannot be expanded; the displaced
 * type is displayed '?.d2', as in Standard ML. *)
datatype d2 = A2 | B2;
> datatype d2 = A2 | B2
type d2 = d2 list;
> type d2 = ?.d2 list

(* Shadowing the same name twice gives two distinct displaced types.
 * Standard ML displays both '?.d3', which does not distinguish them;
 * we expand the alias, which does. *)
datatype d3 = A3 | B3;
> datatype d3 = A3 | B3
type d3 = d3 list;
> type d3 = ?.d3 list
type d3 = d3 list;
> type d3 = ?.d3 list list

(*) Each displaced datatype is a separate type, though both print '?.e3'.
datatype e3 = P3 | Q3;
> datatype e3 = P3 | Q3
type e3 = e3 list;
> type e3 = ?.e3 list
datatype e3 = R3 | S3;
> datatype e3 = R3 | S3
type e3 = e3 list;
> type e3 = ?.e3 list

(* A displaced datatype keeps its identity: its constructors still
 * belong to it, and match against it. Whether a name still refers to
 * a type is decided when the type is displayed, so the same value
 * prints 'e4' before the name is taken over and '?.e4' after. *)
datatype d4 = A4 | B4;
> datatype d4 = A4 | B4
type d4 = d4 list;
> type d4 = ?.d4 list
B4;
> val it = B4 : ?.d4
[A4];
> val it = [A4] : ?.d4 list
case A4 of A4 => 1 | B4 => 2;
> val it = 1 : int

(*) A datatype displaced by another datatype behaves the same way.
datatype e4 = P4 | Q4;
> datatype e4 = P4 | Q4
val x4 = P4;
> val x4 = P4 : e4
datatype e4 = R4 | S4;
> datatype e4 = R4 | S4
x4;
> val it = P4 : ?.e4
val y4 = R4;
> val y4 = R4 : e4

(* An alias survives inference, as in Standard ML, so it is still visible in
 * the type of an expression that never mentions it. *)
type nat = int;
> type nat = int
val n: nat = 5;
> val n = 5 : nat
n;
> val it = 5 : nat

(*) It propagates into a composite that is built from it.
[n];
> val it = [5] : nat list
{a = n};
> val it = {a=5} : {a:nat}
(n, n);
> val it = (5,5) : nat * nat

(*) And out of one, including through a polymorphic function.
val ns: nat list = [1, 2];
> val ns = [1,2] : nat list
List.hd ns;
> val it = 1 : nat
List.map (fn i => i) ns;
> val it = [1,2] : nat list
val p: nat * nat = (1, 2);
> val p = (1,2) : nat * nat
#1 p;
> val it = 1 : nat

(* It is lost exactly where an operation needed the type it abbreviates, which
 * is where the value may have changed. *)
List.map (fn i => i - 1) ns;
> val it = [0,1] : int list

(*) A parameter and a result keep it.
fun f (x: nat) = x;
> val f = fn : nat -> nat
fun g (x: nat): nat = x;
> val g = fn : nat -> nat

(* An alias is transparent, so two aliases of the same type are
 * interchangeable. *)
type count = int;
> type count = int
val c: count = n;
> val c = 5 : count
val n2: nat = c;
> val n2 = 5 : nat

(* Aliases of different types are not. The message names the aliases that were
 * written, and what they abbreviate. *)
type name = string;
> type name = string
val bad: name = n;
> stdIn:1.1-1.18 Error: Cannot deduce type: conflict: name (alias for string) vs nat (alias for int)
>   raised at: stdIn:1.1-1.18
val bad2: nat list = ["x"];
> stdIn:1.1-1.27 Error: Cannot deduce type: conflict: string vs nat (alias for int)
>   raised at: stdIn:1.1-1.27

(* An operator defined for the underlying type is defined for the alias. Note
 * that the result keeps the alias, because Morel's arithmetic operators are
 * overloaded, 'a * 'a -> 'a; Standard ML's '+' is int * int -> int, so SML/NJ
 * gives 'int' here. *)
n + 1;
> val it = 6 : nat
n - 100;
> val it = ~95 : nat
n * 2;
> val it = 10 : nat
n div 2;
> val it = 2 : nat
n mod 2;
> val it = 1 : nat
~n;
> val it = ~5 : nat

(*) A comparison is not arithmetic, so it yields bool.
n < 6;
> val it = true : bool
n = 5;
> val it = true : bool

(*) An alias of 'real' works the same way.
type ratio = real;
> type ratio = real
val r: ratio = 1.5;
> val r = 1.5 : ratio
r + 1.0;
> val it = 2.5 : ratio
Real.abs r;
> val it = 1.5 : real

(*) Mixing an alias with its underlying type is allowed; the alias survives.
n + (1: int);
> val it = 6 : nat

(*) An operator not defined for the underlying type is still rejected.
type flag = bool;
> type flag = bool
val fl: flag = true;
> val fl = true : flag
fl + 1;
> stdIn:1.1-1.7 Error: Cannot deduce type: conflict: flag (alias for bool) vs int
>   raised at: stdIn:1.1-1.7

(*) Type errors report types in the syntax they are written in.
val t1: int * int = 1;
> stdIn:1.1-1.22 Error: Cannot deduce type: conflict: int * int vs int
>   raised at: stdIn:1.1-1.22
val t2: int * int = (1, 2, 3);
> stdIn:1.1-1.30 Error: Cannot deduce type: conflict: int * int vs T3 * T4 * T5
>   raised at: stdIn:1.1-1.30
val r1: {x: int} = 1;
> stdIn:1.1-1.21 Error: Cannot deduce type: conflict: {x:int} vs int
>   raised at: stdIn:1.1-1.21

(*) End type-alias.smli
