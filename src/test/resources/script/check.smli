 *
 * Tests constrained types, i.e. a 'type' declaration with a
 * 'check' clause.
 *)

Sys.set ("lineWidth", 78);
> val it = () : unit

(* A 'check' clause on a type declaration states a constraint on the type.
 * The constraint is parsed but not yet enforced. *)
type nat = int check i => i >= 0;
> type nat = int check i => i >= 0
val n: nat = 5;
> val n = 5 : nat

(*) A clause may be repeated; each adds a constraint.
type batchSize = int check i => i >= 1 check j => j <= 12;
> type batchSize = int check i => i >= 1 check j => j <= 12

(*) The match may have more than one branch, and need not be exhaustive.
type badPair = (bool * int) check
    (true, 0) => true
  | (false, i) => i mod 2 = 0;
> type badPair = bool * int check (true, 0) => true | (false, i) => i mod 2 = 0

(*) The value the match binds may be destructured.
type parityPair = {i: int, j: int} check {i, j} => i mod 2 = j mod 2;
> type parityPair = {i:int, j:int} check {i = i, j = j} => i mod 2 = j mod 2

(*) A type without a clause is unaffected.
type plain = int;
> type plain = int
val p: plain = 5;
> val p = 5 : plain

(* A clause must be a function from the type it constrains to 'bool'. The
 * condition sees the type as the type it abbreviates: the value has not yet
 * been admitted to the constrained type, so the constraint may not be assumed
 * of it. *)
type notBool = int check i => i + 1;
> stdIn:1.1-1.36 Error: Cannot deduce type: conflict: bool vs int
>   raised at: stdIn:1.1-1.36
type notInt = int check s => String.size s > 0;
> stdIn:1.1-1.47 Error: Cannot deduce type: conflict: int vs string
>   raised at: stdIn:1.1-1.47

(* The branches of a clause are alternatives, but separate clauses are
 * conjoined, so the two may not be flattened into one list. Here the first
 * clause is total via its second branch; as separate clauses neither would
 * be. *)
type evenOrZero = int check 0 => true | i => i mod 2 = 0 check i => i >= 0;
> type evenOrZero = int check 0 => true | i => i mod 2 = 0 check i => i >= 0

(* A constraint is part of the type's identity, so redeclaring the name with a
 * different condition gives a different type; but it does not survive into
 * the type the compiler works with, so a constrained type still behaves as
 * the type it abbreviates. *)
type nat = int check i => i >= 1;
> type nat = int check i => i >= 1
val n2: nat = 5;
> val n2 = 5 : nat
n2 + 1;
> val it = 6 : int
List.hd [n2];
> val it = 5 : nat
List.map (fn i => i) [n2];
> val it = [5] : nat list

(* A condition must be closed: it may refer only to the value it is given and
 * to the standard basis. That is what lets a constrained type be interned like
 * any other type -- two constrained types are the same type when their
 * conditions are textually equal, which would not follow if a condition could
 * also depend on an environment -- and it settles what a condition means when
 * the values it used are re-bound, by making the question not arise.
 *
 * Supporting a non-closed condition, by inlining what it refers to at the
 * declaration so that the condition becomes closed, is a possible future
 * feature; then the type would survive, with the values it used snapshotted
 * as they were when it was declared. *)
val limit = 12;
> val limit = 12 : int
fun lessThanDozen i = i >= 1 andalso i <= limit;
> val lessThanDozen = fn : int -> bool
type batch = int check i => lessThanDozen i;
> stdIn:1.1-1.17 Error: condition of constrained type 'batch' is not closed; it refers to 'lessThanDozen'
>   raised at: stdIn:1.1-1.17

(*) Written out, the same condition is closed.
type batch = int check i => i >= 1 andalso i <= 12;
> type batch = int check i => i >= 1 andalso i <= 12
val six: batch = 6;
> val six = 6 : batch

(*) A reference to the standard basis is closed; a built-in is not re-bindable.
type nonEmpty = string check s => String.size s > 0;
> type nonEmpty = string check s => #size String s > 0
val hi: nonEmpty = "hi";
> val hi = "hi" : nonEmpty
val blank: nonEmpty = "";
> uncaught exception Constraint ["" is not a valid nonEmpty]
>   raised at: stdIn:1.5-1.25

(*) A parameterized type may not be constrained.
type 'a myList = 'a list check l => not (List.null l);
> stdIn:1.6-1.25 Error: cannot constrain parameterized type 'myList'
>   raised at: stdIn:1.6-1.25

(* A binding at a constrained type is where a value flows into a claim, so the
 * condition is checked there. It is not checked anywhere else: the value is
 * already known to satisfy it. *)
val ok: nat = 5;
> val ok = 5 : nat
val notOk: nat = ~1;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.5-1.20

(*) Every clause must hold.
val small: batchSize = 6;
> val small = 6 : batchSize
val tooBig: batchSize = 13;
> uncaught exception Constraint [13 is not a valid batchSize]
>   raised at: stdIn:1.5-1.27
val tooSmall: batchSize = 0;
> uncaught exception Constraint [0 is not a valid batchSize]
>   raised at: stdIn:1.5-1.28

(*) The whole value is quoted in the message, however big.
val evens: parityPair = {i = 2, j = 4};
> val evens = {i=2,j=4} : parityPair
val mixed: parityPair = {i = 1, j = 2};
> uncaught exception Constraint [{i=1,j=2} is not a valid parityPair]
>   raised at: stdIn:1.5-1.39

(* A condition need not match every value; a value it does not match does not
 * satisfy it. Without this the condition would raise 'Match'. *)
type zero = int check 0 => true;
> type zero = int check 0 => true
val z0: zero = 0;
> val z0 = 0 : zero
val z1: zero = 1;
> uncaught exception Constraint [1 is not a valid zero]
>   raised at: stdIn:1.5-1.17

(* 'as' converts a value to a type, checking the type's condition; 'asOpt'
 * tests the condition instead, giving SOME if it holds and NONE if it does
 * not. The type converted to is the one the user named, not the one inference
 * deduces: inference gives the meet of the two, which for a constrained type
 * is the type it abbreviates, so the printed type is 'int'. *)
val i = 5;
> val i = 5 : int
val j = ~5;
> val j = ~5 : int
i as nat;
> val it = 5 : int
j as nat;
> uncaught exception Constraint [~5 is not a valid nat]
>   raised at: stdIn:1.1-1.9
i asOpt nat;
> val it = SOME 5 : int option
j asOpt nat;
> val it = NONE : int option

(*) Converting to an unconstrained type claims nothing, and cannot fail.
i as int;
> val it = 5 : int
j asOpt int;
> val it = SOME ~5 : int option

(*) They bind as loosely as ':', so the whole expression is converted.
i - 1 as nat;
> val it = 4 : int
(i as nat) + 1;
> val it = 6 : int
i - 10 as nat;
> uncaught exception Constraint [~5 is not a valid nat]
>   raised at: stdIn:1.1-1.14

(*) They are left-associative, and mix with ':'.
i as nat as int;
> val it = 5 : int
(i : int) as nat;
> val it = 5 : int

(* A conversion between types with different erasures is an ordinary type
 * error, reported by the unifier without any constraint reasoning. *)
"abc" as nat;
> stdIn:1.1-1.13 Error: Cannot deduce type: conflict: nat (alias for int) vs string
>   raised at: stdIn:1.1-1.13

(* A parameter's check is compiled inside the function, so it travels with
 * the function value and fires however the function is called. The position
 * reported is the function's, not the call's, for that reason. *)
fun f (n: nat) = n;
> val f = fn : nat -> nat
f 5;
> val it = 5 : int
f ~1;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.5-1.19
val k = fn (n: nat) => n + 1;
> val k = fn : int -> int
k ~3;
> uncaught exception Constraint [~3 is not a valid nat]
>   raised at: stdIn:1.12-1.29

(* So a constrained value may be passed through a polymorphic function that
 * knows nothing of the constraint, and is still checked. This is why such a
 * function needs no reified type or handler. *)
List.map f [1, 2];
> val it = [1,2] : int list
List.map f [1, ~2];
> uncaught exception Constraint [~2 is not a valid nat]
>   raised at: stdIn:1.5-1.19
List.filter (fn i => i > 0) [1, ~2];
> val it = [1] : int list

(* The annotation is read, not deduced, because the body may weaken it:
 * arithmetic drops the constraint, so this function's type is 'int -> int',
 * but its parameter is still checked. *)
fun decr (n: nat) = n - 1;
> val decr = fn : int -> int
decr 3;
> val it = 2 : int
decr ~3;
> uncaught exception Constraint [~3 is not a valid nat]
>   raised at: stdIn:1.5-1.26

(* A claim on a composite type is a claim about its components, so each is
 * checked. The message names the component that failed and quotes it, rather
 * than the whole value. A tuple's components are numbered as its selectors
 * are, so 'component 2' is what '#2' selects. A list element has no index;
 * 'List.all', which walks the list, does not offer one. *)
type employee = {empno: nat, name: string};
> type employee = {empno:nat, name:string}
val e: employee = {empno = 1, name = "Fred"};
> val e = {empno=1,name="Fred"} : employee
val e2: employee = {empno = ~1, name = "Fred"};
> uncaught exception Constraint [~1 is not a valid nat: field empno]
>   raised at: stdIn:1.5-1.47

(*) Nesting is followed to any depth.
type team = {lead: employee, size: nat};
> type team = {lead:employee, size:nat}
val t: team = {lead = {empno = ~1, name = "Fred"}, size = 2};
> uncaught exception Constraint [~1 is not a valid nat: field lead.empno]
>   raised at: stdIn:1.5-1.61

(*) A tuple behaves as a record does.
type pair = nat * nat;
> type pair = nat * nat
val p: pair = (1, 2);
> val p = (1,2) : pair
val p2: pair = (1, ~2);
> uncaught exception Constraint [~2 is not a valid nat: component 2]
>   raised at: stdIn:1.5-1.23

(*) Every element of a list must satisfy the element type's condition.
type nats = nat list;
> type nats = nat list
val ns: nats = [1, 2];
> val ns = [1,2] : nats
val ns2: nats = [1, ~2];
> uncaught exception Constraint [~2 is not a valid nat: element]
>   raised at: stdIn:1.5-1.24

(* Components are checked before the whole, so a type's own condition may
 * assume that its components satisfy theirs. *)
type nonEmptyNats = nat list check l => not (List.null l);
> type nonEmptyNats = nat list check l => not (#null List l)
val q1: nonEmptyNats = [1];
> val q1 = [1] : nonEmptyNats
val q2: nonEmptyNats = [];
> uncaught exception Constraint [[] is not a valid nonEmptyNats]
>   raised at: stdIn:1.5-1.26
val q3: nonEmptyNats = [~1];
> uncaught exception Constraint [~1 is not a valid nat: element]
>   raised at: stdIn:1.5-1.28

(*) A composite that constrains nothing is not checked at all.
type plainPair = int * string;
> type plainPair = int * string
val pp: plainPair = (1, "a");
> val pp = (1,"a") : plainPair

(* The whole is blamed only when its own condition fails; a component that
 * fails is blamed for itself. Components are checked first, so the innermost
 * failure is the one reported. *)
type evenPair = (nat * nat) check (i, j) => i * j mod 2 = 0;
> type evenPair = nat * nat check (i, j) => i * j mod 2 = 0
val ep1: evenPair = (2, 3);
> val ep1 = (2,3) : evenPair
val ep2: evenPair = (~1, 2);
> uncaught exception Constraint [~1 is not a valid nat: component 1]
>   raised at: stdIn:1.5-1.28
val ep3: evenPair = (1, 3);
> uncaught exception Constraint [(1,3) is not a valid evenPair]
>   raised at: stdIn:1.5-1.27

(* Applying a datatype constructor is a construction site, like a binding:
 * the constructor was declared to hold a 'nat', so its argument is checked. *)
datatype box = Box of nat;
> datatype box = Box of nat
Box 1;
> val it = Box 1 : box
Box ~1;
> uncaught exception Constraint [~1 is not a valid nat: argument of Box]
>   raised at: stdIn:1.1-1.4

(*) The path names the component within the argument.
datatype boxPair = BoxPair of nat * nat;
> datatype boxPair = BoxPair of nat * nat
BoxPair (1, ~2);
> uncaught exception Constraint [~2 is not a valid nat: argument of BoxPair.2]
>   raised at: stdIn:1.1-1.8

(*) A constructor that holds an unconstrained type is not checked.
datatype plainBox = PlainBox of int;
> datatype plainBox = PlainBox of int
PlainBox ~1;
> val it = PlainBox ~1 : plainBox

(* A record modifier yields a plain record, which claims nothing, so it is
 * checked where its result is bound at the constrained type rather than at
 * the modifier itself. *)
{e replace empno = ~1};
> val it = {empno=~1,name="Fred"} : {empno:int, name:string}
val e3: employee = {e replace empno = ~1};
> uncaught exception Constraint [~1 is not a valid nat: field empno]
>   raised at: stdIn:1.5-1.42

(* An ascription is a claim, like a binding, so it is checked wherever it
 * appears -- not only where its value is bound. *)
(~1 : nat);
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.1-1.11
([1, ~2] : nat list);
> uncaught exception Constraint [~2 is not a valid nat: element]
>   raised at: stdIn:1.1-1.21
val fm = fn () => (~1 : nat);
> val fm = fn : unit -> int
fm ();
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.19-1.29

(* A 'fun' declaration's result annotation reaches Resolver as an ascription
 * on the body, so a result is checked too. The declared type is still 'int':
 * the annotation and the body's type meet, and the meet of a constrained type
 * and the type it abbreviates is the latter. *)
fun neg () : nat = ~1;
> val neg = fn : unit -> int
neg ();
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.20-1.22
fun pos () : nat = 1;
> val pos = fn : unit -> int
pos ();
> val it = 1 : int
fun idNat (x: int) : nat = x;
> val idNat = fn : int -> int
idNat 1;
> val it = 1 : int
idNat ~1;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.28

(* A check on a value is made when the value is made, and a function value is
 * not a value its type can be checked against: to check 'nat -> nat' every
 * argument it is ever given and every result it ever returns would have to be
 * checked, which means replacing the function with a proxy. Rather than do
 * that silently, or accept the claim and check nothing, the claim is
 * rejected. *)
val h: nat -> nat = fn i => i - 1;
> stdIn:1.8-1.18 Error: cannot claim a constrained function type 'nat -> nat'
>   raised at: stdIn:1.8-1.18
val h2: int -> nat = fn i => i;
> stdIn:1.9-1.19 Error: cannot claim a constrained function type 'int -> nat'
>   raised at: stdIn:1.9-1.19
val h3: nat -> int = fn i => i;
> stdIn:1.9-1.19 Error: cannot claim a constrained function type 'nat -> int'
>   raised at: stdIn:1.9-1.19

(*) A function type nested inside another type is rejected too.
val h4: {f: nat -> nat} = {f = fn i => i};
> stdIn:1.9-1.24 Error: cannot claim a constrained function type '{f:nat -> nat}'
>   raised at: stdIn:1.9-1.24

(*) So is one claimed at a parameter, or by an ascription or a conversion.
fun apply2 (g: nat -> nat) = g 1;
> stdIn:1.16-1.26 Error: cannot claim a constrained function type 'nat -> nat'
>   raised at: stdIn:1.16-1.26
val h5 = (fn i => i) : nat -> nat;
> stdIn:1.24-1.34 Error: cannot claim a constrained function type 'nat -> nat'
>   raised at: stdIn:1.24-1.34

(*) A function type that constrains nothing is unaffected.
val h6: int -> int = fn i => i;
> val h6 = fn : int -> int
val h7: plain -> plain = fn i => i;
> val h7 = fn : plain -> plain

(* A conversion between types with different erasures is an ordinary type
 * error; the unifier names both, and says which is an alias. *)
val bad2: nat = "abc";
> stdIn:1.1-1.22 Error: Cannot deduce type: conflict: nat (alias for int) vs string
>   raised at: stdIn:1.1-1.22

(* A condition may itself raise. Then whether the value has the type is not
 * false but unknown, and 'Constraint' is raised either way -- the value has
 * not been shown to have the type -- but the message says which happened, and
 * what went wrong. *)
type odd = int check i => 100 div i mod 2 = 1;
> type odd = int check i => 100 div i mod 2 = 1
val odd1: odd = 3;
> val odd1 = 3 : odd
val odd2: odd = 2;
> uncaught exception Constraint [2 is not a valid odd]
>   raised at: stdIn:1.5-1.18
val odd3: odd = 0;
> uncaught exception Constraint [cannot tell whether 0 is a valid odd; Div [divide by zero]]
>   raised at: stdIn:1.5-1.18

(*) A component says which component, as it does when the condition is false.
type odds = odd list;
> type odds = odd list
val os1: odds = [3, 5];
> uncaught exception Constraint [5 is not a valid odd: element]
>   raised at: stdIn:1.5-1.23
val os2: odds = [3, 2];
> uncaught exception Constraint [2 is not a valid odd: element]
>   raised at: stdIn:1.5-1.23
val os3: odds = [3, 0];
> uncaught exception Constraint [cannot tell whether 0 is a valid odd: element; Div [divide by zero]]
>   raised at: stdIn:1.5-1.23

(* 'asOpt' asks rather than claims, so a condition that is false is an answer;
 * but one that raises has no answer, so it raises too. *)
3 asOpt odd;
> val it = SOME 3 : int option
2 asOpt odd;
> val it = NONE : int option
0 asOpt odd;
> uncaught exception Constraint [cannot tell whether 0 is a valid odd; Div [divide by zero]]
>   raised at: stdIn:1.1-1.12

(* A scan over a constrained type enumerates the values of that type, so the
 * type's condition belongs in the query, where the planner can use it to
 * generate the values rather than generate and reject them. It does not
 * raise: which values the type has is the question being asked, not something
 * already claimed of a value in hand. *)
type parityPair = {i: int, j: int} check {i, j} => i mod 2 = j mod 2;
> type parityPair = {i:int, j:int} check {i = i, j = j} => i mod 2 = j mod 2
from {i, j}: parityPair where i elem [0..2] andalso j elem [5..8];
> val it = [{i=0,j=6},{i=0,j=8},{i=1,j=5},{i=1,j=7},{i=2,j=6},{i=2,j=8}]
>   : {i:int, j:int} list

(*) The condition restricts a scalar scan too.
from n: nat where n elem [~2..2];
> val it = [0,1,2] : int list

(*) A scan over an unconstrained type is unaffected.
type plainPair = {i: int, j: int};
> type plainPair = {i:int, j:int}
from {i, j}: plainPair where i elem [0..1] andalso j elem [0..1];
> val it = [{i=0,j=0},{i=0,j=1},{i=1,j=0},{i=1,j=1}] : {i:int, j:int} list

(* Grounding a record variable from a constraint on a field selection is not
 * implemented, so the destructured form above is the one to write. *)
from p: parityPair where p.i elem [0..2] andalso p.j elem [5..8];
> stdIn:1.6-1.19 Error: pattern 'p' is not grounded
>   raised at: stdIn:1.6-1.19

(* A claim is an annotation the user wrote, not a type inference deduced. So
 * a 'let val' is checked exactly as a top-level 'val' is; both read the same
 * annotation, through the same code. *)
val topLevel: nat = ~1;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.5-1.23
let val inLet: nat = ~1 in inLet end;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.9-1.24

(* And a type inference deduces is not a claim. Here the user claimed nothing:
 * the function checks its own parameter, and 'nat -> nat' is what inference
 * made of that, so there is nothing to reject and nothing to check twice. *)
val fnVal = fn (n: nat) => n;
> val fnVal = fn : nat -> nat
fnVal ~1;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.16-1.29

(*) An annotation on a component of a pattern claims that component.
val (compA: nat, compB) = (~1, 2);
> uncaught exception Constraint [~1 is not a valid nat: component 1]
>   raised at: stdIn:1.5-1.34
fun compFn (x: nat, y: int) = x;
> val compFn = fn : nat * int -> nat
compFn (~1, 2);
> uncaught exception Constraint [~1 is not a valid nat: component 1]
>   raised at: stdIn:1.5-1.32

(* Entering a branch whose pattern claims a type is where a value flows into
 * the claim, so that is where the check goes. A pattern stays irrefutable: it
 * still matches every value, and may then raise. *)
case ~1 of (n: nat) => n;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.12-1.25
case 1 of (n: nat) => n;
> val it = 1 : int

(* A branch is what a function's parameter and a 'case' have in common, so a
 * function of several branches is checked in whichever branch claims. The
 * parameter of the function as a whole claims nothing -- another branch may
 * match instead -- and its type is 'int -> int'. *)
fun firstOrNat 0 = 0 | firstOrNat (n: nat) = n;
> val firstOrNat = fn : int -> int
firstOrNat 0;
> val it = 0 : int
firstOrNat 5;
> val it = 5 : int
firstOrNat ~1;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.24-1.47

(* A schema: a record whose fields are tables. Constraints apply at three
 * levels -- a row, a whole table, and the schema that relates the tables --
 * and each is a condition on the type at that level. *)
type emp = {deptno: int, empno: int, mgrno: int option, sal: real}
  check e => e.sal > 0.0;
> type emp = {deptno:int, empno:int, mgrno:int option, sal:real} check e => #sal e > 0.0
type dept = {deptno: int, dname: string};
> type dept = {deptno:int, dname:string}

(* Intra-relation constraints, on the table: an employee number identifies at
 * most one employee -- there are as many distinct numbers as rows -- and
 * nobody earns more than their manager. A manager is optional, so the
 * employee at the top of the tree has none. *)
type emps = emp bag
  check es => Bag.length es
      = Bag.length (from e in es yield e.empno distinct)
  check es => not (exists e in es, m in es
      where e.mgrno = SOME m.empno andalso e.sal > m.sal);
> type emps = emp bag check es => #length Bag es = #length Bag (from e in es yield #empno e distinct) check es => not (exists e in es, m in es where #mgrno e = SOME (#empno m) andalso #sal e > #sal m)

(* An inter-relation constraint, on the schema: every employee's department
 * exists. Only the schema can state it, because only it sees both tables. *)
type hr = {depts: dept bag, emps: emps}
  check h => not (exists e in h.emps
      where not (exists d in h.depts where d.deptno = e.deptno));
> type hr = {depts:dept bag, emps:emps} check h => not (exists e in #emps h where not (exists d in #depts h where #deptno d = #deptno e))

val hr0: hr = {
  depts = bag [{deptno = 10, dname = "Sales"},
               {deptno = 20, dname = "Research"}],
  emps = bag [{empno = 1, deptno = 10, mgrno = NONE, sal = 9.0},
              {empno = 2, deptno = 20, mgrno = SOME 1, sal = 5.0}]};
> val hr0 =
>   {depts=[{deptno=10,dname="Sales"},{deptno=20,dname="Research"}],
>    emps=[{deptno=10,empno=1,mgrno=NONE,sal=9},
>          {deptno=20,empno=2,mgrno=SOME 1,sal=5}]} : hr

(* A schema derived from another is checked where it is bound; the derivation
 * itself yields a plain record, which claims nothing. Hiring is an append. *)
val hrHired: hr = {hr0 replace emps = from e in hr0.emps
  union [{empno = 3, deptno = 10, mgrno = SOME 1, sal = 4.0}]};
> val hrHired =
>   {depts=[{deptno=10,dname="Sales"},{deptno=20,dname="Research"}],
>    emps=[{deptno=10,empno=1,mgrno=NONE,sal=9},
>          {deptno=20,empno=2,mgrno=SOME 1,sal=5},
>          {deptno=10,empno=3,mgrno=SOME 1,sal=4}]} : hr

(*) Hiring someone with a number already in use breaks the table.
val hrDup: hr = {hr0 replace emps = from e in hr0.emps
  union [{empno = 2, deptno = 10, mgrno = SOME 1, sal = 4.0}]};
> uncaught exception Constraint [[{deptno=10,empno=1,mgrno=NONE,sal=9},{deptno=20,empno=2,mgrno=SOME 1,sal=5},{deptno=10,empno=2,mgrno=SOME 1,sal=4}] is not a valid emps: field emps]
>   raised at: stdIn:1.5-2.63

(* Hiring someone unpaid breaks the row, and is blamed on the row: a
 * constraint is checked at the level that states it. *)
val hrUnpaid: hr = {hr0 replace emps = from e in hr0.emps
  union [{empno = 3, deptno = 10, mgrno = SOME 1, sal = 0.0}]};
> uncaught exception Constraint [{deptno=10,empno=3,mgrno=SOME 1,sal=0} is not a valid emp: field emps.element]
>   raised at: stdIn:1.5-2.63

(*) Raising someone above their manager breaks the table.
val hrRaise: hr = {hr0 replace emps = from e in hr0.emps
  yield (if e.empno = 2 then {e replace sal = 99.0} else e)};
> uncaught exception Constraint [[{deptno=10,empno=1,mgrno=NONE,sal=9},{deptno=20,empno=2,mgrno=SOME 1,sal=99}] is not a valid emps: field emps]
>   raised at: stdIn:1.5-2.61

(*) Moving someone to a department that does not exist breaks the schema.
val hrMoved: hr = {hr0 replace emps = from e in hr0.emps
  yield (if e.empno = 2 then {e replace deptno = 99} else e)};
> uncaught exception Constraint [{depts=[{deptno=10,dname="Sales"},{deptno=20,dname="Research"}],emps=[{deptno=10,empno=1,mgrno=NONE,sal=9},{deptno=99,empno=2,mgrno=SOME 1,sal=5}]} is not a valid hr]
>   raised at: stdIn:1.5-2.62

(*) Closing a department that still has employees breaks it from the other side.
val hrClosed: hr = {hr0 replace depts = from d in hr0.depts
  where d.deptno <> 20};
> uncaught exception Constraint [{depts=[{deptno=10,dname="Sales"}],emps=[{deptno=10,empno=1,mgrno=NONE,sal=9},{deptno=20,empno=2,mgrno=SOME 1,sal=5}]} is not a valid hr]
>   raised at: stdIn:1.5-2.24

(* Whether a reference is to the basis is decided by the binding, not by the
 * name. A user who shadows a basis name has declared a value of their own,
 * and a condition that referred to it would take its meaning from the
 * environment: before this was checked, the condition below was accepted, and
 * admitted ~1 though it reads as "not negative".
 *
 * This shadows 'not' for everything after it, so it comes last. *)
val not = fn (b: bool) => true;
> val not = fn : bool -> bool
type shadowed = int check i => not (i < 0);
> stdIn:1.1-1.20 Error: condition of constrained type 'shadowed' is not closed; it refers to 'not'
>   raised at: stdIn:1.1-1.20

