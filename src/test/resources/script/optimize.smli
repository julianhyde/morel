 *
 * Tests for inlining and other optimizations.
 *)
Sys.set ("stringDepth", NONE);
> val it = () : unit

(* --- Variable inlining ------------------------------------------ *)

(*) A variable used once is inlined.
let val x = 1 in x + 2 end;
> val it = 3 : int
Sys.plan ();
> val it = "apply2(fnValue Int.+, constant(1), constant(2))" : string

(*) A variable used twice is not inlined if non-atomic.
let val x = 1 + 1 in x + x end;
> val it = 4 : int
Sys.plan ();
> val it =
>   "let1(expCode apply2(fnValue Int.+, constant(1), constant(1)), resultCode apply2(fnValue Int.+, stack(offset 1, name x), stack(offset 1, name x)))"
>   : string

(*) An atomic variable (bound to a literal) used twice is inlined.
let val x = 5 in x + x end;
> val it = 10 : int
Sys.plan ();
> val it = "apply2(fnValue Int.+, constant(5), constant(5))" : string

(* A variable used once, but in an expression that a query evaluates
 * for each row, is not inlined: that would evaluate it once per row,
 * not once. Here "ys" would be computed for each element of "xs". *)
let
  val n = 2
  val ys = from i in [1, 2, 3] where i > n yield i * 10
in
  from x in [10, 20, 30] where x elem ys
end;
> val it = [30] : int list
Sys.planEx "-1";
> val it =
>   "val it =\n  let\n    val ys =\n      project i [#`*` Int (i, 10)] : int list\n        filter i [i > 2] : int list\n          [1, 2, 3] : int list\n    \n  in\n    r$0[ys]\n  end\n\nr$0[ys] =\n  filter x [op elem (x, ys)] : int list\n    [10, 20, 30] : int list\n"
>   : string

(*) A function used once in a query is inlined, because it is a value.
let
  fun big x = x > 15
in
  from x in [10, 20, 30] where big x
end;
> val it = [20,30] : int list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   filter x [x > 15] : int list
>     [10, 20, 30] : int list
> |_} : string

(*) A dead variable (not used) is removed.
let val x = 1 val y = 2 in y end;
> val it = 2 : int
Sys.plan ();
> val it = "constant(2)" : string

(* --- Function inlining ------------------------------------------ *)

(*) A function applied once is inlined.
let val f = fn x => x + 1 in f 5 end;
> val it = 6 : int
Sys.plan ();
> val it = "apply2(fnValue Int.+, constant(5), constant(1))" : string

(* --- Singleton case inlining ------------------------------------ *)

(*) A singleton case with id pattern is inlined.
let val f = fn x => case x of y => y + 2 in f 3 end;
> val it = 5 : int
Sys.plan ();
> val it = "apply2(fnValue Int.+, constant(3), constant(2))" : string

(* --- Constant case inlining (issue #330) ------------------------ *)

(*) Case on a constant matching a literal pattern.
let val x = 2 in case x of 1 => "one" | 2 => "two" | _ => "large" end;
> val it = "two" : string
Sys.plan ();
> val it = "constant(two)" : string

(*) Case on a constant matching the first pattern.
let val x = 1 in case x of 1 => "one" | 2 => "two" | _ => "large" end;
> val it = "one" : string
Sys.plan ();
> val it = "constant(one)" : string

(*) Case on a constant matching the wildcard pattern.
let val x = 99 in case x of 1 => "one" | 2 => "two" | _ => "large" end;
> val it = "large" : string
Sys.plan ();
> val it = "constant(large)" : string

(*) Case on a constant with id pattern that binds the value.
let val x = 5 in case x of y => y + 10 end;
> val it = 15 : int
Sys.plan ();
> val it = "apply2(fnValue Int.+, constant(5), constant(10))" : string

(*) If-then-else with constant true condition.
if true then "yes" else "no";
> val it = "yes" : string
Sys.plan ();
> val it = "constant(yes)" : string

(*) If-then-else with constant false condition.
if false then "yes" else "no";
> val it = "no" : string
Sys.plan ();
> val it = "constant(no)" : string
Sys.planEx "~1";
> val it = "val it = case false of true => \"yes\" | _ => \"no\"" : string
Sys.planEx "1";
> val it = "val it = \"no\"" : string

(*) Boolean case.
let val b = true in case b of true => 1 | false => 0 end;
> val it = 1 : int
Sys.plan ();
> val it = "constant(1)" : string

(*) String case.
let val s = "hello" in case s of "hello" => 1 | "world" => 2 | _ => 3 end;
> val it = 1 : int
Sys.plan ();
> val it = "constant(1)" : string

(*) Char case.
let val c = #"a" in case c of #"a" => 1 | #"b" => 2 | _ => 3 end;
> val it = 1 : int
Sys.plan ();
> val it = "constant(1)" : string

(*) Real case.
let val r = 1.0 in case r of 0.0 => 0 | 1.0 => 1 | _ => 2 end;
> val it = 1 : int
Sys.planEx "1";
> val it = "val it = 1" : string

(*) Unit case.
let val u = () in case u of () => "unit" | _ => "not unit" end;
> stdIn:1.44-1.59 Error: match redundant
>   raised at: stdIn:1.44-1.59
Sys.planEx "1";
> val it = "val it = \"unit\"" : string

(*) Tuple case.
let
  val t = (1, "a")
in
  case t of
     (0, _) => "zero"
   | (1, s) => "one:" ^ s
   | _ => "other"
end;
> val it = "one:a" : string
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   let
>     val t = (1, "a")
>   in
>     case t of (0, _) => "zero" | (1, s) => "one:" ^ s | _ => "other"
>   end|_} : string
Sys.planEx "1";
> val it = "val it = #`^` String (\"one:\", \"a\")" : string

(*) Record case.
let
  val t = {a = 1, b = "a"}
in
  case t of
     {a = 0, ...} => "zero"
   | {a = 1, b = s} => "one:" ^ s
   | _ => "other"
end;
> val it = "one:a" : string
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   let
>     val t = {a = 1, b = "a"}
>   in
>     case t of {a = 0, b = _} => "zero"
>       | {a = 1, b = s} => "one:" ^ s
>       | _ => "other"
>   end|_} : string
Sys.planEx "1";
> val it = "val it = #`^` String (\"one:\", \"a\")" : string

(*) Enum case
let
  val ordering = LESS
in
  case ordering of
     LESS => "LESS"
   | GREATER => "GREATER"
   | _ => "?"
end;
> val it = "LESS" : string
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   let
>     val ordering = LESS
>   in
>     case ordering of LESS => "LESS" | GREATER => "GREATER" | _ => "?"
>   end|_} : string
Sys.planEx "1";
> val it = "val it = \"LESS\"" : string

(*) Option case (an enum with one argument).
let
  val someA = SOME "a"
in
  case someA of
      SOME "0" => "some0"
    | SOME s => "some:" ^ s
    | NONE => "none"
end;
> val it = "some:a" : string
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   let
>     val someA = SOME "a"
>   in
>     case someA of SOME("0") => "some0"
>       | SOME(s) => "some:" ^ s
>       | NONE => "none"
>   end|_} : string
Sys.planEx "1";
> val it = "val it = #`^` String (\"some:\", \"a\")" : string

let
  val none = NONE
in
  case none of
      SOME "0" => "some0"
    | SOME s => "some:" ^ s
    | NONE => "none"
end;
> val it = "none" : string
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   let
>     val none = NONE
>   in
>     case none of SOME("0") => "some0" | SOME(s) => "some:" ^ s | NONE => "none"
>   end|_} : string
Sys.planEx "1";
> val it = "val it = \"none\"" : string

(*) Either case (an enum with two type parameters).
let
  val `left` = INL "a"
in
  case `left` of INL s => "left:" ^ s | INR s => "right:" ^ s
end;
> val it = "left:a" : string
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   let
>     val `left` = INL "a"
>   in
>     case `left` of INL(s) => "left:" ^ s | INR(s_1) => "right:" ^ s_1
>   end|_} : string
Sys.planEx "1";
> val it = "val it = #`^` String (\"left:\", \"a\")" : string

(*) Tree case (an enum with a tuple value)
let
  datatype tree = EMPTY | NODE of tree * int * string
  val v = NODE (NODE (EMPTY, 1, "a"), 2, "b")
in
  case v of EMPTY => "empty" | NODE (t, i, s) => s
end;
> val it = "b" : string
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   local datatype tree in let
>     val v = NODE (NODE (EMPTY, 1, "a"), 2, "b")
>   in
>     case v of EMPTY => "empty" | NODE((t, i, s)) => s
>   end end|_} : string
Sys.planEx "1";
> val it = "val it = local datatype tree in \"b\" end" : string

(* --- Cross-compile-unit inlining (issue #223) ------------------- *)

(*) An atomic integer from a previous compile unit is inlined.
val x = 42;
> val x = 42 : int
x + 1;
> val it = 43 : int
Sys.planEx "0";
> val it = "val it = 42 + 1" : string

(*) An atomic string from a previous compile unit is inlined.
val greeting = "hello";
> val greeting = "hello" : string
String.size greeting;
> val it = 5 : int
Sys.planEx "0";
> val it = "val it = #size String \"hello\"" : string

(*) An atomic boolean from a previous compile unit is inlined.
val flag = true;
> val flag = true : bool
if flag then 1 else 2;
> val it = 1 : int
Sys.planEx "2";
> val it = "val it = 1" : string

(*) Multiple atomic values from previous compile units are inlined.
val a = 10;
> val a = 10 : int
val b = 20;
> val b = 20 : int
a + b;
> val it = 30 : int
Sys.planEx "0";
> val it = "val it = 10 + 20" : string

(* --- Cross-compile-unit function inlining (issue #223) ---------- *)

(*) A simple function from a previous compile unit is inlined.
val inc = fn x => x + 1;
> val inc = fn : int -> int
inc 5;
> val it = 6 : int
Sys.planEx "3";
> val it = "val it = 5 + 1" : string

(*) A function with multiple operations is inlined and beta-reduced.
val double = fn n => n * 2;
> val double = fn : int -> int
double 7;
> val it = 14 : int
Sys.planEx "3";
> val it = "val it = #`*` Int (7, 2)" : string

(*) Composing inlined functions.
val inc2 = fn x => x + 1;
> val inc2 = fn : int -> int
val double2 = fn x => x * 2;
> val double2 = fn : int -> int
inc2 (double2 3);
> val it = 7 : int
Sys.planEx "3";
> val it = "val it = #`*` Int (3, 2) + 1" : string

fn i => inc2 (double2 i);
> val it = fn : int -> int
Sys.planEx "3";
> val it = "val it = fn i => #`*` Int (i, 2) + 1" : string

(*) Recursive functions are NOT inlined (would cause infinite expansion).
val rec factorial = fn n => if n < 2 then 1 else n * factorial (n - 1);
> val factorial = fn : int -> int
factorial 5;
> val it = 120 : int
Sys.planEx "0";
> val it = "val it = factorial 5" : string

(*) Polymorphic functions are NOT inlined (require type unification).
val id = fn x => x;
> val id = fn : 'a -> 'a
id 42;
> val it = 42 : int
Sys.planEx "0";
> val it = "val it = id 42" : string

(*) Functions that reference other inlinable values are also inlined.
val offset = 100;
> val offset = 100 : int
val addOffset = fn x => x + offset;
> val addOffset = fn : int -> int
addOffset 5;
> val it = 105 : int
Sys.planEx "3";
> val it = "val it = 5 + 100" : string

(*) Capture
val n = 1;
> val n = 1 : int
val f = fn x => x + n;
> val f = fn : int -> int
val n = 2;
> val n = 2 : int
(*) Result should be 4 = 3 + 1, because n = 1 when f captured it.
val i = f 3;
> val i = 4 : int
Sys.planEx "3";
> val it = "val i = 3 + 1" : string

(*) Predicate inversion in a graph query
val edges = [
 {x = 1, y = 2},
 {x = 2, y = 3}];
> val edges = [{x=1,y=2},{x=2,y=3}] : {x:int, y:int} list

fun edge (x, y) = {x, y} elem edges;
> val edge = fn : int * int -> bool

fun path (x, y) =
  edge (x, y)
  orelse (exists z where path (x, z) andalso edge (z, y));
> val path = fn : int * int -> bool

from p where path p;
> val it = [(1,2),(2,3),(1,3)] : (int * int) list

(*) Adjacent range branches of orelse are merged into a single discreteSetOf.
from i where i > 0 andalso i < 10 orelse i > 12 andalso i <= 15;
> val it = [1,2,3,4,5,6,7,8,9,13,14,15] : int list
Sys.planEx "1";
> val it = "val it = #flatten Range ([OPEN (0, 10), OPEN_CLOSED (12, 15)])"
>   : string

(*) Point (i = v) and range branches are also merged.
from i where i = 1 orelse i > 5 andalso i < 8 orelse i = 3;
> val it = [1,6,7,3] : int list
Sys.planEx "1";
> val it = "val it = #flatten Range ([POINT 1, OPEN (5, 8), POINT 3])" : string

(*) Char is a finite type (256 values), so the plan filters the extent directly.
from c where c >= #"a" andalso c <= #"e" orelse c >= #"x" andalso c <= #"z";
> val it = [#"a",#"b",#"c",#"d",#"e",#"x",#"y",#"z"] : char list
Sys.planEx "1";
> val it =
>   {_|
> val it =
>   filter c [c >= #"a" andalso c <= #"e"
>       orelse c >= #"x" andalso c <= #"z"] : char list
>     extent "char" : char list
> |_} : string

(* --- FBBT (feasibility-based bound tightening) ---------------------
 * FBBT uses inequality conditions and tightens bounds to those that
 * could pass the filters (are 'feasible').
 *)

(* For abs, FBBT recognizes `abs x OP c` for the connected-interval
 * cases and emits the equivalent two-sided bounds. *)
from x where abs x < 5;
> val it = [~4,~3,~2,~1,0,1,2,3,4] : int list
Sys.planEx "3";
> val it =
>   {_|
> val it =
>   filter r [#abs Int r < 5] : int list
>     #flatten Range ([OPEN (~5, 5)]) : int list
> |_} : string
from x where abs x <= 3;
> val it = [~3,~2,~1,0,1,2,3] : int list
from x where 5 > abs x;
> val it = [~4,~3,~2,~1,0,1,2,3,4] : int list
from x where abs x = 0;
> val it = [0] : int list
from x where abs x < 10 andalso x > 0;
> val it = [1,2,3,4,5,6,7,8,9] : int list
(* Disjoint case (abs x > c) is two intervals — FBBT skips and the
 * constraint cannot be inverted by the existing extractor either. *)
from x where abs x > 5;
> stdIn:1.6 Error: pattern 'x' is not grounded
>   raised at: stdIn:1.6

(* Strengthened bounds via a non-linear constraint. FBBT recognizes
 * `(varA + kA) * (varB + kB) OP c` and propagates one side's bounds to
 * the other (positive quadrant only). *)
List.length (from x, y where x >= 1 andalso y >= 1 andalso x * (y + 3) < 30);
> val it = 51 : int
Sys.planEx "3";
> val it =
>   {|val it = #length List (r$0)
>
> r$0 =
>   project r [{x = #1 r, y = #2 r}] : {x:int, y:int} list
>     filter r [#`*` Int (#1 r, #2 r + 3) < 30] : (int * int) list
>       join x y : (int * int) list
>         #flatten Range ([CLOSED (1, 7)]) : int list
>         #flatten Range ([CLOSED_OPEN (1, 27)]) : int list
> |} : string

(* Same strengthening via the literal range-list syntax. FBBT injects
 * the implied lower bounds from `[1..]`, propagates through the
 * multiplication constraint, and pushes the deduced upper bounds back
 * into each scan's range constructor — turning `[1..]` into `[1..7]`
 * and `[1..^27]`. Preserves the original `int list` (ordered) type. *)
from x in [1..] where x < 5;
> val it = [1,2,3,4] : int list
List.length (from x in [1..], y in [1..] where x * (y + 3) < 30);
> val it = 51 : int
Sys.planEx "3";
> val it =
>   {|val it = #length List (r$0)
>
> r$0 =
>   project r [{x = #1 r, y = #2 r}] : {x:int, y:int} list
>     filter r [#`*` Int (#1 r, #2 r + 3) < 30] : (int * int) list
>       join x y : (int * int) list
>         #flatten Range ([CLOSED (1, 7)]) : int list
>         #flatten Range ([CLOSED_OPEN (1, 27)]) : int list
> |} : string

(* RangePushdown also handles char-typed infinite range scans. *)
from c in [#"a"..] where c < #"e";
> val it = [#"a",#"b",#"c",#"d"] : char list
Sys.planEx "3";
> val it = "val it = #flatten Range ([CLOSED_OPEN (#\"a\", #\"e\")])" : string
from c in [#"a"..] where c <= #"d";
> val it = [#"a",#"b",#"c",#"d"] : char list

(* Cyclic bounds resolved by FBBT.
 *
 * Each variable's generator depends on another. FBBT propagates the
 * constants through the cycle to deduce constant bounds for each
 * variable: the deduced bounds let the extractor build a finite range
 * for each generator, and the original cross-variable predicates
 * (e.g. `x < y`) remain as post-generation filters. *)
List.length (from x, y where x > 0 andalso x < y andalso y < 10);
> val it = 36 : int
Sys.planEx "3";
> val it =
>   {|val it = #length List (r$0)
>
> r$0 =
>   project r [{x = #1 r, y = #2 r}] : {x:int, y:int} list
>     join x y [x < y] : (int * int) list
>       #flatten Range ([OPEN (0, 10)]) : int list
>       #flatten Range ([OPEN (0, 10)]) : int list
> |} : string
List.length (from x, y where y > 0 andalso y < x andalso x < 10);
> val it = 36 : int
List.length (from x, y, z where x > 0 andalso x < y andalso y < z andalso z < 10);
> val it = 84 : int
from x where x > 0 andalso x < x + 1 andalso x < 5;
> val it = [1,2,3,4] : int list

(* Ranges that cannot be deduced even with FBBT.
 *
 * The first query is feasible but unbounded (`x < y andalso y < x + 10`
 * admits any x). The second has a non-linear constraint that needs
 * monotonicity reasoning. The third is a tilted polytope where the
 * variables only acquire bounds after pairs of constraints are added,
 * which is the job of Fourier-Motzkin elimination, not FBBT. All three
 * report 'not grounded' for now; subsequent techniques will handle
 * them. *)
from x, y where x < y andalso y < x + 10;
> stdIn:1.6 Error: pattern 'x' is not grounded
>   raised at: stdIn:1.6
from x, y where x > 0 andalso x * y = 100 andalso y > 0;
> stdIn:1.6 Error: pattern 'x' is not grounded
>   raised at: stdIn:1.6
from x, y
  where x + y >= 0 andalso x + y <= 10
  andalso x - y >= ~3 andalso x - y <= 3;
> stdIn:1.6 Error: pattern 'x' is not grounded
>   raised at: stdIn:1.6

(* -------------------------------------------------------------------
 * Deduplication that the consumer of a query renders unnecessary.
 *)

(* The expander deduplicates each generator it derives, because an unbounded
 * scan yields each assignment once. 'exists' and 'forall' ask only whether a
 * query has rows, which duplicates cannot change, so the generator is left as
 * it is; the plan below has no 'group'. *)
exists i where i elem [3, 1, 2];
> val it = true : bool
Sys.plan ();
> val it = "apply(fnValue Relational.nonEmpty, argCode constant([3, 1, 2]))"
>   : string
forall i where i elem [2, 4] require i mod 2 = 0;
> val it = true : bool

(* A 'take' or 'skip' depends on how many rows there are, which
 * deduplicating changes, so the generator is deduplicated after all. Here
 * '[1, 1, 2]' has two distinct values, which 'skip 2' removes; the three
 * undeduplicated rows would leave one. *)
from i where i elem [1, 1, 2] skip 2;
> val it = [] : int list
exists i where i elem [1, 1, 2] skip 2;
> val it = false : bool
exists i where i elem [1, 1, 2] skip 1;
> val it = true : bool

(* -------------------------------------------------------------------
 * Removing identity projections.
 *)

from i in [1, 3] yield i;
> val it = [1, 3] : int list
from i in [1, 3] yield {i};
> val it = [{i=1},{i=3}] : {i:int} list
from i in [1, 3], j in [2] yield {i, j};
> val it = [{i=1,j=2},{i=3,j=2}] : {i:int, j:int} list
from i in [1, 3], j in [2] yield {i, j} where i < j;
> val it = [{i=1,j=2}] : {i:int, j:int} list
from i in [1, 3], j in [2] yield {i = j, j = i};
> val it = [{i=2,j=1},{i=2,j=3}] : {i:int, j:int} list

(* Yielding a variable from the environment looks like an identity
 * projection but isn't. *)
val h = "xyz";
> val h = "xyz" : string
from i in [1, 2] yield {h};
> val it = [{h="xyz"},{h="xyz"}] : {h:string} list
from i in [1, 2] yield {h = h};
> val it = [{h="xyz"},{h="xyz"}] : {h:string} list
val b = true;
> val b = true : bool
from i in [1, 3], j in [2] yield {b, h};
> val it = [{b=true,h="xyz"},{b=true,h="xyz"}] : {b:bool, h:string} list

(* `Sys.planEx` writes a query as a query: each step after the keyword that
 * names it, and the scans after the first introduced by `join`. A pattern
 * that destructures is bracketed, so that what it binds is not read as part
 * of the step around it. *)
from x in [1, 2, 3] where x > 1 yield x + 1;
> val it = [3,4] : int list
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   project x [x + 1] : int list
>     filter x [x > 1] : int list
>       [1, 2, 3] : int list
> |_} : string
from x in [1, 2] join y in [3, 4] where x < y;
> val it = [{x=1,y=3},{x=1,y=4},{x=2,y=3},{x=2,y=4}] : {x:int, y:int} list
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   project r [{x = #1 r, y = #2 r}] : {x:int, y:int} list
>     filter r [#1 r < #2 r] : (int * int) list
>       join x y : (int * int) list
>         [1, 2] : int list
>         [3, 4] : int list
> |_} : string
from x in [3, 1, 2] group x;
> val it = [3,1,2] : int list
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   project r [#x r] : int list
>     group x [x = x] : {x:int} list
>       [3, 1, 2] : int list
> |_} : string
from x in [1, 2, 3] order x skip 1 take 1;
> val it = [2] : int list
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   take [1] : int list
>     skip [1] : int list
>       sort x [x] : int list
>         [1, 2, 3] : int list
> |_} : string
from (x, y) in [(1, 2)] yield x + y;
> val it = [3] : int list
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   project r [#1 r + #2 r] : int list
>     [(1, 2)] : (int * int) list
> |_} : string
from {a, b} in [{a = 1, b = 2}] yield a + b;
> val it = [3] : int list
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   project r [#a r + #b r] : int list
>     [{a = 1, b = 2}] : {a:int, b:int} list
> |_} : string

(* A selector is written by the field it selects: a record's label, a
 * tuple's ordinal, or the name of a structure's member. *)
val rs = [{a = 1, b = 2}];
> val rs = [{a=1,b=2}] : {a:int, b:int} list
from r in rs where #a r > 0;
> val it = [{a=1,b=2}] : {a:int, b:int} list
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   filter r [#a r > 0] : {a:int, b:int} list
>     rs : {a:int, b:int} list
> |_} : string
val ps = [(1, 2)];
> val ps = [(1,2)] : (int * int) list
from p in ps where #1 p > 0;
> val it = [(1,2)] : (int * int) list
Sys.planEx "~1";
> val it =
>   {_|
> val it =
>   filter p [#1 p > 0] : (int * int) list
>     ps : (int * int) list
> |_} : string
val xs = [1, 2, 3];
> val xs = [1,2,3] : int list
from i in List.rev xs;
> val it = [3,2,1] : int list
Sys.planEx "~1";
> val it = "val it = #rev List xs" : string

(* --- Hash join -------------------------------------------------- *)

(* A join whose condition has an equality between a key over the
 * left element and a key over the right element is a hash join
 * ("hashJoin" in the plan): the right side is put into buckets by
 * its key, once, and each left element reads only its own bucket.
 * The answer, and its order, are those of a nested loop: here, the
 * two "ys" elements whose "c" is 2 are joined, in order, with each
 * "xs" element whose "b" is 2. *)
val xs = [{a=1,b=2},{a=2,b=3},{a=3,b=2},{a=4,b=9}];
> val xs = [{a=1,b=2},{a=2,b=3},{a=3,b=2},{a=4,b=9}] : {a:int, b:int} list
val ys = [{c=2,d=5},{c=3,d=6},{c=2,d=7},{c=8,d=8}];
> val ys = [{c=2,d=5},{c=3,d=6},{c=2,d=7},{c=8,d=8}] : {c:int, d:int} list
from x in xs join y in ys on x.b = y.c yield {x.a, y.d};
> val it = [{a=1,d=5},{a=1,d=7},{a=2,d=6},{a=3,d=5},{a=3,d=7}]
>   : {a:int, d:int} list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([[1, 2], [2, 3], [3, 2], [4, 9]]), sink hashJoin(pat y, exp constant([[2, 5], [3, 6], [2, 7], [8, 8]]), leftKey apply(fnValue nth:1, argCode stack(offset 1, name x)), rightKey apply(fnValue nth:0, argCode stack(offset 1, name y)), condition apply2(fnValue =, apply(fnValue nth:1, argCode stack(offset 2, name x)), apply(fnValue nth:0, argCode stack(offset 1, name y))), sink collect(tuple(apply(fnValue nth:0, argCode stack(offset 2, name x)), apply(fnValue nth:1, argCode stack(offset 1, name y)))))))"
>   : string

(* A key that calls a function might raise, so it is not evaluated
 * eagerly; the join stays a nested loop ("join" in the plan), and
 * gives the same answer. *)
from x in xs join y in ys on x.b + 0 = y.c yield {x.a, y.d};
> val it = [{a=1,d=5},{a=1,d=7},{a=2,d=6},{a=3,d=5},{a=3,d=7}]
>   : {a:int, d:int} list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([[1, 2], [2, 3], [3, 2], [4, 9]]), sink join(pat y, exp constant([[2, 5], [3, 6], [2, 7], [8, 8]]), condition apply2(fnValue =, apply2(fnValue Int.+, apply(fnValue nth:1, argCode stack(offset 2, name x)), constant(0)), apply(fnValue nth:0, argCode stack(offset 1, name y))), sink collect(tuple(apply(fnValue nth:0, argCode stack(offset 2, name x)), apply(fnValue nth:1, argCode stack(offset 1, name y)))))))"
>   : string

(*) A left join keeps a left element whose bucket is empty.
from x in xs left join y in ys on x.b = y.c yield {x.a, y};
> val it =
>   [{a=1,y=SOME {c=2,d=5}},{a=1,y=SOME {c=2,d=7}},{a=2,y=SOME {c=3,d=6}},
>    {a=3,y=SOME {c=2,d=5}},{a=3,y=SOME {c=2,d=7}},{a=4,y=NONE}]
>   : {a:int, y:{c:int, d:int} option} list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([[1, 2], [2, 3], [3, 2], [4, 9]]), sink hashJoin(pat y, exp constant([[2, 5], [3, 6], [2, 7], [8, 8]]), leftKey apply(fnValue nth:1, argCode stack(offset 1, name x)), rightKey apply(fnValue nth:0, argCode stack(offset 1, name y)), condition apply2(fnValue =, apply(fnValue nth:1, argCode stack(offset 2, name x)), apply(fnValue nth:0, argCode stack(offset 1, name y))), sink collect(tuple(apply(fnValue nth:0, argCode apply(fnValue nth:0, argCode tuple(stack(offset 2, name x), stack(offset 1, name y)))), apply(fnValue nth:1, argCode tuple(stack(offset 2, name x), stack(offset 1, name y))))))))"
>   : string

(* Conjuncts other than the equality are evaluated for each element
 * of the bucket. *)
from x in xs join y in ys on x.b = y.c andalso x.a < y.d - 4
  yield {x.a, y.d};
> val it = [{a=1,d=7}] : {a:int, d:int} list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([[1, 2], [2, 3], [3, 2], [4, 9]]), sink hashJoin(pat y, exp constant([[2, 5], [3, 6], [2, 7], [8, 8]]), leftKey apply(fnValue nth:1, argCode stack(offset 1, name x)), rightKey apply(fnValue nth:0, argCode stack(offset 1, name y)), condition andalso(apply2(fnValue =, apply(fnValue nth:1, argCode stack(offset 2, name x)), apply(fnValue nth:0, argCode stack(offset 1, name y))), apply2(fnValue <, apply(fnValue nth:0, argCode stack(offset 2, name x)), apply2(fnValue Int.-, apply(fnValue nth:1, argCode stack(offset 1, name y)), constant(4)))), sink collect(tuple(apply(fnValue nth:0, argCode stack(offset 2, name x)), apply(fnValue nth:1, argCode stack(offset 1, name y)))))))"
>   : string

(* Two equalities make a key that is a tuple. A key may be a
 * constant, if the other side reads the right element. *)
from x in xs join y in ys on x.b = y.c andalso 7 = y.d yield {x.a, y.d};
> val it = [{a=1,d=7},{a=3,d=7}] : {a:int, d:int} list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([[1, 2], [2, 3], [3, 2], [4, 9]]), sink hashJoin(pat y, exp constant([[2, 5], [3, 6], [2, 7], [8, 8]]), leftKey tuple(apply(fnValue nth:1, argCode stack(offset 1, name x)), constant(7)), rightKey tuple(apply(fnValue nth:0, argCode stack(offset 1, name y)), apply(fnValue nth:1, argCode stack(offset 1, name y))), condition andalso(apply2(fnValue =, apply(fnValue nth:1, argCode stack(offset 2, name x)), apply(fnValue nth:0, argCode stack(offset 1, name y))), apply2(fnValue =, constant(7), apply(fnValue nth:1, argCode stack(offset 1, name y)))), sink collect(tuple(apply(fnValue nth:0, argCode stack(offset 2, name x)), apply(fnValue nth:1, argCode stack(offset 1, name y)))))))"
>   : string

(* Keys may be options, built with constructors such as SOME. As
 * everywhere in Morel, NONE = NONE. *)
val ps = [{k=SOME 1,v="a"},{k=NONE,v="b"},{k=SOME 2,v="c"}];
> val ps = [{k=SOME 1,v="a"},{k=NONE,v="b"},{k=SOME 2,v="c"}]
>   : {k:int option, v:string} list
val qs = [{k=SOME 1,w=10},{k=NONE,w=20},{k=SOME 3,w=30}];
> val qs = [{k=SOME 1,w=10},{k=NONE,w=20},{k=SOME 3,w=30}]
>   : {k:int option, w:int} list
from p in ps join q in qs on p.k = q.k yield {p.v, q.w};
> val it = [{v="a",w=10},{v="b",w=20}] : {v:string, w:int} list
from p in ps join q in qs on p.k = SOME q.w yield {p.v, q.w};
> val it = [] : {v:string, w:int} list
Sys.plan ();
> val it =
>   "globalMarshal(globals [SOME], body from(sink join(pat p, exp constant([[[SOME, 1], a], [[NONE], b], [[SOME, 2], c]]), sink hashJoin(pat q, exp constant([[[SOME, 1], 10], [[NONE], 20], [[SOME, 3], 30]]), leftKey apply(fnValue nth:0, argCode stack(offset 1, name p)), rightKey apply(fnValue tyCon, argCode apply(fnValue nth:1, argCode stack(offset 1, name q))), condition apply2(fnValue =, apply(fnValue nth:0, argCode stack(offset 2, name p)), apply(fnValue tyCon, argCode apply(fnValue nth:1, argCode stack(offset 1, name q)))), sink collect(tuple(apply(fnValue nth:1, argCode stack(offset 2, name p)), apply(fnValue nth:1, argCode stack(offset 1, name q))))))))"
>   : string

(* Keys may be records, strings and decimals. Equal decimals are
 * equal however they are written. *)
from x in [{s="a",n=decimal "1.50"},{s="b",n=decimal "2"}]
  join y in [{s="a",n=decimal "1.5"},{s="b",n=decimal "2.00"}]
    on {s=x.s,n=x.n} = {s=y.s,n=y.n}
  yield x.s;
> val it = ["a","b"] : string list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([[1.5, a], [2, b]]), sink hashJoin(pat y, exp constant([[1.5, a], [2, b]]), leftKey tuple(apply(fnValue nth:0, argCode stack(offset 1, name x)), apply(fnValue nth:1, argCode stack(offset 1, name x))), rightKey tuple(apply(fnValue nth:0, argCode stack(offset 1, name y)), apply(fnValue nth:1, argCode stack(offset 1, name y))), condition apply2(fnValue =, tuple(apply(fnValue nth:0, argCode stack(offset 2, name x)), apply(fnValue nth:1, argCode stack(offset 2, name x))), tuple(apply(fnValue nth:0, argCode stack(offset 1, name y)), apply(fnValue nth:1, argCode stack(offset 1, name y)))), sink collect(apply(fnValue nth:1, argCode stack(offset 2, name x))))))"
>   : string

(*) Empty inputs.
from x in [] : {a:int, b:int} list join y in ys on x.b = y.c
  yield y.d;
> val it = [] : int list
from x in xs join y in [] : {c:int, d:int} list on x.b = y.c
  yield x.a;
> val it = [] : int list
from x in xs left join y in [] : {c:int, d:int} list on x.b = y.c
  yield {x.a, y};
> val it = [{a=1,y=NONE},{a=2,y=NONE},{a=3,y=NONE},{a=4,y=NONE}]
>   : {a:int, y:{c:int, d:int} option} list

(* Real keys are not hashed: NaN and ~0.0 make Java's equality
 * differ from Morel's. *)
from x in [1.5, 2.5] join y in [2.5, 3.5] on x = y yield x;
> val it = [2.5] : real list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([1.5, 2.5]), sink join(pat y, exp constant([2.5, 3.5]), condition apply2(fnValue =, stack(offset 2, name x), stack(offset 1, name y)), sink collect(stack(offset 2, name x)))))"
>   : string

(* Nor is a right side that reads the left element; nor a condition
 * that reads the ordinal; nor a condition with no equality. *)
from x in xs join y in (from y in ys where y.c = x.b) on x.b = y.c
  yield {x.a, y.d};
> val it = [{a=1,d=5},{a=1,d=7},{a=2,d=6},{a=3,d=5},{a=3,d=7}]
>   : {a:int, d:int} list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([[1, 2], [2, 3], [3, 2], [4, 9]]), sink join(pat y, exp from(sink join(pat y, exp constant([[2, 5], [3, 6], [2, 7], [8, 8]]), sink where(condition apply2(fnValue =, apply(fnValue nth:0, argCode stack(offset 1, name y)), apply(fnValue nth:1, argCode stack(offset 2, name x))), sink collect(stack(offset 1, name y))))), condition apply2(fnValue =, apply(fnValue nth:1, argCode stack(offset 2, name x)), apply(fnValue nth:0, argCode stack(offset 1, name y))), sink collect(tuple(apply(fnValue nth:0, argCode stack(offset 2, name x)), apply(fnValue nth:1, argCode stack(offset 1, name y)))))))"
>   : string
from x in xs join y in ys on x.b = y.c andalso ordinal < 3
  yield {x.a, y.d};
> val it = [{a=1,d=5},{a=1,d=7}] : {a:int, d:int} list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([[1, 2], [2, 3], [3, 2], [4, 9]]), sink join(pat y, exp constant([[2, 5], [3, 6], [2, 7], [8, 8]]), condition ordinal, sink collect(tuple(apply(fnValue nth:0, argCode stack(offset 2, name x)), apply(fnValue nth:1, argCode stack(offset 1, name y)))))))"
>   : string
from x in xs join y in ys on x.b < y.c yield {x.a, y.d};
> val it = [{a=1,d=6},{a=1,d=8},{a=2,d=8},{a=3,d=6},{a=3,d=8}]
>   : {a:int, d:int} list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([[1, 2], [2, 3], [3, 2], [4, 9]]), sink join(pat y, exp constant([[2, 5], [3, 6], [2, 7], [8, 8]]), condition apply2(fnValue <, apply(fnValue nth:1, argCode stack(offset 2, name x)), apply(fnValue nth:0, argCode stack(offset 1, name y))), sink collect(tuple(apply(fnValue nth:0, argCode stack(offset 2, name x)), apply(fnValue nth:1, argCode stack(offset 1, name y)))))))"
>   : string

(*) A right join is evaluated differently, and is not hashed.
from x in xs right join y in ys on x.b = y.c yield {x, y.d};
> val it =
>   [{d=5,x=SOME {a=1,b=2}},{d=7,x=SOME {a=1,b=2}},{d=6,x=SOME {a=2,b=3}},
>    {d=5,x=SOME {a=3,b=2}},{d=7,x=SOME {a=3,b=2}},{d=8,x=NONE}]
>   : {d:int, x:{a:int, b:int} option} list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([[1, 2], [2, 3], [3, 2], [4, 9]]), sink buildJoin(pat y, exp constant([[2, 5], [3, 6], [2, 7], [8, 8]]), condition apply2(fnValue =, apply(fnValue nth:1, argCode stack(offset 2, name x)), apply(fnValue nth:0, argCode stack(offset 1, name y))), sink collect(tuple(apply(fnValue nth:1, argCode apply(fnValue nth:1, argCode tuple(stack(offset 2, name x), stack(offset 1, name y)))), apply(fnValue nth:0, argCode tuple(stack(offset 2, name x), stack(offset 1, name y))))))))"
>   : string

(* In a function, whose argument is on the stack. The right key reads
 * only the right element; the left key may read the argument. *)
fun f n = from x in xs join y in ys on x.b = y.c andalso n = y.d
  yield {x.a, y.d};
> val f = fn : int -> {a:int, d:int} list
f 7;
> val it = [{a=1,d=7},{a=3,d=7}] : {a:int, d:int} list
fun g n = from x in xs join y in ys on (x.b, n) = (y.c, 5) yield x.a;
> val g = fn : int -> int list
g 5;
> val it = [1,1,2,3,3] : int list
g 6;
> val it = [] : int list

(* The condition is evaluated only for the elements of a bucket. So
 * a condition that would raise for a pair whose keys differ does
 * not raise: here "1 div (y.d - 8)" raises Div for the "ys" element
 * whose "d" is 8, which no "xs" element matches. (The order in which
 * a join evaluates its condition over pairs is not specified.) *)
from x in xs join y in ys on 1 div (y.d - 8) < 1 andalso x.b = y.c
  yield {x.a, y.d};
> val it = [{a=1,d=5},{a=1,d=7},{a=2,d=6},{a=3,d=5},{a=3,d=7}]
>   : {a:int, d:int} list

(* --- A where into the joins below it ---------------------------- *)

(* In a query of comma-separated scans, each conjunct of the "where"
 * moves into the join that first reads both its sides, or into the
 * input that it reads alone, so that the join is a hash join rather
 * than a filter over a cross product. "Sys.planEx" shows the tree
 * after the rules; "Sys.plan" what is executed. *)
val zs = [{e=5,f="five"},{e=7,f="seven"}];
> val zs = [{e=5,f="five"},{e=7,f="seven"}] : {e:int, f:string} list
from x in xs, y in ys where x.b = y.c yield {x.a, y.d};
> val it = [{a=1,d=5},{a=1,d=7},{a=2,d=6},{a=3,d=5},{a=3,d=7}]
>   : {a:int, d:int} list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([[1, 2], [2, 3], [3, 2], [4, 9]]), sink hashJoin(pat y, exp constant([[2, 5], [3, 6], [2, 7], [8, 8]]), leftKey apply(fnValue nth:1, argCode stack(offset 1, name x)), rightKey apply(fnValue nth:0, argCode stack(offset 1, name y)), condition apply2(fnValue =, apply(fnValue nth:1, argCode stack(offset 2, name x)), apply(fnValue nth:0, argCode stack(offset 1, name y))), sink collect(tuple(apply(fnValue nth:0, argCode stack(offset 2, name x)), apply(fnValue nth:1, argCode stack(offset 1, name y)))))))"
>   : string
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project r [{a = #a (#1 r), d = #d (#2 r)}] : {a:int, d:int} list
>     join x y [#b x = #c y] : t$0
>       xs : {a:int, b:int} list
>       ys : {c:int, d:int} list
>
> t$0 ({a:int, b:int} * {c:int, d:int}) list
> |_} : string

(* Three scans. "x.a > 1" reads only "x", so it filters "xs";
 * "z.f <> "q"" reads only "z", so it filters "zs" before it is
 * hashed; each equality goes into the join that reads both its
 * sides. *)
from x in xs, y in ys, z in zs
  where x.b = y.c andalso y.d = z.e andalso x.a > 1
    andalso z.f <> "q"
  yield {x.a, z.f};
> val it = [{a=3,f="five"},{a=3,f="seven"}] : {a:int, f:string} list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([[1, 2], [2, 3], [3, 2], [4, 9]]), sink where(condition apply2(fnValue >, apply(fnValue nth:0, argCode stack(offset 1, name x)), constant(1)), sink hashJoin(pat y, exp constant([[2, 5], [3, 6], [2, 7], [8, 8]]), leftKey apply(fnValue nth:1, argCode stack(offset 1, name x)), rightKey apply(fnValue nth:0, argCode stack(offset 1, name y)), condition apply2(fnValue =, apply(fnValue nth:1, argCode stack(offset 2, name x)), apply(fnValue nth:0, argCode stack(offset 1, name y))), sink hashJoin(pat z, exp from(sink join(pat z, exp constant([[5, five], [7, seven]]), sink where(condition apply2(fnValue <>, apply(fnValue nth:1, argCode stack(offset 1, name z)), constant(q)), sink collect(stack(offset 1, name z))))), leftKey apply(fnValue nth:1, argCode stack(offset 1, name y)), rightKey apply(fnValue nth:0, argCode stack(offset 1, name z)), condition apply2(fnValue =, apply(fnValue nth:1, argCode stack(offset 2, name y)), apply(fnValue nth:0, argCode stack(offset 1, name z))), sink collect(tuple(apply(fnValue nth:0, argCode stack(offset 3, name x)), apply(fnValue nth:1, argCode stack(offset 1, name z)))))))))"
>   : string
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project r [{a = #a (#1 r), f = #f (#3 r)}] : {a:int, f:string} list
>     join r z [#d (#2 r) = #e z] : t$0
>       join x y [#b x = #c y] : t$1
>         filter x [#a x > 1] : {a:int, b:int} list
>           xs : {a:int, b:int} list
>         ys : {c:int, d:int} list
>       filter z [#f z <> "q"] : {e:int, f:string} list
>         zs : {e:int, f:string} list
>
> t$0 ({a:int, b:int} * {c:int, d:int} * {e:int, f:string}) list
> t$1 ({a:int, b:int} * {c:int, d:int}) list
> |_} : string

(* A conjunct that might raise -- here "10 div x.a" -- stays where it
 * was written; the others move. *)
from x in xs, y in ys where x.b = y.c andalso 10 div x.a > 1
  yield {x.a, y.d};
> val it = [{a=1,d=5},{a=1,d=7},{a=2,d=6},{a=3,d=5},{a=3,d=7}]
>   : {a:int, d:int} list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project r [{a = #a (#1 r), d = #d (#2 r)}] : {a:int, d:int} list
>     filter r [#div Int (10, #a (#1 r)) > 1] : t$0
>       join x y [#b x = #c y] : t$0
>         xs : {a:int, b:int} list
>         ys : {c:int, d:int} list
>
> t$0 ({a:int, b:int} * {c:int, d:int}) list
> |_} : string

(* The conjuncts of a "where" join those of an "on". *)
from x in xs join y in ys on x.b = y.c where x.a < y.c
  yield {x.a, y.d};
> val it = [{a=1,d=5},{a=1,d=7},{a=2,d=6}] : {a:int, d:int} list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project r [{a = #a (#1 r), d = #d (#2 r)}] : {a:int, d:int} list
>     join x y [#b x = #c y andalso #a x < #c y] : t$0
>       xs : {a:int, b:int} list
>       ys : {c:int, d:int} list
>
> t$0 ({a:int, b:int} * {c:int, d:int}) list
> |_} : string

(* Consecutive "where" steps are merged, then moved. *)
from x in xs, y in ys where x.b = y.c where x.a > 1 yield {x.a, y.d};
> val it = [{a=2,d=6},{a=3,d=5},{a=3,d=7}] : {a:int, d:int} list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project r [{a = #a (#1 r), d = #d (#2 r)}] : {a:int, d:int} list
>     join x y [#b x = #c y] : t$0
>       filter x [#a x > 1] : {a:int, b:int} list
>         xs : {a:int, b:int} list
>       ys : {c:int, d:int} list
>
> t$0 ({a:int, b:int} * {c:int, d:int}) list
> |_} : string

(* Over a left join, a part of the "where" that reads only the left
 * side filters the left input: each of its elements is in the
 * output, padded or not. A part that reads the right side, whose
 * fields are options, stays; moving it into the "on" would keep the
 * rows that it removes. *)
from x in xs left join y in ys on x.b = y.c
  where x.a > 1 andalso Option.isSome y
  yield x.a;
> val it = [2,3,3] : int list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project r [#a (#1 r)] : int list
>     filter r [#isSome Option (#2 r)] : t$0
>       join x y [left] [#b x = #c y] : t$0
>         filter x [#a x > 1] : {a:int, b:int} list
>           xs : {a:int, b:int} list
>         ys : {c:int, d:int} list
>
> t$0 ({a:int, b:int} * {c:int, d:int} option) list
> |_} : string

(* Over a right join, likewise, a part that reads only the right
 * side filters the right input. *)
from x in xs right join y in ys on x.b = y.c
  where y.d > 5 andalso Option.isSome x
  yield y.d;
> val it = [7,6,7] : int list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project r [#d (#2 r)] : int list
>     filter r [#isSome Option (#1 r)] : t$0
>       join x y [right] [#b x = #c y] : t$0
>         xs : {a:int, b:int} list
>         filter y [#d y > 5] : {c:int, d:int} list
>           ys : {c:int, d:int} list
>
> t$0 ({a:int, b:int} option * {c:int, d:int}) list
> |_} : string

(* Over a full join, both sides are padded, and nothing moves. *)
from x in xs full join y in ys on x.b = y.c
  where Option.isSome x andalso Option.isSome y
  yield {x, y};
> val it =
>   [{x=SOME {a=1,b=2},y=SOME {c=2,d=5}},{x=SOME {a=1,b=2},y=SOME {c=2,d=7}},
>    {x=SOME {a=2,b=3},y=SOME {c=3,d=6}},{x=SOME {a=3,b=2},y=SOME {c=2,d=5}},
>    {x=SOME {a=3,b=2},y=SOME {c=2,d=7}}]
>   : {x:{a:int, b:int} option, y:{c:int, d:int} option} list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project r [{x = #1 r, y = #2 r}] : t$0
>     filter r [#isSome Option (#1 r) andalso #isSome Option (#2 r)] : t$1
>       join x y [full] [#b x = #c y] : t$1
>         xs : {a:int, b:int} list
>         ys : {c:int, d:int} list
>
> t$0 {x:{a:int, b:int} option, y:{c:int, d:int} option} list
> t$1 ({a:int, b:int} option * {c:int, d:int} option) list
> |_} : string

(* Nor does a "where" that reads "ordinal" move. *)
from x in xs, y in ys where x.b = y.c andalso ordinal < 2 yield {x.a, y.d};
> val it = [{a=1,d=5}] : {a:int, d:int} list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project r [{a = #a (#1 r), d = #d (#2 r)}] : {a:int, d:int} list
>     filter r $ordinal [#b (#1 r) = #c (#2 r) andalso $ordinal < 2] : t$0
>       join x y : t$0
>         xs : {a:int, b:int} list
>         ys : {c:int, d:int} list
>
> t$0 ({a:int, b:int} * {c:int, d:int}) list
> |_} : string

(* A conjunct that refers to the row from inside a query, here an
 * "exists", makes the resolver name the row, in a "let" around the
 * whole condition. The other conjuncts still move; the "exists"
 * becomes a semi-join (see below). *)
from x in xs, y in ys
  where x.b = y.c andalso (exists z in zs where z.e = y.d)
  yield {x.a, y.d};
> val it = [{a=1,d=5},{a=1,d=7},{a=3,d=5},{a=3,d=7}] : {a:int, d:int} list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project r [{a = #a (#1 r), d = #d (#2 r)}] : {a:int, d:int} list
>     join r z [semi] [#e z = #d (#2 r)] : t$0
>       join x y [#b x = #c y] : t$0
>         xs : {a:int, b:int} list
>         ys : {c:int, d:int} list
>       zs : {e:int, f:string} list
>
> t$0 ({a:int, b:int} * {c:int, d:int}) list
> |_} : string

(* --- Exists as a semi-join -------------------------------------- *)

(* An "exists" whose query reads the row only in equalities becomes a
 * semi-join: the query is evaluated once, not once per row, and the
 * join hashes it. Each row that has a match is kept once, however
 * many it has, in its order. Here "ys" has two elements with "c = 2",
 * and "xs" keeps each of its elements with "b = 2" once. *)
from x in xs where (exists y in ys where y.c = x.b) yield x.a;
> val it = [1,2,3] : int list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([[1, 2], [2, 3], [3, 2], [4, 9]]), sink hashSemiJoin(pat y, exp constant([[2, 5], [3, 6], [2, 7], [8, 8]]), leftKey apply(fnValue nth:1, argCode stack(offset 1, name x)), rightKey apply(fnValue nth:0, argCode stack(offset 1, name y)), condition apply2(fnValue =, apply(fnValue nth:0, argCode stack(offset 1, name y)), apply(fnValue nth:1, argCode stack(offset 2, name x))), sink collect(apply(fnValue nth:0, argCode stack(offset 1, name x))))))"
>   : string
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project x [#a x] : int list
>     join x y [semi] [#c y = #b x] : {a:int, b:int} list
>       xs : {a:int, b:int} list
>       ys : {c:int, d:int} list
> |_} : string

(* "not (exists ...)" becomes an anti-join. A conjunct of the query
 * that does not read the row stays in the query. *)
from x in xs
  where not (exists y in ys where y.c = x.b andalso y.d > 5)
  yield x.a;
> val it = [4] : int list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([[1, 2], [2, 3], [3, 2], [4, 9]]), sink hashAntiJoin(pat y, exp from(sink join(pat y, exp constant([[2, 5], [3, 6], [2, 7], [8, 8]]), sink where(condition apply2(fnValue >, apply(fnValue nth:1, argCode stack(offset 1, name y)), constant(5)), sink collect(stack(offset 1, name y))))), leftKey apply(fnValue nth:1, argCode stack(offset 1, name x)), rightKey apply(fnValue nth:0, argCode stack(offset 1, name y)), condition apply2(fnValue =, apply(fnValue nth:0, argCode stack(offset 1, name y)), apply(fnValue nth:1, argCode stack(offset 2, name x))), sink collect(apply(fnValue nth:0, argCode stack(offset 1, name x))))))"
>   : string

(* The equality may be in a filter under a join in the query; it comes
 * out to the semi-join's condition. *)
from x in xs
  where (exists y in ys, z in zs where y.d = z.e andalso y.c = x.b)
  yield x.a;
> val it = [1,3] : int list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project x [#a x] : int list
>     join x y [semi] [#c (#1 y) = #b x] : {a:int, b:int} list
>       xs : {a:int, b:int} list
>       join y z [#d y = #e z] : t$0
>         ys : {c:int, d:int} list
>         zs : {e:int, f:string} list
>
> t$0 ({c:int, d:int} * {e:int, f:string}) list
> |_} : string

(* An "exists" whose query reads the row other than in an equality is
 * left as it is, and evaluated for each row. *)
from x in xs where (exists y in ys where y.c > x.b) yield x.a;
> val it = [1,2,3] : int list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   project x [#a x] : int list
>     filter x [let
>           val v$0 = x
>         in
>           #nonEmpty Relational (r$0[v$0])
>         end] : {a:int, b:int} list
>       xs : {a:int, b:int} list
>
> r$0[v$0] =
>   filter y [#c y > #b v$0] : {c:int, d:int} list
>     ys : {c:int, d:int} list
> |_} : string

(* So is one whose query reads the row above a "group". *)
from x in xs
  where (exists g in (from y in ys group y.c compute {n = count over ()})
    where g.c = x.b andalso g.n > 1)
  yield x.a;
> val it = [1,3] : int list

(* The rewrite keeps the order in which "andalso" evaluates. A
 * conjunct after "exists" that might raise stays above the semi-join,
 * so that it sees only the rows that pass the "exists"; here "div"
 * would raise for the customer that has no orders. *)
val custs = [{id = 1, n = 0}, {id = 2, n = 1}];
> val custs = [{id=1,n=0},{id=2,n=1}] : {id:int, n:int} list
val orders = [{cust = 2, qty = 1}, {cust = 3, qty = 0}];
> val orders = [{cust=2,qty=1},{cust=3,qty=0}] : {cust:int, qty:int} list
from c in custs
  where (exists r in orders where r.cust = c.id)
    andalso 100 div c.n > 1;
> val it = [{id=2,n=1}] : {id:int, n:int} list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   filter c [#div Int (100, #n c) > 1] : {id:int, n:int} list
>     join c r [semi] [#cust r = #id c] : {id:int, n:int} list
>       custs : {id:int, n:int} list
>       orders : {cust:int, qty:int} list
> |_} : string
(* A subquery is not decorrelated if a conjunct that stays in it might
 * raise: decorrelated, it would be evaluated over every order, and
 * "div" would raise for the order whose customer is not in "custs". *)
from c in custs
  where (exists r in orders where r.cust = c.id andalso 10 div r.qty > 1);
> val it = [{id=2,n=1}] : {id:int, n:int} list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   filter c [let
>         val v$0 = c
>       in
>         #nonEmpty Relational (r$0[v$0])
>       end] : {id:int, n:int} list
>     custs : {id:int, n:int} list
>
> r$0[v$0] =
>   filter r [#cust r = #id v$0
>       andalso #div Int (10, #qty r) > 1] : {cust:int, qty:int} list
>     orders : {cust:int, qty:int} list
> |_} : string
(*) A conjunct before "exists" moves below the semi-join.
from c in custs
  where c.n > 0 andalso (exists r in orders where r.cust = c.id);
> val it = [{id=2,n=1}] : {id:int, n:int} list
Sys.planEx "-1";
> val it =
>   {_|
> val it =
>   join c r [semi] [#cust r = #id c] : {id:int, n:int} list
>     filter c [#n c > 0] : {id:int, n:int} list
>       custs : {id:int, n:int} list
>     orders : {cust:int, qty:int} list
> |_} : string

(* --- Constant folding ------------------------------------------- *)

(* A call that converts a constant without losing information is
 * evaluated at compile time. *)
from x in [1, 2] yield Decimal.fromInt x + Decimal.fromInt 100;
> val it = [101,102] : decimal list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([1, 2]), sink collect(apply2(fnValue Decimal.+, apply(fnValue Decimal.fromInt, argCode stack(offset 1, name x)), constant(100)))))"
>   : string
Real.fromInt 7;
> val it = 7 : real
Sys.plan ();
> val it = "constant(7.0)" : string
(*) A real cannot hold every int, so this call is not folded.
Real.fromInt 16777217;
> val it = 1.6777216E7 : real
Sys.plan ();
> val it = "apply(fnValue Real.fromInt, argCode constant(16777217))" : string
Real.fromInt 2147483647;
> val it = 2.1474836E9 : real
Sys.plan ();
> val it = "apply(fnValue Real.fromInt, argCode constant(2147483647))" : string
(*) A call that would raise is left, and raises only if reached.
if true then #"a" else Char.chr 300;
> val it = #"a" : char
Sys.plan ();
> val it = "constant(a)" : string
Char.chr 300;
> uncaught exception Chr
>   raised at: stdIn:1.1-1.13

(* A value made of constants -- a tuple, record, list or bag, or a
 * datatype constructor applied to a constant -- is evaluated once. *)
fn () => [SOME 1, NONE, SOME 3];
> val it = fn : unit -> int option list
Sys.plan ();
> val it = "match(v, constant([[SOME, 1], [NONE], [SOME, 3]]))" : string
fn () => {a = (1, SOME "x"), b = bag [Time.fromSeconds 10]};
> val it = fn : unit -> {a:int * string option, b:time bag}
Sys.plan ();
> val it = "match(v, constant([[1, [SOME, x]], [10000000000]]))" : string

(*) A field of a record whose other fields are constant.
fn x => #b {a = 1, b = x + 1};
> val it = fn : int -> int
Sys.plan ();
> val it =
>   "match(x, apply2(fnValue Int.+, stack(offset 1, name x), constant(1)))"
>   : string
(*) Not if another field might raise.
fn x => #b {a = 1 div x, b = x + 1};
> val it = fn : int -> int
Sys.plan ();
> val it =
>   "match(x, tailApply(fnValue nth:1, argCode tuple(apply2(fnValue Int.div, constant(1), stack(offset 1, name x)), apply2(fnValue Int.+, stack(offset 1, name x), constant(1)))))"
>   : string

(* "elem" and "notelem" against a constant collection look the value
 * up in a set. *)
from x in [SOME 1, NONE, SOME 4] where x elem [SOME 1, SOME 3, SOME 5];
> val it = [SOME 1] : int option list
Sys.plan ();
> val it =
>   "globalMarshal(globals [SOME], body from(sink join(pat x, exp constant([[SOME, 1], [NONE], [SOME, 4]]), sink where(condition elemSet(stack(offset 1, name x), set [[SOME, 1], [SOME, 3], [SOME, 5]]), sink collect(stack(offset 1, name x))))))"
>   : string
from x in [1, 2, 3] where x notelem [1, 3];
> val it = [2] : int list
Sys.plan ();
> val it =
>   "from(sink join(pat x, exp constant([1, 2, 3]), sink where(condition notElemSet(stack(offset 1, name x), set [1, 3]), sink collect(stack(offset 1, name x)))))"
>   : string

(*) End optimize.smli
